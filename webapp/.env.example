# ---------------------------------------------------------------------------
# Entra ID (Azure AD) app registration
# ---------------------------------------------------------------------------
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Reserved for the interactive Microsoft sign-in flow (not wired up yet).
MS_REDIRECT_URI=http://localhost:7005/api/auth/microsoft/callback

# ---------------------------------------------------------------------------
# BBT PRODUCT FORECAST workspace + semantic model
# ---------------------------------------------------------------------------
PBI_WORKSPACE_ID=9bb10710-8cac-427c-8ec3-67b10cd6a142
# Brands this deployment serves, one semantic model each:
#   code|Label|datasetId  (comma separated)
# Also verified working, uncomment to add:
#   ,MM|Mishmash / Tabel|bfd92b4d-fc5f-43d8-989c-8285f1cff145
#   ,SLC|Slice / Just C|0011f5d1-ff79-435d-8a6a-a663af7ed58c
PBI_DATASETS=

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=7005

# 1 = run the UI against generated sample data (no Power BI calls at all).
# 0 = query the live semantic model with the app registration above.
DEMO_MODE=0

# Seconds to cache each DAX result in memory (0 disables caching)
CACHE_TTL=120
