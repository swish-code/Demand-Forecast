# Demand Forecast — Railway service variables
#
# Paste the whole of this file into the Railway service's Variables tab using
# "Raw Editor". Railway has no .env file: what is here becomes real environment
# variables on the container, and the app reads process.env either way, so the
# names are identical to the ones used locally.
#
# Three values are deliberately left blank. Fill them in on Railway rather than
# writing them down here — a variables screen is not a place a secret leaks
# from, a file copied between machines is.
#
# Anything not listed keeps its default in server/config.js.


# --- filled in on Railway -----------------------------------------------------

# App registration secret, from Entra > App registrations > Certificates & secrets.
MS_CLIENT_SECRET=

# The first administrator's password. Set a strong one; it can be changed in the
# app afterwards. Leave it blank and one is generated and printed to the deploy
# log on first boot, which is also fine — read it there and change it.
ADMIN_PASSWORD=

# Your Railway domain, without a trailing slash. Settings > Networking gives you
# something like demand-forecast-production.up.railway.app. Both of these must
# use it, and the redirect URI must ALSO be added to the app registration in
# Entra > Authentication, or the Microsoft sign-in returns an error.
APP_ORIGIN=https://REPLACE-ME.up.railway.app
MS_REDIRECT_URI=https://REPLACE-ME.up.railway.app/api/auth/microsoft/callback


# --- where the data lives -----------------------------------------------------

# Railway gives each deployment a fresh filesystem, so anything written beside
# the code is gone on the next deploy — accounts, recipients, the local copy of
# the forecast, all of it. Attach a Volume to this service, mount it at /data,
# and point the app there. Without this the app runs and then quietly forgets
# everything every time you push.
#
#   Railway > the service > Variables > Volumes > add, mount path /data
DATA_DIR=/data


# --- the database -------------------------------------------------------------

# NOT YET IN USE. The PostgreSQL layer is written (server/db/driver.js and
# schema.js) but the application still reads and writes through the synchronous
# SQLite interface, so setting this today changes nothing. It is left here ready
# for the migration; until then the volume above is what makes the data durable.
#
# When the migration lands: add a Postgres database to the project and paste
# this reference exactly as written — Railway substitutes the running database's
# connection string, and a literal URL would break when the database redeploys.
# DATABASE_URL=${{Postgres.DATABASE_URL}}

# Managed Postgres presents a certificate its own proxy signed, so verification
# is relaxed for this host. Never set this to verify-full without also giving
# the container the CA.
# PGSSLMODE=require


# --- Microsoft and Power BI ---------------------------------------------------

MS_TENANT_ID=e37d603e-a9ef-4804-bda4-f22f73c66c0c
MS_CLIENT_ID=b16c4d77-3582-4951-ab0c-e0f326c5fb94
PBI_WORKSPACE_ID=9bb10710-8cac-427c-8ec3-67b10cd6a142
PBI_DATASETS=BBT|BBT|2a75de6b-bcbd-474b-b564-109706fe5a38,CHP|Chilli Pepper|1881d7ed-00d0-4f8f-bbe2-cbfb663da89b,PAT|Pattie Pattie|26fa5966-2962-4bde-8047-e07cdf5cc732,SS|Shawarma Shakir|96df4c23-ab81-4b74-8600-2c10183db956,YP|Yelo Pizza|c8910a0b-ccbb-4190-a198-be17aebec9d8,SLC|Slice|0011f5d1-ff79-435d-8a6a-a663af7ed58c|SLC,BUR|Just C|0011f5d1-ff79-435d-8a6a-a663af7ed58c|BUR,MM|Mishmash|bfd92b4d-fc5f-43d8-989c-8285f1cff145|MM,TBL|Tabel|bfd92b4d-fc5f-43d8-989c-8285f1cff145|TBL


# --- how hard to push Power BI ------------------------------------------------

# The capacity answers 429 with Retry-After: 60 when too many queries arrive at
# once. Six was measured as the point where throughput stops improving.
PBI_MAX_CONCURRENCY=6
CACHE_TTL=1800
DEMO_MODE=0


# --- the local copy of the data -----------------------------------------------

# Overview and Products are answered from a copy held in the database rather
# than from Power BI, which is what makes them open in well under a second.
CUBE_ENABLED=1
CUBE_DAYS=90
CUBE_AHEAD_DAYS=35
CUBE_REFRESH_MINUTES=60
CUBE_RECENT_DAYS=4
CUBE_BACKFILL_HOUR=2


# --- behind Railway's proxy ---------------------------------------------------

# Railway terminates TLS at its edge and forwards to the container, so the
# request Express sees arrives from the proxy, not the browser. One hop of
# trust makes req.ip the real client address again — which is what the sign-in
# log and the lockout counter record against.
TRUST_PROXY_HOPS=1


# --- accounts and sessions ----------------------------------------------------

ADMIN_EMAIL=admin@swishhh.net
SESSION_TTL_HOURS=12

# COOKIE_INSECURE is deliberately absent. It exists so sessions work over plain
# http on a laptop; Railway serves https, and setting it here would send session
# cookies without the Secure flag.


# --- daily mail ---------------------------------------------------------------

# Every report leaves as this address, whoever presses send. The mailbox has to
# be connected once from the admin page after the first deploy: the consent is
# tied to the redirect URI above, so it does not survive the move from
# localhost and has to be granted again on the Railway domain.
OUTLOOK_EMAIL=automation@swishhh.net
MAIL_TRANSPORT=delegated
MAIL_FROM_NAME=Demand Forecast

# Reports go out at MAIL_HOUR, but only once the model holds yesterday's sales.
# If the refresh is late they wait and retry, and send anyway at
# MAIL_LATEST_HOUR with a note saying the data was stale.
MAIL_HOUR=9
MAIL_LATEST_HOUR=12
MAIL_ENABLED=1
DIGEST_HOUR=7

# Uncomment to put the deployment back into test mode: every report is then
# delivered to this one address instead of to its real recipient.
# MAIL_TEST_TO=automation@swishhh.net


# --- not set on Railway -------------------------------------------------------
#
# PORT      Railway injects it, and the app already reads it. Setting it by hand
#           is how a deploy ends up unreachable.
# DB_PATH   the SQLite file path, which a Postgres deployment does not use.
