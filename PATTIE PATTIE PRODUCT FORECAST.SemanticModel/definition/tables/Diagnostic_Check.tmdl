	partition Diagnostic_Check = calculated
		mode: import
		source =
				
				SUMMARIZECOLUMNS(
				    'PAT'[LocationID],
				    'PAT'[VOUCHERDATE],
				    "Total_Distinct_Keys",        DISTINCTCOUNT('PAT'[KEY]),
				    "Total_Distinct_OrderProdID", DISTINCTCOUNT('PAT'[ORDER_PRODUCT_ID]),
				    "Total_Rows",                 COUNTROWS('PAT'),
				    "Total_Qty",                  SUM('PAT'[Qty])
				)

	annotation PBI_Id = 33f35d631a834d60826f88f4de5ea619

