	column 'Actual Sales' =
			
			IF(
			    'FM FORECAST'[DATE] < TODAY(),
			    COALESCE(
			        CALCULATE(
			            SUM('FM SALES PER LOCATION'[Sales]),
			            FILTER(
			                ALL('FM SALES PER LOCATION'),
			                'FM SALES PER LOCATION'[Date] = 'FM FORECAST'[DATE]
			                    && 'FM SALES PER LOCATION'[Brand] = 'FM FORECAST'[BRAND]
			            )
			        ),
			        0
			    ),
			    BLANK()
			)
		lineageTag: fdf6765c-f801-4c35-a4de-4c6ae27d8ce4
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column MonthlyRunRate_MTD = ```
			
			VAR CurrentDate = 'FM FORECAST'[DATE]
			VAR MTDStart = DATE(YEAR(CurrentDate), MONTH(CurrentDate), 1)
			
			-- Cumulative Actual Sales, grouped by brand and location
			VAR CumulativeActualSales = 
			    CALCULATE(
			        SUM('FM FORECAST'[Actual Sales]),
			        FILTER(
			            'FM FORECAST',
			            'FM FORECAST'[Date] <= CurrentDate &&
			            'FM FORECAST'[Date] >= MTDStart &&
			            NOT(ISBLANK('FM FORECAST'[D. Forecast %])) &&
			            'FM FORECAST'[Brand] = EARLIER('FM FORECAST'[BRAND])  -- Group by LocationID
			        )
			    )
			
			-- Cumulative Forecast %, grouped by brand and location
			VAR CumulativeForecast = 
			    CALCULATE(
			        SUM('FM FORECAST'[D. Forecast %]),
			        FILTER(
			            'FM FORECAST',
			            'FM FORECAST'[Date] <= CurrentDate &&
			            'FM FORECAST'[Date] >= MTDStart &&
			            'FM FORECAST'[Brand] = EARLIER('FM FORECAST'[BRAND])        )
			    )
			
			RETURN
			IF(
			    CumulativeForecast = 0 || ISBLANK(CumulativeForecast),
			    0,
			    DIVIDE(CumulativeActualSales, CumulativeForecast)
			)
			```
		lineageTag: 7acf042f-abfe-48fd-ae25-68faeef156ce
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Yesterday = ```
			'FM FORECAST'[DATE] - 1
			
			```
		formatString: General Date
		lineageTag: df8c06c4-9b3a-4b7d-ad66-ec1b41d0e85d
