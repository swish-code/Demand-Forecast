		annotation SummarizationSetBy = Automatic

	column 'Yesterday Monthly RunRate' = ```
			
			VAR CurrentBrand = 'FM FORECAST'[BRAND]
			VAR YesterdayRunRate = 
			    CALCULATE(
			        MAX('FM FORECAST'[MonthlyRunRate_MTD]),
			        FILTER(
			            'FM FORECAST',
			            'FM FORECAST'[Date] = TODAY() - 1 &&
			            'FM FORECAST'[Brand] = CurrentBrand        )
			    )
			RETURN
			YesterdayRunRate
			```
		lineageTag: 3b4663f2-7b9c-4c99-aaef-b1702e2b0b3e
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Day = DAY('FM FORECAST'[DATE].[Date])
		formatString: 0
		lineageTag: 9b53a47f-d53d-4a94-94fb-e97bc52b3d88
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column DateCategorys = ```
			
			IF (
			    'FM FORECAST'[DATE] < TODAY(),
			    "Actual",  -- Categorizes dates before today
			    "Forecast" -- Categorizes today and future dates
			)
			
			```
		lineageTag: de13334b-27f7-4f84-9cc1-e7efc9abe9eb
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column CurrentMonthRunrate =
			
			IF(
			    MONTH('FM FORECAST'[DATE]) = MONTH(TODAY()) &&
			    YEAR('FM FORECAST'[DATE]) = YEAR(TODAY()), -- Ensure it is the current month
			    IF(
			        DAY(TODAY()) > 1, -- Start calculation from the 2nd day of the month
			        IF(
			            'FM FORECAST'[Actual Sales] = 0,
			            'FM FORECAST'[D. Forecast %] * 'FM FORECAST'[Yesterday Monthly RunRate],
			            BLANK()
			        ),
			        BLANK() -- Exclude rows on the 1st day of the month
			    ),
			    BLANK() -- Exclude rows outside the current month
			)
		lineageTag: 32c62125-b11e-4121-9a15-f085fcc2d8dd
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Totalsale = ```
			
			IF(
			    NOT(ISBLANK('FM FORECAST'[Actual Sales])), 
			    'FM FORECAST'[Actual Sales], -- Use ActualSales if available
			    IF(
			        NOT(ISBLANK('FM FORECAST'[CurrentMonthRunrate])), 
			        'FM FORECAST'[CurrentMonthRunrate], -- Use CurrentMonthRunrate if ActualSales is not available
			        'FM FORECAST'[NextMonthRunrate] -- Use NextMonthRunrate as a fallback
			    )
			) 
			```
		lineageTag: b3e3c702-70e8-43fd-a5cb-d377442b5de3
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Year_Forecast = YEAR('FM FORECAST'[DATE].[Date])
		formatString: 0
		lineageTag: efc3705f-9811-4f11-b917-50c6739088c4
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column NextMonthRunrate =
			
			'FM FORECAST'[SeasonalEffectSales]*'FM FORECAST'[D. Forecast %]
		lineageTag: 45b9c70f-524c-4e45-8028-b44f525def94
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Month_Forecast = MONTH('FM FORECAST'[DATE].[Date])
		formatString: 0
		lineageTag: 74d5c267-1492-4cf6-94a7-081dfaf41295
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column SeasonalEffectSales = ```
			
			VAR CurrentYear = 'FM FORECAST'[Year_Forecast]  -- Get Year from FORECAST[Year_Forecast]
			VAR CurrentMonth = 'FM FORECAST'[Month_Forecast]  -- Get Month from FORECAST[Month_Forecast]
			VAR CurrentBrand = 'FM FORECAST'[Brand]  -- Capture the current Brand from FORECAST[Brand]
			
			
			RETURN
			LOOKUPVALUE(
			    'Seasonal Effect test'[SeasonalMonth],  -- The column to return
			    'Seasonal Effect test'[Brand], CurrentBrand,  -- Match Brand between tables
			    'Seasonal Effect test'[Year_SeasonalEffect], CurrentYear,  -- Match Year
			    'Seasonal Effect test'[Month_SeasonalEffect], CurrentMonth  -- Match Month
			)
			
			```
		lineageTag: e306e666-b1c7-442f-9728-d4e34e3edff7
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column MonthRunrate = ```
			
			    CALCULATE(
			        LASTNONBLANK('FM FORECAST'[YesterdayMonthly], 1) * LASTNONBLANK('FM FORECAST'[D. Forecast %], 1),
			        'FM FORECAST'[DATE] <= TODAY() - 1
			    ) 
			
			```
		lineageTag: 5a55930b-f3e5-4e50-bba5-63923b16dfff
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column YesterdayMonthly = ```
			
			VAR PreviousDa = 'FM FORECAST'[DATE] - 1
			VAR CurrentBrand = 'FM FORECAST'[BRAND]
			VAR YesterdayRunRate = 
			    CALCULATE(
			        MAX('FM FORECAST'[MonthlyRunRate_MTD]),
			        FILTER(
			            'FM FORECAST',
			            'FM FORECAST'[Date] = PreviousDa &&
			            'FM FORECAST'[Brand] = CurrentBrand         )
			    )
			RETURN
			IF(DAY('FM FORECAST'[DATE]) = 1, YesterdayRunRate * 'FM FORECAST'[SeasonalEffect], YesterdayRunRate)
			```
		lineageTag: d8634d22-8012-4909-b9c1-61adccdaf35c
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column SeasonalEffect =
			
			VAR CurrentYear = 'FM FORECAST'[Year_Forecast]
			VAR CurrentMonth = 'FM FORECAST'[Month_Forecast]
			VAR CurrentBrand = 'FM FORECAST'[BRAND]
			
			RETURN
			LOOKUPVALUE(
			    'Seasonal Effect test'[Seasonal Effect],
			    'Seasonal Effect test'[Brand], CurrentBrand,
			    'Seasonal Effect test'[Year_SeasonalEffect], CurrentYear,
			    'Seasonal Effect test'[Month_SeasonalEffect], CurrentMonth
			)
		lineageTag: d35b0147-2956-473c-a404-1ea8916c6efc
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

