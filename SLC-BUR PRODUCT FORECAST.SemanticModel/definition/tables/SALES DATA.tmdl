	partition 'SALES DATA' = m
		mode: import
		source =
				let
				    // ==============================
				    // 1️⃣ ORDERS VIEW (MAIN TABLE)
				    // ==============================
				    Source = Snowflake.Databases("UMWIJEO-IF31569.snowflakecomputing.com", "AIRBYTE_WAREHOUSE"),
				    // ==============================
				    // 1️⃣ ORDERS VIEW (MAIN TABLE)
				    // ==============================
				    AIRBYTE_FOODICS_Database = Source{[Name="AIRBYTE_FOODICS",Kind="Database"]}[Data],
				    // ==============================
				    // 1️⃣ ORDERS VIEW (MAIN TABLE)
				    // ==============================
				    AIRBYTE_FOODICS_Schema = AIRBYTE_FOODICS_Database{[Name="AIRBYTE_FOODICS",Kind="Schema"]}[Data],
				    // ==============================
				    // 1️⃣ ORDERS VIEW (MAIN TABLE)
				    // ==============================
				    ALL_ORDERS_FINAL_V2_Table = AIRBYTE_FOODICS_Schema{[Name="ALL_ORDERS_FINAL_V2",Kind="Table"]}[Data],
				    #"Filtered Rows" = Table.SelectRows(ALL_ORDERS_FINAL_V2_Table, each ([CHAINID] = "BUR" or [CHAINID] = "SLC"))
				in
				    #"Filtered Rows"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

