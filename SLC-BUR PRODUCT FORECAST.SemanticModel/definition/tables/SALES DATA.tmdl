table 'SALES DATA'
	lineageTag: 54cb4775-07e5-476e-b446-de61ccb16966

	column Net_ = 'SALES DATA'[TrxSales]-'SALES DATA'[COTDiscountAmount]
		lineageTag: 34507392-6eaa-47a2-a4df-9e3dfb02a676
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column OrderSource_ =
			
			VAR Addr8 = UPPER('SALES DATA'[CUSTADDRESS8])
			VAR Addr10 = UPPER('SALES DATA'[CUSTADDRESS8])
			VAR First1_8 = LEFT(Addr8, 1)
			VAR First2_8 = LEFT(Addr8, 2)
			VAR First1_10 = LEFT(Addr10, 1)
			VAR First2_10 = LEFT(Addr10, 2)
			VAR VDate = 'SALES DATA'[VoucherDate]
			VAR HasRef = NOT(ISBLANK('SALES DATA'[COTRefnumber]))
			
			RETURN
			IF(
			    VDate >= DATE(2026,3,9),
			
			    SWITCH(
			        TRUE(),
			
			        Addr8 = "" || Addr8 = "IN-STORE", "In-Store",
			
			        First1_8 = "K", "Keeta",
			        First2_8 = "CA", "Cari",
			        First2_8 = "CO", "Call Center",
			        First2_8 = "DE", "Deliveroo",
			        First2_8 = "DR", "Application",
			        First2_8 = "JA", "Jahez",
			        First2_8 = "OR", "Ordable",
			        First2_8 = "TA", "Talabat",
			        First2_8 = "SN", "Snoonu",
			        First1_8 IN {"W","Z"}, "Ordable",
			        First1_8 = "V", "V-Throu",
			
			        "In-Store"
			    ),
			
			    SWITCH(
			        TRUE(),
			
			        Addr10 = "" || Addr10 = "IN-STORE", "In-Store",
			
			        First1_10 = "K" && HasRef, "Keeta",
			        First2_10 = "CA" && HasRef, "Cari",
			        First2_10 = "CO" && HasRef, "Call Center",
			        First2_10 = "DE" && HasRef, "Deliveroo",
			        First2_10 = "DR" && HasRef, "Application",
			        First2_10 = "JA" && HasRef, "Jahez",
			        First2_10 = "OR" && HasRef, "Ordable",
			        First2_10 = "TA" && HasRef, "Talabat",
			        First2_10 = "SN" && HasRef, "Snoonu",
			        First1_10 IN {"W","Z"} && HasRef, "Ordable",
			        First1_10 = "V" && HasRef, "V-Throu",
			
			        "In-Store"
			    )
			)
		lineageTag: 7d3b6937-2d56-4dad-a1dc-0bf02fe66149
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

