	column CUMULATIVE_MONTH_TARGET =
			
			VAR CurrentDate = TODAY()
			VAR MonthStart = DATE(YEAR(CurrentDate), MONTH(CurrentDate), 1)
			VAR MonthEnd = EOMONTH(CurrentDate, 0)
			VAR ThisBrand = 'FORECAST'[Brand]
			RETURN
			IF(
			'FORECAST'[Date] >= MonthStart &&
			'FORECAST'[Date] <= MonthEnd &&
			ISBLANK('FORECAST'[Actual Sales]),
			CALCULATE(
			SUM('FORECAST'[D. Forecast %]),
			FILTER(
			'FORECAST',
			'FORECAST'[Date] >= MonthStart &&
			'FORECAST'[Date] <= MonthEnd &&
			ISBLANK('FORECAST'[Actual Sales]) &&
			'FORECAST'[Brand] = ThisBrand
			)
			)
			)
		lineageTag: 63a02f73-6277-440f-9263-e1e4f55079de
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Remaining_RRR_For_CurrentMonth =
			
			VAR CurrentDate = TODAY()
			VAR MonthStart = DATE(YEAR(CurrentDate), MONTH(CurrentDate), 1)
			VAR MonthEnd = EOMONTH(CurrentDate, 0)
			VAR ThisBrand = 'FORECAST'[Brand]
			
			VAR ActualSalesThisMonth =
			CALCULATE(
			SUM('FORECAST'[Actual Sales]),
			FILTER(
			'FORECAST',
			'FORECAST'[Date] >= MonthStart &&
			'FORECAST'[Date] <= MonthEnd &&
			'FORECAST'[Brand] = ThisBrand
			)
			)
			
			RETURN
			IF(
			'FORECAST'[Date] >= MonthStart &&
			'FORECAST'[Date] <= MonthEnd,
			'FORECAST'[AdjustedTarget] - ActualSalesThisMonth,
			BLANK()
			)
		lineageTag: a65a9146-df1a-4337-84ac-3b3e8b1ebffa
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Required_Run_Rate =
			
			VAR CurrentDate = TODAY()
			VAR MonthStart = DATE(YEAR(CurrentDate), MONTH(CurrentDate), 1)
			VAR MonthEnd = EOMONTH(CurrentDate, 0)
			VAR NextMonthStart = EOMONTH(CurrentDate, 0) + 1
			VAR NextMonthEnd = EOMONTH(CurrentDate, 1)
			RETURN
			IF(
			'FORECAST'[Date] >= MonthStart &&
			'FORECAST'[Date] <= MonthEnd &&
			ISBLANK('FORECAST'[Actual Sales]),
			DIVIDE(
			'FORECAST'[D. Forecast %] * 'FORECAST'[Remaining_RRR_For_CurrentMonth],
			'FORECAST'[CUMULATIVE_MONTH_TARGET]
			),
			IF(
			'FORECAST'[Date] >= NextMonthStart &&
			'FORECAST'[Date] <= NextMonthEnd,
			'FORECAST'[AdjustedRRR] * 'FORECAST'[D. Forecast %]
			)
			)
		lineageTag: e4dcc3d9-4ed0-4e52-a5f8-597b9d9686b7
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column RRR_FUTURE =
			
			VAR CurrentDate = TODAY()
			VAR MonthStart = DATE(YEAR(CurrentDate), MONTH(CurrentDate), 1)
			VAR MonthEnd = EOMONTH(CurrentDate, 0)
			RETURN
			IF(
			'FORECAST'[Date] < MonthStart || 'FORECAST'[Date] > MonthEnd,
			'FORECAST'[AdjustedRRR] * 'FORECAST'[D. Forecast %],
			BLANK()
			)
		formatString: #,0
		lineageTag: 0bde3985-a948-427a-8b07-a24b67bdbdb2
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isDecimal":true}

