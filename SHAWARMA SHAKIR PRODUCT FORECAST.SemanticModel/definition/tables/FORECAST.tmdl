	column CurrentMonthRunrate =
			
			IF(
			    MONTH(FORECAST[Date]) = MONTH(TODAY()) &&
			    YEAR(FORECAST[Date]) = YEAR(TODAY()), -- Ensure it is the current month
			    IF(
			        DAY(TODAY()) > 1, -- Start calculation from the 2nd day of the month
			        IF(
			            FORECAST[Actual Sales] = 0,
			            FORECAST[D. Forecast %] * FORECAST[Yesterday Monthly RunRate],
			            BLANK()
			        ),
			        BLANK() -- Exclude rows on the 1st day of the month
			    ),
			    BLANK() -- Exclude rows outside the current month
			)
		lineageTag: e11f6528-9ff4-4230-b2a8-b60b4299d4c0
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Totalsale = ```
			
			IF(
			    NOT(ISBLANK(FORECAST[Actual Sales])), 
			    FORECAST[Actual Sales], -- Use ActualSales if available
			    IF(
			        NOT(ISBLANK(FORECAST[CurrentMonthRunrate])), 
			        FORECAST[CurrentMonthRunrate], -- Use CurrentMonthRunrate if ActualSales is not available
			        FORECAST[NextMonthRunrate] -- Use NextMonthRunrate as a fallback
			    )
			) 
			```
		formatString: #,0
		lineageTag: c25e1b47-c282-4201-a117-30aab18b9ad2
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isDecimal":true}

