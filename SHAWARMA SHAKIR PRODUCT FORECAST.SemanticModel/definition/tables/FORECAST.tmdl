	column CumulativeSeasonalEffect_Forecast = ```
			
			COALESCE(
			    LOOKUPVALUE(
			        'Seasonal Effect test'[Seasonal Effect], 
			        'Seasonal Effect Test'[Date], 
			        'FORECAST'[Date],
			        'Seasonal Effect Test'[Brand], 
			        'FORECAST'[Brand]  -- Match with Brand as well
