	column RRR-REMAINING = ```
			
			IF (
			    NOT ISBLANK('FORECAST'[AdjustedRRR]),
			    'FORECAST'[AdjustedRRR] - 'FORECAST'[CumulativeActualSales_PrevDay]
			)
			
			```
		lineageTag: 429498fe-6757-4bd7-b490-24fb9d76b7c7
		summarizeBy: sum

