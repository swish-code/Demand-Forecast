	column 'Actual Sales' = ```
			
			IF(
			    'FORECAST'[Date] < TODAY(),
			    COALESCE(
			        LOOKUPVALUE(
			            'HEADER'[NetSales],
			            'HEADER'[VoucherDate],    'FORECAST'[Date],
			            'HEADER'[Brand],          'FORECAST'[Brand],
			            'HEADER'[LOCATIONID],     'FORECAST'[LOCATIONID]  -- Fixed: added missing quote & comma
			        ), 
			        0
			    ),
			    BLANK()
			)
			```
		formatString: 0
		lineageTag: 8284b172-1995-4e61-b072-db3ab5aa2394
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column MonthlyRunRate_MTD = ```
			
			VAR CurrentDate = 'FORECAST'[Date]
			VAR MTDStart = DATE(YEAR(CurrentDate), MONTH(CurrentDate), 1)
			
			-- Cumulative Actual Sales, grouped by brand and location
			VAR CumulativeActualSales = 
			    CALCULATE(
			        SUM('FORECAST'[Actual Sales]),
			        FILTER(
			            'FORECAST',
			            'FORECAST'[Date] <= CurrentDate &&
			            'FORECAST'[Date] >= MTDStart &&
			            'FORECAST'[Effect] <> "Yes" &&
			            NOT(ISBLANK('FORECAST'[D. Forecast %])) &&
			            'FORECAST'[Brand] = EARLIER('FORECAST'[Brand]) &&
			            'FORECAST'[LocationID] = EARLIER('FORECAST'[LocationID])  -- Group by LocationID
			        )
			    )
			
			-- Cumulative Forecast %, grouped by brand and location
			VAR CumulativeForecast = 
			    CALCULATE(
			        SUM('FORECAST'[D. Forecast %]),
			        FILTER(
			            'FORECAST',
			            'FORECAST'[Date] <= CurrentDate &&
			            'FORECAST'[Date] >= MTDStart &&
			            'FORECAST'[Effect] <> "Yes" &&
			            'FORECAST'[Brand] = EARLIER('FORECAST'[Brand]) &&
			            'FORECAST'[LocationID] = EARLIER('FORECAST'[LocationID])  -- Group by LocationID
			        )
			    )
			
			RETURN
			IF(
			    CumulativeForecast = 0 || ISBLANK(CumulativeForecast),
			    0,
			    DIVIDE(CumulativeActualSales, CumulativeForecast)
			)
			```
		lineageTag: dd4f417c-9225-4bc0-8cf4-35b93893add8
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

