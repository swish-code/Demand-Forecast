	column YesterdayMonthly = ```
			
			VAR PreviousDa = 'FORECAST'[Date] - 1
			VAR CurrentBrand = 'FORECAST'[Brand]
			VAR CurrentLocationID = 'FORECAST'[LocationID]  -- Capture current row's LocationID
			VAR YesterdayRunRate = 
			    CALCULATE(
			        MAX('FORECAST'[MonthlyRunRate_MTD]),
			        FILTER(
			            'FORECAST',
			            'FORECAST'[Date] = PreviousDa &&
			            'FORECAST'[Brand] = CurrentBrand &&
			            'FORECAST'[LocationID] = CurrentLocationID  -- Match by LocationID
			        )
			    )
			RETURN
			IF(DAY('FORECAST'[Date]) = 1, YesterdayRunRate * 'FORECAST'[SeasonalEffect], YesterdayRunRate)
			```
		lineageTag: cceadcad-8c1f-4bb9-ab65-aeff4a79e189
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column MonthRunrate = ```
			
			    CALCULATE(
			        LASTNONBLANK(FORECAST[YesterdayMonthly], 1) * LASTNONBLANK(FORECAST[D. Forecast %], 1),
			        FORECAST[Date] <= TODAY() - 1
			    ) 
			
			```
		formatString: #,0
		lineageTag: ad6ab7ae-8b3b-4d5e-a1b0-6b51667efa91
