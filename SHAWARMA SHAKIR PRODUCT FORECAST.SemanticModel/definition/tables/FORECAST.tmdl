	measure FORECAST_YTD = ```
			
			VAR MinDateYear = YEAR(CALCULATE(MIN('FORECAST'[Date])))  -- Get the year of the minimum date
			RETURN
			CALCULATE(
			    SUM('FORECAST'[D.TARGET]),  -- Sum the forecast values
			    FILTER(
			        ALL('FORECAST'[Date]),  -- Remove any date filter
			        YEAR('FORECAST'[Date]) = MinDateYear  -- Include all rows for the year of the minimum date
			    )
			)
			
