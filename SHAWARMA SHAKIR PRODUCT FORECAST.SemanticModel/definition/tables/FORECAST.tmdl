	column LAST1DAYSRR =
			
			IF(
			    NOT ISBLANK('FORECAST'[Actual Sales]),
			    'FORECAST'[MonthlyRunRate_Yesterday_From2nd] * 'FORECAST'[D. Forecast %],
			    BLANK()
			)
		lineageTag: 841ae3fe-6b7e-4d24-8808-eb3516189ed9
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column MonthlyRunRate_Yesterday_From2nd = ```
			
			VAR CurrentDate = 'FORECAST'[Date]
			VAR CurrentBrand = 'FORECAST'[Brand]
			VAR StartOfMont = DATE(YEAR(CurrentDate), MONTH(CurrentDate), 1)
			VAR SecondOfMonth = StartOfMont + 1
			VAR EndOfMont = EOMONTH(CurrentDate, 0)
			VAR Yesterday = CurrentDate - 1
			
			VAR YesterdayActualSales =
			    CALCULATE(
			        SUM('FORECAST'[Actual Sales]),
			        FILTER(
			            'FORECAST',
			            'FORECAST'[Date] = Yesterday &&
			            'FORECAST'[Brand] = CurrentBrand &&
			            'FORECAST'[Effect] <> "Yes"
			        )
			    )
			
			VAR YesterdayForecast =
			    CALCULATE(
			        SUM('FORECAST'[D. Forecast %]),
			        FILTER(
			            'FORECAST',
			            'FORECAST'[Date] = Yesterday &&
			            'FORECAST'[Brand] = CurrentBrand &&
			            'FORECAST'[Effect] <> "Yes"
			        )
			    )
			
			RETURN
			IF(
			    CurrentDate >= SecondOfMonth && CurrentDate <= EndOfMont,
			    IF(
			        ISBLANK(YesterdayForecast) || YesterdayForecast = 0,
			        0,
			        DIVIDE(YesterdayActualSales, YesterdayForecast)
			    ),
			    BLANK()
			)
			
			```
		lineageTag: ea9c663d-fed2-41ce-8096-0a04a2816075
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Yesterday Monthly Run Rate 1 DAYS RRR' = ```
			
			VAR CurrentBrand = FORECAST[Brand]
			VAR YesterdayRunRate = 
			    CALCULATE(
			        MAX(FORECAST[MonthlyRunRate_Yesterday_From2nd]),
			        FILTER(
			            FORECAST,
			            FORECAST[Date] = TODAY() &&
			            FORECAST[Brand] = CurrentBrand
			        )
			    )
			RETURN
			YesterdayRunRate
			
			```
		lineageTag: 608f95c6-1ff3-43a8-8df3-0ba44d8a0a11
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column CurrentMonthRunrateRR1 = ```
			
			IF(
			    MONTH(FORECAST[Date]) = MONTH(TODAY()) &&
			    YEAR(FORECAST[Date]) = YEAR(TODAY()),  -- Ensure it's the current month
			    IF(
			        DAY(FORECAST[Date]) >= 2,  -- Start showing from the 8th
			        IF(
			            FORECAST[Actual Sales] = 0,
			            FORECAST[D. Forecast %] * FORECAST[Yesterday Monthly Run Rate 1 DAYS RRR],
			            BLANK()
			        ),
			        BLANK()  -- Exclude rows before 8th
			    ),
			    BLANK()  -- Exclude rows outside the current month
			)
			
			```
