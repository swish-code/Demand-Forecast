	column 'Required Run Rate TEST' = ```
			
			VAR CurrentRowDate = 'FORECAST'[Date]
			VAR CurrentMonth = MONTH(CurrentRowDate)
			VAR CurrentYear = YEAR(CurrentRowDate)
			VAR CurrentDay = DAY(CurrentRowDate)
			VAR ThisBrand = 'FORECAST'[Brand]
			
			-- Did RRR become > 0 on or before 15th of the same month for this brand?
			VAR HasRRRBefore15 =
			    CALCULATE(
			        COUNTROWS('FORECAST'),
			        FILTER(
			            ALL('FORECAST'),
			            'FORECAST'[AdjustedRRR] > 0 &&
			            'FORECAST'[Brand] = ThisBrand &&
			            MONTH('FORECAST'[Date]) = CurrentMonth &&
			            YEAR('FORECAST'[Date]) = CurrentYear &&
			            DAY('FORECAST'[Date]) <= 15
			        )
			    ) > 0
			
			-- Find first date from 15th onwards where accuracy crosses thresholds
			VAR CutoffDate =
			    CALCULATE(
			        MIN('FORECAST'[Date]),
			        FILTER(
			            ALL('FORECAST'),
			            'FORECAST'[Brand] = ThisBrand &&
			            MONTH('FORECAST'[Date]) = CurrentMonth &&
			            YEAR('FORECAST'[Date]) = CurrentYear &&
			            DAY('FORECAST'[Date]) >= 15 &&
			            (
			                (DAY('FORECAST'[Date]) >= 15 && DAY('FORECAST'[Date]) <= 17 && 'FORECAST'[Accuracy] > 0.60) ||
			                (DAY('FORECAST'[Date]) > 17 && DAY('FORECAST'[Date]) <= 20 && 'FORECAST'[Accuracy] > 0.50) ||
			                (DAY('FORECAST'[Date]) > 20 && DAY('FORECAST'[Date]) <= 23 && 'FORECAST'[Accuracy] > 0.40) ||
			                (DAY('FORECAST'[Date]) > 23 && DAY('FORECAST'[Date]) <= 25 && 'FORECAST'[Accuracy] > 0.30) ||
			                (DAY('FORECAST'[Date]) > 25 && 'FORECAST'[Accuracy] > 0.20)
			            )
			        )
			    )
			
			-- Core calculation
			VAR BaseValue =
			    IF(
			        'FORECAST'[AdjustedRRR] > 0 &&
			        (ISBLANK(CutoffDate) || CurrentRowDate < CutoffDate) &&
			        (CurrentDay <= 15 || HasRRRBefore15),
			        'FORECAST'[Required_Run_Rate] + 'FORECAST'[RR_TEST]
			    )
			
			-- Final return: if BaseValue is blank, use RRR_FUTURE
			RETURN
			COALESCE(BaseValue, 'FORECAST'[RRR_FUTURE])
			
			```
		dataType: int64
		formatString: #,0
		lineageTag: e3103ffe-a637-4b2f-802d-e9b7e12386d8
		summarizeBy: sum

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

	column SeasonalEffectSales2 = ```
			
			VAR CurrentYear = FORECAST[Year_Forecast]  -- Get Year from FORECAST[Year_Forecast]
			VAR CurrentMonth = FORECAST[Month_Forecast]  -- Get Month from FORECAST[Month_Forecast]
			VAR CurrentBrand = FORECAST[Brand]  -- Capture the current Brand from FORECAST[Brand]
			
			RETURN
			LOOKUPVALUE(
			    'Seasonal Effect test'[SeasonalMonth2],  -- The column to return
			    'Seasonal Effect test'[Brand], CurrentBrand,  -- Match Brand between tables
			    'Seasonal Effect test'[Year_SeasonalEffect], CurrentYear,  -- Match Year
			    'Seasonal Effect test'[Month_SeasonalEffect], CurrentMonth  -- Match Month
			)
			
			```
