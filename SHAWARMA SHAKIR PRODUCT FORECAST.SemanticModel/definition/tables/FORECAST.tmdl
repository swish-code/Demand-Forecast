	column Previous_CumulativeForecast_MTD = ```
			
			VAR CurrentDate = 'FORECAST'[Date]
			VAR MonthStart = DATE(YEAR(CurrentDate), MONTH(CurrentDate), 1)
			VAR IsFirstDayOfMonth = CurrentDate = MonthStart
			VAR Brand = 'FORECAST'[Brand]  -- Adjust if you have a different column name for Brand
			VAR PreviousDate = CurrentDate - 1
			RETURN
			IF(
			    IsFirstDayOfMonth,
			    'FORECAST'[D. Forecast %],
			    CALCULATE(
			        SUM('FORECAST'[D. Forecast %]),
			        FILTER(
			            'FORECAST',
			            'FORECAST'[Date] >= MonthStart &&
			            'FORECAST'[Date] < CurrentDate &&
			            'FORECAST'[Effect] <> "Yes" &&
			            'FORECAST'[Brand] = Brand  -- Ensures the calculation is done per brand
			        )
			    )
			)
			
			```
