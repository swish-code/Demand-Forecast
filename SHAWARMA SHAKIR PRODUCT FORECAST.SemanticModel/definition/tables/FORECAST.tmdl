			    ISBLANK('FORECAST'[Actual Sales]),
			    'FORECAST'[CurrentMonthRunrateRR1],
			    'FORECAST'[Actual Sales]
			)
			
			```
		lineageTag: cc8cbebb-ec3b-4b64-bb03-6ce5fd7626c1
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column MonthlyRunRate_Last7Days = ```
			
			VAR CurrentDate = 'FORECAST'[Date]
			VAR CurrentBrand = 'FORECAST'[Brand]
			VAR DayOfMonth = DAY(CurrentDate)
			
			RETURN
			IF(
			    DayOfMonth < 8,
			    BLANK(),  -- Show blank for 1st to 7th of the month
			    VAR StartDate = CurrentDate - 7
			    VAR EndDate = CurrentDate - 1
			
			    VAR CumulativeActualSales =
			        CALCULATE(
			            SUM('FORECAST'[Actual Sales]),
			            FILTER(
			                'FORECAST',
			                'FORECAST'[Date] >= StartDate &&
			                'FORECAST'[Date] <= EndDate &&
			                'FORECAST'[Brand] = CurrentBrand &&
			                'FORECAST'[Effect] <> "Yes"
			            )
			        )
			
			    VAR CumulativeForecast =
			        CALCULATE(
			            SUM('FORECAST'[D. Forecast %]),
			            FILTER(
			                'FORECAST',
			                'FORECAST'[Date] >= StartDate &&
			                'FORECAST'[Date] <= EndDate &&
			                'FORECAST'[Brand] = CurrentBrand &&
			                'FORECAST'[Effect] <> "Yes"
			            )
			        )
			
			    RETURN
			        IF(
			            CumulativeForecast = 0 || ISBLANK(CumulativeForecast),
			            0,
			            DIVIDE(CumulativeActualSales, CumulativeForecast)
			        )
			)
			
			```
		lineageTag: ade716c9-b21e-403b-a547-f4b808bec97d
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column LAST7DAYSRR = ```
			
