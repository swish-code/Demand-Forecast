	column ACCURACY = ```
			
			IF(
			    NOT ISBLANK('FORECAST'[Actual Sales]),
			    DIVIDE(
			        'FORECAST'[Actual Sales] - 'FORECAST'[Required Run Rate Live],
			        'FORECAST'[Required Run Rate Live]
			    )
			)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 2986d636-2beb-422a-994d-e1f5f21a3aec
