	column CurrentMonthRunrateRR7 = ```
			
			VAR CurrentDate = 'FORECAST'[Date]
			VAR CurrentBrand = 'FORECAST'[Brand]
			VAR YesterdayRunRate =
			    CALCULATE(
			        MAX('FORECAST'[Yesterday Monthly Run Rate 7 DAYS RRR]),
