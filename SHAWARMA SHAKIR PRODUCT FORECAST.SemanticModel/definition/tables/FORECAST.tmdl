	measure 'MoM Growth %' = ```
			
			VAR CurrentMonthValue = SUM('SALES DATA'[Net])
			VAR PreviousMonthValue = 
			    CALCULATE(
			        SUM('SALES DATA'[Net]),
			        PREVIOUSMONTH('SALES DATA'[VoucherDate])
			    )
			RETURN 
			    IF(
			        NOT ISBLANK(PreviousMonthValue),
			        (CurrentMonthValue - PreviousMonthValue) / PreviousMonthValue,
			        BLANK()
			    )
			
			```
		lineageTag: 34447172-b9aa-42c3-b119-76fdf8c79149

		annotation PBI_FormatHint = {"isGeneralNumber":true}

