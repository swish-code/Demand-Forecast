	column Target% = ```
			
			VAR CurrentDate = 'FORECAST'[Date]
			VAR MonthStart = DATE(YEAR(CurrentDate), MONTH(CurrentDate), 1)
			RETURN
			IF(
			    CurrentDate = MonthStart, 
			    1,  -- Show 100% (1) on the first day of the month
			    1 - 'FORECAST'[Previous_CumulativeForecast_MTD]  -- For other days, subtract the cumulative forecast
			)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: fc494867-0508-41d3-9b85-16bf927f86c9
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column RR_TEST = ```
			
			IF (
			    NOT ISBLANK('FORECAST'[Actual Sales]) && NOT ISBLANK('FORECAST'[AdjustedRRR]),
			    ('FORECAST'[D. Forecast %] / 'FORECAST'[Target%]) * 'FORECAST'[RRR-REMAINING]
			)
			
			```
		lineageTag: cb62e6c0-104e-4dfe-b9c3-69e6ebf7cdd7
