	column CumulativeActualSales_PrevDay =
			
			VAR CurrentDate = 'FORECAST'[Date]
			VAR MonthStart = DATE(YEAR(CurrentDate), MONTH(CurrentDate), 1)
			RETURN
			IF(
			CurrentDate = MonthStart,
			0,
			CALCULATE(
			SUM('FORECAST'[Actual Sales]),
			FILTER(
			ALLEXCEPT('FORECAST', 'FORECAST'[Brand]), -- keep brand context
			'FORECAST'[Date] >= MonthStart &&
			'FORECAST'[Date] < CurrentDate &&
			'FORECAST'[Effect] <> "Yes"
			)
			)
			)
		lineageTag: b35c7929-3d23-4aa0-8b52-73150c5776fe
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

