	column 'Incidence Rate Final' =
			
			
			VAR _item  = Forecast_Product_Table[Clean_ItemID]
			VAR _loc   = Forecast_Product_Table[LocationID]
			VAR _chain = Forecast_Product_Table[CHAINID]
			VAR _date  = Forecast_Product_Table[Date]
			
			-- Check if item is active NOW (last 3 days from today)
			VAR _isActiveNow =
			    COUNTROWS(
			        FILTER(
			            Incidence_Table,
			            Incidence_Table[CleanNewItemID]       = _item  &&
			            Incidence_Table[CleanLocationID]       = _loc   &&
			            Incidence_Table[CHAINID]               = _chain &&
			            Incidence_Table[VOUCHERDATE]           >= TODAY() - 3 &&
			            Incidence_Table[Numerator (Total Qty)] > 0
			        )
			    ) > 0
			
			-- Check if item was active at the time of this past date
			-- (had sales within 3 days of that date)
			VAR _wasActiveAtDate =
			    COUNTROWS(
			        FILTER(
			            Incidence_Table,
			            Incidence_Table[CleanNewItemID]       = _item  &&
			            Incidence_Table[CleanLocationID]       = _loc   &&
			            Incidence_Table[CHAINID]               = _chain &&
			            Incidence_Table[VOUCHERDATE]           >= _date - 3 &&
			            Incidence_Table[VOUCHERDATE]           <= _date &&
			            Incidence_Table[Numerator (Total Qty)] > 0
			        )
			    ) > 0
			
			-- Past dates: actual rate from Incidence_Table
			VAR _actualRate =
			    MAXX(
			        FILTER(
			            Incidence_Table,
			            TRIM(LOWER(Incidence_Table[CleanNewItemID])) = TRIM(LOWER(_item)) &&
			            Incidence_Table[CleanLocationID]              = _loc               &&
			            Incidence_Table[CHAINID]                      = _chain             &&
			            Incidence_Table[VOUCHERDATE]                  = _date
			        ),
			        Incidence_Table[Incidence Rate % Final]
			    )
			
			-- Future dates: forecasted rate from Forecast_Spine
			VAR _forecastRate =
			    LOOKUPVALUE(
			        Forecast_Spine[Forecasted_Incidence_Rate],
			        Forecast_Spine[CleanNewItemID],  _item,
			        Forecast_Spine[CleanLocationID], _loc,
			        Forecast_Spine[CHAINID],         _chain,
			        Forecast_Spine[Date],            _date
			    )
			
			RETURN
			IF(
			    _date >= TODAY(),
			    IF(_isActiveNow, _forecastRate, BLANK()),       -- future: active now only
			    IF(_wasActiveAtDate, _actualRate, BLANK())       -- past: active at that time only
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 097e7e6e-c74c-4074-83ca-233cc78de80b
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column IsTomorrow =
			
			IF(
			    YEAR(Forecast_Product_Table[Date]) = YEAR(TODAY() + 1) &&
			    MONTH(Forecast_Product_Table[Date]) = MONTH(TODAY() + 1) &&
			    DAY(Forecast_Product_Table[Date]) = DAY(TODAY() + 1),
			    1, 0
			)
		formatString: 0
		lineageTag: 7eaa88ee-0f4e-4eaf-b24b-602bea1cefe2
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	partition Forecast_Product_Table = calculated
		mode: import
		source =
				
				
				VAR _today = TODAY()
				VAR _forecastEnd = DATE(2026, 12, 31)
				
				-- ==========================================
				-- ALL historical Item + Location + Chain combinations
				-- Product Name is added later to avoid duplicates
				-- ==========================================
				VAR _allCombos =
				    ADDCOLUMNS(
				        SUMMARIZE(
				            Incidence_Table,
				            Incidence_Table[CleanNewItemID],
				            Incidence_Table[CleanLocationID],
				            Incidence_Table[CHAINID]
				        ),
				        "ProductName_Fixed_Option",
				            CALCULATE(
				                MAX(Incidence_Table[ProductName_Fixed_Option])
				            )
				    )
				
				-- ==========================================
				-- ACTIVE Item + Location + Chain combinations
				-- Only items sold in the last 3 days
				-- ==========================================
				VAR _activeCombos =
				    ADDCOLUMNS(
				        SUMMARIZE(
				            FILTER(
				                Incidence_Table,
				                Incidence_Table[VOUCHERDATE] >= _today - 3 &&
				                Incidence_Table[Numerator (Total Qty)] > 0
				            ),
				            Incidence_Table[CleanNewItemID],
				            Incidence_Table[CleanLocationID],
				            Incidence_Table[CHAINID]
				        ),
				        "ProductName_Fixed_Option",
				            CALCULATE(
				                MAX(Incidence_Table[ProductName_Fixed_Option])
				            )
				    )
				
				-- ==========================================
				-- Historical Dates
				-- ==========================================
				VAR _pastDates =
				    SELECTCOLUMNS(
				        CALENDAR(
				            DATE(2025, 11, 1),
				            _today - 1
				        ),
				        "Date", [Date]
				    )
				
				-- ==========================================
				-- Future Dates
				-- ==========================================
				VAR _futureDates =
				    SELECTCOLUMNS(
				        CALENDAR(
				            _today,
				            _forecastEnd
				        ),
				        "Date", [Date]
				    )
				
				-- ==========================================
				-- Historical Rows
				-- ==========================================
				VAR _pastRows =
				    GENERATE(
				        SELECTCOLUMNS(
				            _allCombos,
				            "Clean_ItemID", [CleanNewItemID],
				            "LocationID", [CleanLocationID],
				            "CHAINID", [CHAINID],
				            "ProductName_Fixed_Option", [ProductName_Fixed_Option]
				        ),
				        _pastDates
				    )
				
				-- ==========================================
				-- Future Rows
				-- ==========================================
				VAR _futureRows =
				    GENERATE(
				        SELECTCOLUMNS(
				            _activeCombos,
				            "Clean_ItemID", [CleanNewItemID],
				            "LocationID", [CleanLocationID],
				            "CHAINID", [CHAINID],
				            "ProductName_Fixed_Option", [ProductName_Fixed_Option]
				        ),
				        _futureDates
				    )
				
				RETURN
				UNION(
				    _pastRows,
				    _futureRows
				)

	annotation PBI_Id = 6b1a08f87fef4053bad2c4493f69fe0e

