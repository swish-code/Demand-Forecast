table Forecast_Product_Table
	lineageTag: 9af598eb-f872-4983-9513-6a72c814ae69

	measure INC_History_Days =
			
			VAR _item        = MAX(Forecast_Product_Table[Clean_ItemID])
			VAR _loc         = MAX(Forecast_Product_Table[LocationID])
			VAR _prod        = MAX(Forecast_Product_Table[ProductName_Fixed_Option])
			VAR _currentDate = MAX(Forecast_Product_Table[Date])
			
			VAR _base =
			    FILTER(
			        Incidence_Table,
			        Incidence_Table[Clean_ItemID]              = _item  &&
			        Incidence_Table[LocationID]                = _loc   &&
			        Incidence_Table[ProductName_Fixed_Option]  = _prod  &&
			        Incidence_Table[VOUCHERDATE]               < _currentDate &&
			        Incidence_Table[VOUCHERDATE]               >= _currentDate - 28 &&
			        NOT ISBLANK(Incidence_Table[Actual Incidence Rate %])
			    )
			
			RETURN COUNTROWS(_base)
		formatString: 0
		lineageTag: a329029b-8fe8-4f64-bd44-4c1a7003a6d8

	measure 'Real Combo Count' =
			
			COUNTROWS(
			    SUMMARIZE(
			        Forecast_Product_Table,
			        Forecast_Product_Table[Clean_ItemID],
			        Forecast_Product_Table[LocationID],
			        Forecast_Product_Table[CHAINID],
			        Forecast_Product_Table[ProductName_Fixed_Option]
			    )
			)
		formatString: 0
		lineageTag: a271e752-e0b1-41a5-9f63-c351e072a3f4

	measure Debug =
			
			VAR _item  = SELECTEDVALUE(Forecast_Spine[Clean_ItemID])
			VAR _loc   = SELECTEDVALUE(Forecast_Spine[CleanLocationID])
			VAR _chain = SELECTEDVALUE(Forecast_Spine[CHAINID])
			VAR _date  = SELECTEDVALUE(Forecast_Spine[Date])
			
			VAR _lastActualDate =
			    CALCULATE(
			        MAX(Incidence_Table[VOUCHERDATE]),
			        Incidence_Table[Clean_ItemID]    = _item,
			        Incidence_Table[CleanLocationID] = _loc,
			        Incidence_Table[CHAINID]         = _chain
			    )
			
			VAR _anchorDate =
			    IF(_date > _lastActualDate, _lastActualDate, _date)
			
			VAR _start28 = _anchorDate - 28
			
			VAR _base =
			    FILTER(
			        Incidence_Table,
			        Incidence_Table[Clean_ItemID]     = _item  &&
			        Incidence_Table[CleanLocationID]  = _loc   &&
			        Incidence_Table[CHAINID]          = _chain &&
			        Incidence_Table[VOUCHERDATE]      > _start28 &&
			        Incidence_Table[VOUCHERDATE]      <= _anchorDate
			    )
			
			VAR _daily =
			    ADDCOLUMNS(
			        SUMMARIZE(_base, Incidence_Table[VOUCHERDATE]),
			        "Qty",    CALCULATE(SUM(Incidence_Table[Numerator (Total Qty)])),
			        "Orders", CALCULATE(SUM(Incidence_Table[Denominator (Total Orders)])),
			        "Age",    DATEDIFF(Incidence_Table[VOUCHERDATE], _anchorDate, DAY)
			    )
			
			RETURN
			    SUMX(_daily, [Qty]) & " / " & SUMX(_daily, [Orders])
		lineageTag: 7b748d6d-c930-4b61-8191-6b773d654d4e

	column Date
		formatString: Long Date
		lineageTag: 562f3722-8e4b-4acf-a15b-ef80574dcce6
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		annotation SummarizationSetBy = Automatic

	column Total_Sales =
			
			VAR _chain = [CHAINID]
			VAR _loc = [LOCATIONID]
			VAR _date = [Date]
			VAR _today = TODAY()
			RETURN
			IF(
			    _date < _today,
			    -- Past dates: use Month runrate
			    CALCULATE(
			        SUM('FORECAST (2)'[MonthRunrate]),
			        'FORECAST (2)'[BRAND] = _chain,
			        'FORECAST (2)'[BRANCH] = _loc,
			        'FORECAST (2)'[DATE] = _date
			    ),
			    -- Today and future dates: use Total sale
			    CALCULATE(
			        MAX('FORECAST (2)'[Totalsale]),
			        'FORECAST (2)'[BRAND] = _chain,
			        'FORECAST (2)'[BRANCH] = _loc,
			        'FORECAST (2)'[DATE] = _date
			    )
			)
		lineageTag: e3f16696-40d1-4433-8c6d-c21a81383788
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Actual_Qty =
			
			VAR _chain = [CHAINID]
			VAR _loc   = [LOCATIONID]
			VAR _date  = [Date]
			VAR _item  = [Clean_ItemID]
			
			RETURN
			IF(
			    _date < TODAY(),
			
			    -- ACTUALS
			    CALCULATE(
			        SUM(Shakir[Qty]),
			        Shakir[CHAINID] = _chain,
			        Shakir[CleanLocationID] = _loc,
			        Shakir[CleanNewItemID] = _item,
			        Shakir[VOUCHERDATE] = _date
			    )
			)
		formatString: 0
		lineageTag: 749ed83c-f8ac-40bd-9033-4e0fe09035b8
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Forecast_Orders =
			
			DIVIDE([Total_Sales], [AOV], 0)
		lineageTag: 9d72bf5f-8a6b-4340-8855-217d707c10a4
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column VARIANCE = ```
			[Actual_Qty] - [Forecast_Qty_7(last 28+2)]
			
			```
		lineageTag: 6b2150bb-be95-4881-a6bd-8085da118227
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column AOV =
			
			VAR _currentDate = Forecast_Product_Table[Date]
			VAR _loc         = Forecast_Product_Table[LocationID]
			VAR _chain       = Forecast_Product_Table[CHAINID]
			VAR _weekday     = WEEKDAY(_currentDate, 2)
			
			-- Get all past dates for same Brand + Location + same Weekday with their AOV
			VAR _allMatchingDates =
			    FILTER(
			        ADDCOLUMNS(
			            DISTINCT(
			                SELECTCOLUMNS(
			                    FILTER(
			                        AOV_Table,
			                        AOV_Table[Brand]      = _chain &&
			                        AOV_Table[LOCATIONID] = _loc   &&
			                        WEEKDAY(DATEVALUE(LEFT(AOV_Table[VOUCHERDATE], 10)), 2) = _weekday &&
			                        DATEVALUE(LEFT(AOV_Table[VOUCHERDATE], 10)) < _currentDate
			                    ),
			                    "AOV_Date", DATEVALUE(LEFT(AOV_Table[VOUCHERDATE], 10))
			                )
			            ),
			            "DayAOV",
			                VAR _d = [AOV_Date]
			                RETURN
			                CALCULATE(
			                    AVERAGE(AOV_Table[Daily_AOV]),
			                    FILTER(
			                        AOV_Table,
			                        DATEVALUE(LEFT(AOV_Table[VOUCHERDATE], 10)) = _d &&
			                        AOV_Table[Brand]      = _chain                   &&
			                        AOV_Table[LOCATIONID] = _loc
			                    )
			                )
			        ),
			        NOT ISBLANK([DayAOV])
			    )
			
			-- Peel the 3 most recent matching weekday dates
			VAR _date1      = MAXX(_allMatchingDates, [AOV_Date])
			VAR _remaining1 = FILTER(_allMatchingDates, [AOV_Date] < _date1)
			
			VAR _date2      = MAXX(_remaining1, [AOV_Date])
			VAR _remaining2 = FILTER(_remaining1, [AOV_Date] < _date2)
			
			VAR _date3      = MAXX(_remaining2, [AOV_Date])
			
			-- Extract AOV for each of the 3 dates
			VAR _aov1 = MAXX(FILTER(_allMatchingDates, [AOV_Date] = _date1), [DayAOV])
			VAR _aov2 = MAXX(FILTER(_allMatchingDates, [AOV_Date] = _date2), [DayAOV])
			VAR _aov3 = MAXX(FILTER(_allMatchingDates, [AOV_Date] = _date3), [DayAOV])
			
			-- Count how many dates were actually found (handles edge case of fewer than 3)
			VAR _count =
			    IF(NOT ISBLANK(_date1), 1, 0) +
			    IF(NOT ISBLANK(_date2), 1, 0) +
			    IF(NOT ISBLANK(_date3), 1, 0)
			
			RETURN
			DIVIDE(
			    COALESCE(_aov1, 0) + COALESCE(_aov2, 0) + COALESCE(_aov3, 0),
			    _count
			)
		lineageTag: a7cf0e87-5b90-48c4-b666-e75622116552
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Actual_Orders = ```
			
			VAR _loc  = Forecast_Product_Table[LOCATIONID]
			VAR _date = Forecast_Product_Table[Date]
			VAR _chain = Forecast_Product_Table[CHAINID]
			
			RETURN
			CALCULATE(
			    DISTINCTCOUNT(Shakir[KEY]),
			    FILTER(
			        Shakir,
			        Shakir[CleanLocationID]  = _loc       
			            && Shakir[VOUCHERDATE]  = _date
			                        && Shakir[CHAINID]  = _chain
			
			    )
			)
			```
		formatString: 0
		lineageTag: 7535d41a-1043-457d-967f-00c1df6bea04
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Actual_AOV =
			
			VAR _loc  = Forecast_Product_Table[LOCATIONID]
			VAR _date = Forecast_Product_Table[Date]
			RETURN
			CALCULATE(
			    MAX(AOV_Table[Daily_AOV]),
			    FILTER(
			        AOV_Table,
			        AOV_Table[LOCATIONID]   = _loc
			            && AOV_Table[VOUCHERDATE] = _date
			    )
			)
		lineageTag: a94b5b96-fbc4-4994-aaac-da3f6d9fa648
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Forecast_Qty_7(last 28+2)' =
			
			ROUND([Incidence Rate Final] * [Forecast_Orders], 0)
		formatString: 0
		lineageTag: 1670fb62-13cd-4fae-a9d3-1367eb46ce9d
