table 'SALES DATA'
	lineageTag: 54cb4775-07e5-476e-b446-de61ccb16966

	column Net = 'SALES DATA'[TrxSales]-'SALES DATA'[COTDiscountAmount]
		lineageTag: 34507392-6eaa-47a2-a4df-9e3dfb02a676
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column OrderSource = ```
			
			SWITCH(
			    TRUE(),
			    
			    // In-Store for empty or "In-Store" address
			    'SALES DATA'[CustAddress8] = "" || 'SALES DATA'[CustAddress8] = "In-Store", "In-Store",
			    
			    // Cari conditions
			    LEFT('SALES DATA'[CustAddress8], 2) IN {"Ca", "CA"} &&
			    'SALES DATA'[OrderType] = "DL" &&
			    NOT(ISBLANK('SALES DATA'[COTRefnumber])), "Cari",
			    
			    // Call Center conditions
			    LEFT('SALES DATA'[CustAddress8], 2) = "CO" &&
			    NOT(ISBLANK('SALES DATA'[COTRefnumber])), "Call Center",
			    
			    // Deliveroo conditions
			    LEFT('SALES DATA'[CustAddress8], 2) IN {"De", "DE"} &&
			    'SALES DATA'[OrderType] = "DL" &&
			    NOT(ISBLANK('SALES DATA'[COTRefnumber])), "Deliveroo",
			    
			    // Application Lovebird & Other Apps
			    LEFT('SALES DATA'[CustAddress8], 2) = "DR" &&
			    NOT(ISBLANK('SALES DATA'[COTRefnumber])), "Application",
			    
			    // Jahez conditions
			    LEFT('SALES DATA'[CustAddress8], 2) = "Ja" &&
			    'SALES DATA'[OrderType] = "DL" &&
			    NOT(ISBLANK('SALES DATA'[COTRefnumber])), "Jahez",
			    
			    // Ordable conditions
			    LEFT('SALES DATA'[CustAddress8], 2) IN {"Or", "OR"} &&
			    NOT(ISBLANK('SALES DATA'[COTRefnumber])), "Ordable",
			    
			    // Talabat conditions
			    LEFT('SALES DATA'[CustAddress8], 2) IN {"Ta", "TA"} &&
			    'SALES DATA'[OrderType] = "DL" &&
			    NOT(ISBLANK('SALES DATA'[COTRefnumber])), "Talabat",
			    
			    // WhatsApp / Zajel (W/Z prefixes)
			    LEFT('SALES DATA'[CustAddress8], 1) IN {"W", "Z"} &&
			    NOT(ISBLANK('SALES DATA'[COTRefnumber])), "Ordable",
			    
			    // V-Throu conditions
			    LEFT('SALES DATA'[CustAddress8], 1) = "V" &&
			    NOT(ISBLANK('SALES DATA'[COTRefnumber])), "V-Throu",
			    
			    // Default
			    "In-Store"
			)
			
			```
		lineageTag: 7d3b6937-2d56-4dad-a1dc-0bf02fe66149
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column DayName = ```
			FORMAT('SALES DATA'[VoucherDate], "dddd")
			
			```
		lineageTag: 0eb5014f-30c9-4794-b7b8-71736a9ab9a3
