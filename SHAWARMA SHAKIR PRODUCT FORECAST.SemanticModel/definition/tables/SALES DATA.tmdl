	column KEY
		dataType: string
		lineageTag: f11a6e1e-bc5a-44a4-96ec-c64ac5d4206a
		summarizeBy: none
		sourceColumn: KEY

		annotation SummarizationSetBy = Automatic

	column Discount = ```
			
			VAR IsJahezOrderSource = ('SALES DATA'[OrderSource] = "Jahez")
			VAR OrderDate = 'SALES DATA'[VoucherDate]
			VAR TransactionSales = 'SALES DATA'[TrxSales]
			VAR COTDiscountAmount = 'SALES DATA'[COTDiscountAmount]
			RETURN
			    IF(
			       IsJahezOrderSource,
			        IF(
			            OrderDate = DATE(2024, 12, 1), 
			            TransactionSales * 0.30,
			            IF(
			                OrderDate >= DATE(2024, 12, 2) && OrderDate <= DATE(2024, 12, 8), 
			                TransactionSales * 0.25,
			                IF(
			                    OrderDate > DATE(2024, 12, 8) && OrderDate <= DATE(2024, 12, 22), 
			                    TransactionSales * 0.40,
			                    COTDiscountAmount
			                )
			            )
			        ),
			        COTDiscountAmount
			    )
			
			```
		lineageTag: 60f25575-eea6-4d8d-bc65-90d7419f9e79
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

