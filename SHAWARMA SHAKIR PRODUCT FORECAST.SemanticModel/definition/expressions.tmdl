expression 'SLICE FOODICS' =
		let
		    // ==============================
		    // 1️⃣ Connect to Snowflake
		    // ==============================
		    Source = Snowflake.Databases("UMWIJEO-IF31569.snowflakecomputing.com", "AIRBYTE_WAREHOUSE"),
		    AIRBYTE_FOODICS_Database = Source{[Name="AIRBYTE_FOODICS",Kind="Database"]}[Data],
		    AIRBYTE_SLICE_Schema = AIRBYTE_FOODICS_Database{[Name="AIRBYTE_SLICE",Kind="Schema"]}[Data],
		    ORDERSVIEW_View = AIRBYTE_SLICE_Schema{[Name="ORDERSVIEW",Kind="View"]}[Data],
		    // ==============================
		    // 2️⃣ Basic Cleanup
		    // ==============================
		    #"Changed Type" = Table.TransformColumnTypes(ORDERSVIEW_View,{{"ID", type text}, {"BUSINESS_DATE", type date}, {"CREATED_AT", type datetime}}),
		    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"CUSTOMER_MOBILE", "CUSTOMER_EMAIL", "CUSTOMER_NAME", "CUSTOMER_ID", "EXTERNAL_SOURCE", "EXTERNAL_NUMBER", "CUSTOMER_NOTES", "KITCHEN_NOTES", "BUSINESS_DATE_IN_UTC", "UPDATED_AT", "CLOSED_AT", "GUESTS", "ID", "BRANCH_TYPE"}),
		    #"Renamed Columns2" = Table.RenameColumns(#"Removed Columns",{{"CREATED_AT", "STARTTIME"}}),
		    #"Added Custom1" = Table.AddColumn(#"Renamed Columns2", "Custom", each DateTimeZone.SwitchZone(DateTime.AddZone([STARTTIME], 0), 3)),
		
		    #"Sorted Rows" = Table.Sort(#"Added Custom1",{{"BRANCH_NAME", Order.Ascending}}),
		    #"Filtered Rows1" = Table.SelectRows(#"Sorted Rows", each ([STATUS] <> 7)),
		    #"Changed Type2" = Table.TransformColumnTypes(#"Filtered Rows1",{{"STARTTIME", type datetime}}),
		    #"Changed Type4" = Table.TransformColumnTypes(#"Changed Type2",{{"Custom", type datetime}}),
		
		    // ==============================
		    // 3️⃣ FIX BUSINESS_DATE USING STARTTIME LOGIC
		    // ==============================
		    #"Added Fixed Date" =
		        Table.AddColumn(
		    #"Changed Type4",
		    "FIXED_BUSINESS_DATE",
		    each
		        let
		            stText = try Text.From([Custom]) otherwise null,
		            st =
		                try
		                    if Value.Is([Custom], type datetime)
		                    then [Custom]
		                    else DateTime.FromText(stText, [Format="en-US"])
		                otherwise null,
		            result =
		                if st <> null then
		                    let
		                        hourPart = try Time.Hour(Time.From(st)) otherwise null
		                    in
		                        if hourPart <> null and hourPart < 7
		                        then Date.AddDays(Date.From(st), -1)
		                        else Date.From(st)
		                else
		                    null
		        in
		            result,
		    type date
		),
		    #"Sorted Rows2" = Table.Sort(#"Added Fixed Date",{{"Custom", Order.Ascending}}),
		    #"Sorted Rows3" = Table.Sort(#"Sorted Rows2",{{"Custom", Order.Ascending}}),
		    #"Renamed Columns3" = Table.RenameColumns(#"Sorted Rows3",{{"STARTTIME", "START"}}),
		    #"Changed Type3" = Table.TransformColumnTypes(#"Renamed Columns3",{{"Custom", type datetime}}),
		    #"Sorted Rows1" = Table.Sort(#"Changed Type3",{{"Custom", Order.Descending}}),
		    #"Sorted Rows4" = Table.Sort(#"Sorted Rows1",{{"Custom", Order.Ascending}}),
		
		    // Replace BUSINESS_DATE with FIXED one
		    #"Removed Old Date" = Table.RemoveColumns(#"Sorted Rows4",{"BUSINESS_DATE"}),
		    #"Renamed New Date" = Table.RenameColumns(#"Removed Old Date",{{"FIXED_BUSINESS_DATE", "BUSINESS_DATE"}}),
		
		    // ==============================
		    // 4️⃣ Brand, Grouping, and Renames
		    // ==============================
		    #"Added Custom" = Table.AddColumn(#"Renamed New Date", "customs", each "SLC"),
		    #"Renamed Columns" = Table.RenameColumns(#"Added Custom",{{"customs", "Brand"}}),
		    #"Removed Columns1" = Table.RemoveColumns(#"Renamed Columns",{"BRANCH_NAME"}),
		    #"Grouped Rows" = Table.Group(#"Removed Columns1", {"Brand", "BUSINESS_DATE"}, {{"TotalAmount", each List.Sum([SUBTOTAL_PRICE]), type nullable number}, {"TotalDiscount", each List.Sum([DISCOUNT_AMOUNT]), type nullable number}}),
		
		    #"Filtered Rows" = Table.SelectRows(#"Grouped Rows", each ([BUSINESS_DATE] <> null)),
		    #"Changed Type1" = Table.TransformColumnTypes(#"Filtered Rows",{{"Brand", type text}}),
		    #"Renamed Columns1" = Table.RenameColumns(#"Changed Type1",{
		        {"BUSINESS_DATE", "VOUCHERDATE"},
		        {"TotalAmount", "TotalSales"},
		        {"TotalDiscount", "TotalDiscounts"}
		    }),
		    #"Sorted Rows5" = Table.Sort(#"Renamed Columns1",{{"VOUCHERDATE", Order.Descending}})
		in
		    #"Sorted Rows5"
