	column Date
		formatString: General Date
		lineageTag: b95abc26-12f6-4e25-8307-3e47192d8676
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		variation Variation
			isDefault
			relationship: 6d081d67-5990-477f-92c5-717e23e2b717
			defaultHierarchy: LocalDateTable_93fd8f69-89fd-4ec2-bb66-6b361c617b9b.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	column Forecasted_Incidence_Rate =
			
			
			VAR _currentItem  = Forecast_Spine[CleanNewItemID]
			VAR _currentLoc   = Forecast_Spine[CleanLocationID]
			VAR _currentChain = Forecast_Spine[CHAINID]
			VAR _spineDate    = Forecast_Spine[Date]
			
			VAR _anchorDate =
			    CALCULATE(
			        MAX(Incidence_Table[VOUCHERDATE]),
			        FILTER(
			            Incidence_Table,
			            Incidence_Table[CleanNewItemID]  = _currentItem  &&
			            Incidence_Table[CleanLocationID] = _currentLoc   &&
			            Incidence_Table[CHAINID]         = _currentChain
			        )
			    )
			
			-- =====================================
			-- WEEKDAY MATCHING
			-- =====================================
			
			VAR _spineWeekday  = WEEKDAY(_spineDate,  2)   -- 1=Mon … 7=Sun
			VAR _anchorWeekday = WEEKDAY(_anchorDate, 2)
			
			-- Days to roll back from anchor to land on same weekday as spine date
			VAR _dayOffset = MOD(_anchorWeekday - _spineWeekday + 7, 7)
			
			-- Most recent actual date sharing spine's weekday (on or before anchor)
			VAR _week1Date = _anchorDate - _dayOffset         -- e.g. last Saturday
			VAR _week2Date = _anchorDate - _dayOffset - 7     -- e.g. Saturday before that
			
			-- =====================================
			-- HISTORY WINDOW (28 days before anchor)
			-- =====================================
			
			VAR _monthStart = _anchorDate - 28
			
			VAR _history =
			    FILTER(
			        Incidence_Table,
			        Incidence_Table[CleanNewItemID]  = _currentItem  &&
			        Incidence_Table[CleanLocationID] = _currentLoc   &&
			        Incidence_Table[CHAINID]         = _currentChain &&
			        Incidence_Table[VOUCHERDATE]     > _monthStart   &&
			        Incidence_Table[VOUCHERDATE]     < _anchorDate
			    )
			
			-- =====================================
			-- 1. RECENCY-WEIGHTED ROLLING RATE
			-- =====================================
			
			VAR _weightedNumerator =
			    SUMX(
			        SUMMARIZE(
			            _history,
			            Incidence_Table[VOUCHERDATE],
			            "DailyQty", MAX(Incidence_Table[Numerator (Total Qty)]),
			            "Age",      DATEDIFF(Incidence_Table[VOUCHERDATE], _anchorDate, DAY)
			        ),
			        [DailyQty] * EXP(-0.08 * [Age])
			    )
			
			VAR _weightedDenominator =
			    SUMX(
			        SUMMARIZE(
			            _history,
			            Incidence_Table[VOUCHERDATE],
			            "Orders", MAX(Incidence_Table[Denominator (Total Orders)]),
			            "Age",    DATEDIFF(Incidence_Table[VOUCHERDATE], _anchorDate, DAY)
			        ),
			        [Orders] * EXP(-0.08 * [Age])
			    )
			
			VAR _rollingRate =
			    DIVIDE(_weightedNumerator, _weightedDenominator)
			
			-- =====================================
			-- 2. WEEK 1 — SAME WEEKDAY, 1 WEEK AGO
			-- =====================================
			
			VAR _week1Num =
			    SUMX(
			        FILTER(
			            Incidence_Table,
			            Incidence_Table[CleanNewItemID]  = _currentItem  &&
			            Incidence_Table[CleanLocationID] = _currentLoc   &&
			            Incidence_Table[CHAINID]         = _currentChain &&
			            Incidence_Table[VOUCHERDATE]     = _week1Date
			        ),
			        Incidence_Table[Numerator (Total Qty)]
			    )
			
			VAR _week1Den =
			    MAXX(
			        FILTER(
			            Incidence_Table,
			            Incidence_Table[CleanLocationID] = _currentLoc   &&
			            Incidence_Table[CHAINID]         = _currentChain &&
			            Incidence_Table[VOUCHERDATE]     = _week1Date
			        ),
			        Incidence_Table[Denominator (Total Orders)]
			    )
			
			VAR _week1Rate = DIVIDE(_week1Num, _week1Den)
			
			-- =====================================
			-- 3. WEEK 2 — SAME WEEKDAY, 2 WEEKS AGO
			-- =====================================
			
			VAR _week2Num =
			    SUMX(
			        FILTER(
			            Incidence_Table,
			            Incidence_Table[CleanNewItemID]  = _currentItem  &&
			            Incidence_Table[CleanLocationID] = _currentLoc   &&
			            Incidence_Table[CHAINID]         = _currentChain &&
			            Incidence_Table[VOUCHERDATE]     = _week2Date
			        ),
			        Incidence_Table[Numerator (Total Qty)]
			    )
			
			VAR _week2Den =
			    MAXX(
			        FILTER(
			            Incidence_Table,
			            Incidence_Table[CleanLocationID] = _currentLoc   &&
			            Incidence_Table[CHAINID]         = _currentChain &&
			            Incidence_Table[VOUCHERDATE]     = _week2Date
			        ),
			        Incidence_Table[Denominator (Total Orders)]
			    )
			
			VAR _week2Rate = DIVIDE(_week2Num, _week2Den)
			
			-- =====================================
			-- 4. WEIGHTED WEEKDAY MEMORY
			-- =====================================
			
			VAR _weekdayRate =
			    SWITCH(
			        TRUE(),
			        NOT ISBLANK(_week1Rate) && NOT ISBLANK(_week2Rate),
			            (_week1Rate * 0.7) + (_week2Rate * 0.3),
			        NOT ISBLANK(_week1Rate),
			            _week1Rate,
			        NOT ISBLANK(_week2Rate),
			            _week2Rate,
			        BLANK()
			    )
			
			-- =====================================
			-- 5. SELL FREQUENCY CONFIDENCE
			-- =====================================
			
			VAR _daysSold =
			    COUNTROWS(
			        FILTER(
			            _history,
			            Incidence_Table[Numerator (Total Qty)] > 0
			        )
			    )
			
			VAR _sellFreq = DIVIDE(_daysSold, 28, 0)
			
			-- =====================================
			-- 6. ADAPTIVE BLENDING
			-- =====================================
			
			VAR _weekdayWeight = IF(_sellFreq >= 0.5, 0.5, 0.25)
			VAR _rollingWeight = 1 - _weekdayWeight
			
			VAR _blendedRate =
			    IF(
			        NOT ISBLANK(_weekdayRate),
			        (_rollingRate * _rollingWeight) + (_weekdayRate * _weekdayWeight),
			        _rollingRate
			    )
			
			-- =============================================
			-- 7. DRASTIC CHANGE DETECTION (LAST 7 DAYS)
			-- =============================================
			
			VAR _last7History =
			    FILTER(
			        Incidence_Table,
			        Incidence_Table[CleanNewItemID]  = _currentItem  &&
			        Incidence_Table[CleanLocationID] = _currentLoc   &&
			        Incidence_Table[CHAINID]         = _currentChain &&
			        Incidence_Table[VOUCHERDATE]     > _anchorDate - 7 &&
			        Incidence_Table[VOUCHERDATE]     < _anchorDate
			    )
			
			VAR _last7Qty =
			    SUMX(
			        SUMMARIZE(
			            _last7History,
			            Incidence_Table[VOUCHERDATE],
			            "DailyQty", MAX(Incidence_Table[Numerator (Total Qty)])
			        ),
			        [DailyQty]
			    )
			
			VAR _last7Orders =
			    SUMX(
			        SUMMARIZE(
			            _last7History,
			            Incidence_Table[VOUCHERDATE],
			            "DailyOrders", MAX(Incidence_Table[Denominator (Total Orders)])
			        ),
			        [DailyOrders]
			    )
			
			VAR _last7Rate    = DIVIDE(_last7Qty, _last7Orders)
			
			VAR _relativeChange =
			    DIVIDE(
			        ABS(_last7Rate - _blendedRate),
			        _blendedRate
			    )
			
			VAR _isDrastic =
			    NOT ISBLANK(_last7Rate)   &&
			    NOT ISBLANK(_blendedRate) &&
			    _relativeChange > 0.20
			
			-- =====================================
			-- RETURN
			-- =====================================
			
			RETURN
			IF(
			    ISBLANK(_anchorDate),
			    BLANK(),
			    IF(
			        _isDrastic,
			        _last7Rate,
			        _blendedRate
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: f9ca7a2b-0865-43d8-92b9-cc9418a606a3
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column DOW = WEEKDAY(Forecast_Spine[Date], 2)
