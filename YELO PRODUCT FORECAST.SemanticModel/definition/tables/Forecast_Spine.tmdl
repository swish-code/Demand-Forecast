	column Last28Days_Qty =
			
			
			VAR _item  = Forecast_Spine[CleanNewItemID]
			VAR _loc   = Forecast_Spine[CleanLocationID]
			VAR _chain = Forecast_Spine[CHAINID]
			
			VAR _LastActualDate =
			    CALCULATE(
			        MAX(Incidence_Table[VOUCHERDATE]),
			        FILTER(
			            Incidence_Table,
			            Incidence_Table[CleanNewItemID] = _item &&
			            Incidence_Table[CleanLocationID] = _loc &&
			            Incidence_Table[CHAINID] = _chain
			        )
			    )
			
			RETURN
			CALCULATE(
			    SUM(Incidence_Table[Numerator (Total Qty)]),
			    FILTER(
			        Incidence_Table,
			        Incidence_Table[CleanNewItemID] = _item &&
			        Incidence_Table[CleanLocationID] = _loc &&
			        Incidence_Table[CHAINID] = _chain &&
			        Incidence_Table[VOUCHERDATE] > (_LastActualDate - 28) &&
			        Incidence_Table[VOUCHERDATE] <= _LastActualDate
			    )
			)
		lineageTag: d74a3808-5c76-41fc-a15a-495980820626
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Last28Days_Orders =
			
			
			VAR _item  = Forecast_Spine[CleanNewItemID]
			VAR _loc   = Forecast_Spine[CleanLocationID]
			VAR _chain = Forecast_Spine[CHAINID]
			
			VAR _LastActualDate =
			    CALCULATE(
			        MAX(Incidence_Table[VOUCHERDATE]),
			        FILTER(
			            Incidence_Table,
			            Incidence_Table[CleanNewItemID] = _item &&
			            Incidence_Table[CleanLocationID] = _loc &&
			            Incidence_Table[CHAINID] = _chain
			        )
			    )
			
			RETURN
			CALCULATE(
			    SUM(Incidence_Table[Denominator (Total Orders)]),
			    FILTER(
			        Incidence_Table,
			        Incidence_Table[CleanNewItemID] = _item &&
			        Incidence_Table[CleanLocationID] = _loc &&
			        Incidence_Table[CHAINID] = _chain &&
			        Incidence_Table[VOUCHERDATE] > (_LastActualDate - 28) &&
			        Incidence_Table[VOUCHERDATE] <= _LastActualDate
			    )
			)
		formatString: 0
		lineageTag: 608931b5-1740-466e-a08c-0471ed1f1ed2
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column CleanNewItemID
		lineageTag: 491cb62b-ecec-4ff3-ac2e-b6978815be3b
		summarizeBy: none
		isNameInferred
		sourceColumn: Incidence_Table[CleanNewItemID]

		annotation SummarizationSetBy = Automatic

	column Is_Active =
			
			VAR _currentItem  = Forecast_Spine[CleanNewItemID]
			VAR _currentLoc   = Forecast_Spine[CleanLocationID]
			VAR _currentChain = Forecast_Spine[CHAINID]
			
			VAR _cutoffDate = TODAY() - 3
			
			VAR _existsLast3 =
			    COUNTROWS(
			        FILTER(
			            Incidence_Table,
			            Incidence_Table[CleanNewItemID]  = _currentItem  &&
			            Incidence_Table[CleanLocationID] = _currentLoc   &&
			            Incidence_Table[CHAINID]         = _currentChain &&
			            Incidence_Table[VOUCHERDATE]     >= _cutoffDate
			        )
			    )
			
			RETURN
			IF(_existsLast3 > 0, 1, 0)
		formatString: 0
		lineageTag: 86793acc-0048-484a-be47-38fd01b6efd7
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column Debug_Rate_Comparison =
			
			VAR _forecastedRate = Forecast_Spine[Forecasted_Incidence_Rate]
			VAR _actualRate =
			    MAXX(
			        FILTER(
			            Incidence_Table,
			            Incidence_Table[CleanNewItemID]  = Forecast_Spine[CleanNewItemID] &&
			            Incidence_Table[CleanLocationID] = Forecast_Spine[CleanLocationID] &&
			            Incidence_Table[CHAINID]         = Forecast_Spine[CHAINID] &&
			            Incidence_Table[VOUCHERDATE]     = Forecast_Spine[Date] - 7
			        ),
			        Incidence_Table[Incidence Rate % Final]
			    )
			RETURN
			DIVIDE(_forecastedRate, _actualRate)
		lineageTag: d46336fc-9c8a-40ba-9307-89acdb5335a1
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition Forecast_Spine = calculated
		mode: import
		source =
				
				
				VAR _today = TODAY()
				VAR _forecastEnd = _today + 210
				
				VAR _activeCombos =
				    SUMMARIZECOLUMNS(
				        Incidence_Table[CleanNewItemID],
				        Incidence_Table[CleanLocationID],
				        Incidence_Table[CHAINID],
				        KEEPFILTERS(
				            FILTER(
				                ALL(Incidence_Table),
				                Incidence_Table[VOUCHERDATE] >= _today - 3 &&
				                Incidence_Table[Numerator (Total Qty)] > 0
				            )
				        )
				    )
				
				VAR _futureDates =
				    CALENDAR(_today, _forecastEnd)
				
				RETURN
				GENERATE(_activeCombos, _futureDates)

	annotation PBI_Id = a89ec026082d49df80f7aff54d82ac1f

