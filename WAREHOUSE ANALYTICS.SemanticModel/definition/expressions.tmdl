expression agg_grn_by_po_period =
		let
		    Source = fact_grn_allocated_detail,
		
		    GroupedRows =
		        Table.Group(
		            Source,
		            {"PO Period ID"},
		            {
		                {"Allocated GRN Base Qty", each List.Sum(List.RemoveNulls([GRN Base Qty])), type nullable number},
		                {"Same Day GRN Base Qty", each List.Sum(List.RemoveNulls([Same Day GRN Base Qty])), type nullable number},
		                {"Late GRN Base Qty", each List.Sum(List.RemoveNulls([Late GRN Base Qty])), type nullable number},
		                {"GRN Value", each List.Sum(List.RemoveNulls([GRN Value])), type nullable number},
		                {"Delivery Note Count", each List.Count(List.Distinct(List.RemoveNulls([Delivery Note No]))), Int64.Type},
		                {"GRN Line Count", each Table.RowCount(_), Int64.Type},
		                {"First GRN Date", each try List.Min(List.RemoveNulls([GRN Delivery Date])) otherwise null, type nullable date},
		                {"Last GRN Date", each try List.Max(List.RemoveNulls([GRN Delivery Date])) otherwise null, type nullable date},
		                {"First Booking Date", each try List.Min(List.RemoveNulls([GRN Booking Date])) otherwise null, type nullable date},
		                {"Last Booking Date", each try List.Max(List.RemoveNulls([GRN Booking Date])) otherwise null, type nullable date},
		                {"Actual GRN Supplier", each try if List.Count(List.Distinct(List.RemoveNulls([Supplier]))) = 1 then List.First(List.Distinct(List.RemoveNulls([Supplier]))) else "MULTIPLE" otherwise null, type nullable text},
		                {"Actual GRN Supplier List", each try Text.Combine(List.Distinct(List.RemoveNulls([Supplier])), ", ") otherwise null, type nullable text},
		                {"Actual GRN Unit List", each try Text.Combine(List.Distinct(List.RemoveNulls([GRN Unit])), ", ") otherwise null, type nullable text}
		            }
		        )
		in
		    GroupedRows
	lineageTag: fcd598e4-2046-4899-9169-bc4735d6d24c

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

expression 'Delivery Note' =
		let
		    Source = Oracle.Database(
		        "192.168.1.99/mc",
		        [
		            HierarchicalNavigation = true,
		            Query = Text.Combine(
		                {
		                    "SELECT",
		                    "    p.lfp_pos                       AS ""Pos"",",
		                    "    a.art_nummer                    AS ""Article No."",",
		                    "    a.art_name                      AS ""Article"",",
		                    "    p.lfp_menge                     AS ""QTY"",",
		                    "    w.vpk_name                      AS ""Unit"",",
		                    "    p.lfp_ekpstk                    AS ""Price/Unit"",",
		                    "    p.lfp_mengege                   AS ""QTY/BU"",",
		                    "    p.lfp_ekpstk / w.vpk_grmenge    AS ""Price/BU"",",
		                    "    p.lfp_rabatt * 100 || '%'       AS ""Discount"",",
		                    "    p.lfp_ekp                       AS ""Net"",",
		                    "    k.kst_name                      AS ""Cost Center/Store"",",
		                    "    l.lfs_name                      AS ""Delivery_Note"",",
		                    "    l.lfs_datum                     AS ""Delivery_Date"",",
		                    "    CASE",
		                    "        WHEN l.lfs_status = 32 THEN",
		                    "            CASE",
		                    "                WHEN l.lfs_rts = 1 THEN 'Open Return to Supplier'",
		                    "                ELSE 'Open Delivery Note'",
		                    "            END",
		                    "        WHEN l.lfs_status = 37 THEN 'Booked Delivery Note'",
		                    "        WHEN l.lfs_status >= 41 THEN 'Closed Invoice'",
		                    "        ELSE 'IDK'",
		                    "    END                             AS ""DN Status"",",
		                    "    NULL                            AS ""Last Price/BU"",",
		                    "    v.vpk_name                      AS ""Base Unit"",",
		                    "    nvl(p.sb_name, 'No PO defined') AS ""Order No."",",
		                    "    p.sb_ze                         AS ""Order Date"",",
		                    "    p.bp_mengeorg                   AS ""Requested QTY"",",
		                    "    i.lf_name                       AS ""Supplier"",",
		                    "    b.bst_name                      AS ""Created by"",",
		                    "    p.new_zeit                      AS ""Created At""",
		                    "FROM",
		                    "    lieferschein l,",
		                    "    lieferpos    p,",
		                    "    artikel      a,",
		                    "    vpckeinh     v,",
		                    "    vpckeinh     w,",
		                    "    liefer       i,",
		                    "    kostst       k,",
		                    "    fcurrency    f,",
		                    "    besteller    b",
		                    "WHERE",
		                    "        p.lfs_id = l.lfs_id",
		                    "    AND v.vpk_id = p.vpk_id2",
		                    "    AND w.vpk_id = p.vpk_id1",
		                    "    AND a.art_id = p.art_nr",
		                    "    AND i.lf_id = l.lf_id",
		                    "    AND k.kst_id = p.kst_id",
		                    "    AND p.new_user = b.bst_id",
		                    "    AND i.cur_nr = f.cur_id (+)",
		                    "",
		                    "UNION ALL",
		                    "",
		                    "SELECT",
		                    "    p.lfp_pos                       AS ""Pos"",",
		                    "    a.art_nummer                    AS ""Article No."",",
		                    "    a.art_name                      AS ""Article"",",
		                    "    p.lfp_menge                     AS ""QTY"",",
		                    "    w.vpk_name                      AS ""Unit"",",
		                    "    p.lfp_ekpstk                    AS ""Price/Unit"",",
		                    "    p.lfp_mengege                   AS ""QTY/BU"",",
		                    "    p.lfp_ekpstk / w.vpk_grmenge    AS ""Price/BU"",",
		                    "    p.lfp_rabatt * 100 || '%'       AS ""Discount"",",
		                    "    p.lfp_ekp                       AS ""Net"",",
		                    "    k.kst_name                      AS ""Cost Center/Store"",",
		                    "    l.rng_name                      AS ""Delivery_Note"",",
		                    "    l.rng_datum                     AS ""Delivery_Date"",",
		                    "    CASE",
		                    "        WHEN l.rng_status = 10 THEN 'Booked Invoice'",
		                    "        ELSE 'IDK'",
		                    "    END                             AS ""DN Status"",",
		                    "    NULL                            AS ""Last Price/BU"",",
		                    "    v.vpk_name                      AS ""Base Unit"",",
		                    "    nvl(p.sb_name, 'No PO defined') AS ""Order No."",",
		                    "    p.sb_ze                         AS ""Order Date"",",
		                    "    p.bp_mengeorg                   AS ""Requested QTY"",",
		                    "    i.lf_name                       AS ""Supplier"",",
		                    "    b.bst_name                      AS ""Created by"",",
		                    "    p.new_zeit                      AS ""Created At""",
		                    "FROM",
		                    "    rechnung  l,",
		                    "    rechpos   p,",
		                    "    artikel   a,",
		                    "    vpckeinh  v,",
		                    "    vpckeinh  w,",
		                    "    liefer    i,",
		                    "    kostst    k,",
		                    "    fcurrency f,",
		                    "    besteller b",
		                    "WHERE",
		                    "        p.rng_id = l.rng_id",
		                    "    AND v.vpk_id = p.vpk_id2",
		                    "    AND w.vpk_id = p.vpk_id1",
		                    "    AND a.art_id = p.art_nr",
		                    "    AND i.lf_id = l.lf_id",
		                    "    AND k.kst_id = p.kst_id",
		                    "    AND p.new_user = b.bst_id",
		                    "    AND i.cur_nr = f.cur_id (+)",
		                    "    AND p.lfp_mengege <> 0",
		                    "    AND p.lfp_status <> 64",
		                    "ORDER BY",
		                    "    19,",
		                    "    17,",
		                    "    11,",
		                    "    1"
		                },
		                "#(lf)"
		            )
		        ]
		    ),
		
		    #"Changed Type" = Table.TransformColumnTypes(
		        Source,
		        {
		            {"Pos", Int64.Type},
		            {"Article No.", Int64.Type},
		            {"Article", type text},
		            {"QTY", type number},
		            {"Unit", type text},
		            {"Price/Unit", type number},
		            {"QTY/BU", type number},
		            {"Price/BU", type number},
		            {"Discount", type text},
		            {"Net", type number},
		            {"Cost Center/Store", type text},
		            {"Delivery_Note", type text},
		            {"Delivery_Date", type datetime},
		            {"DN Status", type text},
		            {"Last Price/BU", type any},
		            {"Base Unit", type text},
		            {"Order No.", type text},
		            {"Order Date", type date},
		            {"Requested QTY", Int64.Type},
		            {"Supplier", type text},
		            {"Created by", type text},
		            {"Created At", type datetime}
		        }
		    ),
		
		    #"Filtered Date Range" = Table.SelectRows(
		        #"Changed Type",
		        each Date.From([Delivery_Date]) >= p_FromDate
		    ),
		
		    #"Converted Discount" = Table.TransformColumns(
		        #"Filtered Date Range",
		        {
		            {
		                "Discount",
		                each
		                    if _ = null then
		                        null
		                    else
		                        let
		                            DiscountText = Text.From(_),
		                            CleanDiscount = Text.Replace(DiscountText, "%", "")
		                        in
		                            Number.FromText(CleanDiscount) / 100,
		                Percentage.Type
		            }
		        }
		    ),
		
		    #"Reordered Columns" = Table.ReorderColumns(
		        #"Converted Discount",
		        {
		            "Pos",
		            "Article No.",
		            "Article",
		            "Supplier",
		            "Cost Center/Store",
		            "QTY",
		            "Unit",
		            "Base Unit",
		            "Price/Unit",
		            "QTY/BU",
		            "Price/BU",
		            "Discount",
		            "Net",
		            "Delivery_Note",
		            "Delivery_Date",
		            "DN Status",
		            "Last Price/BU",
		            "Order No.",
		            "Order Date",
		            "Requested QTY",
		            "Created by",
		            "Created At"
		        }
		    ),
		
		    #"Renamed Columns" = Table.RenameColumns(
		        #"Reordered Columns",
		        {
		            {"Cost Center/Store", "Warehouse"},
		            {"Unit", "GRN Unit"},
		            {"QTY", "GRN Qty"},
		            {"QTY/BU", "GRN Base Qty"},
		            {"Net", "GRN Value"},
		            {"Delivery_Note", "Delivery Note No"},
		            {"Delivery_Date", "Delivery Date"},
		            {"Created At", "Booking DateTime"},
		            {"Order Date", "DN Order Date"}
		        }
		    ),
		
		    #"Removed Columns" = Table.RemoveColumns(
		        #"Renamed Columns",
		        {
		            "Created by",
		            "Pos",
		            "Last Price/BU"
		        }
		    ),
		
		    #"Reordered Columns1" = Table.ReorderColumns(
		        #"Removed Columns",
		        {
		            "Article No.",
		            "Article",
		            "Supplier",
		            "Warehouse",
		            "GRN Unit",
		            "GRN Qty",
		            "GRN Base Qty",
		            "Base Unit",
		            "GRN Value",
		            "Price/Unit",
		            "Price/BU",
		            "Discount",
		            "Delivery Note No",
		            "Delivery Date",
		            "DN Status",
		            "Order No.",
		            "DN Order Date",
		            "Requested QTY",
		            "Booking DateTime"
		        }
		    ),
		
		    #"Filtered Rows" = Table.SelectRows(
		        #"Reordered Columns1",
		        each not Text.Contains([DN Status], "Open Return to Supplier")
		    ),
		
		    #"Merged Queries" = Table.NestedJoin(
		        #"Filtered Rows",
		        {"Article"},
		        CategoryLookup,
		        {"Article"},
		        "CategoryLookup",
		        JoinKind.LeftOuter
		    ),
		
		    #"Expanded CategoryLookup" = Table.ExpandTableColumn(
		        #"Merged Queries",
		        "CategoryLookup",
		        {"Sub_Category", "Item_Group", "Storage_Type"},
		        {"Sub_Category", "Item_Group", "Storage_Type"}
		    )
		in
		    #"Expanded CategoryLookup"
	lineageTag: 8d7461d0-207d-4c3b-aa39-e9c689b9458d

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

expression 'Open PO' =
		let
		    Source = Oracle.Database(
		        "192.168.1.99/mc",
		        [
		            HierarchicalNavigation = true,
		            Query = Text.Combine(
		                {
		                    "SELECT",
		                    "    B.ART_NAME AS ""Purchase Article"",",
		                    "    CASE",
		                    "        WHEN B.art_lager = 3 THEN B.ART_NAME",
		                    "        ELSE (SELECT ART_NAME FROM ARTIKEL WHERE ART_ID = B.ART_NR)",
		                    "    END AS ""Stock Article"",",
		                    "    C.LF_NAME AS ""SUPPLIER"",",
		                    "    E.KST_NAME AS ""Cost Center"",",
		                    "    D.VPK_NAME AS ""UNIT"",",
		                    "    A.SB_NAME AS ""PO No"",",
		                    "    A.BP_MENGE AS ""PO_QTY"",",
		                    "    A.BP_MENGE - A.SB_GELIEF AS ""OPEN_QTY"",",
		                    "    A.SB_GELIEF AS ""RECEIVED QTY"",",
		                    "    A.BP_EKP AS ""Unit Price"",",
		                    "    A.BP_FREIG AS ""ORDER DATE"",",
		                    "    A.BP_LTERM AS ""DELEVERY DATE"",",
		                    "    U.BST_LONGNAME AS ""ORDERER""",
		                    "FROM",
		                    "    WARENGRUPPE F,",
		                    "    SPARTE G,",
		                    "    SPARTEGR H,",
		                    "    SAMMELPOS A,",
		                    "    ARTIKEL B,",
		                    "    LIEFER C,",
		                    "    KOSTST E,",
		                    "    VPCKEINH D,",
		                    "    BESTELLER U",
		                    "WHERE",
		                    "        A.ART_ID = B.ART_ID",
		                    "    AND A.LF_ID = C.LF_ID",
		                    "    AND A.VPK_ID = D.VPK_ID",
		                    "    AND A.KST_ID = E.KST_ID",
		                    "    AND F.WGR_ID = B.WGR_ID",
		                    "    AND G.SPA_ID = F.SPA_ID",
		                    "    AND H.SGR_ID = G.SGR_ID",
		                    "    AND A.BP_STATUS = 21",
		                    "    AND A.BST_ID = U.BST_ID",
		                    "ORDER BY",
		                    "    1"
		                },
		                "#(lf)"
		            )
		        ]
		    ),
		
		    #"Changed Type" = Table.TransformColumnTypes(
		        Source,
		        {
		            {"Purchase Article", type text},
		            {"Stock Article", type text},
		            {"SUPPLIER", type text},
		            {"Cost Center", type text},
		            {"UNIT", type text},
		            {"PO No", type text},
		            {"PO_QTY", Int64.Type},
		            {"OPEN_QTY", type number},
		            {"RECEIVED QTY", type number},
		            {"Unit Price", type number},
		            {"ORDER DATE", type datetime},
		            {"DELEVERY DATE", type datetime},
		            {"ORDERER", type text}
		        }
		    ),
		
		    #"Filtered Date Range" = Table.SelectRows(
		        #"Changed Type",
		        each [ORDER DATE] <> null and Date.From([ORDER DATE]) >= p_FromDate
		    ),
		
		    #"Renamed Columns" = Table.RenameColumns(#"Filtered Date Range",{{"Stock Article", "Article2"}, {"SUPPLIER", "Supplier"}, {"Cost Center", "Warehouse"}, {"UNIT", "PO Unit"}, {"PO_QTY", "PO Qty"}, {"Unit Price", "PO Unit Price"}, {"ORDER DATE", "PO Date"}, {"DELEVERY DATE", "PO Delivery Date"}, {"Purchase Article", "Article"}}),
		
		    #"Removed Columns1" = Table.RemoveColumns(
		        #"Renamed Columns",
		        {
		            "OPEN_QTY",
		            "RECEIVED QTY",
		            "ORDERER",
		            "Article2"
		        }
		    ),
		
		    #"Merged Queries" = Table.NestedJoin(
		        #"Removed Columns1",
		        {"Article"},
		        CategoryLookup,
		        {"Article"},
		        "CategoryLookup",
		        JoinKind.LeftOuter
		    ),
		
		    #"Expanded CategoryLookup" = Table.ExpandTableColumn(
		        #"Merged Queries",
		        "CategoryLookup",
		        {"Sub_Category", "Item_Group", "Storage_Type"},
		        {"Sub_Category", "Item_Group", "Storage_Type"}
		    ),
		
		    #"qty clean" = Table.ReplaceValue(
		        #"Expanded CategoryLookup",
		        each [PO Qty],
		        each
		            if
		                (
		                    [Article] = "Cutlery Fork Beige FM"
		                    or [Article] = "Cutlery Spoon Beige FM"
		                )
		                and [PO Qty] = 40000
		            then
		                40
		            else
		                [PO Qty],
		        Replacer.ReplaceValue,
		        {"PO Qty"}
		    ),
		
		    #"Changed Type1" = Table.TransformColumnTypes(
		        #"qty clean",
		        {
		            {"PO Delivery Date", type date}
		        }
		    ),
		
		    #"Replaced Value" = Table.ReplaceValue(
		        #"Changed Type1",
		        each [PO Delivery Date],
		        each
		            if [Article] = "Sticker BBT Medium 2.75*5.5 CM"
		                and [PO Date] = #datetime(2026, 1, 27, 12, 40, 1)
		            then
		                #date(2026, 2, 9)
		            else if [Article] = "Sticker BBT Regular 2.75*5.5 CM"
		                and [PO Date] = #datetime(2026, 1, 27, 12, 40, 36)
		            then
		                #date(2026, 2, 9)
		            else if [Article] = "Sticker BBT Single Double 5*1.3 CM"
		                and [PO Date] = #datetime(2026, 1, 27, 12, 40, 58)
		            then
		                #date(2026, 2, 9)
		            else
		                [PO Delivery Date],
		        Replacer.ReplaceValue,
		        {"PO Delivery Date"}
		    )
		in
		    #"Replaced Value"
	lineageTag: e929a676-9b71-4461-aaf8-f651cc78aede

