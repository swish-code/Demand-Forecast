expression 'fact_outbound_line (2)' =
		let
		    Source = #"Issue Requests & Transfer",
		
		    FxArticleNoText =
		        (x as any) as nullable text =>
		            let
		                Result =
		                    try
		                        if x = null then null
		                        else if Value.Is(x, type number) then Number.ToText(x, "0")
		                        else Text.Trim(Text.Clean(Text.From(x)))
		                    otherwise null
		            in
		                Result,
		
		    FxMultiplierFromUnit =
		        (UnitText as any, BaseUnitText as any) as nullable number =>
		            let
		                U = fnCleanText(UnitText),
		                B = fnCleanBaseUnit(BaseUnitText),
		
		                Tokens =
		                    if U = null
		                    then {}
		                    else Text.SplitAny(U, " -_/()[]{}"),
		
		                Numbers =
		                    List.RemoveNulls(
		                        List.Transform(
		                            Tokens,
		                            each try Number.FromText(_, "en-US") otherwise null
		                        )
		                    ),
		
		                ProductNumber =
		                    if List.Count(Numbers) > 0
		                    then List.Product(Numbers)
		                    else null,
		
		                Result =
		                    if U = null then null
		
		                    else if B = "KG"
		                        and (
		                            Text.Contains(U, "GM")
		                            or Text.Contains(U, "GMS")
		                            or Text.Contains(U, "GRAM")
		                        )
		                        and ProductNumber <> null
		                    then ProductNumber / 1000
		
		                    else if B = "LITER"
		                        and (
		                            Text.Contains(U, "ML")
		                            or Text.Contains(U, "MILLI")
		                        )
		                        and ProductNumber <> null
		                    then ProductNumber / 1000
		
		                    else if ProductNumber <> null then ProductNumber
		
		                    else if U <> null and B <> null and U = B then 1
		
		                    else if B = "KG" and Text.Contains(U, "KG") then 1
		
		                    else if B = "LITER"
		                        and (
		                            Text.Contains(U, "LITER")
		                            or Text.Contains(U, "LITRE")
		                            or Text.Contains(U, "LTR")
		                        )
		                    then 1
		
		                    else if B = "EACH"
		                        and (
		                            Text.Contains(U, "EACH")
		                            or Text.Contains(U, "PCS")
		                            or Text.Contains(U, "PC")
		                        )
		                    then 1
		
		                    else null
		            in
		                Result,
		
		    RenameColumns =
		        Table.RenameColumns(
		            Source,
		            {
		                {"Cost Center/Store", "From Location"},
		                {"Transfer To", "To Location"},
		                {"QTY", "Action Qty"},
		                {"Req QTY", "Requested Qty"},
		                {"QTY/BU", "Action Base Qty"},
		                {"P.Price", "Purchase Price"},
		                {"Total", "Line Value"},
		                {"Date", "Requested Delivery Date"},
		                {"Created At", "Request Created DateTime"},
		                {"Created by", "Created By"}
		            },
		            MissingField.Ignore
		        ),
		
		    KeepColumns =
		        Table.SelectColumns(
		            RenameColumns,
		            {
		                "Pos",
		                "SOH",
		                "Article No.",
		                "Article",
		                "Action Qty",
		                "Requested Qty",
		                "Unit",
		                "Base Unit",
		                "Action Base Qty",
		                "Purchase Price",
		                "Line Value",
		                "From Location",
		                "To Location",
		                "Document",
		                "Requested Delivery Date",
		                "Created By",
		                "Request Created DateTime",
		                "Status",
		                "Info"
		            },
		            MissingField.Ignore
		        ),
		
		    CleanTextColumns =
		        Table.TransformColumns(
		            KeepColumns,
		            {
		                {"Article No.", each FxArticleNoText(_), type nullable text},
		                {"Article", each fnCleanText(_), type nullable text},
		                {"Unit", each fnCleanText(_), type nullable text},
		                {"Base Unit", each fnCleanBaseUnit(_), type nullable text},
		                {"From Location", each fnCleanText(_), type nullable text},
		                {"To Location", each fnCleanText(_), type nullable text},
		                {"Document", each if _ = null then null else Text.Trim(Text.Clean(Text.From(_))), type nullable text},
		                {"Created By", each fnCleanText(_), type nullable text},
		                {"Status", each fnCleanText(_), type nullable text},
		                {"Info", each if _ = null then null else Text.From(_), type nullable text}
		            },
		            null,
		            MissingField.Ignore
		        ),
		
		    FilterStatus =
		        Table.SelectRows(
		            CleanTextColumns,
		            each
		                [Status] <> null
		                and [Status] <> ""
		                and [Status] <> "N/A"
		                and [Status] <> "NA"
		        ),
		
		    AddStatusGroup =
		        Table.AddColumn(
		            FilterStatus,
		            "Status Group",
		            each
		                if [Status] = "REQUESTED" then "REQUESTED"
		                else if [Status] = "BOOKED" then "BOOKED"
		                else if [Status] = "DELIVERED" then "DELIVERED"
		                else if [Status] = "DECLINED" then "DECLINED"
		                else if [Status] = "SUSPENDED TRANSFER TO" then "SUSPENDED TRANSFER TO"
		                else "OTHER",
		            type text
		        ),
		
		    CleanDates =
		        Table.TransformColumns(
		            AddStatusGroup,
		            {
		                {"Requested Delivery Date", each fnDateOnly(_), type nullable date}
		            },
		            null,
		            MissingField.Ignore
		        ),
		
		    AddRequestCreatedDate =
		        Table.AddColumn(
		            CleanDates,
		            "Request Created Date",
		            each fnDateOnly([Request Created DateTime]),
		            type nullable date
		        ),
		
		    AddRequestCreatedTime =
		        Table.AddColumn(
		            AddRequestCreatedDate,
		            "Request Created Time",
		            each if [Request Created DateTime] = null then null else Time.From([Request Created DateTime]),
		            type nullable time
		        ),
		
		    AddCutoffBucket =
		        Table.AddColumn(
		            AddRequestCreatedTime,
		            "Request Cutoff Bucket",
		            each
		                if [Request Created Time] = null then "UNKNOWN"
		                else if [Request Created Time] <= #time(15, 0, 0) then "<=3PM"
		                else ">3PM",
		            type text
		        ),
		
		    AddWithinCutoffFlag =
		        Table.AddColumn(
		            AddCutoffBucket,
		            "Within Cutoff Flag",
		            each if [Request Cutoff Bucket] = "<=3PM" then 1 else 0,
		            Int64.Type
		        ),
		
		    ChangeTypes =
		        Table.TransformColumnTypes(
		            AddWithinCutoffFlag,
		            {
		                {"Pos", Int64.Type},
		                {"SOH", type number},
		                {"Article No.", type text},
		                {"Action Qty", type number},
		                {"Requested Qty", type number},
		                {"Action Base Qty", type number},
		                {"Purchase Price", type number},
		                {"Line Value", type number},
		                {"Requested Delivery Date", type date},
		                {"Request Created Date", type date},
		                {"Request Created Time", type time}
		            },
		            "en-US"
		        ),
		
		    AddArticleKey =
		        Table.AddColumn(
		            ChangeTypes,
		            "__Article Key",
		            each fnCleanText([Article]),
		            type nullable text
		        ),
		
		    AddUnitKey =
		        Table.AddColumn(
		            AddArticleKey,
		            "__Unit Key",
		            each fnCleanText([Unit]),
		            type nullable text
		        ),
		
		    UnitDim =
		        let
		            U0 = dim_unit_conversion,
		
		            U1 =
		                if List.Contains(Table.ColumnNames(U0), "Unitkey")
		                then Table.RenameColumns(U0, {{"Unitkey", "Unit Key"}}, MissingField.Ignore)
		                else U0,
		
		            U2 =
		                if List.Contains(Table.ColumnNames(U1), "Unit Key")
		                then U1
		                else Table.AddColumn(U1, "Unit Key", each fnCleanText([Unit String]), type nullable text),
		
		            U3 =
		                Table.TransformColumns(
		                    U2,
		                    {
		                        {"Unit Key", each fnCleanText(_), type nullable text}
		                    },
		                    null,
		                    MissingField.Ignore
		                ),
		
		            U4 =
		                Table.SelectRows(
		                    U3,
		                    each [Unit Key] <> null and [Unit Key] <> ""
		                ),
		
		            U5 =
		                Table.Distinct(
		                    U4,
		                    {"Unit Key"}
		                )
		        in
		            U5,
		
		    MergeUnit =
		        Table.NestedJoin(
		            AddUnitKey,
		            {"__Unit Key"},
		            UnitDim,
		            {"Unit Key"},
		            "Unit Conversion",
		            JoinKind.LeftOuter
		        ),
		
		    ExpandUnit =
		        Table.ExpandTableColumn(
		            MergeUnit,
		            "Unit Conversion",
		            {"Unit Multiplier"},
		            {"Mapped Unit Multiplier"}
		        ),
		
		    AddFallbackUnitMultiplier =
		        Table.AddColumn(
		            ExpandUnit,
		            "Fallback Unit Multiplier",
		            each
		                if [Action Qty] <> null and [Action Qty] <> 0 and [Action Base Qty] <> null
		                then [Action Base Qty] / [Action Qty]
		                else FxMultiplierFromUnit([Unit], [Base Unit]),
		            type nullable number
		        ),
		
		    AddFinalUnitMultiplier =
		        Table.AddColumn(
		            AddFallbackUnitMultiplier,
		            "Unit Multiplier",
		            each
		                if [Mapped Unit Multiplier] <> null then [Mapped Unit Multiplier]
		                else [Fallback Unit Multiplier],
		            type nullable number
		        ),
		
		    AddRequestedBaseQty =
		        Table.AddColumn(
		            AddFinalUnitMultiplier,
		            "Requested Base Qty",
		            each
		                if [Requested Qty] = null then null
		                else if [Unit Multiplier] = null then null
		                else [Requested Qty] * [Unit Multiplier],
		            type nullable number
		        ),
		
		    AddFinalActionBaseQty =
		        Table.AddColumn(
		            AddRequestedBaseQty,
		            "Final Action Base Qty",
		            each
		                if [Action Base Qty] <> null then [Action Base Qty]
		                else if [Action Qty] <> null and [Unit Multiplier] <> null then [Action Qty] * [Unit Multiplier]
		                else null,
		            type nullable number
		        ),
		
		    RemoveOldActionBaseQty =
		        Table.RemoveColumns(
		            AddFinalActionBaseQty,
		            {"Action Base Qty"},
		            MissingField.Ignore
		        ),
		
		    RenameFinalActionBaseQty =
		        Table.RenameColumns(
		            RemoveOldActionBaseQty,
		            {{"Final Action Base Qty", "Action Base Qty"}},
		            MissingField.Ignore
		        ),
		
		    AddUnitMappingStatus =
		        Table.AddColumn(
		            RenameFinalActionBaseQty,
		            "Unit Mapping Status",
		            each if [Unit Multiplier] = null then "Missing Unit Mapping" else "Mapped",
		            type text
		        ),
		
		    AddOOSFlag =
		        Table.AddColumn(
		            AddUnitMappingStatus,
		            "OOS Flag",
		            each
		                if List.Contains({"REQUESTED", "BOOKED"}, [Status Group])
		                    and ([Action Qty] = null or [Action Qty] = 0)
		                then 1
		                else 0,
		            Int64.Type
		        ),
		
		    AddDocumentArticleKey =
		        Table.AddColumn(
		            AddOOSFlag,
		            "Document Article Key",
		            each
		                let
		                    Doc = if [Document] = null then "" else Text.From([Document]),
		                    ArtNo = if [#"Article No."] = null then "" else Text.From([#"Article No."])
		                in
		                    Doc & "|" & ArtNo,
		            type text
		        ),
		
		    AddDocumentLineID =
		        Table.AddColumn(
		            AddDocumentArticleKey,
		            "Document Line ID",
		            each
		                let
		                    Doc = if [Document] = null then "" else Text.From([Document]),
		                    ArtNo = if [#"Article No."] = null then "" else Text.From([#"Article No."]),
		                    Position = if [Pos] = null then "" else Text.From([Pos])
		                in
		                    Doc & "|" & ArtNo & "|" & Position,
		            type text
		        ),
		
		    CategoryByArticleNo =
		        let
		            C0 =
		                Table.SelectColumns(
		                    CategoryLookup,
		                    {"Article_No", "Sub_Category", "Item_Group", "Storage_Type"},
		                    MissingField.Ignore
		                ),
		
		            C1 =
		                Table.TransformColumns(
		                    C0,
		                    {
		                        {"Article_No", each FxArticleNoText(_), type nullable text}
		                    },
		                    null,
		                    MissingField.Ignore
		                ),
		
		            C2 =
		                Table.SelectRows(
		                    C1,
		                    each [Article_No] <> null and [Article_No] <> ""
		                ),
		
		            C3 =
		                Table.Distinct(
		                    C2,
		                    {"Article_No"}
		                )
		        in
		            C3,
		
		    MergeCategoryByArticleNo =
		        Table.NestedJoin(
		            AddDocumentLineID,
		            {"Article No."},
		            CategoryByArticleNo,
		            {"Article_No"},
		            "Category By Article No",
		            JoinKind.LeftOuter
		        ),
		
		    ExpandCategoryByArticleNo =
		        Table.ExpandTableColumn(
		            MergeCategoryByArticleNo,
		            "Category By Article No",
		            {"Sub_Category", "Item_Group", "Storage_Type"},
		            {"Sub_Category_ByNo", "Item_Group_ByNo", "Storage_Type_ByNo"}
		        ),
		
		    CategoryByArticleName =
		        let
		            C0 =
		                Table.SelectColumns(
		                    CategoryLookup,
		                    {"Article", "Sub_Category", "Item_Group", "Storage_Type"},
		                    MissingField.Ignore
		                ),
		
		            C1 =
		                Table.TransformColumns(
		                    C0,
		                    {
		                        {"Article", each fnCleanText(_), type nullable text}
		                    },
		                    null,
		                    MissingField.Ignore
		                ),
		
		            C2 =
		                Table.RenameColumns(
		                    C1,
		                    {{"Article", "Article Key"}},
		                    MissingField.Ignore
		                ),
		
		            C3 =
		                Table.SelectRows(
		                    C2,
		                    each [Article Key] <> null and [Article Key] <> ""
		                ),
		
		            C4 =
		                Table.Distinct(
		                    C3,
		                    {"Article Key"}
		                )
		        in
		            C4,
		
		    MergeCategoryByArticleName =
		        Table.NestedJoin(
		            ExpandCategoryByArticleNo,
		            {"__Article Key"},
		            CategoryByArticleName,
		            {"Article Key"},
		            "Category By Article Name",
		            JoinKind.LeftOuter
		        ),
		
		    ExpandCategoryByArticleName =
		        Table.ExpandTableColumn(
		            MergeCategoryByArticleName,
		            "Category By Article Name",
		            {"Sub_Category", "Item_Group", "Storage_Type"},
		            {"Sub_Category_ByName", "Item_Group_ByName", "Storage_Type_ByName"}
		        ),
		
		    AddSubCategory =
		        Table.AddColumn(
		            ExpandCategoryByArticleName,
		            "Sub_Category",
		            each if [Sub_Category_ByNo] <> null then [Sub_Category_ByNo] else [Sub_Category_ByName],
		            type nullable text
		        ),
		
		    AddItemGroup =
		        Table.AddColumn(
		            AddSubCategory,
		            "Item_Group",
		            each if [Item_Group_ByNo] <> null then [Item_Group_ByNo] else [Item_Group_ByName],
		            type nullable text
		        ),
		
		    AddStorageType =
		        Table.AddColumn(
		            AddItemGroup,
		            "Storage_Type",
		            each if [Storage_Type_ByNo] <> null then [Storage_Type_ByNo] else [Storage_Type_ByName],
		            type nullable text
		        ),
		
		    AddFromLocationKey =
		        Table.AddColumn(
		            AddStorageType,
		            "__From Location Key",
		            each fnCleanText([From Location]),
		            type nullable text
		        ),
		
		    AddToLocationKey =
		        Table.AddColumn(
		            AddFromLocationKey,
		            "__To Location Key",
		            each fnCleanText([To Location]),
		            type nullable text
		        ),
		
		    WarehouseDim =
		        let
		            W0 = dim_warehouse,
		
		            W1 =
		                if List.Contains(Table.ColumnNames(W0), "Warehouse Key")
		                then W0
		                else Table.AddColumn(W0, "Warehouse Key", each fnCleanText([Warehouse]), type nullable text),
		
		            W2 =
		                Table.TransformColumns(
		                    W1,
		                    {
		                        {"Warehouse Key", each fnCleanText(_), type nullable text},
		                        {"Cost Center", each fnCleanText(_), type nullable text}
		                    },
		                    null,
		                    MissingField.Ignore
		                ),
		
		            W3 =
		                Table.SelectRows(
		                    W2,
		                    each [Warehouse Key] <> null and [Warehouse Key] <> ""
		                ),
		
		            W4 =
		                Table.Distinct(
		                    W3,
		                    {"Warehouse Key"}
		                )
		        in
		            W4,
		
		    MergeFromLocation =
		        Table.NestedJoin(
		            AddToLocationKey,
		            {"__From Location Key"},
		            WarehouseDim,
		            {"Warehouse Key"},
		            "From Mapping",
		            JoinKind.LeftOuter
		        ),
		
		    ExpandFromLocation =
		        Table.ExpandTableColumn(
		            MergeFromLocation,
		            "From Mapping",
		            {"Cost Center"},
		            {"From Cost Center"}
		        ),
		
		    MergeToLocation =
		        Table.NestedJoin(
		            ExpandFromLocation,
		            {"__To Location Key"},
		            WarehouseDim,
		            {"Warehouse Key"},
		            "To Mapping",
		            JoinKind.LeftOuter
		        ),
		
		    ExpandToLocation =
		        Table.ExpandTableColumn(
		            MergeToLocation,
		            "To Mapping",
		            {"Cost Center"},
		            {"To Cost Center"}
		        ),
		
		    AddFinalFromCostCenter =
		        Table.AddColumn(
		            ExpandToLocation,
		            "Final From Cost Center",
		            each if [From Cost Center] = null then [From Location] else [From Cost Center],
		            type nullable text
		        ),
		
		    AddFinalToCostCenter =
		        Table.AddColumn(
		            AddFinalFromCostCenter,
		            "Final To Cost Center",
		            each if [To Cost Center] = null then [To Location] else [To Cost Center],
		            type nullable text
		        ),
		
		    RemoveTempColumns =
		        Table.RemoveColumns(
		            AddFinalToCostCenter,
		            {
		                "__Article Key",
		                "__Unit Key",
		                "Mapped Unit Multiplier",
		                "Fallback Unit Multiplier",
		                "Sub_Category_ByNo",
		                "Item_Group_ByNo",
		                "Storage_Type_ByNo",
		                "Sub_Category_ByName",
		                "Item_Group_ByName",
		                "Storage_Type_ByName",
		                "__From Location Key",
		                "__To Location Key",
		                "From Cost Center",
		                "To Cost Center"
		            },
		            MissingField.Ignore
		        ),
		
		    ReorderColumns =
		        Table.ReorderColumns(
		            RemoveTempColumns,
		            {
		                "Document Line ID",
		                "Document Article Key",
		                "Document",
		                "Pos",
		                "Article No.",
		                "Article",
		                "Sub_Category",
		                "Item_Group",
		                "Storage_Type",
		                "From Location",
		                "Final From Cost Center",
		                "To Location",
		                "Final To Cost Center",
		                "Status",
		                "Status Group",
		                "SOH",
		                "Unit",
		                "Base Unit",
		                "Unit Multiplier",
		                "Unit Mapping Status",
		                "Requested Qty",
		                "Requested Base Qty",
		                "Action Qty",
		                "Action Base Qty",
		                "OOS Flag",
		                "Purchase Price",
		                "Line Value",
		                "Requested Delivery Date",
		                "Request Created DateTime",
		                "Request Created Date",
		                "Request Created Time",
		                "Request Cutoff Bucket",
		                "Within Cutoff Flag",
		                "Created By",
		                "Info"
		            },
		            MissingField.Ignore
		        )
		in
		    ReorderColumns
