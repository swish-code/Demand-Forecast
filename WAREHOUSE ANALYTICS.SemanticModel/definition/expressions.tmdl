	annotation PBI_NavigationStepName = Navigation

expression 'SOH Control' =
		let
		    Source = Oracle.Database("192.168.1.99/mc", [HierarchicalNavigation=true, Query="  SELECT   k.KST_NAME AS ""Cost Center/Store"",#(lf)           a.art_nummer AS ""Article No."",#(lf)           a.ART_NAME AS ""Article"",#(lf)           d.day_sohend AS ""ACT SOH"",#(lf)           v.VPK_NAME AS ""Base Unit"",#(lf)           d.day_pricelast AS ""P. Price"",#(lf)           d.day_price AS ""AVE"",#(lf)           d.day_sohend * d.day_price AS ""Total per AVE"",#(lf)           l.la_vkp AS ""S.Price"",#(lf)           d.day_sohend * l.la_vkp AS ""Total S.Price/BU"",#(lf)           l.la_mindestbestand AS ""MIN SOH"",#(lf)           l.la_sollbestand AS ""POT SOH"",#(lf)           z.lgp_name AS ""Storage Location"",#(lf)           v2.VPK_NAME AS ""Unit""#(lf)    FROM   lager l LEFT JOIN #(lf)    LAGERPLATZ z ON l.LGP_nr = z.LGP_ID,#(lf)           artikel a,#(lf)           vpckeinh v,#(lf)           vpckeinh v2,#(lf)           warengruppe w,#(lf)           sparte s,#(lf)           spartegr s1,#(lf)           kostst k,#(lf)           dailytotals d#(lf)   WHERE       a.art_id = l.art_nr#(lf)           AND v.vpk_id = a.vpk_nr#(lf)           AND a.wgr_id = w.wgr_id#(lf)           AND w.spa_id = s.spa_id#(lf)           AND a.vpk_nr2 = v2.vpk_id#(lf)           AND s.sgr_id = s1.sgr_id#(lf)           AND l.kst_id = k.kst_id#(lf)           AND k.kst_index LIKE 'AAAPAB%'#(lf)           AND a.art_notinv = 0#(lf)           AND l.aktiv = ' '#(lf)           AND d.kst_id = l.kst_id#(lf)           AND d.art_id = l.art_nr#(lf)           AND d.day_date = TRUNC (SYSDATE)#(lf)ORDER BY   k.kst_index, a.ART_NAMEID"])
		in
		    Source
	lineageTag: 088c5ee6-03aa-42be-b5f6-68d07ff00f78

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

expression 'Issue Requests & Transfer Grouped' =
		let
		    FromDateText = Date.ToText(Date.From(p_FromDate), "yyyy-MM-dd"),
		
		    Source =
		        Oracle.Database(
		            "192.168.1.99/mc",
		            [
		                HierarchicalNavigation = true,
		                Query =
		                    Text.Combine(
		                        {
		                            "SELECT",
		                            "    MIN(q.""Pos"") AS ""Pos"",",
		                            "    MAX(q.""SOH"") AS ""SOH"",",
		                            "    MIN(q.""Article No."") AS ""Article No."",",
		                            "    q.""Article"" AS ""Article"",",
		                            "    SUM(q.""QTY"") AS ""QTY"",",
		                            "    SUM(q.""Req QTY"") AS ""Req QTY"",",
		                            "    MIN(q.""Unit"") AS ""Unit"",",
		                            "    MIN(q.""Base Unit"") AS ""Base Unit"",",
		                            "    SUM(q.""QTY/BU"") AS ""QTY/BU"",",
		                            "    AVG(q.""AVE"") AS ""AVE"",",
		                            "    AVG(q.""P.Price"") AS ""P.Price"",",
		                            "    SUM(q.""Total"") AS ""Total"",",
		                            "    q.""Cost Center/Store"" AS ""Cost Center/Store"",",
		                            "    q.""Transfer To"" AS ""Transfer To"",",
		                            "    q.""Document"" AS ""Document"",",
		                            "    q.""Date"" AS ""Date"",",
		                            "    MIN(q.""Created by"") AS ""Created by"",",
		                            "    MIN(q.""Created At"") AS ""Created At"",",
		                            "    CASE MIN(q.""Status Priority"")",
		                            "        WHEN 1 THEN 'Delivered'",
		                            "        WHEN 2 THEN 'Booked'",
		                            "        WHEN 3 THEN 'Declined'",
		                            "        WHEN 4 THEN 'Suspended Transfer To'",
		                            "        WHEN 5 THEN 'Requested'",
		                            "        ELSE 'N\A'",
		                            "    END AS ""Status"",",
		                            "    MIN(q.""Info"") AS ""Info"",",
		                            "    COUNT(*) AS ""Source Row Count""",
		                            "FROM",
		                            "(",
		
		                            "SELECT",
		                            "    z.lbp_sort                    AS ""Pos"",",
		                            "    la.la_bestand / v.vpk_grmenge AS ""SOH"",",
		                            "    a.art_nummer                  AS ""Article No."",",
		                            "    a.art_name                    AS ""Article"",",
		                            "    z.lbp_menge                   AS ""QTY"",",
		                            "    z.lbp_req_menge               AS ""Req QTY"",",
		                            "    v.vpk_name                    AS ""Unit"",",
		                            "    vg.vpk_name                   AS ""Base Unit"",",
		                            "    z.lbp_mengege                 AS ""QTY/BU"",",
		                            "    z.lbp_ekp                     AS ""AVE"",",
		                            "    z.lbp_esp                     AS ""P.Price"",",
		                            "    z.lbp_mengege * z.lbp_ekp     AS ""Total"",",
		                            "    k.kst_name                    AS ""Cost Center/Store"",",
		                            "    k1.kst_name                   AS ""Transfer To"",",
		                            "    l.lbw_name                    AS ""Document"",",
		                            "    TRUNC(l.lbw_datum)            AS ""Date"",",
		                            "    b2.bst_name                   AS ""Created by"",",
		                            "    l.new_zeit                    AS ""Created At"",",
		                            "    CASE l.lbw_status",
		                            "        WHEN 40 THEN 'Delivered'",
		                            "        WHEN 12 THEN 'Open Issue Request'",
		                            "        WHEN 24 THEN 'Suspended Transfer To'",
		                            "        WHEN 20 THEN 'Requested'",
		                            "        WHEN 23 THEN 'Requested'",
		                            "        WHEN 36 THEN 'Declined'",
		                            "        WHEN 10 THEN 'Assortment'",
		                            "        ELSE 'N\A'",
		                            "    END                           AS ""Status"",",
		                            "    CASE l.lbw_status",
		                            "        WHEN 40 THEN 1",
		                            "        WHEN 36 THEN 3",
		                            "        WHEN 24 THEN 4",
		                            "        WHEN 20 THEN 5",
		                            "        WHEN 23 THEN 5",
		                            "        ELSE 99",
		                            "    END                           AS ""Status Priority"",",
		                            "    l.lbw_info                    AS ""Info""",
		                            "FROM",
		                            "    lagbewpos z",
		                            "    LEFT OUTER JOIN lager la ON z.kst_id = la.kst_id",
		                            "                              AND z.la_typ = la.la_typ",
		                            "                              AND z.art_nr = la.art_nr",
		                            "                              AND la.aktiv = ' ',",
		                            "    artikel a,",
		                            "    warengruppe w,",
		                            "    vpckeinh v,",
		                            "    vpckeinh vg,",
		                            "    lagerbew l",
		                            "    LEFT OUTER JOIN besteller owner ON l.lbw_owner = owner.bst_id,",
		                            "    kostst k,",
		                            "    kostst k1,",
		                            "    besteller b1,",
		                            "    besteller b2",
		                            "WHERE",
		                            "        k1.kst_id = l.kst_id1",
		                            "    AND k.kst_id = l.kst_id",
		                            "    AND b1.bst_id = l.chg_user",
		                            "    AND b2.bst_id = l.new_user",
		                            "    AND z.la_typ = 0",
		                            "    AND a.art_id = z.art_nr",
		                            "    AND w.wgr_id = a.wgr_id",
		                            "    AND v.vpk_id = z.vpk_id",
		                            "    AND vg.vpk_id = v.vpk_grund",
		                            "    AND k.kst_id = z.kst_id",
		                            "    AND z.lbw_id = l.lbw_id",
		                            "    AND l.lbw_status NOT IN (10, 51, 12)",
		                            "    AND TRUNC(l.lbw_datum) >= TO_DATE('" & FromDateText & "', 'YYYY-MM-DD')",
		
		                            "UNION ALL",
		
		                            "SELECT",
		                            "    z.lbp_sort                    AS ""Pos"",",
		                            "    la.la_bestand / v.vpk_grmenge AS ""SOH"",",
		                            "    a.art_nummer                  AS ""Article No."",",
		                            "    a.art_name                    AS ""Article"",",
		                            "    z.lbp_menge                   AS ""QTY"",",
		                            "    z.lbp_req_menge               AS ""Req QTY"",",
		                            "    v.vpk_name                    AS ""Unit"",",
		                            "    vg.vpk_name                   AS ""Base Unit"",",
		                            "    z.lbp_mengege                 AS ""QTY/BU"",",
		                            "    z.lbp_ekp                     AS ""AVE"",",
		                            "    z.lbp_esp                     AS ""P.Price"",",
		                            "    z.lbp_mengege * z.lbp_ekp     AS ""Total"",",
		                            "    k.kst_name                    AS ""Cost Center/Store"",",
		                            "    k1.kst_name                   AS ""Transfer To"",",
		                            "    l.lbw_name                    AS ""Document"",",
		                            "    TRUNC(l.lbw_datum)            AS ""Date"",",
		                            "    b2.bst_name                   AS ""Created by"",",
		                            "    l.new_zeit                    AS ""Created At"",",
		                            "    CASE l.lbw_status",
		                            "        WHEN 51 THEN 'Booked'",
		                            "        ELSE 'N\A'",
		                            "    END                           AS ""Status"",",
		                            "    CASE l.lbw_status",
		                            "        WHEN 51 THEN 2",
		                            "        ELSE 99",
		                            "    END                           AS ""Status Priority"",",
		                            "    l.lbw_info                    AS ""Info""",
		                            "FROM",
		                            "    his_lagbewpos z",
		                            "    LEFT OUTER JOIN lager la ON z.kst_id = la.kst_id",
		                            "                              AND z.la_typ = la.la_typ",
		                            "                              AND z.art_nr = la.art_nr",
		                            "                              AND la.aktiv = ' ',",
		                            "    artikel a,",
		                            "    warengruppe w,",
		                            "    vpckeinh v,",
		                            "    vpckeinh vg,",
		                            "    his_lagerbew l",
		                            "    LEFT OUTER JOIN besteller owner ON l.lbw_owner = owner.bst_id,",
		                            "    kostst k,",
		                            "    kostst k1,",
		                            "    besteller b1,",
		                            "    besteller b2",
		                            "WHERE",
		                            "        k1.kst_id = l.kst_id1",
		                            "    AND k.kst_id = l.kst_id",
		                            "    AND b1.bst_id = l.chg_user",
		                            "    AND b2.bst_id = l.new_user",
		                            "    AND z.la_typ = 0",
		                            "    AND a.art_id = z.art_nr",
		                            "    AND w.wgr_id = a.wgr_id",
		                            "    AND v.vpk_id = z.vpk_id",
		                            "    AND vg.vpk_id = v.vpk_grund",
		                            "    AND k.kst_id = z.kst_id",
		                            "    AND l.lbw_status = 51",
		                            "    AND z.lbw_id = l.lbw_id",
		                            "    AND l.lbw_status <> 10",
		                            "    AND TRUNC(l.lbw_datum) >= TO_DATE('" & FromDateText & "', 'YYYY-MM-DD')",
		
		                            ") q",
		                            "GROUP BY",
		                            "    q.""Document"",",
		                            "    q.""Cost Center/Store"",",
		                            "    q.""Transfer To"",",
		                            "    q.""Date"",",
		                            "    q.""Article""",
		                            "ORDER BY",
		                            "    q.""Date"",",
		                            "    q.""Document"",",
		                            "    q.""Article"""
		                        },
		                        "#(lf)"
		                    )
		            ]
		        ),
		
		    #"Changed Type" =
		        Table.TransformColumnTypes(
		            Source,
		            {
		                {"Pos", Int64.Type},
		                {"SOH", type number},
		                {"Article No.", Int64.Type},
		                {"Article", type text},
		                {"QTY", type number},
		                {"Req QTY", type number},
		                {"Unit", type text},
		                {"Base Unit", type text},
		                {"QTY/BU", type number},
		                {"AVE", type number},
		                {"P.Price", type number},
		                {"Total", type number},
		                {"Cost Center/Store", type text},
		                {"Transfer To", type text},
		                {"Document", type text},
		                {"Date", type date},
		                {"Created by", type text},
		                {"Created At", type datetime},
		                {"Status", type text},
		                {"Info", type text},
		                {"Source Row Count", Int64.Type}
		            }
		        )
		in
		    #"Changed Type"
	lineageTag: da63d5e2-412b-4b19-a745-46403a84d5d0

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

expression 'Issue Requests & Transfer' =
		let
		    Source = Oracle.Database(
		        "192.168.1.99/mc",
		        [
		            HierarchicalNavigation = true,
		            Query = Text.Combine(
		                {
		                    "SELECT",
		                    "    z.lbp_sort                    AS ""Pos"",",
		                    "    la.la_bestand / v.vpk_grmenge AS ""SOH"",",
		                    "    a.art_nummer                  AS ""Article No."",",
		                    "    a.art_name                    AS ""Article"",",
		                    "    z.lbp_menge                   AS ""QTY"",",
		                    "    z.lbp_req_menge               AS ""Req QTY"",",
		                    "    v.vpk_name                    AS ""Unit"",",
		                    "    vg.vpk_name                   AS ""Base Unit"",",
		                    "    z.lbp_mengege                 AS ""QTY/BU"",",
		                    "    z.lbp_ekp                     AS ""AVE"",",
		                    "    z.lbp_esp                     AS ""P.Price"",",
		                    "    z.lbp_mengege * z.lbp_ekp     AS ""Total"",",
		                    "    k.kst_name                    AS ""Cost Center/Store"",",
		                    "    k1.kst_name                   AS ""Transfer To"",",
		                    "    l.lbw_name                    AS ""Document"",",
		                    "    l.lbw_datum                   AS ""Date"",",
		                    "    b2.bst_name                   AS ""Created by"",",
		                    "    l.new_zeit                    AS ""Created At"",",
		                    "    CASE l.lbw_status",
		                    "        WHEN 40 THEN 'Delivered'",
		                    "        WHEN 12 THEN 'Open Issue Request'",
		                    "        WHEN 24 THEN 'Suspended Transfer To'",
		                    "        WHEN 20 THEN 'Requested'",
		                    "        WHEN 23 THEN 'Requested'",
		                    "        WHEN 36 THEN 'Declined'",
		                    "        WHEN 10 THEN 'Assortment'",
		                    "        ELSE 'N\A'",
		                    "    END                           AS ""Status"",",
		                    "    l.lbw_info                    AS ""Info""",
		                    "FROM",
		                    "    lagbewpos z",
		                    "    LEFT OUTER JOIN lager la ON z.kst_id = la.kst_id",
		                    "                              AND z.la_typ = la.la_typ",
		                    "                              AND z.art_nr = la.art_nr",
		                    "                              AND la.aktiv = ' ',",
		                    "    artikel a,",
		                    "    warengruppe w,",
		                    "    vpckeinh v,",
		                    "    vpckeinh vg,",
		                    "    lagerbew l",
		                    "    LEFT OUTER JOIN besteller owner ON l.lbw_owner = owner.bst_id,",
		                    "    kostst k,",
		                    "    kostst k1,",
		                    "    besteller b1,",
		                    "    besteller b2",
		                    "WHERE",
		                    "        k1.kst_id = l.kst_id1",
		                    "    AND k.kst_id = l.kst_id",
		                    "    AND b1.bst_id = l.chg_user",
		                    "    AND b2.bst_id = l.new_user",
		                    "    AND z.la_typ = 0",
		                    "    AND a.art_id = z.art_nr",
		                    "    AND w.wgr_id = a.wgr_id",
		                    "    AND v.vpk_id = z.vpk_id",
		                    "    AND vg.vpk_id = v.vpk_grund",
		                    "    AND k.kst_id = z.kst_id",
		                    "    AND z.lbw_id = l.lbw_id",
		                    "    AND l.lbw_status NOT IN (10, 51, 12)",
		                    "",
		                    "UNION ALL",
		                    "",
		                    "SELECT",
		                    "    z.lbp_sort                    AS ""Pos"",",
		                    "    la.la_bestand / v.vpk_grmenge AS ""SOH"",",
		                    "    a.art_nummer                  AS ""Article No."",",
		                    "    a.art_name                    AS ""Article"",",
		                    "    z.lbp_menge                   AS ""QTY"",",
		                    "    z.lbp_req_menge               AS ""Req QTY"",",
		                    "    v.vpk_name                    AS ""Unit"",",
		                    "    vg.vpk_name                   AS ""Base Unit"",",
		                    "    z.lbp_mengege                 AS ""QTY/BU"",",
		                    "    z.lbp_ekp                     AS ""AVE"",",
		                    "    z.lbp_esp                     AS ""P.Price"",",
		                    "    z.lbp_mengege * z.lbp_ekp     AS ""Total"",",
		                    "    k.kst_name                    AS ""Cost Center/Store"",",
		                    "    k1.kst_name                   AS ""Transfer To"",",
		                    "    l.lbw_name                    AS ""Document"",",
		                    "    l.lbw_datum                   AS ""Date"",",
		                    "    b2.bst_name                   AS ""Created by"",",
		                    "    l.new_zeit                    AS ""Created At"",",
		                    "    CASE l.lbw_status",
		                    "        WHEN 51 THEN 'Booked'",
		                    "        ELSE 'N\A'",
		                    "    END                           AS ""Status"",",
		                    "    l.lbw_info                    AS ""Info""",
		                    "FROM",
		                    "    his_lagbewpos z",
		                    "    LEFT OUTER JOIN lager la ON z.kst_id = la.kst_id",
		                    "                              AND z.la_typ = la.la_typ",
		                    "                              AND z.art_nr = la.art_nr",
		                    "                              AND la.aktiv = ' ',",
		                    "    artikel a,",
		                    "    warengruppe w,",
		                    "    vpckeinh v,",
		                    "    vpckeinh vg,",
		                    "    his_lagerbew l",
		                    "    LEFT OUTER JOIN besteller owner ON l.lbw_owner = owner.bst_id,",
		                    "    kostst k,",
		                    "    kostst k1,",
		                    "    besteller b1,",
		                    "    besteller b2",
		                    "WHERE",
		                    "        k1.kst_id = l.kst_id1",
		                    "    AND k.kst_id = l.kst_id",
		                    "    AND b1.bst_id = l.chg_user",
		                    "    AND b2.bst_id = l.new_user",
		                    "    AND z.la_typ = 0",
		                    "    AND a.art_id = z.art_nr",
		                    "    AND w.wgr_id = a.wgr_id",
		                    "    AND v.vpk_id = z.vpk_id",
		                    "    AND vg.vpk_id = v.vpk_grund",
		                    "    AND k.kst_id = z.kst_id",
		                    "    AND l.lbw_status = 51",
		                    "    AND z.lbw_id = l.lbw_id",
		                    "    AND l.lbw_status <> 10"
		                },
		                "#(lf)"
		            )
		        ]
		    ),
		
		    #"Changed Type" = Table.TransformColumnTypes(
		        Source,
		        {
		            {"Pos", Int64.Type},
		            {"SOH", type number},
		            {"Article No.", Int64.Type},
		            {"Article", type text},
		            {"QTY", type number},
		            {"Req QTY", type number},
		            {"Unit", type text},
		            {"Base Unit", type text},
		            {"QTY/BU", type number},
		            {"AVE", type number},
		            {"P.Price", type number},
		            {"Total", type number},
		            {"Cost Center/Store", type text},
		            {"Transfer To", type text},
		            {"Document", type text},
		            {"Date", type date},
		            {"Created by", type text},
		            {"Created At", type datetime},
		            {"Status", type text},
		            {"Info", type text}
		        }
		    ),
		
		    #"Filtered Date Range" = Table.SelectRows(
		        #"Changed Type",
		        each [Date] <> null and Date.From([Date]) >= p_FromDate
		    )
		in
		    #"Filtered Date Range"
	lineageTag: 5c3440b4-bd57-4a53-a53a-1020bb3cc589

