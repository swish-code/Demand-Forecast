expression CategoryLookup =
		let
		    Source = Excel.Workbook(
		        Web.Contents("https://etckuwait-my.sharepoint.com/personal/thalbish_swishhh_net/Documents/RECIPIES%20TEST.xlsm"),
		        null,
		        true
		    ),
		
		    ReplenPlanning_Sheet = Source{[Item="Replen Planning", Kind="Sheet"]}[Data],
		
		    PromotedHeaders1 = Table.PromoteHeaders(ReplenPlanning_Sheet, [PromoteAllScalars=true]),
		
		    RemovedTopRows = Table.Skip(PromotedHeaders1, 7),
		
		    PromotedHeaders = Table.PromoteHeaders(RemovedTopRows, [PromoteAllScalars=true]),
		
		    ChangedType = Table.TransformColumnTypes(PromotedHeaders,{{"Article No.", type text}, {"CODE", type text}, {"ITEM DESCRIPTION", type text}, {"BASE UNIT", type text}, {"IS ACTIVE", type text}, {"Designation", type any}, {"SubCAT", type text}, {"Current WHS ID", type any}, {"ITEM GROUP", type text}, {"STORAGE TYPE", type text}}),
		
		    RemovedColumns = Table.RemoveColumns(ChangedType,{"CODE", "Designation", "Current WHS ID", "PURCH UNIT", "CURRENT STOCK WAC", "TOTAL WAC MTD", "LEAD TIME", "open delivery note", "TRF OUT Delivered & Declined", "CURRENT STOCK", "Actual SOH", "Last PP", "Last PD", "Last TR", "12/25/2025", "1/26/2026", "2/26/2026", "3/26/2026", "MIN", "MAX", "AVG TRANSFER OUT", "WEIGHT MIN", "WEIGHT MAX", "DAYS TO LAST (DTL)", "ReqDate", "ReceinvgDate", "OOS DATE", "CURRENT MONTH - MTD TRANSFER", "MTD XTRAPOL % vs. AVG TRANSFER", "MTD #(lf)DAYS TO LAST", "MTD OOS", "Target Cover", "% Increase", "QTY", "QTY MTD", "Delivery#(lf)Freq", "Delivery Date 1", "Delivery Date 2", "Delivery Date 3", "Delivery Date 4", "Delivery Date 5", "Delivery Date 6", "PIPELINE PENDNG PO", "last Supplier Name", "Status", "WEEK2 PROJ STOCK AVG", "WEEK2 PROJ DTL AVG", "WEEK4 QTY REPLEN", "WEEK4 PROJ STOCK", "WEEK4 PROJ DTL", "WEEK6 QTY REPLEN", "W6 PIPELINE PENDNG PO", "WEEK6 PROJ STOCK", "WEEK6 PROJ DTL", "WEEK8 QTY REPLEN", "WEEK8 PROJ STOCK", "WEEK8 PROJ DTL", "WEEK10 QTY REPLEN", "W10 PIPELINE PENDNG PO", "WEEK10 PROJ STOCK", "WEEK10 PROJ DTL", "WEEK12 QTY REPLEN", "WEEK12 PROJ STOCK", "WEEK12 PROJ DTL", "OOS, <3DTL, <7DTL,<15DTL", "Current Common", "Column74", "Column75"}),
		
		    TrimmedText = Table.TransformColumns(RemovedColumns,{
		        {"ITEM DESCRIPTION", Text.Trim, type text},
		        {"BASE UNIT", Text.Trim, type text},
		        {"SubCAT", Text.Trim, type text},
		        {"ITEM GROUP", Text.Trim, type text},
		        {"STORAGE TYPE", Text.Trim, type text}
		    }),
		
		    CleanedText = Table.TransformColumns(TrimmedText,{
		        {"ITEM DESCRIPTION", Text.Clean, type text},
		        {"BASE UNIT", Text.Clean, type text},
		        {"SubCAT", Text.Clean, type text},
		        {"ITEM GROUP", Text.Clean, type text},
		        {"STORAGE TYPE", Text.Clean, type text}
		    }),
		
		    RemovedDuplicates = Table.Distinct(CleanedText, {"ITEM DESCRIPTION"}),
		
		    RenamedColumns = Table.RenameColumns(RemovedDuplicates,{
		        {"Article No.", "Article_No"},
		        {"ITEM DESCRIPTION", "Article"},
		        {"BASE UNIT", "Base_Unit"},
		        {"IS ACTIVE", "Is_Active"},
		        {"SubCAT", "Sub_Category"},
		        {"ITEM GROUP", "Item_Group"},
		        {"STORAGE TYPE", "Storage_Type"}
		    }),
		    #"Changed Type" = Table.TransformColumnTypes(RenamedColumns,{{"Article_No", type text}, {"Article", type text}, {"Base_Unit", type text}, {"Is_Active", type text}, {"Sub_Category", type text}, {"Item_Group", type text}, {"Storage_Type", type text}})
		in
		    #"Changed Type"
	lineageTag: 1a810c50-f91d-4b03-9363-c8e899d6f8ff

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

expression fact_po_period_base =
		let
		    Source = fact_po_line,
		
		    FilteredRows =
		        Table.SelectRows(
		            Source,
		            each
		                [PO Unit Mapping Status] = "Mapped"
		                and [Article] <> null
		                and [Warehouse] <> null
		                and [PO Delivery Date] <> null
		                and [PO Base Qty] <> null
		        ),
		
		    GroupedPO =
		        Table.Group(
		            FilteredRows,
		            {"Article", "Warehouse", "PO Delivery Date"},
		            {
		                {"Final Cost Center", each try List.First(List.RemoveNulls([Final Cost Center])) otherwise null, type nullable text},
		                {"PO No", each try Text.Combine(List.Sort(List.Distinct(List.RemoveNulls([PO No]))), ", ") otherwise null, type nullable text},
		                {"PO Supplier", each try if List.Count(List.Distinct(List.RemoveNulls([Supplier]))) = 1 then List.First(List.Distinct(List.RemoveNulls([Supplier]))) else "MULTIPLE" otherwise null, type nullable text},
		                {"PO Supplier List", each try Text.Combine(List.Distinct(List.RemoveNulls([Supplier])), ", ") otherwise null, type nullable text},
		                {"PO Unit List", each try Text.Combine(List.Distinct(List.RemoveNulls([PO Unit])), ", ") otherwise null, type nullable text},
		                {"PO Base Unit List", each try Text.Combine(List.Distinct(List.RemoveNulls([PO Base Unit])), ", ") otherwise null, type nullable text},
		                {"PO Date", each try Date.From(List.Min(List.RemoveNulls([PO Date]))) otherwise null, type nullable date},
		                {"PO Base Qty", each List.Sum(List.RemoveNulls([PO Base Qty])), type nullable number},
		                {"PO Value", each List.Sum(List.RemoveNulls([PO Value])), type nullable number},
		                {"PO Count", each List.Count(List.Distinct(List.RemoveNulls([PO No]))), Int64.Type},
		                {"PO Line Count", each Table.RowCount(_), Int64.Type},
		                {"Sub_Category", each try List.First(List.RemoveNulls([Sub_Category])) otherwise null, type nullable text},
		                {"Item_Group", each try List.First(List.RemoveNulls([Item_Group])) otherwise null, type nullable text},
		                {"Storage_Type", each try List.First(List.RemoveNulls([Storage_Type])) otherwise null, type nullable text}
		            }
		        ),
		
		    RenamedDate =
		        Table.RenameColumns(
		            GroupedPO,
		            {{"PO Delivery Date", "PO Start Date"}}
		        ),
		
		    GRNFiltered =
		        Table.SelectRows(
		            fact_grn_line,
		            each
		                [Article] <> null
		                and [Warehouse] <> null
		                and [GRN Delivery Date] <> null
		        ),
		
		    GRNMaxByArticleWarehouse =
		        Table.Group(
		            GRNFiltered,
		            {"Article", "Warehouse"},
		            {
		                {"Last Relevant GRN Date", each List.Max(List.RemoveNulls([GRN Delivery Date])), type nullable date}
		            }
		        ),
		
		    MergeLastGRN =
		        Table.NestedJoin(
		            RenamedDate,
		            {"Article", "Warehouse"},
		            GRNMaxByArticleWarehouse,
		            {"Article", "Warehouse"},
		            "GRN Max",
		            JoinKind.LeftOuter
		        ),
		
		    ExpandLastGRN =
		        Table.ExpandTableColumn(
		            MergeLastGRN,
		            "GRN Max",
		            {"Last Relevant GRN Date"},
		            {"Last Relevant GRN Date"}
		        ),
		
		    SortedRows =
		        Table.Sort(
		            ExpandLastGRN,
		            {
		                {"Article", Order.Ascending},
		                {"Warehouse", Order.Ascending},
		                {"PO Start Date", Order.Ascending}
		            }
		        ),
		
		    GroupedForNextDate =
		        Table.Group(
		            SortedRows,
		            {"Article", "Warehouse"},
		            {
		                {
		                    "Data",
		                    each
		                        let
		                            T = Table.Sort(_, {{"PO Start Date", Order.Ascending}}),
		                            AddIndex = Table.AddIndexColumn(T, "__Index", 0, 1, Int64.Type),
		                            AddNextDate =
		                                Table.AddColumn(
		                                    AddIndex,
		                                    "Next PO Date",
		                                    each try AddIndex[PO Start Date]{[__Index] + 1} otherwise null,
		                                    type nullable date
		                                ),
		                            RemoveIndex = Table.RemoveColumns(AddNextDate, {"__Index"})
		                        in
		                            RemoveIndex
		                }
		            }
		        ),
		
		    Expanded =
		        Table.ExpandTableColumn(
		            GroupedForNextDate,
		            "Data",
		            List.RemoveItems(Table.ColumnNames(SortedRows), {"Article", "Warehouse"}) & {"Next PO Date"}
		        ),
		
		    AddedPOEndDate =
		        Table.AddColumn(
		            Expanded,
		            "PO End Date",
		            each
		                if [Next PO Date] <> null then Date.AddDays([Next PO Date], -1)
		                else if [Last Relevant GRN Date] <> null and [Last Relevant GRN Date] >= [PO Start Date] then [Last Relevant GRN Date]
		                else [PO Start Date],
		            type date
		        ),
		
		    AddedPOPeriodID =
		        Table.AddColumn(
		            AddedPOEndDate,
		            "PO Period ID",
		            each [Article] & "|" & [Warehouse] & "|" & Date.ToText([PO Start Date], "yyyyMMdd"),
		            type text
		        ),
		
		    RemovedHelperColumns =
		        Table.RemoveColumns(
		            AddedPOPeriodID,
		            {"Last Relevant GRN Date"},
		            MissingField.Ignore
		        ),
		
		    ReorderedColumns =
		        Table.ReorderColumns(
		            RemovedHelperColumns,
		            {
		                "PO Period ID",
		                "Article",
		                "Warehouse",
		                "Final Cost Center",
		                "PO No",
		                "PO Supplier",
		                "PO Supplier List",
		                "PO Unit List",
		                "PO Base Unit List",
		                "PO Date",
		                "PO Start Date",
		                "Next PO Date",
		                "PO End Date",
		                "PO Base Qty",
		                "PO Value",
		                "PO Count",
		                "PO Line Count",
		                "Sub_Category",
		                "Item_Group",
		                "Storage_Type"
		            },
		            MissingField.Ignore
		        )
		in
		    ReorderedColumns
	lineageTag: de6d218d-2273-4a85-a574-7c2ff2f80ad0

