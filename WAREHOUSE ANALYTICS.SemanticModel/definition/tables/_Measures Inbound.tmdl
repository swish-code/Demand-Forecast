	measure 'Measure 2'
		lineageTag: aef81a24-64e2-4283-bdce-d69a25954178

		annotation 43dbc3e8-3a1c-4b6f-9923-b49ff7d6691c = True

	measure 'Mixed PO Supplier PO Periods' =
			
			COUNTROWS(
			    FILTER(
			        'fact_po_period_lifecycle',
			        'fact_po_period_lifecycle'[PO Supplier] = "MULTIPLE"
			    )
			)
		formatString: 0
		lineageTag: 980d359b-166c-4d4d-9969-d57b3b5c7fbc

	measure 'Supplier Mismatch PO Periods' =
			
			COUNTROWS(
			    FILTER(
			        'fact_po_period_lifecycle',
			        NOT ISBLANK('fact_po_period_lifecycle'[PO Supplier])
			            && NOT ISBLANK('fact_po_period_lifecycle'[Actual GRN Supplier])
			            && 'fact_po_period_lifecycle'[PO Supplier] <> "MULTIPLE"
			            && 'fact_po_period_lifecycle'[Actual GRN Supplier] <> "MULTIPLE"
			            && 'fact_po_period_lifecycle'[PO Supplier]
			                <> 'fact_po_period_lifecycle'[Actual GRN Supplier]
			    )
			)
		formatString: 0
		lineageTag: 6ac4b196-ddbc-45a0-a920-444a66344522

	measure 'Supplier Mismatch %' =
			
			DIVIDE(
			    [Supplier Mismatch PO Periods],
			    [Total PO Periods],
			    0
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: cd84db74-1a56-4cd7-9020-78b1d9900d74

	measure 'Supplier Mismatch text' =
			
			VAR _Count = [Supplier Mismatch PO Periods]
			VAR _Pct =
			    DIVIDE(
			        _Count,
			        [Total PO Periods],
			        0
			    )
			RETURN
			FORMAT(_Count, "#,##0")
			    & " ("
			    & FORMAT(_Pct, "0.0%")
			    & ")"
		lineageTag: c29266ab-125a-43d1-8cd7-2052882247cc

	measure 'Mixed Supplier Summary text' =
			
			VAR _MixedPO = [Mixed PO Supplier PO Periods]
			VAR _MixedActual = [Mixed Actual Supplier PO Periods]
			RETURN
			"Mixed PO Supplier: " & FORMAT(_MixedPO, "#,##0")
			    & UNICHAR(10) &
			"Mixed Actual Supplier: " & FORMAT(_MixedActual, "#,##0")
		lineageTag: 14dffccc-385b-4d65-9a41-29c2c8f8a888

	measure 'Next Scheduled Refresh' =
			
			VAR CurrentDateTime =
			    UTCNOW() + TIME(3, 0, 0)
			
			VAR CurrentDate =
			    DATE(
			        YEAR(CurrentDateTime),
			        MONTH(CurrentDateTime),
			        DAY(CurrentDateTime)
			    )
			
			VAR CurrentTimeOnly =
			    TIME(
			        HOUR(CurrentDateTime),
			        MINUTE(CurrentDateTime),
			        SECOND(CurrentDateTime)
			    )
			
			VAR RefreshTimes =
			    {
			        TIME(1, 0, 0),
			        TIME(4, 0, 0),
			        TIME(9, 0, 0),
			        TIME(10, 0, 0),
			        TIME(11, 0, 0),
			        TIME(13, 30, 0),
			        TIME(15, 0, 0),
			        TIME(18, 0, 0)
			    }
			
			VAR NextTimeToday =
			    MINX(
			        FILTER(
			            RefreshTimes,
			            [Value] > CurrentTimeOnly
			        ),
			        [Value]
			    )
			
			VAR FirstTimeTomorrow =
			    MINX(
			        RefreshTimes,
			        [Value]
			    )
			
			VAR NextRefresh =
			    IF(
			        NOT ISBLANK(NextTimeToday),
			        CurrentDate + NextTimeToday,
			        CurrentDate + 1 + FirstTimeTomorrow
			    )
			
			RETURN
			    "Next Refresh : "
			        & FORMAT(
			            NextRefresh,
			            "M/d/yyyy h:mm AM/PM"
			        )
		lineageTag: 5d7d998e-902d-4a24-9aa3-a47027beb9c6

