	measure 'Inbound Qty Variance' =
			
			[Inbound GRN Qty] - [Inbound Requested Qty]
		formatString: #,0.0
		lineageTag: b97bb9a4-3a4d-437a-9882-ebf45c7db268

	measure 'Inbound Fill Rate %' =
			
			DIVIDE(
			    [Inbound GRN Qty],
			    [Inbound Requested Qty],
			    0
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 94e440cc-8497-44d9-809a-28db84095df7

	measure 'Inbound Capped Fill Rate %' =
			
			DIVIDE(
			    SUMX(
			        'fact_po_period_lifecycle',
			        MIN(
			            'fact_po_period_lifecycle'[PO Base Qty],
			            'fact_po_period_lifecycle'[Allocated GRN Base Qty]
			        )
			    ),
			    [Inbound Requested Qty],
			    0
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 80fe43ce-2fb8-4470-b99c-8e4cb937a560

	measure 'Inbound Pending %' =
			
			DIVIDE(
			    [Inbound Pending Qty],
			    [Inbound Requested Qty],
			    0
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 4ed24bc2-7105-4fc1-86ec-caa13caf80c8

	measure 'Inbound Over Delivery %' =
			
			DIVIDE(
			    [Inbound Over Delivered Qty],
			    [Inbound Requested Qty],
			    0
			)
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 86dc3299-7394-43c6-a3f3-77abaa799a82

	measure 'Inbound PO Period Count' =
			
