		lineageTag: 96bb45d7-5faf-4e8a-972a-54b89ce18397

	measure 'Inbound In Full %' =
			
			DIVIDE(
			    COALESCE([Inbound In Full Count], 0),
			    COALESCE([Inbound PO Period Count], 0),
