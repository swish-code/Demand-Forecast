		formatString: #,0
		lineageTag: 6a02a80a-a20b-4bf5-af58-4816205a76ff

	measure 'Inbound In Full Count' =
			
			COUNTROWS(
			    FILTER(
			        'fact_po_period_lifecycle',
			        'fact_po_period_lifecycle'[In Full Flag] = 1
			    )
			)
