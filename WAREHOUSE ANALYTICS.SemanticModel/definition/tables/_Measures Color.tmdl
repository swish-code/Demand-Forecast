table '_Measures Color'
	lineageTag: 947b9be9-ba27-4e53-81ce-609d24c63fb4

	measure 'Inbound Fill Rate Color' =
			
			VAR Rate = [Inbound Fill Rate %]
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(Rate), "#B0B0B0",        -- Grey (No Data)
			    Rate >= 0.90, "#2E7D32",         -- Green (Excellent)
			    Rate >= 0.75, "#F9A825",         -- Yellow (Good)
			    Rate >= 0.50, "#FB8C00",         -- Orange (Warning)
			    "#D32F2F"                        -- Red (Poor)
			)
		lineageTag: fba3cd04-3f50-4409-9839-9a6d5ff7b56c

	measure 'Inbound Pending Color' =
			
			VAR Rate = [Inbound Pending %]
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(Rate), "#B0B0B0",        -- Grey (No Data)
			    Rate <= 0.10, "#2E7D32",         -- Green (Excellent)
			    Rate <= 0.25, "#F9A825",         -- Yellow (Acceptable)
			    Rate <= 0.50, "#FB8C00",         -- Orange (Warning)
			    "#D32F2F"                        -- Red (Critical)
			)
		lineageTag: 26b768da-ced3-4f9c-b62b-51a0ddbcee5a

	measure 'Supplier Mismatch Color' =
			
			VAR _Pct =
			    DIVIDE(
			        [Supplier Mismatch PO Periods],
			        [Total PO Periods],
			        0
			    )
			RETURN
			IF(
			    _Pct > 0.01,
			    "#C00000",    -- Dark Red
			    "#70AD47"     -- Dark Green
			)
		lineageTag: fab3b2f2-b416-412c-b2cc-1575133a9396

	measure 'Fulfillment Status Color' =
			
			SWITCH(
			    SELECTEDVALUE('fact_po_period_lifecycle'[Fulfillment Status]),
			    "Fully Delivered", "#22C55E",     -- Modern Green
			    "Over Delivered", "#3B82F6",      -- Modern Blue
			    "Partially Delivered", "#F59E0B", -- Amber
			    "Not Received", "#EF4444",        -- Modern Red
			    "#9CA3AF"                         -- Grey
			)
		lineageTag: 35cf3e2b-0d08-409a-a78b-ed9024f9d692

	measure 'Outbound % Vouchers <eq 3PM Color' =
			
