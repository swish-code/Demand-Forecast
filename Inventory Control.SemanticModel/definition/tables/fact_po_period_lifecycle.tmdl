	column 'Absorbed Outside Period GRN Flag'
		dataType: int64
		formatString: 0
		lineageTag: 0ef92b89-b5d6-4185-b9f2-bd1b265c5f9e
		summarizeBy: sum
		sourceColumn: Absorbed Outside Period GRN Flag

		annotation SummarizationSetBy = Automatic

	partition fact_po_period_lifecycle = m
		mode: import
		source =
				let
				    PO = fact_po_period_base,
				    GRN = agg_grn_by_po_period,
				    GRNDetail = fact_grn_allocated_detail,
				    RecoveredLifecycle = fact_grn_recovered_lifecycle,
				
				    FxSafeText =
				        (x as any) as text =>
				            try
				                if x = null then ""
				                else Text.Trim(Text.Clean(Text.From(x)))
				            otherwise "",
				
				    FxUpperText =
				        (x as any) as text =>
				            Text.Upper(FxSafeText(x)),
				
				    FxDate =
				        (x as any) as nullable date =>
				            try Date.From(x) otherwise null,
				
				    FxDateTime =
				        (x as any) as nullable datetime =>
				            try DateTime.From(x) otherwise null,
				
				    FxNum =
				        (x as any) as nullable number =>
				            try Number.From(x) otherwise null,
				
				    FxNumZero =
				        (x as any) as number =>
				            let
				                N = FxNum(x)
				            in
				                if N = null then 0 else N,
				
				    FxHasPONo =
				        (PONo as any) as logical =>
				            let
				                T = FxUpperText(PONo)
				            in
				                T <> ""
				                    and T <> "NO PO DEFINED"
				                    and T <> "NO_PO"
				                    and T <> "N/A"
				                    and T <> "NA"
				                    and T <> "NULL",
				
				    FxLifecycleKey =
				        (PONo as any, Article as any, Warehouse as any) as text =>
				            FxUpperText(PONo)
				                & "|"
				                & FxUpperText(Article)
				                & "|"
				                & FxUpperText(Warehouse),
				
				    FxTextList =
				        (InputList as list) as nullable text =>
				            let
				                CleanList =
				                    List.Sort(
				                        List.Distinct(
				                            List.Select(
				                                List.Transform(
				                                    List.RemoveNulls(InputList),
				                                    each FxSafeText(_)
				                                ),
				                                each _ <> "" and Text.Upper(_) <> "NULL"
				                            )
				                        )
				                    )
				            in
				                if List.Count(CleanList) = 0 then null else Text.Combine(CleanList, ", "),
				
				    FxSplitTextList =
				        (InputList as list) as nullable text =>
				            let
				                RawList =
				                    List.Transform(
				                        List.RemoveNulls(InputList),
				                        each FxSafeText(_)
				                    ),
				                SplitList =
				                    List.Combine(
				                        List.Transform(
				                            RawList,
				                            each Text.Split(_, ",")
				                        )
				                    ),
				                CleanList =
				                    List.Sort(
				                        List.Distinct(
				                            List.Select(
				                                List.Transform(
				                                    SplitList,
				                                    each FxSafeText(_)
				                                ),
				                                each _ <> "" and Text.Upper(_) <> "NULL"
				                            )
				                        )
				                    )
				            in
				                if List.Count(CleanList) = 0 then null else Text.Combine(CleanList, ", "),
				
				    FxMergeText =
				        (A as any, B as any) as nullable text =>
				            FxSplitTextList({A, B}),
				
				    FxMergeGRNStatus =
				        (ExistingStatus as any, OutsideStatus as any) as nullable text =>
				            let
				                E = FxSafeText(ExistingStatus),
				                O = FxSafeText(OutsideStatus)
				            in
				                if O = "" then
				                    if E = "" then null else E
				                else if E = "" or Text.Upper(E) = "NO GRN YET" then
				                    O
				                else
				                    FxSplitTextList({E, O}),
				
				    FxSupplierFromList =
				        (TextListValue as any) as nullable text =>
				            let
				                T = FxSafeText(TextListValue),
				                Parts =
				                    List.Sort(
				                        List.Distinct(
				                            List.Select(
				                                List.Transform(
				                                    Text.Split(T, ","),
				                                    each FxSafeText(_)
				                                ),
				                                each _ <> "" and Text.Upper(_) <> "NULL"
				                            )
				                        )
				                    )
				            in
				                if List.Count(Parts) = 0 then null
				                else if List.Count(Parts) = 1 then Parts{0}
				                else "MULTIPLE",
				
				    FxMinDateFromTwo =
				        (A as any, B as any) as nullable date =>
				            let
				                L = List.RemoveNulls({FxDate(A), FxDate(B)})
				            in
				                if List.Count(L) = 0 then null else List.Min(L),
				
				    FxMaxDateFromTwo =
				        (A as any, B as any) as nullable date =>
				            let
				                L = List.RemoveNulls({FxDate(A), FxDate(B)})
				            in
				                if List.Count(L) = 0 then null else List.Max(L),
				
				    FxMinDateTimeFromTwo =
				        (A as any, B as any) as nullable datetime =>
				            let
				                L = List.RemoveNulls({FxDateTime(A), FxDateTime(B)})
				            in
				                if List.Count(L) = 0 then null else List.Min(L),
				
				    FxMaxDateTimeFromTwo =
				        (A as any, B as any) as nullable datetime =>
				            let
				                L = List.RemoveNulls({FxDateTime(A), FxDateTime(B)})
				            in
				                if List.Count(L) = 0 then null else List.Max(L),
				
				    FxReplaceColumn =
				        (InputTable as table, ColumnName as text, Generator as function, ColumnType as any) as table =>
				            let
				                TempColumnName = "__Adjusted " & ColumnName,
				                AddedTemp =
				                    Table.AddColumn(
				                        InputTable,
				                        TempColumnName,
				                        Generator,
				                        ColumnType
				                    ),
				                RemovedOld =
				                    Table.RemoveColumns(
				                        AddedTemp,
				                        {ColumnName},
				                        MissingField.Ignore
				                    ),
				                RenamedNew =
				                    Table.RenameColumns(
				                        RemovedOld,
				                        {{TempColumnName, ColumnName}},
				                        MissingField.Ignore
				                    )
				            in
				                RenamedNew,
				
				    POSelected =
				        Table.SelectColumns(
				            PO,
				            {
				                "PO Period ID",
				                "PO Period Source",
				                "Article",
				                "Warehouse",
				                "Final Cost Center",
				                "PO No",
				                "PO Supplier",
				                "PO Supplier List",
				                "PO Unit List",
				                "PO Base Unit List",
				                "PO Date",
				                "PO Start Date",
				                "Next PO Date",
				                "PO End Date",
				                "PO Base Qty",
				                "PO Value",
				                "PO Count",
				                "PO Line Count",
				                "Sub_Category",
				                "Item_Group",
				                "Storage_Type"
				            },
				            MissingField.UseNull
				        ),
				
				    POReady =
				        Table.SelectRows(
				            POSelected,
				            each
				                [PO Period ID] <> null
				                and [PO Period ID] <> ""
				                and [Article] <> null
				                and [Article] <> ""
				                and [Warehouse] <> null
				                and [Warehouse] <> ""
				                and [PO Start Date] <> null
				                and [PO Base Qty] <> null
				        ),
				
				    MergedGRN =
				        Table.NestedJoin(
				            POReady,
				            {"PO Period ID"},
				            GRN,
				            {"PO Period ID"},
				            "GRN Agg",
				            JoinKind.LeftOuter
				        ),
				
				    ExpandedGRN =
				        Table.ExpandTableColumn(
				            MergedGRN,
				            "GRN Agg",
				            {
				                "Inbound Match Status",
				                "GRN Match Status",
				                "Allocated GRN Base Qty",
				                "Allocated GRN Qty",
				                "Same Day GRN Base Qty",
				                "Late GRN Base Qty",
				                "Allocated GRN Value",
				                "Delivery Note Count",
				                "GRN Line Count",
				                "First GRN Delivery Date",
				                "Last GRN Delivery Date",
				                "First Booking DateTime",
				                "Last Booking DateTime",
				                "Receipt Spread Days",
				                "Delivery Note List",
				                "GRN Supplier",
				                "GRN Supplier List",
				                "GRN PO No List",
				                "GRN Match Status List",
				                "Inbound Match Status List"
				            },
				            {
				                "__GRN Inbound Match Status",
				                "__GRN Match Status",
				                "Allocated GRN Base Qty",
				                "Allocated GRN Qty",
				                "Same Day GRN Base Qty",
				                "Late GRN Base Qty",
				                "GRN Value",
				                "Delivery Note Count",
				                "GRN Line Count",
				                "First GRN Delivery Date",
				                "Last GRN Delivery Date",
				                "First Booking DateTime",
				                "Last Booking DateTime",
				                "Receipt Spread Days",
				                "Delivery Note List",
				                "GRN Supplier",
				                "GRN Supplier List",
				                "GRN PO No List",
				                "GRN Match Status List",
				                "Inbound Match Status List"
				            }
				        ),
				
				    GRNUnitRows =
				        Table.SelectRows(
				            GRNDetail,
				            each
				                [Inbound Match Status] = "Matched"
				                and [PO Period ID] <> null
				                and [PO Period ID] <> ""
				        ),
				
				    GRNUnitGrouped =
				        Table.Group(
				            GRNUnitRows,
				            {"PO Period ID"},
				            {
				                {"Actual GRN Unit List", each FxTextList([GRN Unit]), type nullable text},
				                {"Actual GRN Base Unit List", each FxTextList([GRN Base Unit]), type nullable text}
				            }
				        ),
				
				    MergedGRNUnits =
				        Table.NestedJoin(
				            ExpandedGRN,
				            {"PO Period ID"},
				            GRNUnitGrouped,
				            {"PO Period ID"},
				            "GRN Units",
				            JoinKind.LeftOuter
				        ),
				
				    ExpandedGRNUnits =
				        Table.ExpandTableColumn(
				            MergedGRNUnits,
				            "GRN Units",
				            {"Actual GRN Unit List", "Actual GRN Base Unit List"},
				            {"Actual GRN Unit List", "Actual GRN Base Unit List"}
				        ),
				
				    ReplaceNullNumbers =
				        Table.ReplaceValue(
				            ExpandedGRNUnits,
				            null,
				            0,
				            Replacer.ReplaceValue,
				            {
				                "Allocated GRN Base Qty",
				                "Allocated GRN Qty",
				                "Same Day GRN Base Qty",
				                "Late GRN Base Qty",
				                "GRN Value",
				                "Delivery Note Count",
				                "GRN Line Count"
				            }
				        ),
				
				    AddedInboundMatchStatus =
				        Table.AddColumn(
				            ReplaceNullNumbers,
				            "Inbound Match Status",
				            each "Matched",
				            type text
				        ),
				
				    AddedGRNMatchStatus =
				        Table.AddColumn(
				            AddedInboundMatchStatus,
				            "GRN Match Status",
				            each
				                if [__GRN Match Status] <> null and [__GRN Match Status] <> "" then
				                    [__GRN Match Status]
				                else
				                    "No GRN Yet",
				            type text
				        ),
				
				    AddedActualGRNSupplier =
				        Table.AddColumn(
				            AddedGRNMatchStatus,
				            "Actual GRN Supplier",
				            each [GRN Supplier],
				            type nullable text
				        ),
				
				    AddedActualGRNSupplierList =
				        Table.AddColumn(
				            AddedActualGRNSupplier,
				            "Actual GRN Supplier List",
				            each [GRN Supplier List],
				            type nullable text
				        ),
				
				    AddedFirstGRNDate =
				        Table.AddColumn(
				            AddedActualGRNSupplierList,
				            "First GRN Date",
				            each FxDate([First GRN Delivery Date]),
				            type nullable date
				        ),
				
				    AddedLastGRNDate =
				        Table.AddColumn(
				            AddedFirstGRNDate,
				            "Last GRN Date",
				            each FxDate([Last GRN Delivery Date]),
				            type nullable date
				        ),
				
				    AddedFirstBookingDate =
				        Table.AddColumn(
				            AddedLastGRNDate,
				            "First Booking Date",
				            each
				                if [First Booking DateTime] = null then
				                    null
				                else
				                    Date.From([First Booking DateTime]),
				            type nullable date
				        ),
				
				    AddedLastBookingDate =
				        Table.AddColumn(
				            AddedFirstBookingDate,
				            "Last Booking Date",
				            each
				                if [Last Booking DateTime] = null then
				                    null
				                else
				                    Date.From([Last Booking DateTime]),
				            type nullable date
				        ),
				
				    AddedFirstReceiptDelayDays =
				        Table.AddColumn(
				            AddedLastBookingDate,
				            "First Receipt Delay Days",
				            each
				                if [First GRN Date] = null or [PO Start Date] = null then
				                    null
				                else
				                    Duration.Days([First GRN Date] - [PO Start Date]),
				            Int64.Type
				        ),
				
				    AddedPendingQty =
				        Table.AddColumn(
				            AddedFirstReceiptDelayDays,
				            "Pending Qty",
				            each
				                let
				                    ReqQty = FxNum([PO Base Qty]),
				                    GrnQty = FxNum([Allocated GRN Base Qty])
				                in
				                    if ReqQty <> null and GrnQty <> null and ReqQty > GrnQty then
				                        ReqQty - GrnQty
				                    else
				                        0,
				            type number
				        ),
				
				    AddedOverDeliveredQty =
				        Table.AddColumn(
				            AddedPendingQty,
				            "Over Delivered Qty",
				            each
				                let
				                    ReqQty = FxNum([PO Base Qty]),
				                    GrnQty = FxNum([Allocated GRN Base Qty])
				                in
				                    if ReqQty <> null and GrnQty <> null and GrnQty > ReqQty then
				                        GrnQty - ReqQty
				                    else
				                        0,
				            type number
				        ),
				
				    AddedFulfillmentStatus =
				        Table.AddColumn(
				            AddedOverDeliveredQty,
				            "Fulfillment Status",
				            each
				                let
				                    ReqQty = FxNum([PO Base Qty]),
				                    GrnQty = FxNum([Allocated GRN Base Qty])
				                in
				                    if GrnQty = null or GrnQty = 0 then
				                        "Not Received"
				                    else if ReqQty = null or ReqQty = 0 then
				                        "Unknown"
				                    else if Number.Abs(GrnQty - ReqQty) <= 0.01 then
				                        "Fully Delivered"
				                    else if GrnQty < ReqQty then
				                        "Partially Delivered"
				                    else if GrnQty > ReqQty then
				                        "Over Delivered"
				                    else
				                        "Unknown",
				            type text
				        ),
				
				    AddedInFullFlag =
				        Table.AddColumn(
				            AddedFulfillmentStatus,
				            "In Full Flag",
				            each
				                let
				                    ReqQty = FxNum([PO Base Qty]),
				                    GrnQty = FxNum([Allocated GRN Base Qty])
				                in
				                    if ReqQty <> null and ReqQty > 0 and GrnQty <> null and GrnQty >= ReqQty then
				                        1
				                    else
				                        0,
				            Int64.Type
				        ),
				
				    AddedOnTimeFlag =
				        Table.AddColumn(
				            AddedInFullFlag,
				            "On Time Flag",
				            each
				                let
				                    ReqQty = FxNum([PO Base Qty]),
				                    SameDayQty = FxNum([Same Day GRN Base Qty])
				                in
				                    if ReqQty <> null and ReqQty > 0 and SameDayQty <> null and SameDayQty >= ReqQty then
				                        1
				                    else
				                        0,
				            Int64.Type
				        ),
				
				    AddedOTIFFlag =
				        Table.AddColumn(
				            AddedOnTimeFlag,
				            "OTIF Flag",
				            each
				                if [In Full Flag] = 1 and [On Time Flag] = 1 then
				                    1
				                else
				                    0,
				            Int64.Type
				        ),
				
				    FilledGRNMatchStatusList =
				        Table.ReplaceValue(
				            AddedOTIFFlag,
				            null,
				            "No GRN Yet",
				            Replacer.ReplaceValue,
				            {"GRN Match Status List"}
				        ),
				
				    FilledInboundMatchStatusList =
				        Table.ReplaceValue(
				            FilledGRNMatchStatusList,
				            null,
				            "Matched",
				            Replacer.ReplaceValue,
				            {"Inbound Match Status List"}
				        ),
				
				    AddedRecoveredRequiredQty =
				        Table.AddColumn(
				            FilledInboundMatchStatusList,
				            "Recovered Required Qty",
				            each null,
				            type nullable number
				        ),
				
				    AddedRecoveredRequiredBaseQty =
				        Table.AddColumn(
				            AddedRecoveredRequiredQty,
				            "Recovered Required Base Qty",
				            each null,
				            type nullable number
				        ),
				
				    AddedRecoveredRequiredQtySource =
				        Table.AddColumn(
				            AddedRecoveredRequiredBaseQty,
				            "Recovered Required Qty Source",
				            each null,
				            type nullable text
				        ),
				
				    AddedRecoveredIncludeFlag =
				        Table.AddColumn(
				            AddedRecoveredRequiredQtySource,
				            "Recovered Include In Fill Rate Flag",
				            each 0,
				            Int64.Type
				        ),
				
				    RemovedHelperColumns =
				        Table.RemoveColumns(
				            AddedRecoveredIncludeFlag,
				            {
				                "__GRN Inbound Match Status",
				                "__GRN Match Status",
				                "GRN Supplier",
				                "GRN Supplier List",
				                "First GRN Delivery Date",
				                "Last GRN Delivery Date",
				                "Actual GRN Base Unit List"
				            },
				            MissingField.Ignore
				        ),
				
				    MatchedLifecycle =
				        Table.ReorderColumns(
				            RemovedHelperColumns,
				            {
				                "PO Period ID",
				                "PO Period Source",
				                "Inbound Match Status",
				                "GRN Match Status",
				                "Article",
				                "Warehouse",
				                "Final Cost Center",
				                "PO No",
				                "PO Supplier",
				                "PO Supplier List",
				                "Actual GRN Supplier",
				                "Actual GRN Supplier List",
				                "PO Unit List",
				                "Actual GRN Unit List",
				                "PO Base Unit List",
				                "PO Date",
				                "PO Start Date",
				                "Next PO Date",
				                "PO End Date",
				                "PO Base Qty",
				                "Recovered Required Qty",
				                "Recovered Required Base Qty",
				                "Recovered Required Qty Source",
				                "Allocated GRN Base Qty",
				                "Allocated GRN Qty",
				                "Same Day GRN Base Qty",
				                "Late GRN Base Qty",
				                "Pending Qty",
				                "Over Delivered Qty",
				                "PO Value",
				                "GRN Value",
				                "PO Count",
				                "PO Line Count",
				                "Delivery Note Count",
				                "GRN Line Count",
				                "Delivery Note List",
				                "GRN PO No List",
				                "First GRN Date",
				                "Last GRN Date",
				                "First Booking Date",
				                "Last Booking Date",
				                "First Booking DateTime",
				                "Last Booking DateTime",
				                "First Receipt Delay Days",
				                "Receipt Spread Days",
				                "Fulfillment Status",
				                "In Full Flag",
				                "On Time Flag",
				                "OTIF Flag",
				                "GRN Match Status List",
				                "Inbound Match Status List",
				                "Recovered Include In Fill Rate Flag",
				                "Sub_Category",
				                "Item_Group",
				                "Storage_Type"
				            },
				            MissingField.Ignore
				        ),
				
				    MatchedWithKey =
				        Table.AddColumn(
				            MatchedLifecycle,
				            "__Lifecycle Key",
				            each
				                if [Inbound Match Status] = "Matched" and FxHasPONo([PO No]) then
				                    FxLifecycleKey([PO No], [Article], [Warehouse])
				                else
				                    null,
				            type nullable text
				        ),
				
				    MatchedTargetMap =
				        Table.Buffer(
				            Table.Group(
				                Table.SelectRows(
				                    MatchedWithKey,
				                    each [__Lifecycle Key] <> null and [__Lifecycle Key] <> ""
				                ),
				                {"__Lifecycle Key"},
				                {
				                    {
				                        "Target PO Period ID",
				                        each
				                            let
				                                SortedRows =
				                                    Table.Sort(
				                                        _,
				                                        {
				                                            {"PO Start Date", Order.Ascending},
				                                            {"PO End Date", Order.Descending}
				                                        }
				                                    )
				                            in
				                                SortedRows{0}[PO Period ID],
				                        type nullable text
				                    }
				                }
				            )
				        ),
				
				    RecoveredWithKey =
				        Table.AddColumn(
				            RecoveredLifecycle,
				            "__Lifecycle Key",
				            each
				                if [Inbound Match Status] = "Non-Matched" and FxHasPONo([PO No]) then
				                    FxLifecycleKey([PO No], [Article], [Warehouse])
				                else
				                    null,
				            type nullable text
				        ),
				
				    MergeRecoveredTarget =
				        Table.NestedJoin(
				            RecoveredWithKey,
				            {"__Lifecycle Key"},
				            MatchedTargetMap,
				            {"__Lifecycle Key"},
				            "__Target PO",
				            JoinKind.LeftOuter
				        ),
				
				    ExpandRecoveredTarget =
				        Table.ExpandTableColumn(
				            MergeRecoveredTarget,
				            "__Target PO",
				            {"Target PO Period ID"},
				            {"__Target PO Period ID"}
				        ),
				
				    AddRecoveredDuplicateFlag =
				        Table.AddColumn(
				            ExpandRecoveredTarget,
				            "Recovered Duplicate Existing PO Flag",
				            each
				                if [__Target PO Period ID] <> null and [__Target PO Period ID] <> "" then
				                    1
				                else
				                    0,
				            Int64.Type
				        ),
				
				    RecoveredToAbsorb =
				        Table.SelectRows(
				            AddRecoveredDuplicateFlag,
				            each [Recovered Duplicate Existing PO Flag] = 1
				        ),
				
				    RecoveredToKeepRaw =
				        Table.SelectRows(
				            AddRecoveredDuplicateFlag,
				            each [Recovered Duplicate Existing PO Flag] <> 1
				        ),
				
				    RecoveredToKeep =
				        Table.RemoveColumns(
				            RecoveredToKeepRaw,
				            {"__Lifecycle Key", "__Target PO Period ID"},
				            MissingField.Ignore
				        ),
				
				    AbsorbedGrouped =
				        Table.Group(
				            RecoveredToAbsorb,
				            {"__Target PO Period ID"},
				            {
				                {"Outside Period GRN Base Qty", each List.Sum(List.RemoveNulls([Allocated GRN Base Qty])), type nullable number},
				                {"Outside Period GRN Qty", each List.Sum(List.RemoveNulls([Allocated GRN Qty])), type nullable number},
				                {"Outside Period GRN Value", each List.Sum(List.RemoveNulls([GRN Value])), type nullable number},
				                {"Outside Period Delivery Note Count", each List.Sum(List.RemoveNulls([Delivery Note Count])), Int64.Type},
				                {"Outside Period GRN Line Count", each List.Sum(List.RemoveNulls([GRN Line Count])), Int64.Type},
				                {"Outside Period Delivery Note List", each FxSplitTextList([Delivery Note List]), type nullable text},
				                {"Outside Period GRN PO No List", each FxSplitTextList([GRN PO No List]), type nullable text},
				                {"Outside Period GRN Match Status List", each FxSplitTextList([GRN Match Status List]), type nullable text},
				                {"Outside Period Actual GRN Supplier List", each FxSplitTextList([Actual GRN Supplier List]), type nullable text},
				                {"Outside Period Actual GRN Unit List", each FxSplitTextList([Actual GRN Unit List]), type nullable text},
				                {"Outside Period PO Base Unit List", each FxSplitTextList([PO Base Unit List]), type nullable text},
				                {"Outside Period First GRN Date", each let L = List.RemoveNulls([First GRN Date]) in if List.Count(L) = 0 then null else List.Min(L), type nullable date},
				                {"Outside Period Last GRN Date", each let L = List.RemoveNulls([Last GRN Date]) in if List.Count(L) = 0 then null else List.Max(L), type nullable date},
				                {"Outside Period First Booking DateTime", each let L = List.RemoveNulls([First Booking DateTime]) in if List.Count(L) = 0 then null else List.Min(L), type nullable datetime},
				                {"Outside Period Last Booking DateTime", each let L = List.RemoveNulls([Last Booking DateTime]) in if List.Count(L) = 0 then null else List.Max(L), type nullable datetime}
				            }
				        ),
				
				    MergeAbsorbedToMatched =
				        Table.NestedJoin(
				            MatchedWithKey,
				            {"PO Period ID"},
				            AbsorbedGrouped,
				            {"__Target PO Period ID"},
				            "__Absorbed Outside GRN",
				            JoinKind.LeftOuter
				        ),
				
				    ExpandAbsorbed =
				        Table.ExpandTableColumn(
				            MergeAbsorbedToMatched,
				            "__Absorbed Outside GRN",
				            {
				                "Outside Period GRN Base Qty",
				                "Outside Period GRN Qty",
				                "Outside Period GRN Value",
				                "Outside Period Delivery Note Count",
				                "Outside Period GRN Line Count",
				                "Outside Period Delivery Note List",
				                "Outside Period GRN PO No List",
				                "Outside Period GRN Match Status List",
				                "Outside Period Actual GRN Supplier List",
				                "Outside Period Actual GRN Unit List",
				                "Outside Period PO Base Unit List",
				                "Outside Period First GRN Date",
				                "Outside Period Last GRN Date",
				                "Outside Period First Booking DateTime",
				                "Outside Period Last Booking DateTime"
				            },
				            {
				                "Outside Period GRN Base Qty",
				                "Outside Period GRN Qty",
				                "Outside Period GRN Value",
				                "Outside Period Delivery Note Count",
				                "Outside Period GRN Line Count",
				                "Outside Period Delivery Note List",
				                "Outside Period GRN PO No List",
				                "Outside Period GRN Match Status List",
				                "Outside Period Actual GRN Supplier List",
				                "Outside Period Actual GRN Unit List",
				                "Outside Period PO Base Unit List",
				                "Outside Period First GRN Date",
				                "Outside Period Last GRN Date",
				                "Outside Period First Booking DateTime",
				                "Outside Period Last Booking DateTime"
				            }
				        ),
				
				    ReplaceNullAbsorbedNumbers =
				        Table.ReplaceValue(
				            ExpandAbsorbed,
				            null,
				            0,
				            Replacer.ReplaceValue,
				            {
				                "Outside Period GRN Base Qty",
				                "Outside Period GRN Qty",
				                "Outside Period GRN Value",
				                "Outside Period Delivery Note Count",
				                "Outside Period GRN Line Count"
				            }
				        ),
				
				    AddAbsorbedOutsideFlag =
				        Table.AddColumn(
				            ReplaceNullAbsorbedNumbers,
				            "Absorbed Outside Period GRN Flag",
				            each
				                if FxNumZero([Outside Period GRN Base Qty]) > 0 then
				                    1
				                else
				                    0,
				            Int64.Type
				        ),
				
				    AdjustGRNMatchStatus =
				        FxReplaceColumn(
				            AddAbsorbedOutsideFlag,
				            "GRN Match Status",
				            each FxMergeGRNStatus([GRN Match Status], [Outside Period GRN Match Status List]),
				            type nullable text
				        ),
				
				    AdjustAllocatedGRNBaseQty =
				        FxReplaceColumn(
				            AdjustGRNMatchStatus,
				            "Allocated GRN Base Qty",
				            each FxNumZero([Allocated GRN Base Qty]) + FxNumZero([Outside Period GRN Base Qty]),
				            type nullable number
				        ),
				
				    AdjustAllocatedGRNQty =
				        FxReplaceColumn(
				            AdjustAllocatedGRNBaseQty,
				            "Allocated GRN Qty",
				            each FxNumZero([Allocated GRN Qty]) + FxNumZero([Outside Period GRN Qty]),
				            type nullable number
				        ),
				
				    AdjustGRNValue =
				        FxReplaceColumn(
				            AdjustAllocatedGRNQty,
				            "GRN Value",
				            each FxNumZero([GRN Value]) + FxNumZero([Outside Period GRN Value]),
				            type nullable number
				        ),
				
				    AdjustDeliveryNoteCount =
				        FxReplaceColumn(
				            AdjustGRNValue,
				            "Delivery Note Count",
				            each FxNumZero([Delivery Note Count]) + FxNumZero([Outside Period Delivery Note Count]),
				            Int64.Type
				        ),
				
				    AdjustGRNLineCount =
				        FxReplaceColumn(
				            AdjustDeliveryNoteCount,
				            "GRN Line Count",
				            each FxNumZero([GRN Line Count]) + FxNumZero([Outside Period GRN Line Count]),
				            Int64.Type
				        ),
				
				    AdjustDeliveryNoteList =
				        FxReplaceColumn(
				            AdjustGRNLineCount,
				            "Delivery Note List",
				            each FxMergeText([Delivery Note List], [Outside Period Delivery Note List]),
				            type nullable text
				        ),
				
				    AdjustGRNPONoList =
				        FxReplaceColumn(
				            AdjustDeliveryNoteList,
				            "GRN PO No List",
				            each FxMergeText([GRN PO No List], [Outside Period GRN PO No List]),
				            type nullable text
				        ),
				
				    AdjustGRNMatchStatusList =
				        FxReplaceColumn(
				            AdjustGRNPONoList,
				            "GRN Match Status List",
				            each FxMergeText([GRN Match Status List], [Outside Period GRN Match Status List]),
				            type nullable text
				        ),
				
				    AdjustActualGRNSupplierList =
				        FxReplaceColumn(
				            AdjustGRNMatchStatusList,
				            "Actual GRN Supplier List",
				            each FxMergeText([Actual GRN Supplier List], [Outside Period Actual GRN Supplier List]),
				            type nullable text
				        ),
				
				    AdjustActualGRNSupplier =
				        FxReplaceColumn(
				            AdjustActualGRNSupplierList,
				            "Actual GRN Supplier",
				            each FxSupplierFromList([Actual GRN Supplier List]),
				            type nullable text
				        ),
				
				    AdjustActualGRNUnitList =
				        FxReplaceColumn(
				            AdjustActualGRNSupplier,
				            "Actual GRN Unit List",
				            each FxMergeText([Actual GRN Unit List], [Outside Period Actual GRN Unit List]),
				            type nullable text
				        ),
				
				    AdjustFirstGRNDate =
				        FxReplaceColumn(
				            AdjustActualGRNUnitList,
				            "First GRN Date",
				            each FxMinDateFromTwo([First GRN Date], [Outside Period First GRN Date]),
				            type nullable date
				        ),
				
				    AdjustLastGRNDate =
				        FxReplaceColumn(
				            AdjustFirstGRNDate,
				            "Last GRN Date",
				            each FxMaxDateFromTwo([Last GRN Date], [Outside Period Last GRN Date]),
				            type nullable date
				        ),
				
				    AdjustFirstBookingDateTime =
				        FxReplaceColumn(
				            AdjustLastGRNDate,
				            "First Booking DateTime",
				            each FxMinDateTimeFromTwo([First Booking DateTime], [Outside Period First Booking DateTime]),
				            type nullable datetime
				        ),
				
				    AdjustLastBookingDateTime =
				        FxReplaceColumn(
				            AdjustFirstBookingDateTime,
				            "Last Booking DateTime",
				            each FxMaxDateTimeFromTwo([Last Booking DateTime], [Outside Period Last Booking DateTime]),
				            type nullable datetime
				        ),
				
				    AdjustFirstBookingDate =
				        FxReplaceColumn(
				            AdjustLastBookingDateTime,
				            "First Booking Date",
				            each
				                if [First Booking DateTime] = null then
				                    null
				                else
				                    Date.From([First Booking DateTime]),
				            type nullable date
				        ),
				
				    AdjustLastBookingDate =
				        FxReplaceColumn(
				            AdjustFirstBookingDate,
				            "Last Booking Date",
				            each
				                if [Last Booking DateTime] = null then
				                    null
				                else
				                    Date.From([Last Booking DateTime]),
				            type nullable date
				        ),
				
				    RecalcFirstReceiptDelayDays =
				        FxReplaceColumn(
				            AdjustLastBookingDate,
				            "First Receipt Delay Days",
				            each
				                if [First GRN Date] = null or [PO Start Date] = null then
				                    null
				                else
				                    Duration.Days([First GRN Date] - [PO Start Date]),
				            Int64.Type
				        ),
				
				    RecalcReceiptSpreadDays =
				        FxReplaceColumn(
				            RecalcFirstReceiptDelayDays,
				            "Receipt Spread Days",
				            each
				                if [First GRN Date] = null or [Last GRN Date] = null then
				                    null
				                else
				                    Duration.Days([Last GRN Date] - [First GRN Date]),
				            Int64.Type
				        ),
				
				    RecalcPendingQty =
				        FxReplaceColumn(
				            RecalcReceiptSpreadDays,
				            "Pending Qty",
				            each
				                let
				                    ReqQty = FxNum([PO Base Qty]),
				                    GrnQty = FxNum([Allocated GRN Base Qty])
				                in
				                    if ReqQty <> null and GrnQty <> null and ReqQty > GrnQty then
				                        ReqQty - GrnQty
				                    else
				                        0,
				            type number
				        ),
				
				    RecalcOverDeliveredQty =
				        FxReplaceColumn(
				            RecalcPendingQty,
				            "Over Delivered Qty",
				            each
				                let
				                    ReqQty = FxNum([PO Base Qty]),
				                    GrnQty = FxNum([Allocated GRN Base Qty])
				                in
				                    if ReqQty <> null and GrnQty <> null and GrnQty > ReqQty then
				                        GrnQty - ReqQty
				                    else
				                        0,
				            type number
				        ),
				
				    RecalcFulfillmentStatus =
				        FxReplaceColumn(
				            RecalcOverDeliveredQty,
				            "Fulfillment Status",
				            each
				                let
				                    ReqQty = FxNum([PO Base Qty]),
				                    GrnQty = FxNum([Allocated GRN Base Qty])
				                in
				                    if GrnQty = null or GrnQty = 0 then
				                        "Not Received"
				                    else if ReqQty = null or ReqQty = 0 then
				                        "Unknown"
				                    else if Number.Abs(GrnQty - ReqQty) <= 0.01 then
				                        "Fully Delivered"
				                    else if GrnQty < ReqQty then
				                        "Partially Delivered"
				                    else if GrnQty > ReqQty then
				                        "Over Delivered"
				                    else
				                        "Unknown",
				            type text
				        ),
				
				    RecalcInFullFlag =
				        FxReplaceColumn(
				            RecalcFulfillmentStatus,
				            "In Full Flag",
				            each
				                let
				                    ReqQty = FxNum([PO Base Qty]),
				                    GrnQty = FxNum([Allocated GRN Base Qty])
				                in
				                    if ReqQty <> null and ReqQty > 0 and GrnQty <> null and GrnQty >= ReqQty then
				                        1
				                    else
				                        0,
				            Int64.Type
				        ),
				
				    RecalcOnTimeFlag =
				        FxReplaceColumn(
				            RecalcInFullFlag,
				            "On Time Flag",
				            each
				                let
				                    ReqQty = FxNum([PO Base Qty]),
				                    SameDayQty = FxNum([Same Day GRN Base Qty])
				                in
				                    if ReqQty <> null and ReqQty > 0 and SameDayQty <> null and SameDayQty >= ReqQty then
				                        1
				                    else
				                        0,
				            Int64.Type
				        ),
				
				    RecalcOTIFFlag =
				        FxReplaceColumn(
				            RecalcOnTimeFlag,
				            "OTIF Flag",
				            each
				                if [In Full Flag] = 1 and [On Time Flag] = 1 then
				                    1
				                else
				                    0,
				            Int64.Type
				        ),
				
				    AddMatchedRecoveredDuplicateFlag =
				        Table.AddColumn(
				            RecalcOTIFFlag,
				            "Recovered Duplicate Existing PO Flag",
				            each 0,
				            Int64.Type
				        ),
				
				    RemoveMatchedHelperKey =
				        Table.RemoveColumns(
				            AddMatchedRecoveredDuplicateFlag,
				            {"__Lifecycle Key"},
				            MissingField.Ignore
				        ),
				
				    MatchedAdjusted =
				        RemoveMatchedHelperKey,
				
				    FinalColumnList =
				        List.Union(
				            {
				                Table.ColumnNames(MatchedAdjusted),
				                Table.ColumnNames(RecoveredToKeep)
				            }
				        ),
				
				    MatchedAligned =
				        Table.SelectColumns(
				            MatchedAdjusted,
				            FinalColumnList,
				            MissingField.UseNull
				        ),
				
				    RecoveredAligned =
				        Table.SelectColumns(
				            RecoveredToKeep,
				            FinalColumnList,
				            MissingField.UseNull
				        ),
				
				    CombinedLifecycle =
				        Table.Combine(
				            {
				                MatchedAligned,
				                RecoveredAligned
				            }
				        ),
				
				    FinalColumnOrder =
				        Table.ReorderColumns(
				            CombinedLifecycle,
				            {
				                "PO Period ID",
				                "PO Period Source",
				                "Inbound Match Status",
				                "GRN Match Status",
				
				                "Article",
				                "Warehouse",
				                "Final Cost Center",
				
				                "PO No",
				                "PO Supplier",
				                "PO Supplier List",
				                "Actual GRN Supplier",
				                "Actual GRN Supplier List",
				
				                "PO Unit List",
				                "Actual GRN Unit List",
				                "PO Base Unit List",
				
				                "PO Date",
				                "PO Start Date",
				                "Next PO Date",
				                "PO End Date",
				
				                "PO Base Qty",
				                "Recovered Required Qty",
				                "Recovered Required Base Qty",
				                "Recovered Required Qty Source",
				
				                "Allocated GRN Base Qty",
				                "Allocated GRN Qty",
				                "Same Day GRN Base Qty",
				                "Late GRN Base Qty",
				                "Outside Period GRN Base Qty",
				                "Outside Period GRN Qty",
				                "Outside Period GRN Value",
				
				                "Pending Qty",
				                "Over Delivered Qty",
				
				                "PO Value",
				                "GRN Value",
				
				                "PO Count",
				                "PO Line Count",
				                "Delivery Note Count",
				                "GRN Line Count",
				                "Outside Period Delivery Note Count",
				                "Outside Period GRN Line Count",
				
				                "Delivery Note List",
				                "GRN PO No List",
				                "Outside Period Delivery Note List",
				                "Outside Period GRN PO No List",
				
				                "First GRN Date",
				                "Last GRN Date",
				                "First Booking Date",
				                "Last Booking Date",
				                "First Booking DateTime",
				                "Last Booking DateTime",
				
				                "First Receipt Delay Days",
				                "Receipt Spread Days",
				
				                "Fulfillment Status",
				                "In Full Flag",
				                "On Time Flag",
				                "OTIF Flag",
				
				                "GRN Match Status List",
				                "Inbound Match Status List",
				                "Recovered Include In Fill Rate Flag",
				                "Recovered Duplicate Existing PO Flag",
				                "Absorbed Outside Period GRN Flag",
				
				                "Sub_Category",
				                "Item_Group",
				                "Storage_Type",
				
				                "Requested Qty Conflict Flag",
				                "Requested Qty Conflict Status",
				                "Requested Qty Distinct Count",
				                "Requested Base Qty Distinct Count",
				                "Requested Qty List",
				                "Requested Base Qty List"
				            },
				            MissingField.Ignore
				        )
				in
				    FinalColumnOrder

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

