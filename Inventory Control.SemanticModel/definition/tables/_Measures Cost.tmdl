table '_Measures Cost'
	lineageTag: 558c2547-c1b3-476d-8f27-a7d4673ea5e9

	measure 'CC Start Date' =
			
			MINX (
			    ALLSELECTED ( 'CC Date'[Movement Date] ),
			    'CC Date'[Movement Date]
			)
		formatString: mm/dd/yy
		lineageTag: bd6828cc-2640-4704-9b81-9c60affec448

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	measure 'CC End Date' =
			
			MAXX (
			    ALLSELECTED ( 'CC Date'[Movement Date] ),
			    'CC Date'[Movement Date]
			)
		formatString: mm/dd/yy
		lineageTag: 93c33a01-431d-4036-a66a-f3c1180e825f

		annotation PBI_FormatHint = {"isDateTimeCustom":true}

	measure 'CC Opening Stock' =
			
			VAR StartDate =
			    [CC Start Date]
			
			VAR SelectedLocations =
			    VALUES ( 'CC Item Location'[Location] )
			
			VAR SelectedArticleNos =
			    VALUES ( 'CC Item Location'[Article No.] )
			
			RETURN
			    COALESCE (
			        CALCULATE (
			            SUM ( 'cc_daily_inventory'[Opening Stock Qty] ),
			            TREATAS ( { StartDate }, 'cc_daily_inventory'[Movement Date] ),
			            TREATAS ( SelectedLocations, 'cc_daily_inventory'[Location] ),
			            TREATAS ( SelectedArticleNos, 'cc_daily_inventory'[Article No.] )
			        ),
			        0
			    )
		lineageTag: fafc1e81-9c8e-43f5-8f05-5cad814da8ad

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'CC Closing Stock' =
			
			VAR EndDate =
			    [CC End Date]
			
			VAR SelectedLocations =
			    VALUES ( 'CC Item Location'[Location] )
			
			VAR SelectedArticleNos =
			    VALUES ( 'CC Item Location'[Article No.] )
			
			RETURN
			    COALESCE (
			        CALCULATE (
			            SUM ( 'cc_daily_inventory'[Closing Stock Qty] ),
			            TREATAS ( { EndDate }, 'cc_daily_inventory'[Movement Date] ),
			            TREATAS ( SelectedLocations, 'cc_daily_inventory'[Location] ),
			            TREATAS ( SelectedArticleNos, 'cc_daily_inventory'[Article No.] )
			        ),
			        0
			    )
		lineageTag: 9c09fd91-8855-4a81-b60e-0617c59cbdc2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'CC Purchase Qty' =
			
			VAR SelectedDates =
			    VALUES ( 'CC Date'[Movement Date] )
			
			VAR SelectedLocations =
			    VALUES ( 'CC Item Location'[Location] )
			
			VAR SelectedArticleNos =
			    VALUES ( 'CC Item Location'[Article No.] )
			
			VAR SelectedStatus =
			    VALUES ( 'CC Inbound Status'[Inbound Status] )
			
			VAR HasStatusFilter =
			    ISFILTERED ( 'CC Inbound Status'[Inbound Status] )
			
			RETURN
			    COALESCE (
			        IF (
			            HasStatusFilter,
			            CALCULATE (
			                SUMX (
			                    'fact_grn_allocated_detail',
			                    COALESCE (
			                        'fact_grn_allocated_detail'[GRN Base Qty],
			                        'fact_grn_allocated_detail'[Allocated GRN Base Qty],
			                        0
			                    )
			                ),
			                TREATAS ( SelectedDates, 'fact_grn_allocated_detail'[GRN Delivery Date] ),
			                TREATAS ( SelectedLocations, 'fact_grn_allocated_detail'[Warehouse] ),
			                TREATAS ( SelectedArticleNos, 'fact_grn_allocated_detail'[Article No.] ),
			                TREATAS ( SelectedStatus, 'fact_grn_allocated_detail'[DN Status] )
			            ),
			            CALCULATE (
			                SUMX (
			                    'fact_grn_allocated_detail',
			                    COALESCE (
			                        'fact_grn_allocated_detail'[GRN Base Qty],
			                        'fact_grn_allocated_detail'[Allocated GRN Base Qty],
			                        0
			                    )
			                ),
			                TREATAS ( SelectedDates, 'fact_grn_allocated_detail'[GRN Delivery Date] ),
			                TREATAS ( SelectedLocations, 'fact_grn_allocated_detail'[Warehouse] ),
			                TREATAS ( SelectedArticleNos, 'fact_grn_allocated_detail'[Article No.] )
			            )
			        ),
			        0
			    )
		lineageTag: 5db16a7f-42b1-4bb9-bb53-f2f449c2e1ab

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'CC Transfer Out Qty' =
			
			VAR SelectedDates =
			    VALUES ( 'CC Date'[Movement Date] )
			
			VAR SelectedLocationKeys =
			    VALUES ( 'CC Item Location'[Location Key] )
			
			VAR SelectedArticleNoKeys =
			    VALUES ( 'CC Item Location'[Article No Key] )
			
			VAR SelectedArticleKeys =
			    VALUES ( 'CC Item Location'[Article Key] )
			
			VAR SelectedStatuses =
			    VALUES ( 'CC Outbound Status'[Outbound Status] )
			
			VAR HasStatusFilter =
			    ISFILTERED ( 'CC Outbound Status'[Outbound Status] )
			
			VAR ByArticleNo =
			    IF (
			        HasStatusFilter,
			        CALCULATE (
			            SUM ( 'CC Outbound Core'[Outbound Base Qty] ),
			            'CC Outbound Core'[Movement Type] = "Transfer Out",
			            TREATAS ( SelectedDates, 'CC Outbound Core'[Movement Date] ),
			            TREATAS ( SelectedLocationKeys, 'CC Outbound Core'[Location Key] ),
			            TREATAS ( SelectedArticleNoKeys, 'CC Outbound Core'[Article No Key] ),
			            TREATAS ( SelectedStatuses, 'CC Outbound Core'[Status Key] )
			        ),
			        CALCULATE (
			            SUM ( 'CC Outbound Core'[Outbound Base Qty] ),
			            'CC Outbound Core'[Movement Type] = "Transfer Out",
			            'CC Outbound Core'[Status Key] IN { "BOOKED", "DELIVERED", "DECLINED" },
			            TREATAS ( SelectedDates, 'CC Outbound Core'[Movement Date] ),
			            TREATAS ( SelectedLocationKeys, 'CC Outbound Core'[Location Key] ),
			            TREATAS ( SelectedArticleNoKeys, 'CC Outbound Core'[Article No Key] )
			        )
			    )
			
			VAR ByArticleName =
			    IF (
			        HasStatusFilter,
			        CALCULATE (
			            SUM ( 'CC Outbound Core'[Outbound Base Qty] ),
			            'CC Outbound Core'[Movement Type] = "Transfer Out",
			            TREATAS ( SelectedDates, 'CC Outbound Core'[Movement Date] ),
			            TREATAS ( SelectedLocationKeys, 'CC Outbound Core'[Location Key] ),
			            TREATAS ( SelectedArticleKeys, 'CC Outbound Core'[Article Key] ),
			            TREATAS ( SelectedStatuses, 'CC Outbound Core'[Status Key] )
			        ),
			        CALCULATE (
			            SUM ( 'CC Outbound Core'[Outbound Base Qty] ),
			            'CC Outbound Core'[Movement Type] = "Transfer Out",
			            'CC Outbound Core'[Status Key] IN { "BOOKED", "DELIVERED", "DECLINED" },
			            TREATAS ( SelectedDates, 'CC Outbound Core'[Movement Date] ),
			            TREATAS ( SelectedLocationKeys, 'CC Outbound Core'[Location Key] ),
			            TREATAS ( SelectedArticleKeys, 'CC Outbound Core'[Article Key] )
			        )
			    )
			
			RETURN
			    COALESCE (
			        IF (
			            COALESCE ( ByArticleNo, 0 ) <> 0,
			            ByArticleNo,
			            ByArticleName
			        ),
			        0
			    )
		lineageTag: b9b6a0d1-4340-448d-a9c0-a6436f601d04

		annotation PBI_FormatHint = {"isGeneralNumber":true}

