	column 'Requested Base Qty List'
		dataType: string
		lineageTag: b74aaf14-3541-4a89-bff6-5e99f7ed232a
		summarizeBy: none
		sourceColumn: Requested Base Qty List

		annotation SummarizationSetBy = Automatic

	partition fact_grn_allocated_detail = m
		mode: import
		source =
				let
				    PO = fact_po_period_base,
				    GRN = fact_grn_line,
				
				    FxSafeText =
				        (x as any) as text =>
				            try
				                if x = null then ""
				                else Text.Trim(Text.Clean(Text.From(x)))
				            otherwise "",
				
				    FxUpperText =
				        (x as any) as text =>
				            Text.Upper(FxSafeText(x)),
				
				    FxDate =
				        (x as any) as nullable date =>
				            try Date.From(x) otherwise null,
				
				    FxNum =
				        (x as any) as nullable number =>
				            try Number.From(x) otherwise null,
				
				    FxPositiveNumberList =
				        (InputList as list) as list =>
				            List.Select(
				                List.RemoveNulls(
				                    List.Transform(
				                        InputList,
				                        each FxNum(_)
				                    )
				                ),
				                each _ > 0
				            ),
				
				    FxDistinctPositiveNumberList =
				        (InputList as list) as list =>
				            List.Sort(
				                List.Distinct(
				                    List.Transform(
				                        FxPositiveNumberList(InputList),
				                        each Number.Round(_, 5)
				                    )
				                )
				            ),
				
				    FxNumberListText =
				        (InputList as list) as nullable text =>
				            let
				                CleanList = FxDistinctPositiveNumberList(InputList),
				                TextList =
				                    List.Transform(
				                        CleanList,
				                        each Number.ToText(_, "0.#####", "en-US")
				                    )
				            in
				                if List.Count(TextList) = 0 then null else Text.Combine(TextList, ", "),
				
				    FxMinDate =
				        (InputList as list) as nullable date =>
				            let
				                CleanList = List.RemoveNulls(List.Transform(InputList, each FxDate(_)))
				            in
				                if List.Count(CleanList) = 0 then null else List.Min(CleanList),
				
				    FxMaxDate =
				        (InputList as list) as nullable date =>
				            let
				                CleanList = List.RemoveNulls(List.Transform(InputList, each FxDate(_)))
				            in
				                if List.Count(CleanList) = 0 then null else List.Max(CleanList),
				
				    FxHasPONo =
				        (PONo as any) as logical =>
				            let
				                T = FxUpperText(PONo)
				            in
				                T <> ""
				                    and T <> "NO PO DEFINED"
				                    and T <> "NO_PO"
				                    and T <> "N/A"
				                    and T <> "NA"
				                    and T <> "NULL",
				
				    FxMatchKey =
				        (Article as any, Warehouse as any, PONo as any) as text =>
				            FxSafeText(Article)
				                & "|"
				                & FxSafeText(Warehouse)
				                & "|"
				                & FxSafeText(PONo),
				
				    POSelected =
				        Table.SelectColumns(
				            PO,
				            {
				                "PO Period ID",
				                "PO Period Source",
				                "Article",
				                "Warehouse",
				                "PO No",
				                "Final Cost Center",
				                "PO Supplier",
				                "PO Supplier List",
				                "PO Unit List",
				                "PO Base Unit List",
				                "PO Date",
				                "PO Start Date",
				                "Next PO Date",
				                "PO End Date",
				                "PO Base Qty",
				                "PO Value",
				                "PO Count",
				                "PO Line Count"
				            },
				            MissingField.Ignore
				        ),
				
				    POReady =
				        Table.SelectRows(
				            POSelected,
				            each
				                [PO Period ID] <> null
				                and [PO Period ID] <> ""
				                and [Article] <> null
				                and [Article] <> ""
				                and [Warehouse] <> null
				                and [Warehouse] <> ""
				                and [PO No] <> null
				                and [PO No] <> ""
				                and [PO Start Date] <> null
				                and [PO End Date] <> null
				        ),
				
				    POWithMatchKey =
				        Table.AddColumn(
				            POReady,
				            "__Match Key",
				            each FxMatchKey([Article], [Warehouse], [PO No]),
				            type text
				        ),
				
				    POForGrouping =
				        Table.SelectColumns(
				            POWithMatchKey,
				            {
				                "__Match Key",
				                "PO Period ID",
				                "PO Period Source",
				                "PO No",
				                "Final Cost Center",
				                "PO Supplier",
				                "PO Supplier List",
				                "PO Unit List",
				                "PO Base Unit List",
				                "PO Date",
				                "PO Start Date",
				                "Next PO Date",
				                "PO End Date",
				                "PO Base Qty",
				                "PO Value",
				                "PO Count",
				                "PO Line Count"
				            },
				            MissingField.Ignore
				        ),
				
				    POGrouped =
				        Table.Buffer(
				            Table.Group(
				                POForGrouping,
				                {"__Match Key"},
				                {
				                    {
				                        "PO Candidates",
				                        each
				                            Table.Sort(
				                                _,
				                                {
				                                    {"PO Start Date", Order.Descending},
				                                    {"PO End Date", Order.Ascending}
				                                }
				                            ),
				                        type table
				                    },
				                    {
				                        "PO Candidate Count",
				                        each Table.RowCount(_),
				                        Int64.Type
				                    }
				                }
				            )
				        ),
				
				    GRNReady =
				        Table.SelectRows(
				            GRN,
				            each
				                [Article] <> null
				                and [Article] <> ""
				                and [Warehouse] <> null
				                and [Warehouse] <> ""
				                and [GRN Delivery Date] <> null
				                and [GRN Base Qty] <> null
				                and [GRN Line ID] <> null
				                and [GRN Line ID] <> ""
				        ),
				
				    GRNWithIndex =
				        Table.AddIndexColumn(
				            GRNReady,
				            "__GRN Row Index",
				            1,
				            1,
				            Int64.Type
				        ),
				
				    GRNWithMatchKey =
				        Table.AddColumn(
				            GRNWithIndex,
				            "__Match Key",
				            each FxMatchKey([Article], [Warehouse], [GRN PO No]),
				            type text
				        ),
				
				    MergePOGroup =
				        Table.NestedJoin(
				            GRNWithMatchKey,
				            {"__Match Key"},
				            POGrouped,
				            {"__Match Key"},
				            "PO Group",
				            JoinKind.LeftOuter
				        ),
				
				    ExpandPOGroup =
				        Table.ExpandTableColumn(
				            MergePOGroup,
				            "PO Group",
				            {"PO Candidates", "PO Candidate Count"},
				            {"PO Candidates", "PO Candidate Count"}
				        ),
				
				    ReplaceNullCandidateCount =
				        Table.ReplaceValue(
				            ExpandPOGroup,
				            null,
				            0,
				            Replacer.ReplaceValue,
				            {"PO Candidate Count"}
				        ),
				
				    AddSelectedPO =
				        Table.AddColumn(
				            ReplaceNullCandidateCount,
				            "__Selected PO",
				            each
				                let
				                    GrnDate = FxDate([GRN Delivery Date]),
				                    Candidates = try [PO Candidates] otherwise null,
				
				                    MatchedCandidates =
				                        if Candidates = null or GrnDate = null then
				                            #table({}, {})
				                        else
				                            Table.SelectRows(
				                                Candidates,
				                                each
				                                    FxDate([PO Start Date]) <> null
				                                    and FxDate([PO End Date]) <> null
				                                    and GrnDate >= FxDate([PO Start Date])
				                                    and GrnDate <= FxDate([PO End Date])
				                            ),
				
				                    SortedMatched =
				                        if Table.IsEmpty(MatchedCandidates) then
				                            MatchedCandidates
				                        else
				                            Table.Sort(
				                                MatchedCandidates,
				                                {
				                                    {"PO Start Date", Order.Descending},
				                                    {"PO End Date", Order.Ascending}
				                                }
				                            ),
				
				                    Result =
				                        if Table.IsEmpty(SortedMatched) then
				                            null
				                        else
				                            SortedMatched{0}
				                in
				                    Result,
				            type nullable record
				        ),
				
				    MatchedRows =
				        Table.SelectRows(
				            AddSelectedPO,
				            each [__Selected PO] <> null
				        ),
				
				    MatchedExpandedPO =
				        Table.ExpandRecordColumn(
				            MatchedRows,
				            "__Selected PO",
				            {
				                "PO Period ID",
				                "PO Period Source",
				                "PO No",
				                "Final Cost Center",
				                "PO Supplier",
				                "PO Supplier List",
				                "PO Unit List",
				                "PO Base Unit List",
				                "PO Date",
				                "PO Start Date",
				                "Next PO Date",
				                "PO End Date",
				                "PO Base Qty",
				                "PO Value",
				                "PO Count",
				                "PO Line Count"
				            },
				            {
				                "PO Period ID",
				                "PO Period Source",
				                "Matched PO No",
				                "Final Cost Center",
				                "PO Supplier",
				                "PO Supplier List",
				                "PO Unit List",
				                "PO Base Unit List",
				                "PO Date",
				                "PO Start Date",
				                "Next PO Date",
				                "PO End Date",
				                "PO Base Qty",
				                "PO Value",
				                "PO Count",
				                "PO Line Count"
				            }
				        ),
				
				    MatchedAddPOPeriodBaseQty =
				        Table.AddColumn(
				            MatchedExpandedPO,
				            "PO Period Base Qty",
				            each [PO Base Qty],
				            type nullable number
				        ),
				
				    MatchedAddPOPeriodValue =
				        Table.AddColumn(
				            MatchedAddPOPeriodBaseQty,
				            "PO Period Value",
				            each [PO Value],
				            type nullable number
				        ),
				
				    MatchedAddAllocatedGRNBaseQty =
				        Table.AddColumn(
				            MatchedAddPOPeriodValue,
				            "Allocated GRN Base Qty",
				            each [GRN Base Qty],
				            type nullable number
				        ),
				
				    MatchedAddAllocatedGRNQty =
				        Table.AddColumn(
				            MatchedAddAllocatedGRNBaseQty,
				            "Allocated GRN Qty",
				            each [GRN Qty],
				            type nullable number
				        ),
				
				    MatchedAddSameDayGRNBaseQty =
				        Table.AddColumn(
				            MatchedAddAllocatedGRNQty,
				            "Same Day GRN Base Qty",
				            each
				                if FxDate([GRN Delivery Date]) = FxDate([PO Start Date]) then
				                    [GRN Base Qty]
				                else
				                    0,
				            type nullable number
				        ),
				
				    MatchedAddLateGRNBaseQty =
				        Table.AddColumn(
				            MatchedAddSameDayGRNBaseQty,
				            "Late GRN Base Qty",
				            each
				                if FxDate([GRN Delivery Date]) > FxDate([PO Start Date]) then
				                    [GRN Base Qty]
				                else
				                    0,
				            type nullable number
				        ),
				
				    MatchedAddDaysAfterPO =
				        Table.AddColumn(
				            MatchedAddLateGRNBaseQty,
				            "Days After PO",
				            each
				                if [GRN Delivery Date] = null or [PO Start Date] = null then
				                    null
				                else
				                    Duration.Days(FxDate([GRN Delivery Date]) - FxDate([PO Start Date])),
				            Int64.Type
				        ),
				
				    MatchedAddGRNTimingStatus =
				        Table.AddColumn(
				            MatchedAddDaysAfterPO,
				            "GRN Timing Status",
				            each
				                if [GRN Delivery Date] = null or [PO Start Date] = null then
				                    null
				                else if FxDate([GRN Delivery Date]) = FxDate([PO Start Date]) then
				                    "Same Day"
				                else if FxDate([GRN Delivery Date]) > FxDate([PO Start Date]) then
				                    "Late"
				                else
				                    "Early",
				            type nullable text
				        ),
				
				    MatchedAddGRNBookingDate =
				        Table.AddColumn(
				            MatchedAddGRNTimingStatus,
				            "GRN Booking Date",
				            each
				                if [Booking DateTime] = null then
				                    null
				                else
				                    Date.From([Booking DateTime]),
				            type nullable date
				        ),
				
				    MatchedAddBookingDelayDays =
				        Table.AddColumn(
				            MatchedAddGRNBookingDate,
				            "Booking Delay Days",
				            each
				                let
				                    DeliveryDate = FxDate([GRN Delivery Date]),
				                    BookingDate = FxDate([GRN Booking Date])
				                in
				                    if DeliveryDate = null or BookingDate = null then
				                        null
				                    else
				                        Duration.Days(BookingDate - DeliveryDate),
				            Int64.Type
				        ),
				
				    MatchedAddGRNMatchStatus =
				        Table.AddColumn(
				            MatchedAddBookingDelayDays,
				            "GRN Match Status",
				            each "Matched Active PO",
				            type text
				        ),
				
				    MatchedAddInboundMatchStatus =
				        Table.AddColumn(
				            MatchedAddGRNMatchStatus,
				            "Inbound Match Status",
				            each "Matched",
				            type text
				        ),
				
				    MatchedAddGRNMatchKey =
				        Table.AddColumn(
				            MatchedAddInboundMatchStatus,
				            "GRN Match Key",
				            each FxMatchKey([Article], [Warehouse], [GRN PO No]),
				            type text
				        ),
				
				    MatchedAddDetailSource =
				        Table.AddColumn(
				            MatchedAddGRNMatchKey,
				            "GRN Detail Source",
				            each "Matched GRN Detail",
				            type text
				        ),
				
				    MatchedClean =
				        Table.RemoveColumns(
				            MatchedAddDetailSource,
				            {
				                "__GRN Row Index",
				                "__Match Key",
				                "PO Candidates",
				                "PO Candidate Count"
				            },
				            MissingField.Ignore
				        ),
				
				    NonMatchedRowsBase =
				        Table.SelectRows(
				            AddSelectedPO,
				            each
				                [__Selected PO] = null
				                and FxNum([GRN Base Qty]) <> null
				                and FxNum([GRN Base Qty]) > 0
				        ),
				
				    NonMatchedAddRecoveredPONo =
				        Table.AddColumn(
				            NonMatchedRowsBase,
				            "__Recovered PO No",
				            each
				                if FxHasPONo([GRN PO No]) then
				                    FxSafeText([GRN PO No])
				                else
				                    "NO PO DEFINED",
				            type text
				        ),
				
				    NonMatchedAddRecoveredRequiredBaseQty =
				        Table.AddColumn(
				            NonMatchedAddRecoveredPONo,
				            "__Recovered Required Base Qty",
				            each
				                let
				                    ReqBase = FxNum([Requested Base Qty]),
				                    GrnBase = FxNum([GRN Base Qty])
				                in
				                    if ReqBase <> null and ReqBase > 0 then
				                        ReqBase
				                    else
				                        GrnBase,
				            type nullable number
				        ),
				
				    NonMatchedFilteredUsable =
				        Table.SelectRows(
				            NonMatchedAddRecoveredRequiredBaseQty,
				            each
				                FxNum([__Recovered Required Base Qty]) <> null
				                and FxNum([__Recovered Required Base Qty]) > 0
				        ),
				
				    NonMatchedAddRecoveryGroupID =
				        Table.AddColumn(
				            NonMatchedFilteredUsable,
				            "__Recovery Group ID",
				            each
				                "RECOVERED|"
				                    & FxSafeText([Article])
				                    & "|"
				                    & FxSafeText([Warehouse])
				                    & "|"
				                    & FxSafeText([__Recovered PO No]),
				            type text
				        ),
				
				    NonMatchedGroupStats =
				        Table.Buffer(
				            Table.Group(
				                NonMatchedAddRecoveryGroupID,
				                {"__Recovery Group ID"},
				                {
				                    {"__Recovered Group PO Start Date", each FxMinDate([GRN Delivery Date]), type nullable date},
				                    {"__Recovered Group PO End Date", each FxMaxDate([GRN Delivery Date]), type nullable date},
				
				                    {
				                        "__Recovered Group Required Base Qty",
				                        each
				                            let
				                                ReqDistinct = FxDistinctPositiveNumberList([Requested Base Qty]),
				                                GrnList = FxPositiveNumberList([GRN Base Qty])
				                            in
				                                if List.Count(ReqDistinct) = 1 then ReqDistinct{0}
				                                else if List.Count(ReqDistinct) > 1 then null
				                                else if List.Count(GrnList) > 0 then List.Sum(GrnList)
				                                else null,
				                        type nullable number
				                    },
				
				                    {
				                        "__Recovered Group Required Qty",
				                        each
				                            let
				                                ReqDistinct = FxDistinctPositiveNumberList([Requested QTY]),
				                                GrnList = FxPositiveNumberList([GRN Qty])
				                            in
				                                if List.Count(ReqDistinct) = 1 then ReqDistinct{0}
				                                else if List.Count(ReqDistinct) > 1 then null
				                                else if List.Count(GrnList) > 0 then List.Sum(GrnList)
				                                else null,
				                        type nullable number
				                    },
				
				                    {
				                        "Requested Qty Conflict Flag",
				                        each
				                            let
				                                ReqQtyDistinct = FxDistinctPositiveNumberList([Requested QTY]),
				                                ReqBaseDistinct = FxDistinctPositiveNumberList([Requested Base Qty])
				                            in
				                                if List.Count(ReqQtyDistinct) > 1 or List.Count(ReqBaseDistinct) > 1 then 1 else 0,
				                        Int64.Type
				                    },
				
				                    {
				                        "Requested Qty Conflict Status",
				                        each
				                            let
				                                ReqQtyDistinct = FxDistinctPositiveNumberList([Requested QTY]),
				                                ReqBaseDistinct = FxDistinctPositiveNumberList([Requested Base Qty]),
				                                HasRequest = List.Count(ReqQtyDistinct) > 0 or List.Count(ReqBaseDistinct) > 0,
				                                HasConflict = List.Count(ReqQtyDistinct) > 1 or List.Count(ReqBaseDistinct) > 1
				                            in
				                                if HasConflict then "Requested Qty Conflict"
				                                else if HasRequest then "No Conflict"
				                                else "No Delivery Note Requested Qty",
				                        type text
				                    },
				
				                    {"Requested Qty Distinct Count", each List.Count(FxDistinctPositiveNumberList([Requested QTY])), Int64.Type},
				                    {"Requested Base Qty Distinct Count", each List.Count(FxDistinctPositiveNumberList([Requested Base Qty])), Int64.Type},
				                    {"Requested Qty List", each FxNumberListText([Requested QTY]), type nullable text},
				                    {"Requested Base Qty List", each FxNumberListText([Requested Base Qty]), type nullable text}
				                }
				            )
				        ),
				
				    NonMatchedMergeGroupStats =
				        Table.NestedJoin(
				            NonMatchedAddRecoveryGroupID,
				            {"__Recovery Group ID"},
				            NonMatchedGroupStats,
				            {"__Recovery Group ID"},
				            "__Recovered Group Stats",
				            JoinKind.LeftOuter
				        ),
				
				    NonMatchedExpandGroupStats =
				        Table.ExpandTableColumn(
				            NonMatchedMergeGroupStats,
				            "__Recovered Group Stats",
				            {
				                "__Recovered Group PO Start Date",
				                "__Recovered Group PO End Date",
				                "__Recovered Group Required Base Qty",
				                "__Recovered Group Required Qty",
				                "Requested Qty Conflict Flag",
				                "Requested Qty Conflict Status",
				                "Requested Qty Distinct Count",
				                "Requested Base Qty Distinct Count",
				                "Requested Qty List",
				                "Requested Base Qty List"
				            },
				            {
				                "__Recovered Group PO Start Date",
				                "__Recovered Group PO End Date",
				                "__Recovered Group Required Base Qty",
				                "__Recovered Group Required Qty",
				                "Requested Qty Conflict Flag",
				                "Requested Qty Conflict Status",
				                "Requested Qty Distinct Count",
				                "Requested Base Qty Distinct Count",
				                "Requested Qty List",
				                "Requested Base Qty List"
				            }
				        ),
				
				    NonMatchedAddPOPeriodID =
				        Table.AddColumn(
				            NonMatchedExpandGroupStats,
				            "PO Period ID",
				            each [__Recovery Group ID],
				            type text
				        ),
				
				    NonMatchedAddPOPeriodSource =
				        Table.AddColumn(
				            NonMatchedAddPOPeriodID,
				            "PO Period Source",
				            each "Recovered From GRN",
				            type text
				        ),
				
				    NonMatchedAddInboundMatchStatus =
				        Table.AddColumn(
				            NonMatchedAddPOPeriodSource,
				            "Inbound Match Status",
				            each "Non-Matched",
				            type text
				        ),
				
				    NonMatchedAddGRNMatchStatus =
				        Table.AddColumn(
				            NonMatchedAddInboundMatchStatus,
				            "GRN Match Status",
				            each
				                if FxHasPONo([GRN PO No]) = false then
				                    "No PO Defined"
				                else if [PO Candidate Count] = 0 then
				                    "No Active PO Match"
				                else
				                    "PO No Found But Outside Active Period",
				            type text
				        ),
				
				    NonMatchedAddGRNMatchKey =
				        Table.AddColumn(
				            NonMatchedAddGRNMatchStatus,
				            "GRN Match Key",
				            each FxMatchKey([Article], [Warehouse], [GRN PO No]),
				            type text
				        ),
				
				    NonMatchedAddMatchedPONo =
				        Table.AddColumn(
				            NonMatchedAddGRNMatchKey,
				            "Matched PO No",
				            each null,
				            type nullable text
				        ),
				
				    NonMatchedAddFinalCostCenter =
				        Table.AddColumn(
				            NonMatchedAddMatchedPONo,
				            "Final Cost Center",
				            each null,
				            type nullable text
				        ),
				
				    NonMatchedAddPOSupplier =
				        Table.AddColumn(
				            NonMatchedAddFinalCostCenter,
				            "PO Supplier",
				            each null,
				            type nullable text
				        ),
				
				    NonMatchedAddPOSupplierList =
				        Table.AddColumn(
				            NonMatchedAddPOSupplier,
				            "PO Supplier List",
				            each null,
				            type nullable text
				        ),
				
				    NonMatchedAddPOUnitList =
				        Table.AddColumn(
				            NonMatchedAddPOSupplierList,
				            "PO Unit List",
				            each null,
				            type nullable text
				        ),
				
				    NonMatchedAddPOBaseUnitList =
				        Table.AddColumn(
				            NonMatchedAddPOUnitList,
				            "PO Base Unit List",
				            each [GRN Base Unit],
				            type nullable text
				        ),
				
				    NonMatchedAddPODate =
				        Table.AddColumn(
				            NonMatchedAddPOBaseUnitList,
				            "PO Date",
				            each FxDate([DN Order Date]),
				            type nullable date
				        ),
				
				    NonMatchedAddPOStartDate =
				        Table.AddColumn(
				            NonMatchedAddPODate,
				            "PO Start Date",
				            each [__Recovered Group PO Start Date],
				            type nullable date
				        ),
				
				    NonMatchedAddNextPODate =
				        Table.AddColumn(
				            NonMatchedAddPOStartDate,
				            "Next PO Date",
				            each null,
				            type nullable date
				        ),
				
				    NonMatchedAddPOEndDate =
				        Table.AddColumn(
				            NonMatchedAddNextPODate,
				            "PO End Date",
				            each [__Recovered Group PO End Date],
				            type nullable date
				        ),
				
				    NonMatchedAddPOBaseQty =
				        Table.AddColumn(
				            NonMatchedAddPOEndDate,
				            "PO Base Qty",
				            each [__Recovered Group Required Base Qty],
				            type nullable number
				        ),
				
				    NonMatchedAddPOPeriodBaseQty =
				        Table.AddColumn(
				            NonMatchedAddPOBaseQty,
				            "PO Period Base Qty",
				            each [PO Base Qty],
				            type nullable number
				        ),
				
				    NonMatchedAddPOValue =
				        Table.AddColumn(
				            NonMatchedAddPOPeriodBaseQty,
				            "PO Value",
				            each null,
				            type nullable number
				        ),
				
				    NonMatchedAddPOPeriodValue =
				        Table.AddColumn(
				            NonMatchedAddPOValue,
				            "PO Period Value",
				            each null,
				            type nullable number
				        ),
				
				    NonMatchedAddPOCount =
				        Table.AddColumn(
				            NonMatchedAddPOPeriodValue,
				            "PO Count",
				            each 1,
				            Int64.Type
				        ),
				
				    NonMatchedAddPOLineCount =
				        Table.AddColumn(
				            NonMatchedAddPOCount,
				            "PO Line Count",
				            each 0,
				            Int64.Type
				        ),
				
				    NonMatchedAddAllocatedGRNQty =
				        Table.AddColumn(
				            NonMatchedAddPOLineCount,
				            "Allocated GRN Qty",
				            each [GRN Qty],
				            type nullable number
				        ),
				
				    NonMatchedAddAllocatedGRNBaseQty =
				        Table.AddColumn(
				            NonMatchedAddAllocatedGRNQty,
				            "Allocated GRN Base Qty",
				            each [GRN Base Qty],
				            type nullable number
				        ),
				
				    NonMatchedAddSameDayGRNBaseQty =
				        Table.AddColumn(
				            NonMatchedAddAllocatedGRNBaseQty,
				            "Same Day GRN Base Qty",
				            each
				                if FxDate([GRN Delivery Date]) <> null
				                    and [__Recovered Group PO Start Date] <> null
				                    and FxDate([GRN Delivery Date]) = [__Recovered Group PO Start Date]
				                then [GRN Base Qty]
				                else 0,
				            type number
				        ),
				
				    NonMatchedAddLateGRNBaseQty =
				        Table.AddColumn(
				            NonMatchedAddSameDayGRNBaseQty,
				            "Late GRN Base Qty",
				            each
				                if FxDate([GRN Delivery Date]) <> null
				                    and [__Recovered Group PO Start Date] <> null
				                    and FxDate([GRN Delivery Date]) > [__Recovered Group PO Start Date]
				                then [GRN Base Qty]
				                else 0,
				            type number
				        ),
				
				    NonMatchedAddDaysAfterPO =
				        Table.AddColumn(
				            NonMatchedAddLateGRNBaseQty,
				            "Days After PO",
				            each
				                if FxDate([GRN Delivery Date]) = null or [__Recovered Group PO Start Date] = null then
				                    null
				                else
				                    Duration.Days(FxDate([GRN Delivery Date]) - [__Recovered Group PO Start Date]),
				            Int64.Type
				        ),
				
				    NonMatchedAddGRNTimingStatus =
				        Table.AddColumn(
				            NonMatchedAddDaysAfterPO,
				            "GRN Timing Status",
				            each
				                if FxDate([GRN Delivery Date]) = null or [__Recovered Group PO Start Date] = null then
				                    "Non-Matched"
				                else if FxDate([GRN Delivery Date]) = [__Recovered Group PO Start Date] then
				                    "Same Day"
				                else if FxDate([GRN Delivery Date]) > [__Recovered Group PO Start Date] then
				                    "Late"
				                else
				                    "Early",
				            type text
				        ),
				
				    NonMatchedAddGRNBookingDate =
				        Table.AddColumn(
				            NonMatchedAddGRNTimingStatus,
				            "GRN Booking Date",
				            each
				                if [Booking DateTime] = null then
				                    null
				                else
				                    Date.From([Booking DateTime]),
				            type nullable date
				        ),
				
				    NonMatchedAddBookingDelayDays =
				        Table.AddColumn(
				            NonMatchedAddGRNBookingDate,
				            "Booking Delay Days",
				            each
				                let
				                    DeliveryDate = FxDate([GRN Delivery Date]),
				                    BookingDate = FxDate([GRN Booking Date])
				                in
				                    if DeliveryDate = null or BookingDate = null then
				                        null
				                    else
				                        Duration.Days(BookingDate - DeliveryDate),
				            Int64.Type
				        ),
				
				    NonMatchedAddDetailSource =
				        Table.AddColumn(
				            NonMatchedAddBookingDelayDays,
				            "GRN Detail Source",
				            each "Recovered GRN Detail",
				            type text
				        ),
				
				    NonMatchedClean =
				        Table.RemoveColumns(
				            NonMatchedAddDetailSource,
				            {
				                "__GRN Row Index",
				                "__Match Key",
				                "__Selected PO",
				                "PO Candidates",
				                "PO Candidate Count",
				                "__Recovered PO No",
				                "__Recovered Required Base Qty",
				                "__Recovery Group ID",
				                "__Recovered Group PO Start Date",
				                "__Recovered Group PO End Date",
				                "__Recovered Group Required Base Qty",
				                "__Recovered Group Required Qty"
				            },
				            MissingField.Ignore
				        ),
				
				    FinalColumnList =
				        List.Union(
				            {
				                Table.ColumnNames(MatchedClean),
				                Table.ColumnNames(NonMatchedClean)
				            }
				        ),
				
				    MatchedAligned =
				        Table.SelectColumns(
				            MatchedClean,
				            FinalColumnList,
				            MissingField.UseNull
				        ),
				
				    NonMatchedAligned =
				        Table.SelectColumns(
				            NonMatchedClean,
				            FinalColumnList,
				            MissingField.UseNull
				        ),
				
				    CombinedRows =
				        Table.Combine(
				            {
				                MatchedAligned,
				                NonMatchedAligned
				            }
				        ),
				
				    FinalColumnOrder =
				        Table.ReorderColumns(
				            CombinedRows,
				            {
				                "PO Period ID",
				                "PO Period Source",
				                "Inbound Match Status",
				                "GRN Match Status",
				                "GRN Detail Source",
				                "GRN Match Key",
				
				                "Article No.",
				                "Article",
				                "Article Key",
				                "Original Purchase Article No.",
				                "Original Purchase Article",
				                "Original Purchase Article Key",
				                "Manager Stock Article",
				                "Manager Stock Article No.",
				                "Article Mapping Status",
				
				                "Supplier",
				                "Supplier Key",
