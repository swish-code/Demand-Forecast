	column 'CC Item Location Key'
		lineageTag: d53ba4d2-50f0-4203-81d3-9d415b19dcd2
		summarizeBy: none
		isNameInferred
		sourceColumn: [CC Item Location Key]

		annotation SummarizationSetBy = Automatic

	partition 'CC Item Location' = calculated
		mode: import
		source =
				
				VAR BaseRows =
				    FILTER (
				        'cc_daily_inventory',
				        NOT ISBLANK ( 'cc_daily_inventory'[Location] )
				            && NOT ISBLANK ( 'cc_daily_inventory'[Article] )
				    )
				
				VAR ItemRows =
				    SUMMARIZE (
				        BaseRows,
				        'cc_daily_inventory'[Location],
				        'cc_daily_inventory'[Article No.],
				        'cc_daily_inventory'[Article]
				    )
				
				VAR WithCleanColumns =
				    ADDCOLUMNS (
				        ItemRows,
				        "Location Key", UPPER ( TRIM ( [Location] & "" ) ),
				        "Article No Key", TRIM ( [Article No.] & "" ),
				        "Article Key", UPPER ( TRIM ( [Article] & "" ) ),
				        "Base Unit",
				            VAR RawUnit =
				                CALCULATE (
				                    FIRSTNONBLANK ( 'cc_daily_inventory'[Base Unit], 1 )
				                )
				            VAR U =
				                UPPER ( TRIM ( RawUnit & "" ) )
				            RETURN
				                SWITCH (
				                    TRUE (),
				                    U IN { "KG", "KGS", "KILOGRAM", "KILOGRAMS" }, "KG",
				                    U IN { "LITER", "LITRE", "LTR", "LITERS", "LITRES", "LTRS" }, "LITER",
				                    U IN { "EACH", "EA", "PCS", "PC", "PIECE", "PIECES" }, "EACH",
				                    RawUnit
				                )
				    )
				
				RETURN
				    ADDCOLUMNS (
				        WithCleanColumns,
				        "CC Item Location Key",
				            [Location Key]
				                & "|"
				                & IF ( [Article No Key] <> "", [Article No Key], [Article Key] )
				    )

	annotation PBI_Id = ed895d35b16d4988a06866cfcc2608f4

