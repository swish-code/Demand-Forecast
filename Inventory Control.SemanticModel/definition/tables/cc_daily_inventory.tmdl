table cc_daily_inventory
	lineageTag: f94acadc-8215-46c0-b3e1-812ca379059e

	measure 'CC Open PO Qty' =
			
			VAR EndDate =
			    [CC End Date]
			
			VAR SelectedLocationKeys =
			    VALUES ( 'CC Item Location'[Location Key] )
			
			VAR SelectedArticleKeys =
			    VALUES ( 'CC Item Location'[Article Key] )
			
			VAR OpenPOGrain =
			    SELECTCOLUMNS (
			        CALCULATETABLE (
			            SUMMARIZE (
			                'CC Open PO Core',
			                'CC Open PO Core'[PO No],
			                'CC Open PO Core'[PO Date],
			                'CC Open PO Core'[Location],
			                'CC Open PO Core'[Article]
			            ),
			            REMOVEFILTERS ( 'CC Open PO Core' ),
			            'CC Open PO Core'[PO Date] <= EndDate,
			            TREATAS (
			                SelectedLocationKeys,
			                'CC Open PO Core'[Location Key]
			            ),
			            TREATAS (
			                SelectedArticleKeys,
			                'CC Open PO Core'[Article Key]
			            )
			        ),
			        "__PO No", 'CC Open PO Core'[PO No],
			        "__PO Date", 'CC Open PO Core'[PO Date],
			        "__Location", 'CC Open PO Core'[Location],
			        "__Article", 'CC Open PO Core'[Article]
			    )
			
			VAR PendingQty =
			    SUMX (
			        OpenPOGrain,
			        VAR CurrentPONo =
			            [__PO No]
			
			        VAR CurrentPODate =
			            [__PO Date]
			
			        VAR CurrentLocation =
			            [__Location]
			
			        VAR CurrentArticle =
			            [__Article]
			
			        VAR LifecycleRows =
			            FILTER (
			                ALL ( 'fact_po_period_lifecycle' ),
			                'fact_po_period_lifecycle'[Inbound Match Status] = "Matched"
			                    && 'fact_po_period_lifecycle'[PO No] = CurrentPONo
			                    && 'fact_po_period_lifecycle'[PO Date] = CurrentPODate
			                    && 'fact_po_period_lifecycle'[Warehouse] = CurrentLocation
			                    && 'fact_po_period_lifecycle'[Article] = CurrentArticle
			            )
			
			        VAR ReqQty =
			            MAXX (
			                LifecycleRows,
			                COALESCE ( 'fact_po_period_lifecycle'[PO Base Qty], 0 )
			            )
			
			        VAR GRNQty =
			            SUMX (
			                LifecycleRows,
			                COALESCE ( 'fact_po_period_lifecycle'[Allocated GRN Base Qty], 0 )
			            )
			
			        RETURN
			            MAX ( ReqQty - GRNQty, 0 )
			    )
			
			RETURN
			    IF (
			        ISBLANK ( EndDate ),
			        0,
			        PendingQty
			    )
		lineageTag: 9c92b379-63f3-4a70-baf1-e9f238409d87

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'CC Open PO Received Qty' =
			
			VAR EndDate =
			    [CC End Date]
			
			VAR SelectedLocationKeys =
			    VALUES ( 'CC Item Location'[Location Key] )
			
			VAR SelectedArticleKeys =
			    VALUES ( 'CC Item Location'[Article Key] )
			
			VAR OpenPOKeys =
			    CALCULATETABLE (
			        VALUES ( 'CC Open PO Core'[PO Article Location Key] ),
			        REMOVEFILTERS ( 'CC Open PO Core' ),
			        'CC Open PO Core'[PO Date] <= EndDate,
			        TREATAS (
			            SelectedLocationKeys,
			            'CC Open PO Core'[Location Key]
			        ),
			        TREATAS (
			            SelectedArticleKeys,
			            'CC Open PO Core'[Article Key]
			        )
			    )
			
			RETURN
			    IF (
			        ISBLANK ( EndDate ),
			        0,
			        COALESCE (
			            CALCULATE (
			                SUM ( 'CC PO Receipt Core'[Received Base Qty] ),
			                REMOVEFILTERS ( 'CC PO Receipt Core' ),
			                'CC PO Receipt Core'[Receipt Date] <= EndDate,
			                TREATAS (
			                    OpenPOKeys,
			                    'CC PO Receipt Core'[PO Article Location Key]
			                )
			            ),
			            0
			        )
			    )
		lineageTag: af227d67-3e3e-4e3b-9ba2-ae8decce64f6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'CC Open PO Remaining Qty' =
			
			VAR OpenQty =
			    [CC Open PO Qty]
			
			VAR ReceivedQty =
			    [CC Open PO Received Qty]
			
			VAR RemainingQty =
			    OpenQty - ReceivedQty
			
			RETURN
			    IF (
			        RemainingQty > 0,
			        RemainingQty,
			        0
			    )
		lineageTag: 710b68c5-755d-44d2-89e7-513965f28add

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'CC Supplier Coverage Days' =
			
			VAR RemainingPOQty =
			    [CC Open PO Remaining Qty]
			
			VAR AvgTransferOut =
			    [CC Average Transfer Out Qty]
			
			RETURN
			    IF (
			        RemainingPOQty <= 0 || AvgTransferOut <= 0,
			        BLANK (),
			        DIVIDE (
			            RemainingPOQty,
			            AvgTransferOut
			        )
			    )
		lineageTag: 0223ea4f-1347-4353-9b6c-fb8598e5d645

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'CC Supplier Coverage Category' =
			
			VAR RemainingPOQty =
			    [CC Open PO Remaining Qty]
			
			VAR AvgTransferOut =
			    [CC Average Transfer Out Qty]
			
			VAR SupplierDays =
			    [CC Supplier Coverage Days]
			
			RETURN
			    SWITCH (
			        TRUE (),
			        RemainingPOQty <= 0, "No Open PO",
			        AvgTransferOut <= 0, "No Outbound",
			        SupplierDays <= 7, "7 days",
			        SupplierDays <= 14, "8-14 days",
			        SupplierDays <= 21, "15-21 days",
			        SupplierDays <= 28, "22-28 days",
			        "More than 29 days"
			    )
		lineageTag: 7b59f518-96ce-465d-a667-5f2e758a2408

	measure 'CC Combined Coverage Days' =
			
			VAR ClosingQty =
			    [CC Closing Stock]
			
			VAR RemainingPOQty =
			    [CC Open PO Remaining Qty]
			
			VAR AvgTransferOut =
			    [CC Average Transfer Out Qty]
			
			VAR TotalAvailableQty =
			    ClosingQty + RemainingPOQty
			
			RETURN
			    IF (
			        TotalAvailableQty <= 0 || AvgTransferOut <= 0,
			        BLANK (),
			        DIVIDE (
			            TotalAvailableQty,
			            AvgTransferOut
			        )
			    )
		lineageTag: b3c43174-4f57-4e3f-ad2d-2936ea14bfce

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Measure 8'
		lineageTag: b7b598c9-70bc-426c-a7ba-84c1aa65f6ec

		annotation 43dbc3e8-3a1c-4b6f-9923-b49ff7d6691c = True

	measure 'CC Combined Coverage Category' =
			
			VAR ClosingQty =
			    [CC Closing Stock]
			
			VAR RemainingPOQty =
			    [CC Open PO Remaining Qty]
			
			VAR AvgTransferOut =
			    [CC Average Transfer Out Qty]
			
			VAR CombinedDays =
			    [CC Combined Coverage Days]
			
			VAR TotalAvailableQty =
			    ClosingQty + RemainingPOQty
			
			RETURN
			    SWITCH (
			        TRUE (),
			        TotalAvailableQty <= 0, "No SOH + No PO",
			        AvgTransferOut <= 0, "No Outbound",
			        CombinedDays <= 7, "7 days",
			        CombinedDays <= 14, "8-14 days",
			        CombinedDays <= 21, "15-21 days",
			        CombinedDays <= 28, "22-28 days",
			        "More than 29 days"
			    )
		lineageTag: bf04efef-3303-4137-9d0f-4674a711851b

	measure 'Measure 9'
		lineageTag: a20038f3-7f07-4afe-9d70-d7eb83612863

		annotation 43dbc3e8-3a1c-4b6f-9923-b49ff7d6691c = True

	measure 'CC Open PO Gross Qty' =
			
			VAR EndDate =
			    [CC End Date]
			
			VAR SelectedLocationKeys =
			    VALUES ( 'CC Item Location'[Location Key] )
			
			VAR SelectedArticleKeys =
			    VALUES ( 'CC Item Location'[Article Key] )
			
			RETURN
			    IF (
			        ISBLANK ( EndDate ),
			        0,
			        COALESCE (
			            CALCULATE (
			                SUM ( 'CC Open PO Core'[Open PO Base Qty] ),
			                REMOVEFILTERS ( 'CC Open PO Core' ),
			                'CC Open PO Core'[PO Date] <= EndDate,
			                TREATAS (
			                    SelectedLocationKeys,
			                    'CC Open PO Core'[Location Key]
			                ),
			                TREATAS (
			                    SelectedArticleKeys,
			                    'CC Open PO Core'[Article Key]
			                )
			            ),
			            0
			        )
			    )
		lineageTag: db01ceb0-6905-48f0-93d7-da22022ffcd7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'CC Open PO Pending Value' =
			
			VAR EndDate =
			    [CC End Date]
			
			VAR SelectedLocationKeys =
			    VALUES ( 'CC Item Location'[Location Key] )
			
			VAR SelectedArticleKeys =
			    VALUES ( 'CC Item Location'[Article Key] )
			
			VAR CurrentOpenPOQty =
			    [CC Open PO Qty]
			
			VAR OpenPOGrain =
			    SELECTCOLUMNS (
			        CALCULATETABLE (
			            ADDCOLUMNS (
			                SUMMARIZE (
			                    'CC Open PO Core',
			                    'CC Open PO Core'[PO No],
			                    'CC Open PO Core'[PO Date],
			                    'CC Open PO Core'[Location],
			                    'CC Open PO Core'[Article]
			                ),
			                "__BaseUnitPOPrice",
			                    DIVIDE (
			                        CALCULATE ( SUM ( 'CC Open PO Core'[Open PO Value] ) ),
			                        CALCULATE ( SUM ( 'CC Open PO Core'[Open PO Base Qty] ) ),
			                        0
			                    )
			            ),
			            REMOVEFILTERS ( 'CC Open PO Core' ),
			            'CC Open PO Core'[PO Date] <= EndDate,
			            TREATAS (
			                SelectedLocationKeys,
			                'CC Open PO Core'[Location Key]
			            ),
			            TREATAS (
			                SelectedArticleKeys,
			                'CC Open PO Core'[Article Key]
			            )
			        ),
			        "__PO No", 'CC Open PO Core'[PO No],
			        "__PO Date", 'CC Open PO Core'[PO Date],
			        "__Location", 'CC Open PO Core'[Location],
			        "__Article", 'CC Open PO Core'[Article],
			        "__BaseUnitPOPrice", [__BaseUnitPOPrice]
			    )
			
			VAR ResultValue =
			    SUMX (
			        OpenPOGrain,
			        VAR CurrentPONo =
			            [__PO No]
			
			        VAR CurrentPODate =
			            [__PO Date]
			
			        VAR CurrentLocation =
			            [__Location]
			
			        VAR CurrentArticle =
			            [__Article]
			
			        VAR BaseUnitPrice =
			            [__BaseUnitPOPrice]
			
			        VAR LifecycleRows =
			            FILTER (
			                ALL ( 'fact_po_period_lifecycle' ),
			                'fact_po_period_lifecycle'[Inbound Match Status] = "Matched"
			                    && 'fact_po_period_lifecycle'[PO No] = CurrentPONo
			                    && 'fact_po_period_lifecycle'[PO Date] = CurrentPODate
			                    && 'fact_po_period_lifecycle'[Warehouse] = CurrentLocation
			                    && 'fact_po_period_lifecycle'[Article] = CurrentArticle
			            )
			
			        VAR ReqQty =
			            MAXX (
			                LifecycleRows,
			                COALESCE ( 'fact_po_period_lifecycle'[PO Base Qty], 0 )
			            )
			
			        VAR GRNQty =
			            SUMX (
			                LifecycleRows,
			                COALESCE ( 'fact_po_period_lifecycle'[Allocated GRN Base Qty], 0 )
			            )
			
			        VAR PendingQty =
			            MAX ( ReqQty - GRNQty, 0 )
			
			        RETURN
			            PendingQty * BaseUnitPrice
			    )
			
			RETURN
			    IF (
			        ISBLANK ( EndDate ) || CurrentOpenPOQty <= 0,
			        BLANK (),
			        ResultValue
			    )
		formatString: #,0.0
		lineageTag: 6db17efe-d051-4628-945e-dd144b816632

	measure 'CC Utilization PO Bucket Open PO Value' =
			
			VAR SelectedSOHBuckets =
			    VALUES ( 'CC SOH Bucket'[SOH Control Category] )
			
			VAR HasSOHBucketFilter =
			    ISFILTERED ( 'CC SOH Bucket'[SOH Control Category] )
			
			VAR SelectedOutboundBuckets =
			    VALUES ( 'CC Outbound Bucket'[Outbound Consumption Category] )
			
			VAR HasOutboundBucketFilter =
			    ISFILTERED ( 'CC Outbound Bucket'[Outbound Consumption Category] )
			
			VAR SelectedWHBuckets =
			    VALUES ( 'CC Coverage Bucket'[Coverage Bucket] )
			
			VAR HasWHBucketFilter =
			    ISFILTERED ( 'CC Coverage Bucket'[Coverage Bucket] )
			
			VAR SelectedSupplierBuckets =
			    VALUES ( 'CC Supplier Coverage Bucket'[Supplier Coverage Category] )
			
			VAR HasSupplierBucketFilter =
			    ISFILTERED ( 'CC Supplier Coverage Bucket'[Supplier Coverage Category] )
			
			VAR SelectedCombinedBuckets =
			    VALUES ( 'CC Combined Coverage Bucket'[Combined Coverage Category] )
			
			VAR HasCombinedBucketFilter =
			    ISFILTERED ( 'CC Combined Coverage Bucket'[Combined Coverage Category] )
			
			VAR SelectedUtilizationBuckets =
			    VALUES ( 'CC Utilization PO Bucket'[Utilization PO Category] )
			
			VAR HasUtilizationBucketFilter =
			    ISFILTERED ( 'CC Utilization PO Bucket'[Utilization PO Category] )
			
			VAR BottomTableRows =
			    ADDCOLUMNS (
			        SUMMARIZE (
			            ALLSELECTED ( 'CC Item Location' ),
			            'CC Item Location'[Article No.],
			            'CC Item Location'[Article],
			            'CC Item Location'[Base Unit]
			        ),
			        "__ShowRow", CALCULATE ( [CC Show Row] ),
			        "__SOHCategory", CALCULATE ( [CC SOH Control Category] ),
			        "__OutboundCategory", CALCULATE ( [CC Outbound Consumption Category] ),
			        "__WHCategory", CALCULATE ( [CC Coverage Category] ),
			        "__SupplierCategory", CALCULATE ( [CC Supplier Coverage Category] ),
			        "__CombinedCategory", CALCULATE ( [CC Combined Coverage Category] ),
			        "__UtilizationCategory", CALCULATE ( [CC Utilization PO Control Category] ),
			        "__UtilizationBaseQty", CALCULATE ( [CC Purchase Qty] + [CC Open PO Qty] ),
			        "__OpenPOValue", CALCULATE ( [CC Open PO Pending Value] )
			    )
			
			RETURN
			    SUMX (
			        FILTER (
			            BottomTableRows,
			            [__ShowRow] = 1
			                && [__UtilizationBaseQty] > 0
			                && (
			                    NOT HasSOHBucketFilter
			                        || CONTAINSROW ( SelectedSOHBuckets, [__SOHCategory] )
			                )
			                && (
			                    NOT HasOutboundBucketFilter
			                        || CONTAINSROW ( SelectedOutboundBuckets, [__OutboundCategory] )
			                )
			                && (
			                    NOT HasWHBucketFilter
			                        || CONTAINSROW ( SelectedWHBuckets, [__WHCategory] )
			                )
			                && (
			                    NOT HasSupplierBucketFilter
			                        || CONTAINSROW ( SelectedSupplierBuckets, [__SupplierCategory] )
			                )
			                && (
			                    NOT HasCombinedBucketFilter
			                        || CONTAINSROW ( SelectedCombinedBuckets, [__CombinedCategory] )
			                )
			                && (
			                    NOT HasUtilizationBucketFilter
			                        || CONTAINSROW (
			                            SelectedUtilizationBuckets,
			                            [__UtilizationCategory]
			                        )
			                )
			        ),
			        [__OpenPOValue]
			    )
		formatString: #,0.0
		lineageTag: 4244e3a0-3ae9-4ca4-a78b-f57116bcae1b

	measure 'CC Open PO Qty Visual' =
			
