	partition cc_daily_inventory = m
		mode: import
		source =
				let
				    FromDateText =
				        Date.ToText(
				            Date.From(p_FromDate),
				            "yyyy-MM-dd"
				        ),
				
				    Source =
				        Oracle.Database(
				            "192.168.1.99/mc",
				            [
				                HierarchicalNavigation = true,
				                Query =
				"
				WITH lager_agg AS (
				    SELECT
				        l.KST_ID,
				        l.ART_NR AS ART_ID,
				        MAX(l.LA_MINDESTBESTAND) AS MIN_SOH,
				        MAX(l.LA_SOLLBESTAND) AS POT_SOH,
				        MAX(l.LA_VKP) AS S_PRICE
				    FROM LAGER l
				    WHERE l.AKTIV = ' '
				    GROUP BY
				        l.KST_ID,
				        l.ART_NR
				)
				
				SELECT
				    TRUNC(d.DAY_DATE) AS ""Movement Date"",
				
				    k.KST_ID AS ""KST_ID"",
				    k.KST_NAME AS ""Location"",
				
				    a.ART_ID AS ""ART_ID"",
				    a.ART_NUMMER AS ""Article No."",
				    a.ART_NAME AS ""Article"",
				    v.VPK_NAME AS ""Base Unit"",
				
				    NVL(d.DAY_SOHBEG, 0) AS ""Opening Stock Qty"",
				    NVL(d.DAY_SOHEND, 0) AS ""Closing Stock Qty"",
				
				    NVL(d.DAY_QTYPURCH, 0) AS ""Purchase Qty"",
				    NVL(d.DAY_QTYTRSFIN, 0) AS ""Transfer In Qty"",
				    ABS(NVL(d.DAY_QTYTRSFOUT, 0)) AS ""Transfer Out Qty"",
				    ABS(NVL(d.DAY_QTYUSAGE, 0)) AS ""Usage Qty"",
				
				    NVL(d.DAY_QTYSOLD, 0) AS ""Sold Qty"",
				    NVL(d.DAY_QTYPRODUSE, 0) AS ""Production Usage Qty"",
				    NVL(d.DAY_QTYPROD, 0) AS ""Production Qty"",
				    NVL(d.DAY_QTYINV, 0) AS ""Inventory Qty"",
				    NVL(d.DAY_SOHINV, 0) AS ""Inventory SOH Qty"",
				    NVL(d.DAY_QTYINVBEG, 0) AS ""Inventory Begin Qty"",
				    NVL(d.DAY_QTYEXPENSE, 0) AS ""Expense Qty"",
				    NVL(d.DAY_QTYYIELDIN, 0) AS ""Yield In Qty"",
				
				    la.MIN_SOH AS ""Min SOH"",
				    la.POT_SOH AS ""POT SOH"",
				
				    d.DAY_PRICELAST AS ""P. Price"",
				    d.DAY_PRICE AS ""AVE"",
				    d.DAY_PRICEAVG AS ""Oracle Avg Price"",
				
				    d.DAY_SOHEND * d.DAY_PRICE AS ""Total per AVE"",
				    la.S_PRICE AS ""S.Price"",
				    d.DAY_SOHEND * la.S_PRICE AS ""Total S.Price/BU""
				
				FROM DAILYTOTALS d
				
				    JOIN KOSTST k
				        ON k.KST_ID = d.KST_ID
				
				    JOIN ARTIKEL a
				        ON a.ART_ID = d.ART_ID
				
				    LEFT JOIN VPCKEINH v
				        ON v.VPK_ID = a.VPK_NR
				
				    LEFT JOIN lager_agg la
				        ON la.KST_ID = d.KST_ID
				        AND la.ART_ID = d.ART_ID
				
				WHERE
				    d.DAY_DATE >= TO_DATE('" & FromDateText & "', 'YYYY-MM-DD')
				    AND d.DAY_DATE <= TRUNC(SYSDATE)
				    AND a.ART_NOTINV = 0
				    AND (
				        NVL(d.DAY_SOHBEG, 0) <> 0
				        OR NVL(d.DAY_SOHEND, 0) <> 0
				        OR NVL(d.DAY_QTYPURCH, 0) <> 0
				        OR NVL(d.DAY_QTYTRSFIN, 0) <> 0
				        OR NVL(d.DAY_QTYTRSFOUT, 0) <> 0
				        OR NVL(d.DAY_QTYUSAGE, 0) <> 0
				        OR NVL(d.DAY_QTYSOLD, 0) <> 0
				        OR NVL(d.DAY_QTYPRODUSE, 0) <> 0
				        OR NVL(d.DAY_QTYPROD, 0) <> 0
				        OR NVL(d.DAY_QTYINV, 0) <> 0
				        OR NVL(d.DAY_QTYINVBEG, 0) <> 0
				        OR NVL(d.DAY_QTYEXPENSE, 0) <> 0
				        OR NVL(d.DAY_QTYYIELDIN, 0) <> 0
				    )
				"
				            ]
				        ),
				
				    FxText =
				        (x as any) as nullable text =>
				            try
				                if x = null then null else Text.Trim(Text.Clean(Text.From(x)))
				            otherwise null,
				
				    FxArticleNoText =
				        (x as any) as nullable text =>
				            try
				                if x = null then null
				                else if Value.Is(x, type number) then Number.ToText(x, "0")
				                else Text.Trim(Text.Clean(Text.From(x)))
				            otherwise null,
				
				    #"Changed Type" =
				        Table.TransformColumnTypes(
				            Source,
				            {
				                {"Movement Date", type date},
				
				                {"KST_ID", Int64.Type},
				                {"Location", type text},
				
				                {"ART_ID", Int64.Type},
				                {"Article No.", type text},
				                {"Article", type text},
				                {"Base Unit", type text},
				
				                {"Opening Stock Qty", type number},
				                {"Closing Stock Qty", type number},
				
				                {"Purchase Qty", type number},
				                {"Transfer In Qty", type number},
				                {"Transfer Out Qty", type number},
				                {"Usage Qty", type number},
				
				                {"Sold Qty", type number},
				                {"Production Usage Qty", type number},
				                {"Production Qty", type number},
				                {"Inventory Qty", type number},
				                {"Inventory SOH Qty", type number},
				                {"Inventory Begin Qty", type number},
				                {"Expense Qty", type number},
				                {"Yield In Qty", type number},
				
				                {"Min SOH", type number},
				                {"POT SOH", type number},
				
				                {"P. Price", type number},
				                {"AVE", type number},
				                {"Oracle Avg Price", type number},
				                {"Total per AVE", type number},
				                {"S.Price", type number},
				                {"Total S.Price/BU", type number}
				            },
				            "en-US"
				        ),
				
				    #"Cleaned Text Columns" =
				        Table.TransformColumns(
				            #"Changed Type",
				            {
				                {"Location", each FxText(_), type nullable text},
				                {"Article No.", each FxArticleNoText(_), type nullable text},
				                {"Article", each FxText(_), type nullable text},
				                {"Base Unit", each try fnCleanBaseUnit(_) otherwise FxText(_), type nullable text}
				            },
				            null,
				            MissingField.Ignore
				        ),
				
				    #"Added Location Key" =
				        Table.AddColumn(
				            #"Cleaned Text Columns",
				            "Location Key",
				            each fnCleanText([Location]),
				            type nullable text
				        ),
				
				    #"Added Article Key" =
				        Table.AddColumn(
				            #"Added Location Key",
				            "Article Key",
				            each fnCleanText([Article]),
				            type nullable text
				        ),
				
				    #"Added Article No Key" =
				        Table.AddColumn(
				            #"Added Article Key",
				            "Article No Key",
				            each FxArticleNoText([#"Article No."]),
				            type nullable text
				        ),
				
				    #"Filtered Valid Rows" =
				        Table.SelectRows(
				            #"Added Article No Key",
				            each
				                [Movement Date] <> null
				                and [Location Key] <> null
				                and [Location Key] <> ""
				                and [Article Key] <> null
				                and [Article Key] <> ""
				        ),
				
				    #"Selected Columns" =
				        Table.SelectColumns(
				            #"Filtered Valid Rows",
				            {
				                "Movement Date",
				
				                "KST_ID",
				                "Location",
				                "Location Key",
				
				                "ART_ID",
				                "Article No.",
				                "Article No Key",
				                "Article",
				                "Article Key",
				                "Base Unit",
				
				                "Opening Stock Qty",
				                "Closing Stock Qty",
				
				                "Purchase Qty",
				                "Transfer In Qty",
				                "Transfer Out Qty",
				                "Usage Qty",
				
				                "Sold Qty",
				                "Production Usage Qty",
				                "Production Qty",
				                "Inventory Qty",
				                "Inventory SOH Qty",
				                "Inventory Begin Qty",
				                "Expense Qty",
				                "Yield In Qty",
				
				                "Min SOH",
				                "POT SOH",
				
				                "P. Price",
				                "AVE",
				                "Oracle Avg Price",
				                "Total per AVE",
				                "S.Price",
				                "Total S.Price/BU"
				            },
				            MissingField.Ignore
				        ),
				    #"Filtered Rows" = Table.SelectRows(#"Selected Columns", each [Movement Date] >= #date(2026, 1, 1))
				in
				    #"Filtered Rows"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

