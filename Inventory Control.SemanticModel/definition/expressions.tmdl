expression Wastage =
		let
		    Source =
		        Oracle.Database(
		            "192.168.1.99/mc",
		            [
		                HierarchicalNavigation = true,
		
		                Query = "
		
		/* ============================================================
		   1. LIVE ARTICLE USAGE
		      Requested Usage when VBR_REQUEST = 1
		      Otherwise Open Usage
		   ============================================================ */
		
		SELECT
		    A.VGR_NAME AS VGRNAME,
		    B.VRT_NAME AS VRTNAME,
		    B.VRT_KONTO AS VRTKONTO,
		    B.VRT_MWSTKONTO AS VRTMWSTKONTO,
		
		    C.VBR_NAME AS VBRNAME,
		    C.VBR_DATUM AS VBRDATUM,
		    C.VBR_INFO AS VBRINFO,
		
		    CASE
		        WHEN C.VBR_REQUEST = 1 THEN 'Requested Usage'
		        ELSE 'Open Usage'
		    END AS STATUS,
		
		    D.VBT_MENGE AS VBTMENGE,
		    D.VBT_REQ_MENGE AS REQUESTED_QTY,
		    D.VBT_WES AS VBTWES,
		    D.VBT_VKP AS VBTVKP,
		    D.VBT_INFO AS VBTINFO,
		    D.VBT_MENGEGE AS VBTMENGEGE,
		
		    E.ART_NAME AS ARTNAME,
		    G.VPK_NAME AS VPKNAME,
		
		    H.KST_NAME AS KSTNAME,
		    I.BST_NAME AS BSTNAME
		
		FROM VERBRAUCH C
		
		    INNER JOIN VERBRAUCHPOS D
		        ON C.VBR_ID = D.VBR_ID
		
		    INNER JOIN VERBRART B
		        ON C.VRT_ID = B.VRT_ID
		
		    INNER JOIN VERBRGRUPPE A
		        ON A.VGR_ID = B.VGR_ID
		
		    INNER JOIN ARTIKEL E
		        ON E.ART_ID = D.ART_NR
		
		    LEFT JOIN VPCKEINH G
		        ON G.VPK_ID = D.VPK_NR
		
		    INNER JOIN KOSTST H
		        ON C.KST_ID = H.KST_ID
		
		    LEFT JOIN BESTELLER I
		        ON I.BST_ID = D.NEW_USER
		
		WHERE
		    C.VBR_DATUM >= DATE '2026-04-01'
		
		
		UNION ALL
		
		
		/* ============================================================
		   2. LIVE RECIPE USAGE
		   ============================================================ */
		
		SELECT
		    A.VGR_NAME AS VGRNAME,
		    B.VRT_NAME AS VRTNAME,
		    B.VRT_KONTO AS VRTKONTO,
		    B.VRT_MWSTKONTO AS VRTMWSTKONTO,
		
		    C.VBR_NAME AS VBRNAME,
		    C.VBR_DATUM AS VBRDATUM,
		    C.VBR_INFO AS VBRINFO,
		
		    CASE
		        WHEN C.VBR_REQUEST = 1 THEN 'Requested Usage'
		        ELSE 'Open Usage'
		    END AS STATUS,
		
		    D.VBT_MENGE AS VBTMENGE,
		    D.VBT_REQ_MENGE AS REQUESTED_QTY,
		    D.VBT_WES AS VBTWES,
		    D.VBT_VKP AS VBTVKP,
		    D.VBT_INFO AS VBTINFO,
		    D.VBT_MENGEGE AS VBTMENGEGE,
		
		    F.REZ_NAME AS ARTNAME,
		
		    ' ' AS VPKNAME,
		
		    H.KST_NAME AS KSTNAME,
		    I.BST_NAME AS BSTNAME
		
		FROM VERBRAUCH C
		
		    INNER JOIN VERBRAUCHPOS D
		        ON C.VBR_ID = D.VBR_ID
		
		    INNER JOIN VERBRART B
		        ON C.VRT_ID = B.VRT_ID
		
		    INNER JOIN VERBRGRUPPE A
		        ON A.VGR_ID = B.VGR_ID
		
		    INNER JOIN REZEPTUR F
		        ON F.REZ_ID = D.REZ_NR
		
		    INNER JOIN KOSTST H
		        ON C.KST_ID = H.KST_ID
		
		    LEFT JOIN BESTELLER I
		        ON I.BST_ID = D.NEW_USER
		
		WHERE
		    C.VBR_DATUM >= DATE '2026-04-01'
		
		
		UNION ALL
		
		
		/* ============================================================
		   3. HISTORICAL ARTICLE USAGE
		      Anything in HIS_VERBRAUCH = Booked
		   ============================================================ */
		
		SELECT
		    A.VGR_NAME AS VGRNAME,
		    B.VRT_NAME AS VRTNAME,
		    B.VRT_KONTO AS VRTKONTO,
		    B.VRT_MWSTKONTO AS VRTMWSTKONTO,
		
		    C.VBR_NAME AS VBRNAME,
		    C.VBR_DATUM AS VBRDATUM,
		    C.VBR_INFO AS VBRINFO,
		
		    'Booked' AS STATUS,
		
		    D.VBT_MENGE AS VBTMENGE,
		    D.VBT_REQ_MENGE AS REQUESTED_QTY,
		    D.VBT_WES AS VBTWES,
		    D.VBT_VKP AS VBTVKP,
		    D.VBT_INFO AS VBTINFO,
		    D.VBT_MENGEGE AS VBTMENGEGE,
		
		    E.ART_NAME AS ARTNAME,
		    G.VPK_NAME AS VPKNAME,
		
		    H.KST_NAME AS KSTNAME,
		    I.BST_NAME AS BSTNAME
		
		FROM HIS_VERBRAUCH C
		
		    INNER JOIN HIS_VERBRAUCHPOS D
		        ON C.VBR_ID = D.VBR_ID
		
		    INNER JOIN VERBRART B
		        ON C.VRT_ID = B.VRT_ID
		
		    INNER JOIN VERBRGRUPPE A
		        ON A.VGR_ID = B.VGR_ID
		
		    INNER JOIN ARTIKEL E
		        ON E.ART_ID = D.ART_NR
		
		    LEFT JOIN VPCKEINH G
		        ON G.VPK_ID = D.VPK_NR
		
		    INNER JOIN KOSTST H
		        ON C.KST_ID = H.KST_ID
		
		    LEFT JOIN BESTELLER I
		        ON I.BST_ID = D.NEW_USER
		
		WHERE
		    C.VBR_DATUM >= DATE '2026-04-01'
		
		
		UNION ALL
		
		
		/* ============================================================
		   4. HISTORICAL RECIPE USAGE
		      Anything in HIS_VERBRAUCH = Booked
		   ============================================================ */
		
		SELECT
		    A.VGR_NAME AS VGRNAME,
		    B.VRT_NAME AS VRTNAME,
		    B.VRT_KONTO AS VRTKONTO,
		    B.VRT_MWSTKONTO AS VRTMWSTKONTO,
		
		    C.VBR_NAME AS VBRNAME,
		    C.VBR_DATUM AS VBRDATUM,
		    C.VBR_INFO AS VBRINFO,
		
		    'Booked' AS STATUS,
		
		    D.VBT_MENGE AS VBTMENGE,
		    D.VBT_REQ_MENGE AS REQUESTED_QTY,
		    D.VBT_WES AS VBTWES,
		    D.VBT_VKP AS VBTVKP,
		    D.VBT_INFO AS VBTINFO,
		    D.VBT_MENGEGE AS VBTMENGEGE,
		
		    F.REZ_NAME AS ARTNAME,
		
		    ' ' AS VPKNAME,
		
		    H.KST_NAME AS KSTNAME,
		    I.BST_NAME AS BSTNAME
		
		FROM HIS_VERBRAUCH C
		
		    INNER JOIN HIS_VERBRAUCHPOS D
		        ON C.VBR_ID = D.VBR_ID
		
		    INNER JOIN VERBRART B
		        ON C.VRT_ID = B.VRT_ID
		
		    INNER JOIN VERBRGRUPPE A
		        ON A.VGR_ID = B.VGR_ID
		
		    INNER JOIN REZEPTUR F
		        ON F.REZ_ID = D.REZ_NR
		
		    INNER JOIN KOSTST H
		        ON C.KST_ID = H.KST_ID
		
		    LEFT JOIN BESTELLER I
		        ON I.BST_ID = D.NEW_USER
		
		WHERE
		    C.VBR_DATUM >= DATE '2026-04-01'
		
		"
		            ]
		        ),
		
		    // Data types
		    #"Changed Type" =
		        Table.TransformColumnTypes(Source,{{"VBRDATUM", type datetime}, {"STATUS", type text}, {"VBTMENGE", type number}, {"REQUESTED_QTY", Int64.Type}, {"VBTWES", type number}, {"VBTVKP", Int64.Type}, {"VBTMENGEGE", type number}, {"VGRNAME", type text}, {"VRTNAME", type text}, {"VRTKONTO", type text}, {"VRTMWSTKONTO", type text}, {"VBRNAME", type text}, {"VBRINFO", type text}, {"VBTINFO", type text}, {"ARTNAME", type text}, {"VPKNAME", type text}, {"KSTNAME", type text}, {"BSTNAME", type text}})
		in
		    #"Changed Type"
	lineageTag: db465c8d-77d9-4bb8-a484-b8202e6b6435

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

expression 'Full SOH' = ```
		let
		
		    // SQL statement sent directly to the Oracle database
		    SqlQuery = "
		SELECT
		    k.KST_NAME AS ""Cost Center/Store"",      
		    -- Cost Center / Store name from KOSTST table
		
		    a.art_nummer AS ""Article No."",          
		    -- MC article number
		
		    a.ART_NAME AS ""Article"",                
		    -- Article description/name
		
		    d.day_sohend AS ""ACT SOH"",              
		    -- Actual Stock On Hand for the selected DAILYTOTALS date
		
		    v.VPK_NAME AS ""Base Unit"",              
		    -- Article base unit
		
		    d.day_pricelast AS ""P. Price"",          
		    -- Last purchase price
		
		    d.day_price AS ""AVE"",                   
		    -- Average inventory/value price
		
		    d.day_sohend * d.day_price AS ""Total per AVE"",
		    -- Total stock value based on ACT SOH × Average Value
		
		    l.la_vkp AS ""S.Price"",                  
		    -- Selling price stored in LAGER
		
		    d.day_sohend * l.la_vkp AS ""Total S.Price/BU"",
		    -- Total stock value based on ACT SOH × Selling Price
		
		    l.la_mindestbestand AS ""MIN SOH"",       
		    -- Minimum stock level
		
		    l.la_sollbestand AS ""POT SOH"",          
		    -- Target / desired stock level
		
		    z.lgp_name AS ""Storage Location"",       
		    -- Physical storage location
		
		    v2.VPK_NAME AS ""Unit""                   
		    -- Secondary/article unit
		
		
		FROM
		
		    lager l
		    -- Main store/article inventory table
		
		    LEFT JOIN LAGERPLATZ z
		        ON l.LGP_nr = z.LGP_ID
		    -- Connects inventory record to Storage Location
		    -- LEFT JOIN means inventory can still appear even if Storage Location is missing
		
		    ,
		
		    artikel a,
		    -- Article master
		
		    vpckeinh v,
		    -- Base unit table
		
		    vpckeinh v2,
		    -- Secondary unit table
		
		    warengruppe w,
		    -- Article/commodity group
		
		    sparte s,
		    -- Division/category table
		
		    spartegr s1,
		    -- Division group table
		
		    kostst k,
		    -- Cost Center / Store master
		
		    dailytotals d
		    -- Daily stock snapshot/history table
		
		
		WHERE
		
		    a.art_id = l.art_nr
		    -- Connects LAGER inventory to Article master
		
		    AND v.vpk_id = a.vpk_nr
		    -- Connects article to its Base Unit
		
		    AND a.wgr_id = w.wgr_id
		    -- Connects Article to Article Group
		
		    AND w.spa_id = s.spa_id
		    -- Connects Article Group to Division
		
		    AND a.vpk_nr2 = v2.vpk_id
		    -- Connects Article to its secondary Unit
		
		    AND s.sgr_id = s1.sgr_id
		    -- Connects Division to Division Group
		
		    AND l.kst_id = k.kst_id
		    -- Connects LAGER inventory to Cost Center / Store
		
		
		    -- COST CENTER FILTER REMOVED
		    -- Previously:
		    -- AND k.kst_index LIKE 'AAAPAB%'
		    --
		    -- Because this condition is removed,
		    -- the query can now return ALL Cost Centers / Stores
		    -- available through the LAGER + KOSTST relationship.
		
		
		    AND a.art_notinv = 0
		    -- Keeps articles where ART_NOTINV = 0
		    -- This is the inventory-related article filter used by the original query
		
		    AND l.aktiv = ' '
		    -- Keeps LAGER records where AKTIV contains a blank space
		    -- Preserved exactly from the existing MC query
		
		    AND d.kst_id = l.kst_id
		    -- DAILYTOTALS Cost Center must match LAGER Cost Center
		
		    AND d.art_id = l.art_nr
		    -- DAILYTOTALS Article must match LAGER Article
		
		    AND d.day_date = TRUNC(SYSDATE)
		    -- Returns DAILYTOTALS records for TODAY only
		
		
		ORDER BY
		
		    k.kst_index,
		    -- Sort first by Cost Center index
		
		    a.ART_NAMEID
		    -- Second sorting field
		    -- Kept exactly as it appears in your current working MC query
		",
		
		    // Connect to Oracle and execute the SQL above
		    Source =
		        Oracle.Database(
		            "192.168.1.99/mc",
		            [
		                // Keeps Oracle navigation behaviour enabled
		                HierarchicalNavigation = true,
		
		                // Executes the SQL query defined above
		                Query = SqlQuery
		            ]
		        ),
		    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Cost Center/Store", type text}, {"Article No.", Int64.Type}, {"Article", type text}, {"ACT SOH", Int64.Type}, {"Base Unit", type text}, {"P. Price", type number}, {"AVE", type number}, {"Total per AVE", Int64.Type}, {"S.Price", Int64.Type}, {"Total S.Price/BU", Int64.Type}, {"MIN SOH", type number}, {"POT SOH", type number}, {"Storage Location", type text}, {"Unit", type text}})
		in
		    #"Changed Type"
		```
	lineageTag: 72ecd47f-3ccd-4e18-b4dc-520d3b7d987b

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

expression p_FromDate =
		let
		    Value = #date(2025, 1, 1)
		in
		    Value
	lineageTag: e24ffea7-b30b-4598-8ef4-83344d08d03a

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Date

expression cc_soh_current =
		let
		    Source =
		        Oracle.Database(
		            "192.168.1.99/mc",
		            [
		                HierarchicalNavigation = true,
		                Query =
		"
		SELECT
		    k.KST_NAME AS ""Location"",
		    a.ART_NUMMER AS ""Article No."",
		    a.ART_NAME AS ""Article"",
		    MAX(d.DAY_SOHEND) AS ""SOH Qty"",
		    MAX(v.VPK_NAME) AS ""Base Unit"",
		    MAX(d.DAY_PRICELAST) AS ""P. Price"",
		    MAX(d.DAY_PRICE) AS ""AVE"",
		    MAX(d.DAY_SOHEND) * MAX(d.DAY_PRICE) AS ""Total per AVE"",
		    MAX(l.LA_VKP) AS ""S.Price"",
		    MAX(d.DAY_SOHEND) * MAX(l.LA_VKP) AS ""Total S.Price/BU"",
		    MAX(l.LA_MINDESTBESTAND) AS ""Min SOH"",
		    MAX(l.LA_SOLLBESTAND) AS ""POT SOH"",
		    MAX(v2.VPK_NAME) AS ""Unit""
		FROM
		    LAGER l
		    LEFT JOIN LAGERPLATZ z
		        ON l.LGP_NR = z.LGP_ID
		    JOIN ARTIKEL a
		        ON a.ART_ID = l.ART_NR
		    JOIN VPCKEINH v
		        ON v.VPK_ID = a.VPK_NR
		    JOIN VPCKEINH v2
		        ON v2.VPK_ID = a.VPK_NR2
		    JOIN WARENGRUPPE w
		        ON a.WGR_ID = w.WGR_ID
		    JOIN SPARTE s
		        ON w.SPA_ID = s.SPA_ID
		    JOIN SPARTEGR s1
		        ON s.SGR_ID = s1.SGR_ID
		    JOIN KOSTST k
		        ON l.KST_ID = k.KST_ID
		    JOIN DAILYTOTALS d
		        ON d.KST_ID = l.KST_ID
		        AND d.ART_ID = l.ART_NR
		WHERE
		    a.ART_NOTINV = 0
		    AND l.AKTIV = ' '
		    AND d.DAY_DATE = TRUNC(SYSDATE)
		GROUP BY
		    k.KST_NAME,
		    a.ART_NUMMER,
		    a.ART_NAME
		"
		            ]
		        ),
		
		    FxText =
		        (x as any) as nullable text =>
		            try
		                if x = null then null else Text.Trim(Text.Clean(Text.From(x)))
		            otherwise null,
		
		    FxArticleNoText =
		        (x as any) as nullable text =>
		            try
		                if x = null then null
		                else if Value.Is(x, type number) then Number.ToText(x, "0")
		                else Text.Trim(Text.Clean(Text.From(x)))
		            otherwise null,
		
		    #"Changed Type" =
		        Table.TransformColumnTypes(
		            Source,
		            {
		                {"Location", type text},
		                {"Article No.", type text},
		                {"Article", type text},
		                {"SOH Qty", type number},
		                {"Base Unit", type text},
		                {"P. Price", type number},
		                {"AVE", type number},
		                {"Total per AVE", type number},
		                {"S.Price", type number},
		                {"Total S.Price/BU", type number},
		                {"Min SOH", type number},
		                {"POT SOH", type number},
		                {"Unit", type text}
		            },
		            "en-US"
		        ),
		
		    #"Cleaned Columns" =
		        Table.TransformColumns(
		            #"Changed Type",
		            {
		                {"Location", each FxText(_), type nullable text},
		                {"Article No.", each FxArticleNoText(_), type nullable text},
		                {"Article", each FxText(_), type nullable text},
		                {"Base Unit", each try fnCleanBaseUnit(_) otherwise FxText(_), type nullable text},
		                {"Unit", each try fnCleanBaseUnit(_) otherwise FxText(_), type nullable text}
		            },
		            null,
		            MissingField.Ignore
		        ),
		
		    #"Added Location Key" =
		        Table.AddColumn(
		            #"Cleaned Columns",
		            "Location Key",
		            each fnCleanText([Location]),
		            type nullable text
		        ),
		
		    #"Added Article Key" =
		        Table.AddColumn(
		            #"Added Location Key",
		            "Article Key",
		            each fnCleanText([Article]),
		            type nullable text
		        ),
		
		    #"Added Article No Key" =
		        Table.AddColumn(
		            #"Added Article Key",
		            "Article No Key",
		            each FxArticleNoText([#"Article No."]),
		            type nullable text
		        ),
		
		    #"Added SOH Snapshot Date" =
		        Table.AddColumn(
		            #"Added Article No Key",
		            "SOH Snapshot Date",
		            each Date.From(DateTime.LocalNow()),
		            type date
		        ),
		
		    #"Filtered Valid Rows" =
		        Table.SelectRows(
		            #"Added SOH Snapshot Date",
		            each
		                [Location Key] <> null
		                and [Location Key] <> ""
		                and [Article Key] <> null
		                and [Article Key] <> ""
		        ),
		
		    #"Selected Columns" =
		        Table.SelectColumns(
		            #"Filtered Valid Rows",
		            {
		                "SOH Snapshot Date",
		                "Location",
		                "Location Key",
		                "Article No.",
		                "Article No Key",
		                "Article",
		                "Article Key",
		                "Base Unit",
		                "SOH Qty",
		                "Min SOH",
		                "POT SOH",
		                "P. Price",
		                "AVE",
		                "Total per AVE",
		                "S.Price",
		                "Total S.Price/BU",
		                "Unit"
		            },
		            MissingField.Ignore
		        )
		in
		    #"Selected Columns"
	lineageTag: ec18e977-28d6-4a1f-b666-34f797e857de

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

expression cc_wastage_line =
		let
		    FromDateText = Date.ToText(Date.From(p_FromDate), "yyyy-MM-dd"),
		
		    Source =
		        Oracle.Database(
		            "192.168.1.99/mc",
		            [
		                HierarchicalNavigation = true,
		                Query =
		"
		SELECT
		    TRUNC(q.VBRDATUM) AS ""Movement Date"",
		    q.KSTNAME AS ""Location"",
		    q.ARTNAME AS ""Article"",
		    q.VPKNAME AS ""Base Unit"",
		    q.STATUS AS ""Wastage Status"",
		    SUM(ABS(q.USAGE_QTY)) AS ""Usage Qty""
		FROM
		(
		    SELECT
		        C.VBR_DATUM AS VBRDATUM,
		        CASE
		            WHEN C.VBR_REQUEST = 1 THEN 'Requested Usage'
		            ELSE 'Open Usage'
		        END AS STATUS,
		        CASE
		            WHEN D.VBT_MENGEGE IS NULL OR D.VBT_MENGEGE = 0
		            THEN NVL(D.VBT_MENGE, 0)
		            ELSE D.VBT_MENGEGE
		        END AS USAGE_QTY,
		        E.ART_NAME AS ARTNAME,
		        G.VPK_NAME AS VPKNAME,
		        H.KST_NAME AS KSTNAME
		    FROM VERBRAUCH C
		        INNER JOIN VERBRAUCHPOS D
		            ON C.VBR_ID = D.VBR_ID
		        INNER JOIN ARTIKEL E
		            ON E.ART_ID = D.ART_NR
		        LEFT JOIN VPCKEINH G
		            ON G.VPK_ID = D.VPK_NR
		        INNER JOIN KOSTST H
		            ON C.KST_ID = H.KST_ID
		    WHERE C.VBR_DATUM >= TO_DATE('" & FromDateText & "', 'YYYY-MM-DD')
		
		    UNION ALL
		
		    SELECT
		        C.VBR_DATUM AS VBRDATUM,
		        CASE
		            WHEN C.VBR_REQUEST = 1 THEN 'Requested Usage'
		            ELSE 'Open Usage'
		        END AS STATUS,
		        CASE
		            WHEN D.VBT_MENGEGE IS NULL OR D.VBT_MENGEGE = 0
		            THEN NVL(D.VBT_MENGE, 0)
		            ELSE D.VBT_MENGEGE
		        END AS USAGE_QTY,
		        F.REZ_NAME AS ARTNAME,
		        ' ' AS VPKNAME,
		        H.KST_NAME AS KSTNAME
		    FROM VERBRAUCH C
		        INNER JOIN VERBRAUCHPOS D
		            ON C.VBR_ID = D.VBR_ID
		        INNER JOIN REZEPTUR F
		            ON F.REZ_ID = D.REZ_NR
		        INNER JOIN KOSTST H
		            ON C.KST_ID = H.KST_ID
		    WHERE C.VBR_DATUM >= TO_DATE('" & FromDateText & "', 'YYYY-MM-DD')
		
		    UNION ALL
		
		    SELECT
		        C.VBR_DATUM AS VBRDATUM,
		        'Booked' AS STATUS,
		        CASE
		            WHEN D.VBT_MENGEGE IS NULL OR D.VBT_MENGEGE = 0
		            THEN NVL(D.VBT_MENGE, 0)
		            ELSE D.VBT_MENGEGE
		        END AS USAGE_QTY,
		        E.ART_NAME AS ARTNAME,
		        G.VPK_NAME AS VPKNAME,
		        H.KST_NAME AS KSTNAME
		    FROM HIS_VERBRAUCH C
		        INNER JOIN HIS_VERBRAUCHPOS D
		            ON C.VBR_ID = D.VBR_ID
		        INNER JOIN ARTIKEL E
		            ON E.ART_ID = D.ART_NR
		        LEFT JOIN VPCKEINH G
		            ON G.VPK_ID = D.VPK_NR
		        INNER JOIN KOSTST H
		            ON C.KST_ID = H.KST_ID
		    WHERE C.VBR_DATUM >= TO_DATE('" & FromDateText & "', 'YYYY-MM-DD')
		
		    UNION ALL
		
		    SELECT
		        C.VBR_DATUM AS VBRDATUM,
		        'Booked' AS STATUS,
		        CASE
		            WHEN D.VBT_MENGEGE IS NULL OR D.VBT_MENGEGE = 0
		            THEN NVL(D.VBT_MENGE, 0)
		            ELSE D.VBT_MENGEGE
		        END AS USAGE_QTY,
		        F.REZ_NAME AS ARTNAME,
		        ' ' AS VPKNAME,
		        H.KST_NAME AS KSTNAME
		    FROM HIS_VERBRAUCH C
		        INNER JOIN HIS_VERBRAUCHPOS D
		            ON C.VBR_ID = D.VBR_ID
		        INNER JOIN REZEPTUR F
		            ON F.REZ_ID = D.REZ_NR
		        INNER JOIN KOSTST H
		            ON C.KST_ID = H.KST_ID
		    WHERE C.VBR_DATUM >= TO_DATE('" & FromDateText & "', 'YYYY-MM-DD')
		) q
		WHERE
		    q.ARTNAME IS NOT NULL
		    AND q.KSTNAME IS NOT NULL
		GROUP BY
		    TRUNC(q.VBRDATUM),
		    q.KSTNAME,
		    q.ARTNAME,
		    q.VPKNAME,
		    q.STATUS
		HAVING
		    SUM(ABS(q.USAGE_QTY)) > 0
		"
		            ]
		        ),
		
		    FxText =
		        (x as any) as nullable text =>
		            try
		                if x = null then null else Text.Trim(Text.Clean(Text.From(x)))
		            otherwise null,
		
		    #"Changed Type" =
		        Table.TransformColumnTypes(
		            Source,
		            {
		                {"Movement Date", type date},
		                {"Location", type text},
		                {"Article", type text},
		                {"Base Unit", type text},
		                {"Wastage Status", type text},
		                {"Usage Qty", type number}
		            },
		            "en-US"
		        ),
		
		    #"Cleaned Columns" =
		        Table.TransformColumns(
		            #"Changed Type",
		            {
		                {"Location", each FxText(_), type nullable text},
		                {"Article", each FxText(_), type nullable text},
		                {"Base Unit", each try fnCleanBaseUnit(_) otherwise FxText(_), type nullable text},
		                {"Wastage Status", each FxText(_), type nullable text}
		            },
		            null,
		            MissingField.Ignore
		        ),
		
		    #"Added Location Key" =
		        Table.AddColumn(
		            #"Cleaned Columns",
		            "Location Key",
		            each fnCleanText([Location]),
		            type nullable text
		        ),
		
		    #"Added Article Key" =
		        Table.AddColumn(
		            #"Added Location Key",
		            "Article Key",
		            each fnCleanText([Article]),
		            type nullable text
		        ),
		
		    #"Filtered Valid Rows" =
		        Table.SelectRows(
		            #"Added Article Key",
		            each
		                [Movement Date] <> null
		                and [Location Key] <> null
		                and [Location Key] <> ""
		                and [Article Key] <> null
		                and [Article Key] <> ""
		                and [Usage Qty] <> null
		                and [Usage Qty] > 0
		        ),
		
		    #"Selected Columns" =
		        Table.SelectColumns(
		            #"Filtered Valid Rows",
		            {
		                "Movement Date",
		                "Location",
		                "Location Key",
		                "Article",
		                "Article Key",
		                "Base Unit",
		                "Wastage Status",
		                "Usage Qty"
		            },
		            MissingField.Ignore
		        )
		in
		    #"Selected Columns"
	lineageTag: c8fa314d-04eb-4815-a661-18494efa6649

