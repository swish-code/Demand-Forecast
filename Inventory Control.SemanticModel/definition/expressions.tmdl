		    #"Replaced Errors2" = Table.ReplaceErrorValues(#"Replaced Errors1", {{"Designation", "N/A"}}),
		    #"Changed Type2" = Table.TransformColumnTypes(#"Replaced Errors2",{{"Article No.", type any}})
		in
		    #"Changed Type2"
	lineageTag: 9dae909c-d5e2-4727-a3be-5c3dbc15cc41

	annotation PBI_NavigationStepName = Navigation

