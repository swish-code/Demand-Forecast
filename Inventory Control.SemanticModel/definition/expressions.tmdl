expression map_art_no =
		let
		    Source = #"Manager Article",
		
		    ValidRows =
		        Table.SelectRows(
		            Source,
		            each
		                [Mapping Usable Flag] = 1
		                and [Purchase Article No Key] <> null
		                and [Purchase Article No Key] <> ""
		                and [Stock Article Key] <> null
		                and [Stock Article Key] <> ""
		        ),
		
		    Grouped =
		        Table.Group(
		            ValidRows,
		            {"Purchase Article No Key"},
		            {
		                {"Row Count", each Table.RowCount(_), Int64.Type},
		
		                {
		                    "Purchase Article Key",
		                    each try List.First(List.RemoveNulls([Purchase Article Key])) otherwise null,
		                    type nullable text
		                },
		
		                {
		                    "Purchase Article",
		                    each try List.First(List.RemoveNulls([#"P.Article"])) otherwise null,
		                    type nullable text
		                },
		
		                {
		                    "Purchase Article No.",
		                    each try List.First(List.RemoveNulls([#"P.Article No."])) otherwise null,
		                    type nullable text
		                },
		
		                {
		                    "Stock Article Key Count",
		                    each
		                        List.Count(
		                            List.Distinct(
		                                List.RemoveNulls([Stock Article Key])
		                            )
		                        ),
		                    Int64.Type
		                },
		
		                {
		                    "Stock Article Key",
		                    each try List.First(List.RemoveNulls([Stock Article Key])) otherwise null,
		                    type nullable text
		                },
		
		                {
		                    "Stock Article",
		                    each try List.First(List.RemoveNulls([Article])) otherwise null,
		                    type nullable text
		                },
		
		                {
		                    "Stock Article No Key",
		                    each try List.First(List.RemoveNulls([Stock Article No Key])) otherwise null,
		                    type nullable text
		                },
		
		                {
		                    "Stock Article No.",
		                    each try List.First(List.RemoveNulls([#"Article No."])) otherwise null,
		                    type nullable text
		                },
		
		                {
		                    "Item Group",
		                    each try List.First(List.RemoveNulls([Item Group])) otherwise null,
		                    type nullable text
		                },
		
		                {
		                    "Category",
		                    each try List.First(List.RemoveNulls([Category])) otherwise null,
		                    type nullable text
		                },
		
		                {
		                    "Category Group",
		                    each try List.First(List.RemoveNulls([Category Group])) otherwise null,
		                    type nullable text
		                }
		            }
		        ),
		
		    AddMappingStatus =
		        Table.AddColumn(
		            Grouped,
		            "Purchase No Mapping Status",
		            each
		                if [Stock Article Key Count] = 1 then
		                    "Ready"
		                else
		                    "Ambiguous Purchase Article No",
		            type text
		        ),
		
		    KeepReadyOnly =
		        Table.SelectRows(
		            AddMappingStatus,
		            each [Purchase No Mapping Status] = "Ready"
		        ),
		
		    FinalColumns =
		        Table.SelectColumns(
		            KeepReadyOnly,
		            {
		                "Purchase Article No Key",
		                "Purchase Article Key",
		                "Purchase Article",
		                "Purchase Article No.",
		                "Stock Article Key",
		                "Stock Article",
		                "Stock Article No Key",
		                "Stock Article No.",
		                "Item Group",
		                "Category",
		                "Category Group",
		                "Row Count",
		                "Purchase No Mapping Status"
		            },
		            MissingField.Ignore
		        )
		in
		    FinalColumns
	lineageTag: 24435f4e-b83e-49b4-9eda-69e5d9e57ce9

