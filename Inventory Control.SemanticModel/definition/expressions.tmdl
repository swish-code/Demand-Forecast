	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

expression 'Open PO' =
		let
		    Source =
		        Oracle.Database(
		            "192.168.1.99/mc",
		            [
		                HierarchicalNavigation = true,
		                Query =
		                    Text.Combine(
		                        {
		                            "SELECT",
		                            "    B.ART_NAME AS ""Purchase Article"",",
		                            "    CASE",
		                            "        WHEN B.art_lager = 3 THEN B.ART_NAME",
		                            "        ELSE (SELECT ART_NAME FROM ARTIKEL WHERE ART_ID = B.ART_NR)",
		                            "    END AS ""Stock Article"",",
		                            "    C.LF_NAME AS ""SUPPLIER"",",
		                            "    E.KST_NAME AS ""Cost Center"",",
		                            "    D.VPK_NAME AS ""UNIT"",",
		                            "    DB.VPK_NAME AS ""BASE UNIT"",",
		                            "    D.VPK_GRMENGE AS ""PO UNIT MULTIPLIER"",",
		                            "    A.SB_NAME AS ""PO No"",",
		                            "    A.BP_MENGE AS ""PO_QTY"",",
		                            "    A.BP_MENGE - A.SB_GELIEF AS ""OPEN_QTY"",",
		                            "    A.SB_GELIEF AS ""RECEIVED QTY"",",
		                            "    A.BP_EKP AS ""Unit Price"",",
		                            "    A.BP_FREIG AS ""ORDER DATE"",",
		                            "    A.BP_LTERM AS ""DELEVERY DATE"",",
		                            "    U.BST_LONGNAME AS ""ORDERER""",
		                            "FROM",
		                            "    WARENGRUPPE F,",
		                            "    SPARTE G,",
		                            "    SPARTEGR H,",
		                            "    SAMMELPOS A,",
		                            "    ARTIKEL B,",
		                            "    LIEFER C,",
		                            "    KOSTST E,",
		                            "    VPCKEINH D,",
		                            "    VPCKEINH DB,",
		                            "    BESTELLER U",
		                            "WHERE",
		                            "        A.ART_ID = B.ART_ID",
		                            "    AND A.LF_ID = C.LF_ID",
		                            "    AND A.VPK_ID = D.VPK_ID",
		                            "    AND DB.VPK_ID = D.VPK_GRUND",
		                            "    AND A.KST_ID = E.KST_ID",
		                            "    AND F.WGR_ID = B.WGR_ID",
		                            "    AND G.SPA_ID = F.SPA_ID",
		                            "    AND H.SGR_ID = G.SGR_ID",
		                            "    AND A.BP_STATUS = 21",
		                            "    AND A.BST_ID = U.BST_ID"
		                        },
		                        "#(lf)"
		                    )
		            ]
		        ),
		
		    FxCleanDisplayText =
		        (x as any) as nullable text =>
		            let
		                Result =
		                    try
		                        if x = null then null
		                        else Text.Trim(Text.Clean(Text.From(x)))
		                    otherwise null
		            in
		                Result,
		
		    FxHasText =
		        (x as any) as logical =>
		            try x <> null and Text.Trim(Text.From(x)) <> "" otherwise false,
		
		    FxNum =
		        (x as any) as nullable number =>
		            try Number.From(x) otherwise null,
		
		    #"Changed Type" =
		        Table.TransformColumnTypes(
		            Source,
		            {
		                {"Purchase Article", type text},
		                {"Stock Article", type text},
		                {"SUPPLIER", type text},
		                {"Cost Center", type text},
		                {"UNIT", type text},
		                {"BASE UNIT", type text},
		                {"PO UNIT MULTIPLIER", type number},
		                {"PO No", type text},
		                {"PO_QTY", type number},
		                {"OPEN_QTY", type number},
		                {"RECEIVED QTY", type number},
		                {"Unit Price", type number},
		                {"ORDER DATE", type datetime},
		                {"DELEVERY DATE", type datetime},
		                {"ORDERER", type text}
		            }
		        ),
		
		    #"Filtered Date Range" =
		        Table.SelectRows(
		            #"Changed Type",
		            each [ORDER DATE] <> null and Date.From([ORDER DATE]) >= p_FromDate
		        ),
		
		    #"Renamed Columns" =
		        Table.RenameColumns(
		            #"Filtered Date Range",
		            {
		                {"Purchase Article", "Original Purchase Article"},
		                {"Stock Article", "Oracle Stock Article"},
		                {"SUPPLIER", "Supplier"},
		                {"Cost Center", "Warehouse"},
		                {"UNIT", "PO Unit"},
		                {"BASE UNIT", "PO Base Unit"},
		                {"PO UNIT MULTIPLIER", "ERP PO Unit Multiplier"},
		                {"PO_QTY", "PO Qty"},
		                {"Unit Price", "PO Unit Price"},
		                {"ORDER DATE", "PO Date"},
		                {"DELEVERY DATE", "PO Delivery Date"}
		            },
		            MissingField.Ignore
		        ),
		
		    #"Clean Text Columns" =
		        Table.TransformColumns(
		            #"Renamed Columns",
		            {
		                {"Original Purchase Article", each FxCleanDisplayText(_), type nullable text},
		                {"Oracle Stock Article", each FxCleanDisplayText(_), type nullable text},
		                {"Supplier", each FxCleanDisplayText(_), type nullable text},
		                {"Warehouse", each FxCleanDisplayText(_), type nullable text},
		                {"PO Unit", each FxCleanDisplayText(_), type nullable text},
		                {"PO Base Unit", each FxCleanDisplayText(_), type nullable text},
		                {"PO No", each FxCleanDisplayText(_), type nullable text},
		                {"ORDERER", each FxCleanDisplayText(_), type nullable text}
		            },
		            null,
		            MissingField.Ignore
		        ),
		
		    #"Added Purchase Article Key" =
		        Table.AddColumn(
		            #"Clean Text Columns",
		            "Purchase Article Key",
		            each fnCleanText([Original Purchase Article]),
		            type nullable text
		        ),
		
		    #"Merged Article Mapping" =
		        Table.NestedJoin(
		            #"Added Purchase Article Key",
		            {"Purchase Article Key"},
		            map_art_name,
		            {"Purchase Article Key"},
		            "Article Mapping",
		            JoinKind.LeftOuter
		        ),
		
		    #"Expanded Article Mapping" =
		        Table.ExpandTableColumn(
		            #"Merged Article Mapping",
		            "Article Mapping",
		            {
		                "Stock Article",
		                "Stock Article No.",
		                "Item Group",
		                "Category",
		                "Category Group"
		            },
		            {
		                "Manager Stock Article",
		                "Manager Stock Article No.",
		                "Manager Item Group",
		                "Manager Category",
		                "Manager Category Group"
		            }
		        ),
		
		    #"Added Article Mapping Status" =
		        Table.AddColumn(
		            #"Expanded Article Mapping",
		            "Article Mapping Status",
		            each
		                if FxHasText([Manager Stock Article]) then
		                    "Mapped by Manager Article"
		                else if FxHasText([Oracle Stock Article]) then
		                    "Used Oracle Stock Article"
		                else
		                    "Missing Mapping - Used Original",
		            type text
		        ),
		
		    #"Added Article" =
		        Table.AddColumn(
		            #"Added Article Mapping Status",
		            "Article",
		            each
		                if FxHasText([Manager Stock Article]) then
		                    [Manager Stock Article]
		                else if FxHasText([Oracle Stock Article]) then
		                    [Oracle Stock Article]
		                else
		                    [Original Purchase Article],
		            type nullable text
		        ),
		
		    #"Added PO Unit Multiplier" =
		        Table.AddColumn(
		            #"Added Article",
		            "PO Unit Multiplier",
		            each
		                let
		                    M = FxNum([ERP PO Unit Multiplier])
		                in
		                    if M <> null and M > 0 then M else 1,
		            type number
		        ),
		
		    #"Removed Columns1" =
		        Table.RemoveColumns(
		            #"Added PO Unit Multiplier",
		            {
		                "OPEN_QTY",
		                "RECEIVED QTY",
		                "ORDERER",
		                "Purchase Article Key"
		            },
		            MissingField.Ignore
		        ),
		
		    #"Merged CategoryLookup" =
		        Table.NestedJoin(
		            #"Removed Columns1",
		            {"Article"},
		            CategoryLookup,
		            {"Article"},
		            "CategoryLookup",
		            JoinKind.LeftOuter
		        ),
		
		    #"Expanded CategoryLookup" =
		        Table.ExpandTableColumn(
		            #"Merged CategoryLookup",
		            "CategoryLookup",
		            {"Sub_Category", "Item_Group", "Storage_Type"},
		            {"CL Sub_Category", "CL Item_Group", "CL Storage_Type"}
		        ),
		
		    #"Added Sub Category" =
		        Table.AddColumn(
		            #"Expanded CategoryLookup",
		            "Sub_Category",
		            each
		                if FxHasText([CL Sub_Category]) then [CL Sub_Category]
		                else [Manager Category],
		            type nullable text
		        ),
		
		    #"Added Item Group" =
		        Table.AddColumn(
		            #"Added Sub Category",
		            "Item_Group",
		            each
		                if FxHasText([CL Item_Group]) then [CL Item_Group]
		                else [Manager Item Group],
		            type nullable text
		        ),
		
		    #"Added Storage Type" =
		        Table.AddColumn(
		            #"Added Item Group",
		            "Storage_Type",
		            each
		                if FxHasText([CL Storage_Type]) then [CL Storage_Type]
		                else [Manager Category Group],
		            type nullable text
		        ),
		
		    #"Removed Temp Category Columns" =
		        Table.RemoveColumns(
		            #"Added Storage Type",
		            {
		                "CL Sub_Category",
		                "CL Item_Group",
		                "CL Storage_Type",
		                "Manager Item Group",
		                "Manager Category",
		                "Manager Category Group"
		            },
		            MissingField.Ignore
		        ),
		
		    #"qty clean" =
		        Table.ReplaceValue(
		            #"Removed Temp Category Columns",
		            each [PO Qty],
		            each
		                if
		                    (
		                        [Article] = "Cutlery Fork Beige FM"
		                        or [Article] = "Cutlery Spoon Beige FM"
		                    )
		                    and [PO Qty] = 40000
		                then
		                    40
		                else
		                    [PO Qty],
		            Replacer.ReplaceValue,
		            {"PO Qty"}
		        ),
		
		    #"Changed Type1" =
		        Table.TransformColumnTypes(
		            #"qty clean",
		            {
		                {"PO Delivery Date", type date},
		                {"Article", type text},
		                {"Original Purchase Article", type text},
		                {"Oracle Stock Article", type text},
		                {"Manager Stock Article", type text},
		                {"Manager Stock Article No.", type text},
		                {"Article Mapping Status", type text},
		                {"ERP PO Unit Multiplier", type number},
		                {"PO Unit Multiplier", type number},
		                {"PO Base Unit", type text},
		                {"Sub_Category", type text},
		                {"Item_Group", type text},
		                {"Storage_Type", type text}
		            }
		        ),
		
		    #"Replaced Value" =
		        Table.ReplaceValue(
		            #"Changed Type1",
		            each [PO Delivery Date],
		            each
		                if [Article] = "Sticker BBT Medium 2.75*5.5 CM"
		                    and [PO Date] = #datetime(2026, 1, 27, 12, 40, 1)
		                then
		                    #date(2026, 2, 9)
		                else if [Article] = "Sticker BBT Regular 2.75*5.5 CM"
		                    and [PO Date] = #datetime(2026, 1, 27, 12, 40, 36)
		                then
		                    #date(2026, 2, 9)
		                else if [Article] = "Sticker BBT Single Double 5*1.3 CM"
		                    and [PO Date] = #datetime(2026, 1, 27, 12, 40, 58)
		                then
		                    #date(2026, 2, 9)
		                else
		                    [PO Delivery Date],
		            Replacer.ReplaceValue,
		            {"PO Delivery Date"}
		        ),
		
		    #"Final Column Order" =
		        Table.ReorderColumns(
		            #"Replaced Value",
		            {
		                "Article",
		                "Original Purchase Article",
		                "Oracle Stock Article",
		                "Manager Stock Article",
		                "Manager Stock Article No.",
		                "Article Mapping Status",
		                "Supplier",
		                "Warehouse",
		                "PO Unit",
		                "PO Base Unit",
		                "ERP PO Unit Multiplier",
		                "PO Unit Multiplier",
		                "PO No",
		                "PO Qty",
		                "PO Unit Price",
		                "PO Date",
		                "PO Delivery Date",
		                "Sub_Category",
		                "Item_Group",
		                "Storage_Type"
		            },
		            MissingField.Ignore
		        )
		in
		    #"Final Column Order"
