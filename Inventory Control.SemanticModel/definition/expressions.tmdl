expression fact_grn_no_active_po_exception =
		let
		    GRN = fact_grn_line,
		    PO = fact_po_period_base,
		    MatchedGRN = fact_grn_allocated_detail,
		
		    FxSafeText =
		        (x as any) as text =>
		            try
		                if x = null then ""
		                else Text.Trim(Text.Clean(Text.From(x)))
		            otherwise "",
		
		    FxUpperText =
		        (x as any) as text =>
		            Text.Upper(FxSafeText(x)),
		
		    FxDate =
		        (x as any) as nullable date =>
		            try Date.From(x) otherwise null,
		
		    FxNum =
		        (x as any) as nullable number =>
		            try Number.From(x) otherwise null,
		
		    FxMatchKey =
		        (Article as any, Warehouse as any, PONo as any) as text =>
		            FxSafeText(Article)
		                & "|"
		                & FxSafeText(Warehouse)
		                & "|"
		                & FxSafeText(PONo),
		
		    FxHasPONo =
		        (PONo as any) as logical =>
		            let
		                T = FxUpperText(PONo)
		            in
		                T <> ""
		                    and T <> "NO PO DEFINED"
		                    and T <> "NO_PO"
		                    and T <> "N/A"
		                    and T <> "NA"
		                    and T <> "NULL",
		
		    MatchedIDsBase =
		        Table.SelectColumns(
		            MatchedGRN,
		            {"GRN Line ID"},
		            MissingField.Ignore
		        ),
		
		    MatchedIDsFiltered =
		        Table.SelectRows(
		            MatchedIDsBase,
		            each
		                [GRN Line ID] <> null
		                and [GRN Line ID] <> ""
		        ),
		
		    MatchedIDs =
		        Table.Buffer(
		            Table.Distinct(
		                MatchedIDsFiltered,
		                {"GRN Line ID"}
		            )
		        ),
		
		    GRNFiltered =
		        Table.SelectRows(
		            GRN,
		            each
		                [Article] <> null
		                and [Article] <> ""
		                and [Warehouse] <> null
		                and [Warehouse] <> ""
		                and [GRN Delivery Date] <> null
