expression 'Replen Planning' =
		let
		    Source = Excel.Workbook(
		        Web.Contents(
		            "https://etckuwait-my.sharepoint.com/personal/a_hafez_swishhh_net/Documents/Desktop/Swish%20SPS%20V3%202026.xlsm"
		        ),
		        null,
		        true
		    ),
		
		    #"Replen Planning_Sheet" =
		        Source{[Item="Replen Planning", Kind="Sheet"]}[Data],
		
		    // First header promotion - same logic as your new source
		    #"Promoted Headers" =
		        Table.PromoteHeaders(
		            #"Replen Planning_Sheet",
		            [PromoteAllScalars=true]
		        ),
		
		    // New workbook has 4 rows before the real headers
		    #"Removed Top Rows" =
		        Table.Skip(
		            #"Promoted Headers",
		            4
		        ),
		
		    // Promote the actual Replen Planning headers
		    #"Promoted Headers1" =
		        Table.PromoteHeaders(
		            #"Removed Top Rows",
		            [PromoteAllScalars=true]
		        ),
		
		    // Clean spaces / hidden characters from headers
		    #"Cleaned Column Names" =
		        Table.TransformColumnNames(
		            #"Promoted Headers1",
		            each Text.Trim(Text.Clean(_))
		        ),
		
		    // Take the FIRST 11 physical columns from the new file
		    First11ColumnNames =
		        List.FirstN(
		            Table.ColumnNames(#"Cleaned Column Names"),
		            11
		        ),
		
		    #"Selected First 11 Columns" =
		        Table.SelectColumns(
		            #"Cleaned Column Names",
		            First11ColumnNames
		        ),
		
		    // Exact structure required by the existing model
		    TargetColumnNames =
		        {
		            "Article No.",
		            "CODE",
		            "ITEM DESCRIPTION",
		            "BASE UNIT",
		            "IS ACTIVE",
		            "Designation",
		            "SubCAT",
		            "Current WHS ID",
		            "ITEM GROUP",
		            "STORAGE TYPE",
		            "PURCH UNIT"
		        },
		
		    // Force the first 11 columns into the exact old/current names
		    #"Standardized Structure" =
		        Table.FromColumns(
		            Table.ToColumns(#"Selected First 11 Columns"),
		            TargetColumnNames
		        ),
		
		    // Match your existing data types
		    #"Changed Type" =
		        Table.TransformColumnTypes(
		            #"Standardized Structure",
		            {
		                {"Article No.", type any},
		                {"CODE", type text},
		                {"ITEM DESCRIPTION", type text},
		                {"BASE UNIT", type text},
		                {"IS ACTIVE", type text},
		                {"Designation", type any},
		                {"SubCAT", type text},
		                {"Current WHS ID", type any},
		                {"ITEM GROUP", type text},
		                {"STORAGE TYPE", type text},
		                {"PURCH UNIT", type any}
		            }
		        ),
		
		    // Same error handling as current query
		    #"Replaced PURCH UNIT Errors" =
		        Table.ReplaceErrorValues(
		            #"Changed Type",
		            {{"PURCH UNIT", "N/A"}}
		        ),
		
		    #"Replaced WHS Errors" =
		        Table.ReplaceErrorValues(
		            #"Replaced PURCH UNIT Errors",
		            {{"Current WHS ID", "N/A"}}
		        ),
		
		    #"Replaced Designation Errors" =
		        Table.ReplaceErrorValues(
		            #"Replaced WHS Errors",
		            {{"Designation", "N/A"}}
		        )
		
		in
		    #"Replaced Designation Errors"
