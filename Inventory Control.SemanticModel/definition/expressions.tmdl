expression ref_soh_article_global_status =
		let
		    Source = #"SOH Control",
		
		    FxArticleNoText =
		        (x as any) as nullable text =>
		            let
		                Result =
		                    try
		                        if x = null then null
		                        else if Value.Is(x, type number) then Number.ToText(x, "0")
		                        else Text.Trim(Text.Clean(Text.From(x)))
		                    otherwise null
		            in
		                Result,
		
		    FxCleanKey =
		        (x as any) as nullable text =>
		            let
		                Result =
		                    try
		                        if x = null then null
		                        else fnCleanText(x)
		                    otherwise null
		            in
		                Result,
		
		    FxArticleMatchKey =
		        (ArticleNoValue as any, ArticleValue as any) as nullable text =>
		            let
		                ArticleNoKey = FxArticleNoText(ArticleNoValue),
		                ArticleNameKey = FxCleanKey(ArticleValue),
		
		                Result =
		                    if ArticleNoKey <> null and ArticleNoKey <> "" then
		                        "NO|" & ArticleNoKey
		                    else if ArticleNameKey <> null and ArticleNameKey <> "" then
		                        "NAME|" & ArticleNameKey
		                    else
		                        null
		            in
		                Result,
		
		    KeepColumns =
		        Table.SelectColumns(
		            Source,
		            {
		                "Article No.",
		                "Article",
		                "ACT SOH",
		                "Base Unit",
		                "P. Price",
		                "AVE"
		            },
		            MissingField.Ignore
		        ),
		
		    TypeChanges =
		        Table.TransformColumnTypes(
		            KeepColumns,
		            {
		                {"Article No.", type text},
		                {"Article", type text},
		                {"ACT SOH", type number},
		                {"Base Unit", type text},
		                {"P. Price", type number},
		                {"AVE", type number}
		            },
		            "en-US"
		        ),
		
		    CleanColumns =
		        Table.TransformColumns(
		            TypeChanges,
		            {
		                {"Article No.", each FxArticleNoText(_), type nullable text},
		                {"Article", each fnCleanText(_), type nullable text},
		                {"Base Unit", each fnCleanBaseUnit(_), type nullable text}
		            },
		            null,
		            MissingField.Ignore
		        ),
		
		    AddArticleMatchKey =
		        Table.AddColumn(
		            CleanColumns,
		            "Article Match Key",
		            each FxArticleMatchKey([#"Article No."], [Article]),
		            type nullable text
		        ),
		
		    FilterValidArticle =
		        Table.SelectRows(
		            AddArticleMatchKey,
		            each
		                [Article Match Key] <> null
		                and [Article Match Key] <> ""
		        ),
		
		    GroupedByArticle =
		        Table.Group(
		            FilterValidArticle,
		            {"Article Match Key"},
		            {
		                {"SOH Article No.", each try List.First(List.RemoveNulls([#"Article No."])) otherwise null, type nullable text},
		                {"SOH Article", each try List.First(List.RemoveNulls([Article])) otherwise null, type nullable text},
		                {"SOH Base Unit", each try List.First(List.RemoveNulls([Base Unit])) otherwise null, type nullable text},
		                {"Article Total ACT SOH", each try List.Sum(List.RemoveNulls([ACT SOH])) otherwise null, type nullable number},
		                {"Article Max ACT SOH", each try List.Max(List.RemoveNulls([ACT SOH])) otherwise null, type nullable number},
		                {"Article Min ACT SOH", each try List.Min(List.RemoveNulls([ACT SOH])) otherwise null, type nullable number},
		                {"SOH Row Count", each Table.RowCount(_), Int64.Type},
		                {"SOH Valid Row Count", each List.Count(List.RemoveNulls([ACT SOH])), Int64.Type},
		                {"SOH Negative/Zero Row Count", each List.Count(List.Select(List.RemoveNulls([ACT SOH]), each _ <= 0)), Int64.Type},
		                {"SOH Avg P. Price", each try List.Average(List.RemoveNulls([#"P. Price"])) otherwise null, type nullable number},
		                {"SOH Avg AVE", each try List.Average(List.RemoveNulls([AVE])) otherwise null, type nullable number}
		            }
		        ),
		
		    AddArticleGlobalNegativeFlag =
		        Table.AddColumn(
		            GroupedByArticle,
		            "Article Global Negative Flag",
		            each
		                if [SOH Valid Row Count] > 0 and [Article Max ACT SOH] <= 0
		                then 1
		                else 0,
		            Int64.Type
		        ),
		
		    AddArticleGlobalNegativeStatus =
		        Table.AddColumn(
		            AddArticleGlobalNegativeFlag,
		            "Article Global Negative Status",
		            each
		                if [SOH Valid Row Count] = 0 then "No Valid SOH"
		                else if [Article Max ACT SOH] <= 0 then "Globally Negative / Zero"
		                else "Positive SOH Exists",
		            type text
		        ),
		
		    ReorderedColumns =
		        Table.ReorderColumns(
		            AddArticleGlobalNegativeStatus,
		            {
		                "Article Match Key",
		                "SOH Article No.",
		                "SOH Article",
		                "SOH Base Unit",
		                "Article Total ACT SOH",
		                "Article Max ACT SOH",
		                "Article Min ACT SOH",
		                "SOH Row Count",
		                "SOH Valid Row Count",
		                "SOH Negative/Zero Row Count",
		                "Article Global Negative Flag",
		                "Article Global Negative Status",
		                "SOH Avg P. Price",
		                "SOH Avg AVE"
		            },
		            MissingField.Ignore
		        )
		in
		    ReorderedColumns
	lineageTag: e8469a08-d588-4d13-8066-4451c659b5ff

