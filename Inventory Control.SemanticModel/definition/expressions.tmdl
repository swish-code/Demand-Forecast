		            GRNWithMatchKey,
		            {"__Match Key"},
		            POGrouped,
		            {"__Match Key"},
		            "PO Group",
		            JoinKind.LeftOuter
		        ),
		
		    ExpandPOGroup =
		        Table.ExpandTableColumn(
		            MergePOGroup,
		            "PO Group",
		            {"PO Candidates", "PO Candidate Count"},
		            {"PO Candidates", "PO Candidate Count"}
		        ),
		
		    ReplaceNullCandidateCount =
		        Table.ReplaceValue(
		            ExpandPOGroup,
		            null,
		            0,
		            Replacer.ReplaceValue,
		            {"PO Candidate Count"}
		        ),
		
		    AddSelectedPO =
		        Table.AddColumn(
		            ReplaceNullCandidateCount,
		            "__Selected PO Period ID",
		            each
		                let
		                    GrnDate = FxDate([GRN Delivery Date]),
		                    Candidates = try [PO Candidates] otherwise null,
		
		                    MatchedCandidates =
		                        if Candidates = null or GrnDate = null then
		                            #table({}, {})
		                        else
		                            Table.SelectRows(
		                                Candidates,
		                                each
		                                    FxDate([PO Start Date]) <> null
		                                    and FxDate([PO End Date]) <> null
		                                    and GrnDate >= FxDate([PO Start Date])
		                                    and GrnDate <= FxDate([PO End Date])
		                            ),
		
		                    SortedMatched =
		                        if Table.IsEmpty(MatchedCandidates) then
		                            MatchedCandidates
		                        else
		                            Table.Sort(
		                                MatchedCandidates,
		                                {
		                                    {"PO Start Date", Order.Descending},
		                                    {"PO End Date", Order.Ascending}
		                                }
		                            ),
		
		                    Result =
		                        if Table.IsEmpty(SortedMatched) then
		                            null
		                        else
		                            SortedMatched{0}[PO Period ID]
		                in
		                    Result,
		            type nullable text
		        ),
		
		    KeepOnlyUnmatched =
		        Table.SelectRows(
		            AddSelectedPO,
		            each [__Selected PO Period ID] = null
		        ),
		
		    AddedRecoveredPONo =
		        Table.AddColumn(
		            KeepOnlyUnmatched,
		            "__Recovered PO No",
		            each
		                if FxHasPONo([GRN PO No]) then
		                    FxSafeText([GRN PO No])
		                else
		                    "NO PO DEFINED",
		            type text
		        ),
		
		    AddedRecoveredRequiredBaseQty =
		        Table.AddColumn(
		            AddedRecoveredPONo,
		            "__Recovered Required Base Qty",
		            each
		                let
		                    RequestedBase = FxNum([Requested Base Qty]),
		                    GrnBase = FxNum([GRN Base Qty])
		                in
		                    if RequestedBase <> null and RequestedBase > 0 then
		                        RequestedBase
		                    else
		                        GrnBase,
		            type nullable number
		        ),
		
		    AddedRecoveredRequiredQty =
		        Table.AddColumn(
		            AddedRecoveredRequiredBaseQty,
		            "__Recovered Required Qty",
		            each
		                let
		                    RequestedQty = FxNum([Requested QTY]),
		                    GrnQty = FxNum([GRN Qty])
		                in
		                    if RequestedQty <> null and RequestedQty > 0 then
		                        RequestedQty
		                    else
		                        GrnQty,
		            type nullable number
		        ),
		
		    AddedRecoveredRequiredSource =
		        Table.AddColumn(
		            AddedRecoveredRequiredQty,
		            "Recovered Required Qty Source",
		            each
		                let
		                    RequestedBase = FxNum([Requested Base Qty]),
		                    RequestedQty = FxNum([Requested QTY])
		                in
		                    if RequestedBase <> null and RequestedBase > 0 then
		                        "Delivery Note Requested QTY"
		                    else if RequestedQty <> null and RequestedQty > 0 then
		                        "Delivery Note Requested QTY"
		                    else
		                        "GRN Qty Fallback",
		            type text
		        ),
		
		    FilteredUsableRows =
		        Table.SelectRows(
		            AddedRecoveredRequiredSource,
		            each
		                FxNum([GRN Base Qty]) <> null
		                and FxNum([GRN Base Qty]) > 0
		                and FxNum([__Recovered Required Base Qty]) <> null
		                and FxNum([__Recovered Required Base Qty]) > 0
		        ),
		
		    AddedRecoveryGroupID =
		        Table.AddColumn(
		            FilteredUsableRows,
		            "__Recovery Group ID",
		            each
		                "RECOVERED|"
		                    & FxSafeText([Article])
		                    & "|"
		                    & FxSafeText([Warehouse])
		                    & "|"
		                    & FxSafeText([__Recovered PO No]),
		            type text
		        ),
		
		    AddedGRNMatchStatusBase =
		        Table.AddColumn(
		            AddedRecoveryGroupID,
		            "__GRN Match Status",
		            each
		                if FxHasPONo([GRN PO No]) = false then
		                    "No PO Defined"
		                else if [PO Candidate Count] = 0 then
		                    "No Active PO Match"
		                else
		                    "PO No Found But Outside Active Period",
		            type text
		        ),
		
		    RemovedHeavyHelpers =
		        Table.RemoveColumns(
		            AddedGRNMatchStatusBase,
		            {
		                "PO Candidates",
		                "__Selected PO Period ID",
		                "__Match Key"
		            },
		            MissingField.Ignore
		        ),
		
		    GroupedRows =
		        Table.Group(
		            RemovedHeavyHelpers,
		            {"__Recovery Group ID"},
		            {
		                {"PO Period Source", each "Recovered From GRN", type text},
		                {"Inbound Match Status", each "Non-Matched", type text},
		                {"GRN Match Status", each FxTextList([__GRN Match Status]), type nullable text},
		
		                {"Article", each FxFirstText([Article]), type nullable text},
		                {"Warehouse", each FxFirstText([Warehouse]), type nullable text},
		                {"Final Cost Center", each null, type nullable text},
		
		                {"PO No", each FxFirstText([__Recovered PO No]), type nullable text},
		                {"PO Supplier", each null, type nullable text},
		                {"PO Supplier List", each null, type nullable text},
		
		                {
		                    "Actual GRN Supplier",
		                    each
		                        let
		                            Suppliers =
		                                List.Sort(
		                                    List.Distinct(
		                                        List.Select(
		                                            List.Transform(
		                                                List.RemoveNulls([Supplier]),
		                                                each FxSafeText(_)
		                                            ),
		                                            each _ <> "" and Text.Upper(_) <> "NULL"
		                                        )
		                                    )
		                                )
		                        in
		                            if List.Count(Suppliers) = 0 then null
		                            else if List.Count(Suppliers) = 1 then Suppliers{0}
		                            else "MULTIPLE",
		                    type nullable text
		                },
		
		                {"Actual GRN Supplier List", each FxTextList([Supplier]), type nullable text},
		
		                {"PO Unit List", each null, type nullable text},
		                {"Actual GRN Unit List", each FxTextList([GRN Unit]), type nullable text},
		                {"PO Base Unit List", each FxTextList([GRN Base Unit]), type nullable text},
		
		                {"PO Date", each FxMinDate([DN Order Date]), type nullable date},
		                {"PO Start Date", each FxMinDate([GRN Delivery Date]), type nullable date},
		                {"Next PO Date", each null, type nullable date},
		                {"PO End Date", each FxMaxDate([GRN Delivery Date]), type nullable date},
		
		                {
		                    "PO Base Qty",
		                    each
		                        let
		                            ReqDistinct = FxDistinctPositiveNumberList([Requested Base Qty]),
		                            GrnList = FxPositiveNumberList([GRN Base Qty])
		                        in
		                            if List.Count(ReqDistinct) = 1 then ReqDistinct{0}
		                            else if List.Count(ReqDistinct) > 1 then null
		                            else if List.Count(GrnList) > 0 then List.Sum(GrnList)
		                            else null,
		                    type nullable number
		                },
		
		                {
		                    "Recovered Required Qty",
		                    each
		                        let
		                            ReqDistinct = FxDistinctPositiveNumberList([Requested QTY]),
		                            GrnList = FxPositiveNumberList([GRN Qty])
		                        in
		                            if List.Count(ReqDistinct) = 1 then ReqDistinct{0}
		                            else if List.Count(ReqDistinct) > 1 then null
		                            else if List.Count(GrnList) > 0 then List.Sum(GrnList)
		                            else null,
		                    type nullable number
		                },
		
		                {
		                    "Recovered Required Base Qty",
		                    each
		                        let
		                            ReqDistinct = FxDistinctPositiveNumberList([Requested Base Qty]),
		                            GrnList = FxPositiveNumberList([GRN Base Qty])
		                        in
		                            if List.Count(ReqDistinct) = 1 then ReqDistinct{0}
		                            else if List.Count(ReqDistinct) > 1 then null
		                            else if List.Count(GrnList) > 0 then List.Sum(GrnList)
		                            else null,
		                    type nullable number
		                },
		
		                {
		                    "Recovered Required Qty Source",
		                    each
		                        let
		                            ReqQtyDistinct = FxDistinctPositiveNumberList([Requested QTY]),
		                            ReqBaseDistinct = FxDistinctPositiveNumberList([Requested Base Qty]),
		                            HasRequest = List.Count(ReqQtyDistinct) > 0 or List.Count(ReqBaseDistinct) > 0,
		                            HasConflict = List.Count(ReqQtyDistinct) > 1 or List.Count(ReqBaseDistinct) > 1
		                        in
		                            if HasConflict then "Delivery Note Requested QTY Conflict"
		                            else if HasRequest then "Delivery Note Requested QTY"
		                            else "GRN Qty Fallback",
		                    type nullable text
		                },
		
		                {
		                    "Requested Qty Conflict Flag",
		                    each
		                        let
		                            ReqQtyDistinct = FxDistinctPositiveNumberList([Requested QTY]),
		                            ReqBaseDistinct = FxDistinctPositiveNumberList([Requested Base Qty])
		                        in
		                            if List.Count(ReqQtyDistinct) > 1 or List.Count(ReqBaseDistinct) > 1 then 1 else 0,
		                    Int64.Type
		                },
		
		                {
		                    "Requested Qty Conflict Status",
		                    each
		                        let
		                            ReqQtyDistinct = FxDistinctPositiveNumberList([Requested QTY]),
		                            ReqBaseDistinct = FxDistinctPositiveNumberList([Requested Base Qty]),
		                            HasRequest = List.Count(ReqQtyDistinct) > 0 or List.Count(ReqBaseDistinct) > 0,
		                            HasConflict = List.Count(ReqQtyDistinct) > 1 or List.Count(ReqBaseDistinct) > 1
		                        in
		                            if HasConflict then "Requested Qty Conflict"
		                            else if HasRequest then "No Conflict"
		                            else "No Delivery Note Requested Qty",
		                    type text
		                },
		
		                {"Requested Qty Distinct Count", each List.Count(FxDistinctPositiveNumberList([Requested QTY])), Int64.Type},
		                {"Requested Base Qty Distinct Count", each List.Count(FxDistinctPositiveNumberList([Requested Base Qty])), Int64.Type},
		                {"Requested Qty List", each FxNumberListText([Requested QTY]), type nullable text},
		                {"Requested Base Qty List", each FxNumberListText([Requested Base Qty]), type nullable text},
		
		                {"Allocated GRN Base Qty", each List.Sum(FxPositiveNumberList([GRN Base Qty])), type nullable number},
		                {"Allocated GRN Qty", each List.Sum(FxPositiveNumberList([GRN Qty])), type nullable number},
		
		                {
		                    "Same Day GRN Base Qty",
		                    each
		                        let
		                            FirstDate = FxMinDate([GRN Delivery Date]),
		                            SameDayRows =
		                                if FirstDate = null then
		                                    #table({"GRN Base Qty"}, {})
		                                else
		                                    Table.SelectRows(
		                                        _,
		                                        (r) => FxDate(r[GRN Delivery Date]) = FirstDate
		                                    )
		                        in
		                            List.Sum(FxPositiveNumberList(SameDayRows[GRN Base Qty])),
		                    type nullable number
		                },
		
		                {
		                    "Late GRN Base Qty",
		                    each
		                        let
		                            FirstDate = FxMinDate([GRN Delivery Date]),
		                            LateRows =
		                                if FirstDate = null then
		                                    #table({"GRN Base Qty"}, {})
		                                else
		                                    Table.SelectRows(
		                                        _,
		                                        (r) => FxDate(r[GRN Delivery Date]) > FirstDate
		                                    )
		                        in
		                            List.Sum(FxPositiveNumberList(LateRows[GRN Base Qty])),
		                    type nullable number
		                },
		
		                {"PO Value", each null, type nullable number},
		                {"GRN Value", each List.Sum(FxNumberList([GRN Value])), type nullable number},
		
		                {"PO Count", each 1, Int64.Type},
		                {"PO Line Count", each 0, Int64.Type},
		                {"Delivery Note Count", each List.Count(List.Distinct(List.RemoveNulls([Delivery Note No]))), Int64.Type},
		                {"GRN Line Count", each Table.RowCount(_), Int64.Type},
		
		                {"Delivery Note List", each FxTextList([Delivery Note No]), type nullable text},
		                {"GRN PO No List", each FxTextList([GRN PO No]), type nullable text},
		
		                {"First GRN Date", each FxMinDate([GRN Delivery Date]), type nullable date},
		                {"Last GRN Date", each FxMaxDate([GRN Delivery Date]), type nullable date},
		
		                {"First Booking DateTime", each FxMinDateTime([Booking DateTime]), type nullable datetime},
		                {"Last Booking DateTime", each FxMaxDateTime([Booking DateTime]), type nullable datetime},
		
		                {"GRN Match Status List", each FxTextList([__GRN Match Status]), type nullable text},
		                {"Inbound Match Status List", each "Non-Matched", type text},
		
		                {"Sub_Category", each FxFirstText([Sub_Category]), type nullable text},
		                {"Item_Group", each FxFirstText([Item_Group]), type nullable text},
		                {"Storage_Type", each FxFirstText([Storage_Type]), type nullable text}
		            }
		        ),
		
		    RenamedPOPeriodID =
		        Table.RenameColumns(
		            GroupedRows,
		            {{"__Recovery Group ID", "PO Period ID"}},
		            MissingField.Ignore
		        ),
		
		    AddedPendingQty =
		        Table.AddColumn(
		            RenamedPOPeriodID,
		            "Pending Qty",
		            each
		                let
		                    ReqQty = FxNum([PO Base Qty]),
		                    GrnQty = FxNum([Allocated GRN Base Qty])
		                in
		                    if ReqQty <> null and GrnQty <> null and ReqQty > GrnQty then
		                        ReqQty - GrnQty
		                    else
		                        0,
		            type number
		        ),
		
		    AddedOverDeliveredQty =
		        Table.AddColumn(
		            AddedPendingQty,
		            "Over Delivered Qty",
		            each
		                let
		                    ReqQty = FxNum([PO Base Qty]),
		                    GrnQty = FxNum([Allocated GRN Base Qty])
		                in
		                    if ReqQty <> null and GrnQty <> null and GrnQty > ReqQty then
		                        GrnQty - ReqQty
		                    else
		                        0,
		            type number
		        ),
		
		    AddedFulfillmentStatus =
		        Table.AddColumn(
		            AddedOverDeliveredQty,
		            "Fulfillment Status",
		            each
		                let
		                    ReqQty = FxNum([PO Base Qty]),
		                    GrnQty = FxNum([Allocated GRN Base Qty]),
		                    ConflictFlag = try [Requested Qty Conflict Flag] otherwise 0
		                in
		                    if ConflictFlag = 1 then
		                        "Requested Qty Conflict"
		                    else if GrnQty = null or GrnQty = 0 then
		                        "Not Received"
		                    else if ReqQty = null or ReqQty = 0 then
		                        "Unknown"
		                    else if Number.Abs(GrnQty - ReqQty) <= 0.01 then
		                        "Fully Delivered"
		                    else if GrnQty < ReqQty then
		                        "Partially Delivered"
		                    else if GrnQty > ReqQty then
		                        "Over Delivered"
		                    else
		                        "Unknown",
		            type text
		        ),
		
		    AddedInFullFlag =
		        Table.AddColumn(
		            AddedFulfillmentStatus,
		            "In Full Flag",
		            each
		                let
		                    ReqQty = FxNum([PO Base Qty]),
		                    GrnQty = FxNum([Allocated GRN Base Qty]),
		                    ConflictFlag = try [Requested Qty Conflict Flag] otherwise 0
		                in
		                    if ConflictFlag = 0
		                        and ReqQty <> null
		                        and ReqQty > 0
		                        and GrnQty <> null
		                        and GrnQty >= ReqQty
		                    then 1
		                    else 0,
		            Int64.Type
		        ),
		
		    AddedOnTimeFlag =
		        Table.AddColumn(
		            AddedInFullFlag,
		            "On Time Flag",
		            each
		                let
		                    ReqQty = FxNum([PO Base Qty]),
		                    SameDayQty = FxNum([Same Day GRN Base Qty]),
		                    ConflictFlag = try [Requested Qty Conflict Flag] otherwise 0
		                in
		                    if ConflictFlag = 0
		                        and ReqQty <> null
		                        and ReqQty > 0
		                        and SameDayQty <> null
		                        and SameDayQty >= ReqQty
		                    then 1
		                    else 0,
		            Int64.Type
		        ),
		
		    AddedOTIFFlag =
		        Table.AddColumn(
		            AddedOnTimeFlag,
		            "OTIF Flag",
		            each
		                if [In Full Flag] = 1 and [On Time Flag] = 1 then
		                    1
		                else
		                    0,
		            Int64.Type
		        ),
		
		    AddedFirstBookingDate =
		        Table.AddColumn(
		            AddedOTIFFlag,
		            "First Booking Date",
		            each
		                if [First Booking DateTime] = null then
		                    null
		                else
		                    Date.From([First Booking DateTime]),
		            type nullable date
		        ),
		
		    AddedLastBookingDate =
		        Table.AddColumn(
		            AddedFirstBookingDate,
		            "Last Booking Date",
		            each
		                if [Last Booking DateTime] = null then
		                    null
		                else
		                    Date.From([Last Booking DateTime]),
		            type nullable date
		        ),
		
		    AddedFirstReceiptDelayDays =
		        Table.AddColumn(
		            AddedLastBookingDate,
		            "First Receipt Delay Days",
		            each
		                if [First GRN Date] = null or [PO Start Date] = null then
		                    null
		                else
		                    Duration.Days([First GRN Date] - [PO Start Date]),
		            Int64.Type
		        ),
		
		    AddedReceiptSpreadDays =
		        Table.AddColumn(
		            AddedFirstReceiptDelayDays,
		            "Receipt Spread Days",
		            each
		                if [First GRN Date] = null or [Last GRN Date] = null then
		                    null
		                else
		                    Duration.Days([Last GRN Date] - [First GRN Date]),
		            Int64.Type
		        ),
		
		    AddedRecoveredFlag =
		        Table.AddColumn(
		            AddedReceiptSpreadDays,
		            "Recovered Include In Fill Rate Flag",
		            each
		                if [Requested Qty Conflict Flag] = 1 then
		                    0
		                else
		                    1,
		            Int64.Type
		        ),
		
		    ReorderedColumns =
		        Table.ReorderColumns(
		            AddedRecoveredFlag,
		            {
		                "PO Period ID",
		                "PO Period Source",
		                "Inbound Match Status",
		                "GRN Match Status",
		                "Article",
		                "Warehouse",
		                "Final Cost Center",
		                "PO No",
		                "PO Supplier",
		                "PO Supplier List",
		                "Actual GRN Supplier",
		                "Actual GRN Supplier List",
		                "PO Unit List",
		                "Actual GRN Unit List",
		                "PO Base Unit List",
		                "PO Date",
		                "PO Start Date",
		                "Next PO Date",
		                "PO End Date",
		                "PO Base Qty",
		                "Recovered Required Qty",
		                "Recovered Required Base Qty",
		                "Recovered Required Qty Source",
		                "Requested Qty Conflict Flag",
		                "Requested Qty Conflict Status",
		                "Requested Qty Distinct Count",
		                "Requested Base Qty Distinct Count",
		                "Requested Qty List",
		                "Requested Base Qty List",
		                "Allocated GRN Base Qty",
		                "Allocated GRN Qty",
		                "Same Day GRN Base Qty",
		                "Late GRN Base Qty",
		                "Pending Qty",
		                "Over Delivered Qty",
		                "PO Value",
		                "GRN Value",
		                "PO Count",
		                "PO Line Count",
		                "Delivery Note Count",
		                "GRN Line Count",
		                "Delivery Note List",
		                "GRN PO No List",
		                "First GRN Date",
		                "Last GRN Date",
		                "First Booking Date",
		                "Last Booking Date",
		                "First Booking DateTime",
		                "Last Booking DateTime",
		                "First Receipt Delay Days",
		                "Receipt Spread Days",
		                "Fulfillment Status",
		                "In Full Flag",
		                "On Time Flag",
		                "OTIF Flag",
		                "GRN Match Status List",
		                "Inbound Match Status List",
		                "Recovered Include In Fill Rate Flag",
		                "Sub_Category",
		                "Item_Group",
		                "Storage_Type"
		            },
		            MissingField.Ignore
		        )
		in
		    ReorderedColumns
	lineageTag: 0488f168-4d75-46ad-a77f-4f104ca1444a

