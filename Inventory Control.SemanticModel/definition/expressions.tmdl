 QTY REPLEN", type text}, {"W10 PIPELINE PENDNG PO", type text}, {"WEEK10 PROJ STOCK", type text}, {"WEEK10 PROJ DTL", type text}, {"WEEK12 QTY REPLEN", type text}, {"WEEK12 PROJ STOCK", type text}, {"WEEK12 PROJ DTL", type text}, {"OOS, <3DTL, <7DTL,<15DTL", type text}, {"Current Common", type text}, {"Column74", type any}, {"Column75", type any}}),
