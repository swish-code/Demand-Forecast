expression fact_grn_recovered_lifecycle =
		let
		    PO = fact_po_period_base,
		    GRN = fact_grn_line,
		
		    FxSafeText =
		        (x as any) as text =>
		            try
		                if x = null then ""
		                else Text.Trim(Text.Clean(Text.From(x)))
		            otherwise "",
		
		    FxUpperText =
		        (x as any) as text =>
		            Text.Upper(FxSafeText(x)),
		
		    FxDate =
		        (x as any) as nullable date =>
		            try Date.From(x) otherwise null,
		
		    FxDateTime =
		        (x as any) as nullable datetime =>
		            try DateTime.From(x) otherwise null,
		
		    FxNum =
		        (x as any) as nullable number =>
		            try Number.From(x) otherwise null,
		
		    FxNumberList =
		        (InputList as list) as list =>
		            List.RemoveNulls(
		                List.Transform(
		                    InputList,
		                    each FxNum(_)
		                )
		            ),
		
		    FxPositiveNumberList =
		        (InputList as list) as list =>
		            List.Select(
		                FxNumberList(InputList),
		                each _ > 0
		            ),
		
		    FxDistinctPositiveNumberList =
		        (InputList as list) as list =>
		            List.Sort(
		                List.Distinct(
		                    List.Transform(
		                        FxPositiveNumberList(InputList),
		                        each Number.Round(_, 5)
		                    )
		                )
		            ),
		
		    FxNumberListText =
		        (InputList as list) as nullable text =>
		            let
		                CleanList = FxDistinctPositiveNumberList(InputList),
		                TextList =
		                    List.Transform(
		                        CleanList,
		                        each Number.ToText(_, "0.#####", "en-US")
		                    )
		            in
		                if List.Count(TextList) = 0 then null else Text.Combine(TextList, ", "),
		
		    FxHasPONo =
		        (PONo as any) as logical =>
		            let
		                T = FxUpperText(PONo)
		            in
		                T <> ""
		                    and T <> "NO PO DEFINED"
		                    and T <> "NO_PO"
		                    and T <> "N/A"
		                    and T <> "NA"
		                    and T <> "NULL",
		
		    FxTextList =
		        (InputList as list) as nullable text =>
		            let
		                CleanList =
		                    List.Sort(
		                        List.Distinct(
		                            List.Select(
		                                List.Transform(
		                                    List.RemoveNulls(InputList),
		                                    each FxSafeText(_)
		                                ),
		                                each _ <> "" and Text.Upper(_) <> "NULL"
		                            )
		                        )
		                    )
		            in
		                if List.Count(CleanList) = 0 then null else Text.Combine(CleanList, ", "),
		
		    FxFirstText =
		        (InputList as list) as nullable text =>
		            let
		                CleanList =
		                    List.Select(
		                        List.Transform(
		                            List.RemoveNulls(InputList),
		                            each FxSafeText(_)
		                        ),
		                        each _ <> "" and Text.Upper(_) <> "NULL"
		                    )
		            in
		                if List.Count(CleanList) = 0 then null else CleanList{0},
		
		    FxMinDate =
		        (InputList as list) as nullable date =>
		            let
		                CleanList =
		                    List.RemoveNulls(
		                        List.Transform(
		                            InputList,
		                            each FxDate(_)
		                        )
		                    )
		            in
		                if List.Count(CleanList) = 0 then null else List.Min(CleanList),
		
		    FxMaxDate =
		        (InputList as list) as nullable date =>
		            let
		                CleanList =
		                    List.RemoveNulls(
		                        List.Transform(
		                            InputList,
		                            each FxDate(_)
		                        )
		                    )
		            in
		                if List.Count(CleanList) = 0 then null else List.Max(CleanList),
		
		    FxMinDateTime =
		        (InputList as list) as nullable datetime =>
		            let
		                CleanList =
		                    List.RemoveNulls(
		                        List.Transform(
		                            InputList,
		                            each FxDateTime(_)
		                        )
		                    )
		            in
		                if List.Count(CleanList) = 0 then null else List.Min(CleanList),
		
		    FxMaxDateTime =
		        (InputList as list) as nullable datetime =>
		            let
		                CleanList =
		                    List.RemoveNulls(
		                        List.Transform(
		                            InputList,
		                            each FxDateTime(_)
		                        )
		                    )
		            in
		                if List.Count(CleanList) = 0 then null else List.Max(CleanList),
		
		    FxMatchKey =
		        (Article as any, Warehouse as any, PONo as any) as text =>
		            FxSafeText(Article)
		                & "|"
		                & FxSafeText(Warehouse)
		                & "|"
		                & FxSafeText(PONo),
		
		    POSelected =
		        Table.SelectColumns(
		            PO,
		            {
		                "PO Period ID",
		                "PO Period Source",
		                "Article",
		                "Warehouse",
		                "PO No",
		                "PO Start Date",
		                "PO End Date"
		            },
		            MissingField.Ignore
		        ),
		
		    POReady =
		        Table.SelectRows(
		            POSelected,
		            each
		                [PO Period ID] <> null
		                and [PO Period ID] <> ""
		                and [Article] <> null
		                and [Article] <> ""
		                and [Warehouse] <> null
		                and [Warehouse] <> ""
		                and [PO No] <> null
		                and [PO No] <> ""
		                and [PO Start Date] <> null
		                and [PO End Date] <> null
		        ),
		
		    POWithMatchKey =
		        Table.AddColumn(
		            POReady,
		            "__Match Key",
		            each FxMatchKey([Article], [Warehouse], [PO No]),
		            type text
		        ),
		
		    POForGrouping =
		        Table.SelectColumns(
		            POWithMatchKey,
		            {
		                "__Match Key",
		                "PO Period ID",
		                "PO Start Date",
		                "PO End Date"
		            },
		            MissingField.Ignore
		        ),
		
		    POGrouped =
		        Table.Buffer(
		            Table.Group(
		                POForGrouping,
		                {"__Match Key"},
		                {
		                    {
		                        "PO Candidates",
		                        each
		                            Table.Sort(
		                                _,
		                                {
		                                    {"PO Start Date", Order.Descending},
		                                    {"PO End Date", Order.Ascending}
		                                }
		                            ),
		                        type table
		                    },
		                    {
