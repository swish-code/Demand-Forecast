		                }
		            )
		        ),
		
		    GRNFiltered =
		        Table.SelectRows(
		            GRN,
		            each
		                [Article] <> null
		                and [Article] <> ""
		                and [Warehouse] <> null
		                and [Warehouse] <> ""
		                and [GRN Delivery Date] <> null
		                and [GRN Line ID] <> null
		                and [GRN Line ID] <> ""
		                and FxNum([GRN Base Qty]) <> null
		                and FxNum([GRN Base Qty]) > 0
