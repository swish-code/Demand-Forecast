		            "Manager Stock Article No.",
		            each
		                if FxHasText([#"No Map Stock Article No."]) then [#"No Map Stock Article No."]
		                else if FxHasText([#"Name Map Stock Article No."]) then [#"Name Map Stock Article No."]
		                else null,
		            type nullable text
		        ),
		
		    #"Added Manager Item Group" =
		        Table.AddColumn(
		            #"Added Manager Stock Article No",
		            "Manager Item Group",
		            each
		                if FxHasText([No Map Item Group]) then [No Map Item Group]
		                else if FxHasText([Name Map Item Group]) then [Name Map Item Group]
		                else null,
		            type nullable text
		        ),
		
		    #"Added Manager Category" =
		        Table.AddColumn(
		            #"Added Manager Item Group",
		            "Manager Category",
		            each
		                if FxHasText([No Map Category]) then [No Map Category]
		                else if FxHasText([Name Map Category]) then [Name Map Category]
		                else null,
		            type nullable text
		        ),
		
		    #"Added Manager Category Group" =
