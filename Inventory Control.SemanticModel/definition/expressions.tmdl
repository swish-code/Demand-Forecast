expression fnCleanText =
		(x as any) as nullable text =>
		let
		    SourceText = if x = null then null else Text.From(x),
		    Cleaned = if SourceText = null then null else Text.Clean(Text.Trim(SourceText)),
		    NoNBSP = if Cleaned = null then null else Text.Replace(Cleaned, Character.FromNumber(160), " "),
		    SplitWords = if NoNBSP = null then null else List.Select(Text.Split(NoNBSP, " "), each _ <> ""),
		    SingleSpaced = if SplitWords = null then null else Text.Combine(SplitWords, " "),
		    UpperText = if SingleSpaced = null or SingleSpaced = "" then null else Text.Upper(SingleSpaced)
		in
		    UpperText
	lineageTag: e02adaad-a4a1-4055-93f7-c583f6851b9a

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Function

expression fnCleanBaseUnit =
		(x as any) as nullable text =>
		let
		    U = fnCleanText(x),
		    Result =
		        if U = null then null
		        else if List.Contains({"KG", "KGS", "KILOGRAM", "KILOGRAMS"}, U) then "KG"
		        else if List.Contains({"LITER", "LITRE", "LTR", "LITERS", "LITRES"}, U) then "LITER"
		        else if List.Contains({"EACH", "EA", "PCS", "PC", "PIECE", "PIECES"}, U) then "EACH"
		        else U
		in
		    Result
	lineageTag: 502597da-70cd-4de9-9838-ff71d76980d5

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Function

expression fnDateOnly =
		(x as any) as nullable date =>
		let
		    Result =
		        if x = null then null
		        else if Value.Is(x, type date) then x
		        else if Value.Is(x, type datetime) then Date.From(x)
		        else if Value.Is(x, type datetimezone) then Date.From(x)
		        else
		            let
		                T = Text.Trim(Text.From(x))
		            in
		                try Date.FromText(T, [Culture = "en-GB"])
		                otherwise try Date.FromText(T, [Culture = "en-US"])
		                otherwise try Date.From(DateTime.FromText(T, [Culture = "en-GB"]))
		                otherwise try Date.From(DateTime.FromText(T, [Culture = "en-US"]))
		                otherwise null
		in
		    Result
	lineageTag: 40b114a5-2bb5-46db-9a9a-dbca5556102b

