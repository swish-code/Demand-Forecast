expression CategoryLookup =
		let
		    Source = Excel.Workbook(
		        Web.Contents("https://etckuwait-my.sharepoint.com/personal/thalbish_swishhh_net/Documents/RECIPIES%20TEST.xlsm"),
		        null,
		        true
		    ),
		
		    ReplenPlanning_Sheet = Source{[Item="Replen Planning", Kind="Sheet"]}[Data],
		
		    PromotedHeaders1 = Table.PromoteHeaders(ReplenPlanning_Sheet, [PromoteAllScalars=true]),
		
		    RemovedTopRows = Table.Skip(PromotedHeaders1, 7),
		
		    PromotedHeaders = Table.PromoteHeaders(RemovedTopRows, [PromoteAllScalars=true]),
		
		    ChangedType = Table.TransformColumnTypes(PromotedHeaders,{{"Article No.", type text}, {"CODE", type text}, {"ITEM DESCRIPTION", type text}, {"BASE UNIT", type text}, {"IS ACTIVE", type text}, {"Designation", type any}, {"SubCAT", type text}, {"Current WHS ID", type any}, {"ITEM GROUP", type text}, {"STORAGE TYPE", type text}}),
		
		    RemovedColumns = Table.RemoveColumns(ChangedType,{"CODE", "Designation", "Current WHS ID", "PURCH UNIT", "CURRENT STOCK WAC", "TOTAL WAC MTD", "LEAD TIME", "open delivery note", "TRF OUT Delivered & Declined", "CURRENT STOCK", "Actual SOH", "Last PP", "Last PD", "Last TR", "12/25/2025", "1/26/2026", "2/26/2026", "3/26/2026", "MIN", "MAX", "AVG TRANSFER OUT", "WEIGHT MIN", "WEIGHT MAX", "DAYS TO LAST (DTL)", "ReqDate", "ReceinvgDate", "OOS DATE", "CURRENT MONTH - MTD TRANSFER", "MTD XTRAPOL % vs. AVG TRANSFER", "MTD #(lf)DAYS TO LAST", "MTD OOS", "Target Cover", "% Increase", "QTY", "QTY MTD", "Delivery#(lf)Freq", "Delivery Date 1", "Delivery Date 2", "Delivery Date 3", "Delivery Date 4", "Delivery Date 5", "Delivery Date 6", "PIPELINE PENDNG PO", "last Supplier Name", "Status", "WEEK2 PROJ STOCK AVG", "WEEK2 PROJ DTL AVG", "WEEK4 QTY REPLEN", "WEEK4 PROJ STOCK", "WEEK4 PROJ DTL", "WEEK6 QTY REPLEN", "W6 PIPELINE PENDNG PO", "WEEK6 PROJ STOCK", "WEEK6 PROJ DTL", "WEEK8 QTY REPLEN", "WEEK8 PROJ STOCK", "WEEK8 PROJ DTL", "WEEK10 QTY REPLEN", "W10 PIPELINE PENDNG PO", "WEEK10 PROJ STOCK", "WEEK10 PROJ DTL", "WEEK12 QTY REPLEN", "WEEK12 PROJ STOCK", "WEEK12 PROJ DTL", "OOS, <3DTL, <7DTL,<15DTL", "Current Common", "Column74", "Column75"}),
		
		    TrimmedText = Table.TransformColumns(RemovedColumns,{
		        {"ITEM DESCRIPTION", Text.Trim, type text},
		        {"BASE UNIT", Text.Trim, type text},
		        {"SubCAT", Text.Trim, type text},
		        {"ITEM GROUP", Text.Trim, type text},
		        {"STORAGE TYPE", Text.Trim, type text}
		    }),
		
		    CleanedText = Table.TransformColumns(TrimmedText,{
		        {"ITEM DESCRIPTION", Text.Clean, type text},
		        {"BASE UNIT", Text.Clean, type text},
		        {"SubCAT", Text.Clean, type text},
		        {"ITEM GROUP", Text.Clean, type text},
		        {"STORAGE TYPE", Text.Clean, type text}
		    }),
		
		    RemovedDuplicates = Table.Distinct(CleanedText, {"ITEM DESCRIPTION"}),
		
		    RenamedColumns = Table.RenameColumns(RemovedDuplicates,{
		        {"Article No.", "Article_No"},
		        {"ITEM DESCRIPTION", "Article"},
		        {"BASE UNIT", "Base_Unit"},
		        {"IS ACTIVE", "Is_Active"},
		        {"SubCAT", "Sub_Category"},
		        {"ITEM GROUP", "Item_Group"},
		        {"STORAGE TYPE", "Storage_Type"}
		    }),
		    #"Changed Type" = Table.TransformColumnTypes(RenamedColumns,{{"Article_No", type text}, {"Article", type text}, {"Base_Unit", type text}, {"Is_Active", type text}, {"Sub_Category", type text}, {"Item_Group", type text}, {"Storage_Type", type text}})
		in
		    #"Changed Type"
