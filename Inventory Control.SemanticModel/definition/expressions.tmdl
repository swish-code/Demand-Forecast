	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

expression fact_po_period_base =
		let
		    Source = fact_po_line,
		
		    FxSafeText =
		        (x as any) as text =>
		            try
		                if x = null then ""
		                else Text.Trim(Text.Clean(Text.From(x)))
		            otherwise "",
		
		    FxPOText =
		        (x as any) as text =>
		            let
		                T = FxSafeText(x)
		            in
		                if T = "" then "NO_PO" else T,
		
		    FilteredRows =
		        Table.SelectRows(
		            Source,
		            each
		                [PO Unit Mapping Status] = "Mapped"
		                and [Article] <> null
		                and [Article] <> ""
		                and [Warehouse] <> null
		                and [Warehouse] <> ""
		                and [PO No] <> null
		                and [PO No] <> ""
		                and [PO Delivery Date] <> null
		                and [PO Base Qty] <> null
		        ),
		
		    GroupedPO =
		        Table.Group(
		            FilteredRows,
		            {"Article", "Warehouse", "PO No", "PO Delivery Date"},
		            {
		                {"Final Cost Center", each try List.First(List.RemoveNulls([Final Cost Center])) otherwise null, type nullable text},
		
		                {
		                    "PO Supplier",
		                    each
		                        try
		                            if List.Count(List.Distinct(List.RemoveNulls([Supplier]))) = 1
		                            then List.First(List.Distinct(List.RemoveNulls([Supplier])))
		                            else "MULTIPLE"
		                        otherwise null,
		                    type nullable text
		                },
		
		                {
		                    "PO Supplier List",
		                    each try Text.Combine(List.Sort(List.Distinct(List.RemoveNulls([Supplier]))), ", ") otherwise null,
		                    type nullable text
		                },
		
		                {
		                    "PO Unit List",
		                    each try Text.Combine(List.Sort(List.Distinct(List.RemoveNulls([PO Unit]))), ", ") otherwise null,
		                    type nullable text
		                },
		
		                {
		                    "PO Base Unit List",
		                    each try Text.Combine(List.Sort(List.Distinct(List.RemoveNulls([PO Base Unit]))), ", ") otherwise null,
		                    type nullable text
		                },
		
		                {
		                    "PO Date",
		                    each try Date.From(List.Min(List.RemoveNulls([PO Date]))) otherwise null,
		                    type nullable date
		                },
		
		                {
		                    "PO Base Qty",
		                    each List.Sum(List.RemoveNulls([PO Base Qty])),
		                    type nullable number
		                },
		
		                {
		                    "PO Value",
		                    each List.Sum(List.RemoveNulls([PO Value])),
		                    type nullable number
		                },
		
		                {
		                    "PO Count",
		                    each List.Count(List.Distinct(List.RemoveNulls([PO No]))),
		                    Int64.Type
		                },
		
		                {
		                    "PO Line Count",
		                    each Table.RowCount(_),
		                    Int64.Type
		                },
		
		                {
		                    "Sub_Category",
		                    each try List.First(List.RemoveNulls([Sub_Category])) otherwise null,
		                    type nullable text
		                },
		
		                {
		                    "Item_Group",
		                    each try List.First(List.RemoveNulls([Item_Group])) otherwise null,
		                    type nullable text
		                },
		
		                {
		                    "Storage_Type",
		                    each try List.First(List.RemoveNulls([Storage_Type])) otherwise null,
		                    type nullable text
		                }
		            }
		        ),
		
		    RenamedDate =
		        Table.RenameColumns(
		            GroupedPO,
		            {{"PO Delivery Date", "PO Start Date"}}
		        ),
		
		    GRNFiltered =
		        Table.SelectRows(
		            fact_grn_line,
		            each
		                [Article] <> null
		                and [Article] <> ""
		                and [Warehouse] <> null
		                and [Warehouse] <> ""
		                and [GRN Delivery Date] <> null
		                and [GRN PO No] <> null
		                and [GRN PO No] <> ""
		        ),
		
		    GRNMaxByArticleWarehousePO =
		        Table.Group(
		            GRNFiltered,
		            {"Article", "Warehouse", "GRN PO No"},
		            {
		                {
		                    "Last Relevant GRN Date",
		                    each List.Max(List.RemoveNulls([GRN Delivery Date])),
		                    type nullable date
		                }
		            }
		        ),
		
		    MergeLastGRN =
		        Table.NestedJoin(
		            RenamedDate,
		            {"Article", "Warehouse", "PO No"},
		            GRNMaxByArticleWarehousePO,
		            {"Article", "Warehouse", "GRN PO No"},
		            "GRN Max",
		            JoinKind.LeftOuter
		        ),
		
		    ExpandLastGRN =
		        Table.ExpandTableColumn(
		            MergeLastGRN,
		            "GRN Max",
		            {"Last Relevant GRN Date"},
		            {"Last Relevant GRN Date"}
		        ),
		
		    DistinctStartDates =
		        Table.Distinct(
		            Table.SelectColumns(
		                ExpandLastGRN,
		                {"Article", "Warehouse", "PO Start Date"}
		            )
		        ),
		
		    SortedStartDates =
		        Table.Sort(
		            DistinctStartDates,
		            {
		                {"Article", Order.Ascending},
		                {"Warehouse", Order.Ascending},
		                {"PO Start Date", Order.Ascending}
		            }
		        ),
		
		    GroupedForNextDate =
		        Table.Group(
		            SortedStartDates,
		            {"Article", "Warehouse"},
		            {
		                {
		                    "Data",
		                    each
		                        let
		                            T =
		                                Table.Sort(
		                                    _,
		                                    {{"PO Start Date", Order.Ascending}}
		                                ),
		
		                            AddIndex =
		                                Table.AddIndexColumn(
		                                    T,
		                                    "__Index",
		                                    0,
		                                    1,
		                                    Int64.Type
		                                ),
		
		                            AddNextDate =
		                                Table.AddColumn(
		                                    AddIndex,
		                                    "Next PO Date",
		                                    each try AddIndex[PO Start Date]{[__Index] + 1} otherwise null,
		                                    type nullable date
		                                ),
		
		                            RemoveIndex =
		                                Table.RemoveColumns(
		                                    AddNextDate,
		                                    {"__Index"}
		                                )
		                        in
		                            RemoveIndex,
		                    type table
		                }
		            }
		        ),
		
		    NextDateTable =
		        Table.ExpandTableColumn(
		            GroupedForNextDate,
		            "Data",
		            {"PO Start Date", "Next PO Date"},
		            {"PO Start Date", "Next PO Date"}
		        ),
		
		    MergeNextDate =
		        Table.NestedJoin(
		            ExpandLastGRN,
		            {"Article", "Warehouse", "PO Start Date"},
		            NextDateTable,
		            {"Article", "Warehouse", "PO Start Date"},
		            "Next Date",
		            JoinKind.LeftOuter
		        ),
		
		    ExpandNextDate =
		        Table.ExpandTableColumn(
		            MergeNextDate,
		            "Next Date",
		            {"Next PO Date"},
		            {"Next PO Date"}
		        ),
		
		    AddedPOEndDate =
		        Table.AddColumn(
		            ExpandNextDate,
		            "PO End Date",
		            each
		                let
		                    NextEndDate =
		                        if [Next PO Date] <> null
		                        then Date.AddDays([Next PO Date], -1)
		                        else null,
		
		                    GRNEndDate =
		                        if [Last Relevant GRN Date] <> null
		                            and [Last Relevant GRN Date] >= [PO Start Date]
		                        then [Last Relevant GRN Date]
		                        else null,
		
		                    CandidateDates =
		                        List.RemoveNulls(
		                            {
		                                [PO Start Date],
		                                NextEndDate,
		                                GRNEndDate
		                            }
		                        )
		                in
		                    List.Max(CandidateDates),
		            type date
		        ),
		
		    AddedPOPeriodID =
		        Table.AddColumn(
		            AddedPOEndDate,
		            "PO Period ID",
		            each
		                FxSafeText([Article])
		                    & "|"
		                    & FxSafeText([Warehouse])
		                    & "|"
		                    & FxPOText([PO No])
		                    & "|"
		                    & Date.ToText([PO Start Date], "yyyyMMdd"),
		            type text
		        ),
		
		    AddedPOPeriodSource =
		        Table.AddColumn(
		            AddedPOPeriodID,
		            "PO Period Source",
		            each "Open PO",
		            type text
		        ),
		
		    RemovedHelperColumns =
		        Table.RemoveColumns(
		            AddedPOPeriodSource,
		            {"Last Relevant GRN Date"},
		            MissingField.Ignore
		        ),
		
		    ReorderedColumns =
		        Table.ReorderColumns(
		            RemovedHelperColumns,
		            {
		                "PO Period ID",
		                "PO Period Source",
		                "Article",
		                "Warehouse",
		                "Final Cost Center",
		                "PO No",
		                "PO Supplier",
		                "PO Supplier List",
		                "PO Unit List",
		                "PO Base Unit List",
		                "PO Date",
		                "PO Start Date",
		                "Next PO Date",
		                "PO End Date",
		                "PO Base Qty",
		                "PO Value",
		                "PO Count",
		                "PO Line Count",
		                "Sub_Category",
		                "Item_Group",
		                "Storage_Type"
		            },
		            MissingField.Ignore
		        )
		in
		    ReorderedColumns
	lineageTag: de6d218d-2273-4a85-a574-7c2ff2f80ad0

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

expression agg_grn_by_po_period =
		let
		    Source = fact_grn_allocated_detail,
		
		    FxTextList =
		        (InputList as list) as nullable text =>
		            let
		                CleanList =
		                    List.Sort(
		                        List.Distinct(
		                            List.Select(
		                                List.Transform(
		                                    List.RemoveNulls(InputList),
		                                    each Text.Trim(Text.Clean(Text.From(_)))
		                                ),
		                                each _ <> ""
		                            )
		                        )
		                    ),
		                Result =
		                    if List.Count(CleanList) = 0 then
		                        null
		                    else
		                        Text.Combine(CleanList, ", ")
		            in
		                Result,
		
		    FilteredRows =
		        Table.SelectRows(
		            Source,
		            each
		                [Inbound Match Status] = "Matched"
		                and [PO Period ID] <> null
		                and [PO Period ID] <> ""
		                and [Allocated GRN Base Qty] <> null
		        ),
		
		    GroupedRows =
		        Table.Group(
		            FilteredRows,
		            {"PO Period ID"},
		            {
		                {
		                    "Inbound Match Status",
		                    each "Matched",
		                    type text
		                },
		                {
		                    "GRN Match Status",
		                    each
		                        let
		                            StatusList = List.Distinct(List.RemoveNulls([GRN Match Status]))
		                        in
		                            if List.Count(StatusList) = 0 then null
		                            else if List.Count(StatusList) = 1 then StatusList{0}
		                            else Text.Combine(StatusList, ", "),
		                    type nullable text
		                },
		                {
		                    "Allocated GRN Base Qty",
		                    each List.Sum(List.RemoveNulls([Allocated GRN Base Qty])),
		                    type nullable number
		                },
		                {
		                    "Allocated GRN Qty",
		                    each List.Sum(List.RemoveNulls([Allocated GRN Qty])),
		                    type nullable number
		                },
		                {
		                    "Same Day GRN Base Qty",
		                    each List.Sum(List.RemoveNulls([Same Day GRN Base Qty])),
		                    type nullable number
		                },
		                {
		                    "Late GRN Base Qty",
		                    each List.Sum(List.RemoveNulls([Late GRN Base Qty])),
		                    type nullable number
		                },
		                {
		                    "Allocated GRN Value",
		                    each List.Sum(List.RemoveNulls([GRN Value])),
		                    type nullable number
		                },
		                {
		                    "Delivery Note Count",
		                    each List.Count(List.Distinct(List.RemoveNulls([Delivery Note No]))),
		                    Int64.Type
		                },
		                {
		                    "GRN Line Count",
		                    each Table.RowCount(_),
		                    Int64.Type
		                },
		                {
		                    "First GRN Delivery Date",
		                    each
		                        let
		                            Dates = List.RemoveNulls([GRN Delivery Date])
		                        in
		                            if List.Count(Dates) = 0 then null else List.Min(Dates),
		                    type nullable date
		                },
		                {
		                    "Last GRN Delivery Date",
		                    each
		                        let
		                            Dates = List.RemoveNulls([GRN Delivery Date])
		                        in
		                            if List.Count(Dates) = 0 then null else List.Max(Dates),
		                    type nullable date
		                },
		                {
		                    "First Booking DateTime",
		                    each
		                        let
		                            Dates = List.RemoveNulls([Booking DateTime])
		                        in
		                            if List.Count(Dates) = 0 then null else List.Min(Dates),
		                    type nullable datetime
		                },
		                {
		                    "Last Booking DateTime",
		                    each
		                        let
		                            Dates = List.RemoveNulls([Booking DateTime])
		                        in
		                            if List.Count(Dates) = 0 then null else List.Max(Dates),
		                    type nullable datetime
		                },
		                {
		                    "Delivery Note List",
		                    each FxTextList([Delivery Note No]),
		                    type nullable text
		                },
		                {
		                    "GRN Supplier",
		                    each
		                        let
		                            Suppliers = List.Distinct(List.RemoveNulls([Supplier]))
		                        in
		                            if List.Count(Suppliers) = 0 then null
		                            else if List.Count(Suppliers) = 1 then Suppliers{0}
		                            else "MULTIPLE",
		                    type nullable text
		                },
		                {
		                    "GRN Supplier List",
		                    each FxTextList([Supplier]),
		                    type nullable text
		                },
		                {
		                    "GRN PO No List",
		                    each FxTextList([GRN PO No]),
		                    type nullable text
		                },
		                {
		                    "GRN Match Status List",
		                    each FxTextList([GRN Match Status]),
		                    type nullable text
		                },
		                {
		                    "Inbound Match Status List",
		                    each FxTextList([Inbound Match Status]),
		                    type nullable text
		                }
		            }
		        ),
		
		    AddedReceiptSpreadDays =
		        Table.AddColumn(
		            GroupedRows,
		            "Receipt Spread Days",
		            each
		                if [First GRN Delivery Date] = null or [Last GRN Delivery Date] = null then
		                    null
		                else
		                    Duration.Days([Last GRN Delivery Date] - [First GRN Delivery Date]),
		            Int64.Type
		        ),
		
		    FinalColumnOrder =
		        Table.ReorderColumns(
		            AddedReceiptSpreadDays,
		            {
		                "PO Period ID",
		                "Inbound Match Status",
		                "GRN Match Status",
		                "Allocated GRN Base Qty",
		                "Allocated GRN Qty",
		                "Same Day GRN Base Qty",
		                "Late GRN Base Qty",
		                "Allocated GRN Value",
		                "Delivery Note Count",
		                "GRN Line Count",
		                "First GRN Delivery Date",
		                "Last GRN Delivery Date",
		                "First Booking DateTime",
		                "Last Booking DateTime",
		                "Receipt Spread Days",
		                "Delivery Note List",
		                "GRN Supplier",
		                "GRN Supplier List",
		                "GRN PO No List",
		                "GRN Match Status List",
		                "Inbound Match Status List"
		            },
		            MissingField.Ignore
		        )
		in
		    FinalColumnOrder
	lineageTag: fcd598e4-2046-4899-9169-bc4735d6d24c

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

expression 'Delivery Note' =
		let
		    Source =
		        Oracle.Database(
		            "192.168.1.99/mc",
		            [
		                HierarchicalNavigation = true,
		                Query =
		                    Text.Combine(
		                        {
		                            "SELECT",
		                            "    p.lfp_pos                       AS ""Pos"",",
		                            "    a.art_nummer                    AS ""Article No."",",
		                            "    a.art_name                      AS ""Article"",",
		                            "    p.lfp_menge                     AS ""QTY"",",
		                            "    w.vpk_name                      AS ""Unit"",",
		                            "    p.lfp_ekpstk                    AS ""Price/Unit"",",
		                            "    p.lfp_mengege                   AS ""QTY/BU"",",
		                            "    p.lfp_ekpstk / w.vpk_grmenge    AS ""Price/BU"",",
		                            "    p.lfp_rabatt * 100 || '%'       AS ""Discount"",",
		                            "    p.lfp_ekp                       AS ""Net"",",
		                            "    k.kst_name                      AS ""Cost Center/Store"",",
		                            "    l.lfs_name                      AS ""Delivery_Note"",",
		                            "    l.lfs_datum                     AS ""Delivery_Date"",",
		                            "    CASE",
		                            "        WHEN l.lfs_status = 32 THEN",
		                            "            CASE",
		                            "                WHEN l.lfs_rts = 1 THEN 'Open Return to Supplier'",
		                            "                ELSE 'Open Delivery Note'",
		                            "            END",
		                            "        WHEN l.lfs_status = 37 THEN 'Booked Delivery Note'",
		                            "        WHEN l.lfs_status >= 41 THEN 'Closed Invoice'",
		                            "        ELSE 'IDK'",
		                            "    END                             AS ""DN Status"",",
		                            "    NULL                            AS ""Last Price/BU"",",
		                            "    v.vpk_name                      AS ""Base Unit"",",
		                            "    nvl(p.sb_name, 'No PO defined') AS ""Order No."",",
		                            "    p.sb_ze                         AS ""Order Date"",",
		                            "    p.bp_mengeorg                   AS ""Requested QTY"",",
		                            "    i.lf_name                       AS ""Supplier"",",
		                            "    b.bst_name                      AS ""Created by"",",
		                            "    p.new_zeit                      AS ""Created At""",
		                            "FROM",
		                            "    lieferschein l,",
		                            "    lieferpos    p,",
		                            "    artikel      a,",
		                            "    vpckeinh     v,",
		                            "    vpckeinh     w,",
		                            "    liefer       i,",
		                            "    kostst       k,",
		                            "    fcurrency    f,",
		                            "    besteller    b",
		                            "WHERE",
		                            "        p.lfs_id = l.lfs_id",
		                            "    AND v.vpk_id = p.vpk_id2",
		                            "    AND w.vpk_id = p.vpk_id1",
		                            "    AND a.art_id = p.art_nr",
		                            "    AND i.lf_id = l.lf_id",
		                            "    AND k.kst_id = p.kst_id",
		                            "    AND p.new_user = b.bst_id",
		                            "    AND i.cur_nr = f.cur_id (+)",
		
		                            "UNION ALL",
		
		                            "SELECT",
		                            "    p.lfp_pos                       AS ""Pos"",",
		                            "    a.art_nummer                    AS ""Article No."",",
		                            "    a.art_name                      AS ""Article"",",
		                            "    p.lfp_menge                     AS ""QTY"",",
		                            "    w.vpk_name                      AS ""Unit"",",
		                            "    p.lfp_ekpstk                    AS ""Price/Unit"",",
		                            "    p.lfp_mengege                   AS ""QTY/BU"",",
		                            "    p.lfp_ekpstk / w.vpk_grmenge    AS ""Price/BU"",",
		                            "    p.lfp_rabatt * 100 || '%'       AS ""Discount"",",
		                            "    p.lfp_ekp                       AS ""Net"",",
		                            "    k.kst_name                      AS ""Cost Center/Store"",",
		                            "    l.rng_name                      AS ""Delivery_Note"",",
		                            "    l.rng_datum                     AS ""Delivery_Date"",",
		                            "    CASE",
		                            "        WHEN l.rng_status = 10 THEN 'Booked Invoice'",
		                            "        ELSE 'IDK'",
		                            "    END                             AS ""DN Status"",",
		                            "    NULL                            AS ""Last Price/BU"",",
		                            "    v.vpk_name                      AS ""Base Unit"",",
		                            "    nvl(p.sb_name, 'No PO defined') AS ""Order No."",",
		                            "    p.sb_ze                         AS ""Order Date"",",
		                            "    p.bp_mengeorg                   AS ""Requested QTY"",",
		                            "    i.lf_name                       AS ""Supplier"",",
		                            "    b.bst_name                      AS ""Created by"",",
		                            "    p.new_zeit                      AS ""Created At""",
		                            "FROM",
		                            "    rechnung  l,",
		                            "    rechpos   p,",
		                            "    artikel   a,",
		                            "    vpckeinh  v,",
		                            "    vpckeinh  w,",
		                            "    liefer    i,",
		                            "    kostst    k,",
		                            "    fcurrency f,",
		                            "    besteller b",
		                            "WHERE",
		                            "        p.rng_id = l.rng_id",
		                            "    AND v.vpk_id = p.vpk_id2",
		                            "    AND w.vpk_id = p.vpk_id1",
		                            "    AND a.art_id = p.art_nr",
		                            "    AND i.lf_id = l.lf_id",
		                            "    AND k.kst_id = p.kst_id",
		                            "    AND p.new_user = b.bst_id",
		                            "    AND i.cur_nr = f.cur_id (+)",
		                            "    AND p.lfp_mengege <> 0",
		                            "    AND p.lfp_status <> 64"
		                        },
		                        "#(lf)"
		                    )
		            ]
		        ),
		
		    FxCleanDisplayText =
		        (x as any) as nullable text =>
		            let
		                Result =
		                    try
		                        if x = null then null
		                        else Text.Trim(Text.Clean(Text.From(x)))
