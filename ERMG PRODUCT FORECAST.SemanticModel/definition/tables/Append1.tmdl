	measure TotalOfflineRateBranch = ```
			
			VAR DailyOperatingMinutes = 17 * 60
			
			-- Selected date range
			VAR StartDate = MIN('DateTableToday'[Date])
			VAR EndDate = MAX('DateTableToday'[Date])
			VAR TotalDays = DATEDIFF(StartDate, EndDate, DAY) + 1
			
			VAR TotalOperatingMinutes = DailyOperatingMinutes * TotalDays
			
			-- Total Offline Minutes (respects all filters)
			VAR OfflineMinutes = SUM('BUSY TIME'[DurationInMinutes])
			
			-- Distinct Branch+Brand combinations for selected Brand(s), ignoring date filter
			VAR LocationBrandCount =
			    CALCULATE(
			        COUNTROWS(
			            SUMMARIZE(
			                'BUSY TIME',
			                'BUSY TIME'[Branch],
			                'BUSY TIME'[Brand]
			            )
			        ),
			        REMOVEFILTERS('DateTableToday'[Date]),
			        KEEPFILTERS(VALUES('BUSY TIME'[Brand]))
			    )
			
			-- Multiply total operating time by the number of locations (branch-brand combos)
			VAR TotalOperatingMinutesWithBrands = TotalOperatingMinutes * LocationBrandCount
			
			-- Calculate offline rate safely
			VAR OfflineRateRaw =
			    DIVIDE(OfflineMinutes, TotalOperatingMinutesWithBrands, 0)
			
			RETURN
			OfflineRateRaw
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 807f48d7-defa-44fb-affb-c0a04613ceef

