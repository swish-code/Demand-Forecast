	measure CurrentMonthRunrateSE =
			
			VAR SelectedBrand = SELECTEDVALUE( FORECAST[Brand] )
			VAR MinDate       = MIN( 'RunRateDateSlicer'[Date] )
			VAR MaxDate       = MAX( 'DateTableToday'[Date] )
			
			// 1. Build a small table of months between MinDate and MaxDate
			VAR MonthTable =
			    ADDCOLUMNS(
			        DISTINCT(
			            SELECTCOLUMNS(
			                FILTER(
			                    ALL( 'DateTableToday' ),
			                    'DateTableToday'[Date] >= MinDate &&
			                    'DateTableToday'[Date] <= MaxDate
			                ),
			                "MonthKey", EOMONTH( 'DateTableToday'[Date], 0 )
			            )
			        ),
			        "MonthIndex",
			            RANKX(
			                DISTINCT(
			                    SELECTCOLUMNS(
			                        FILTER(
			                            ALL( 'DateTableToday' ),
			                            'DateTableToday'[Date] >= MinDate &&
			                            'DateTableToday'[Date] <= MaxDate
			                        ),
			                        "MonthKey", EOMONTH( 'DateTableToday'[Date], 0 )
			                    )
			                ),
			                [MonthKey],
			                ,
			                ASC,
			                DENSE
			            )
			    )
			
			// 2. Iterate each forecast row and build the run-rate with a product-based seasonal factor
			RETURN
			SUMX(
			    FILTER(
			        FORECAST,
			        FORECAST[Date]  >= MinDate &&
			        FORECAST[Date]  <= MaxDate &&
			        FORECAST[Brand] = SelectedBrand
			    ),
			    VAR ThisMonthKey   = EOMONTH( FORECAST[Date], 0 )
			    VAR ThisMonthIndex =
			        MAXX(
			            FILTER( MonthTable, [MonthKey] = ThisMonthKey ),
			            [MonthIndex]
			        )
			
			    // 3. Product of SeasonalEffect from MonthIndex 2 → ThisMonthIndex
			    VAR SeasonalMultiplier =
			        IF(
			            ThisMonthIndex = 1,
			            1,
			            PRODUCTX(
			                FILTER(
			                    MonthTable,
			                    [MonthIndex] >= 2 &&
			                    [MonthIndex] <= ThisMonthIndex
			                ),
			                // For each month in that filtered set, fetch the effect
			                VAR MKey = [MonthKey]
			                RETURN
			                    CALCULATE(
			                        MAX( FORECAST[SeasonalEffect] ),
			                        ALL( FORECAST ),          // remove row‐context filters
			                        FORECAST[Brand] = SelectedBrand,
			                        EOMONTH( FORECAST[Date], 0 ) = MKey
			                    )
			            )
			        )
			
			    // 4. Final run‐rate contribution for this row
			    RETURN
			        FORECAST[D. Forecast %]
			        * [RunRate_SalesOverForecastDynamic]
			        * SeasonalMultiplier
			)
		lineageTag: 62e40ac1-8007-45ae-b7b4-1364e7078301

	measure RunRate_SalesOverForecastDynamic = ```
			
			VAR SelectedStartDate = MIN(RunRateDateSlicer[Date])
			VAR SelectedEndDate = MAX(RunRateDateSlicer[Date])
			
			VAR FilteredTable =
			    FILTER(
			        ALL(FORECAST),  -- Remove filters to apply only those explicitly controlled
			        NOT ISBLANK(FORECAST[Actual Sales]) &&
			        FORECAST[Actual Sales] <> 0 &&
			        FORECAST[Date] >= SelectedStartDate &&
			        FORECAST[Date] <= SelectedEndDate
			    )
			
			VAR CumulativeActualSales = 
			    CALCULATE(
			        SUM(FORECAST[Actual Sales]),
			        FilteredTable,
			        KEEPFILTERS(VALUES(FORECAST[Brand]))  -- Respect Brand selection
			    )
			
			VAR CumulativeForecast = 
			    CALCULATE(
			        SUM(FORECAST[D. Forecast %]),
			        FilteredTable,
			        KEEPFILTERS(VALUES(FORECAST[Brand]))  -- Respect Brand selection
			    )
			
			RETURN
			IF(
			    CumulativeForecast = 0 || ISBLANK(CumulativeForecast),
			    BLANK(),
			    DIVIDE(CumulativeActualSales, CumulativeForecast)
			)
			
			```
		lineageTag: 161250be-d803-4c31-a566-332d3dbffd00

