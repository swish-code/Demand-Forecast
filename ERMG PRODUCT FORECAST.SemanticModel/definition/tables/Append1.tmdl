	measure 'Variation Percentage MTD_RRR' =
			
			VAR MTD_ActualSales =
			CALCULATE(
			SUM(FORECAST[Actual Sales]),
			DATESMTD('FORECAST'[DATE]),
			'FORECAST'[DATE] < TODAY()
			)
			VAR MTD_MonthRunrate =
			CALCULATE(
			SUM(FORECAST[RR_TEST]),
			DATESMTD('FORECAST'[DATE]),
			'FORECAST'[DATE] < TODAY()
			)
			VAR Result =
			DIVIDE(MTD_ActualSales - MTD_MonthRunrate, MTD_MonthRunrate, 0)
			RETURN
			FORMAT(Result, "0.00%")
		lineageTag: 35c687c4-5d6f-417b-b1df-e29d85f71dee

