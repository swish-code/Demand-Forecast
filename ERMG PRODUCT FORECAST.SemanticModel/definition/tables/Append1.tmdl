	measure TotalOfflineRate = ```
			
			VAR DailyOperatingMinutes = 13.5 * 60 -- Convert daily operating hours to minutes
			VAR StartDate = MIN('DateTableToday'[Date]) -- Start date based on the selected range in DateTable
			VAR EndDate = MAX('DateTableToday'[Date]) -- End date based on the selected range in DateTable
			VAR TotalDays = DATEDIFF(StartDate, EndDate, DAY) + 1 -- Adjust for single-day selection
			VAR TotalOperatingMinutes = DailyOperatingMinutes * TotalDays -- Total operating minutes across the selected period
			
			VAR OfflineMinutes = SUM('BUSY TIME'[DurationInMinutes]) -- Total offline minutes from the BusyTime table
			
			VAR LocationCount = DISTINCTCOUNT('LocationTable'[Location]) -- Count distinct locations
			
			VAR TotalOperatingMinutesWithLocations = TotalOperatingMinutes * LocationCount -- Multiply total operating minutes by location count
			
			VAR OfflineRateRaw = 
			    IF(
			        ISBLANK(OfflineMinutes) || ISBLANK(TotalOperatingMinutesWithLocations), -- Check for missing data
			        0, -- Return 0 if no data exists
			        DIVIDE(OfflineMinutes, TotalOperatingMinutesWithLocations, 0) -- Calculate the offline rate
			    )
			
			RETURN 
			FORMAT(OfflineRateRaw * 100, "0.00") & "%" -- Convert to percentage and add the % sign
			
			```
		lineageTag: c7b3f789-93d7-4903-8888-4b547b123436

