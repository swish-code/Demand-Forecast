	measure MissingChainLocations = ```
			
			VAR AllChainLocations = 
			    SUMMARIZE(
			        'SALES DATA',
			        'SALES DATA'[BRAND],
			        'SALES DATA'[LocationID]
			    )  -- All ChainID-LocationID combinations in the dataset
			
			VAR ChainLocationsWithSalesYesterday = 
			    SUMMARIZE(
			        FILTER(
			            'SALES DATA',
			            'SALES DATA'[VoucherDate] = TODAY() - 1
			        ),
			        'SALES DATA'[BRAND],
			        'SALES DATA'[LocationID]
			    )  -- ChainID-LocationID combinations with sales yesterday
			
			VAR MissingLocationsTable = 
			    EXCEPT(
			        AllChainLocations,
			        ChainLocationsWithSalesYesterday
			    )  -- Find missing ChainID-LocationID combinations
			
			VAR MissingLocationsFormatted = 
			    CONCATENATEX(
			        MissingLocationsTable,
			        'SALES DATA'[BRAND] & " - " & 'SALES DATA'[LocationID],
			        ", "
			    )  -- Create a single text value listing missing ChainID-LocationID pairs
			
			RETURN
			    IF(
			        ISBLANK(MissingLocationsFormatted),
			        "None",  -- No missing combinations
			        MissingLocationsFormatted  -- List of missing combinations
			    )
			
			```
		lineageTag: 2deea75f-a0fe-40be-a3e1-35cb4f8c4c20

	measure 'Variation_Percentage target' = ```
			
			VAR Variation = DIVIDE(
			    [FORECAST_YTD] - [RUNRATE_LastYear],   -- Forecast sales minus last year's sales
			    [RUNRATE_LastYear],                                 -- Last year's sales (denominator)
			    0                                                      -- Return 0 if there is an error (e.g., division by zero)
			) * 100                                                   -- Multiply by 100 to show as percentage
			RETURN 
			    FORMAT(Variation, "0.00") & "%"                         -- Format the result as a string with 2 decimal places and add the '%' sign
			
			```
		lineageTag: 780ecbd0-cdb8-46c1-be91-700d904e9375

	measure 'Variation Percentage MTD' = ```
			
			VAR MTD_ActualSales =
			    CALCULATE(
			        SUM(FORECAST[Actual Sales]),
			        DATESMTD('DateTableToday'[DATE]),
			        'DateTableToday'[DATE] < TODAY()
			    )
			VAR MTD_MonthRunrate =
			    CALCULATE(
			        SUM(FORECAST[MonthRunrate]),
			        DATESMTD('DateTableToday'[DATE]),
			        'DateTableToday'[DATE] < TODAY()
			    )
			RETURN
			    DIVIDE(MTD_ActualSales - MTD_MonthRunrate, MTD_ActualSales, 0)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: ffaa614f-2bba-49d6-9202-5b89818fdf2b

