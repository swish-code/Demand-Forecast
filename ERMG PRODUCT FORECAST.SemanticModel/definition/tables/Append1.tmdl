	measure MissingChainLocationsMTD = ```
			
			VAR StartOfMont = DATE(YEAR(TODAY()), MONTH(TODAY()), 1)
			VAR TodayDate = TODAY()
			
			VAR AllDates =
			    ADDCOLUMNS(
			        CALENDAR(StartOfMont, TodayDate),
			        "Date", [Date]
			    )
			
			VAR AllBrandLocations =
			    SUMMARIZE(
			        'SALES DATA',
			        'SALES DATA'[BRAND],
			        'SALES DATA'[LocationID]
			    )
			
			VAR FullCombination =
			    SELECTCOLUMNS(
			        CROSSJOIN(AllBrandLocations, AllDates),
			        "BRAND", [BRAND],
			        "LocationID", [LocationID],
			        "VoucherDate", [Date]
			    )
			
			VAR ExistingSales =
			    SELECTCOLUMNS(
			        'SALES DATA',
			        "BRAND", 'SALES DATA'[BRAND],
			        "LocationID", 'SALES DATA'[LocationID],
			        "VoucherDate", 'SALES DATA'[VoucherDate]
			    )
			
			RETURN
			    EXCEPT(FullCombination, ExistingSales)
			
			```
		lineageTag: 67aef7c1-f07b-417e-b2b2-887db2278dbd

