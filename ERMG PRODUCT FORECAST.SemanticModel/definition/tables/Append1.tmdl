	measure OfflineRate = ```
			
			VAR DailyOperatingMinutes = 13.5 * 60 -- Convert daily operating hours to minutes
			VAR StartDate = MIN('DateTableToday'[Date]) -- Start date based on the selected range in DateTable
			VAR EndDate = MAX('DateTableToday'[Date]) -- End date based on the selected range in DateTable
			VAR TotalDays = DATEDIFF(StartDate, EndDate, DAY) + 1 -- Total number of days in the selected range, adjusted for single-day selection
			VAR TotalOperatingMinutes = DailyOperatingMinutes * TotalDays -- Total operating minutes across the selected period
			
			VAR OfflineMinutes = SUM('BUSY TIME'[DurationInMinutes]) -- Total offline minutes from the BusyTime table
			
			VAR OfflineRateRaw = 
			    IF(
			        ISBLANK(OfflineMinutes) || ISBLANK(TotalDays), -- Check for missing data
			        0, -- Return 0 if no data exists
			        DIVIDE(OfflineMinutes, TotalOperatingMinutes, 0) -- Calculate the offline rate
			    )
			
			RETURN 
			FORMAT(OfflineRateRaw * 100, "0.00") & "%" -- Convert to percentage and add the % sign
			
			```
		lineageTag: f448f711-61a3-45d7-8455-aa7adf130378

