	measure 'MTD Target' = ```
			
			CALCULATE(
			    SUM('FORECAST'[Forecast]),  -- Summing the Forecast column
			    DATESMTD('FORECAST'[Date]), -- Filtering for the MTD period
			    'FORECAST'[Date] <= 
			        MAXX(  -- Find the max date where ActualSales is not blank
			            FILTER('FORECAST', NOT(ISBLANK('FORECAST'[Actual Sales]))), 
			            'FORECAST'[Date]
			        )
			)
			
