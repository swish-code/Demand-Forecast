	measure 'Required Run Rate TEST' = ```
			
			VAR MaxVisibleDate = MAX('FORECAST'[Date])
			VAR TodayDate = TODAY()
			
			VAR CutoffYear = YEAR(TodayDate)
			VAR CutoffMonth = MONTH(TodayDate)
			
			VAR RowYear = YEAR(MaxVisibleDate)
			VAR RowMonth = MONTH(MaxVisibleDate)
			VAR RowDay = DAY(MaxVisibleDate)
			
			VAR IsSingleBrandSelected = HASONEVALUE('FORECAST'[Brand])
			VAR SelectedBrands = VALUES('FORECAST'[Brand])
			
			// Ensure BrandsTable is always a valid table
			VAR BrandsTable =
			    IF(
			        IsSingleBrandSelected,
			        SELECTCOLUMNS(VALUES('FORECAST'[Brand]), "Brand", 'FORECAST'[Brand]),
			        SELECTCOLUMNS(ALL('FORECAST'[Brand]), "Brand", 'FORECAST'[Brand])
			    )
			
			VAR DateBrandTable =
			    FILTER(
			        CROSSJOIN(
			            FILTER(
			                ALL('FORECAST'[Date]),
			                YEAR('FORECAST'[Date]) = CutoffYear &&
			                MONTH('FORECAST'[Date]) = CutoffMonth &&
			                DAY('FORECAST'[Date]) >= 15
			            ),
			            BrandsTable
			        ),
			        TRUE()
			    )
			
			VAR CutoffDate =
			    MINX(
			        FILTER(
			            DateBrandTable,
			            VAR ThisDate = [Date]
			            VAR ThisBrand = [Brand]
			            VAR VariationPctRRRValue =
			                CALCULATE(
			                    [Variation Percentage RRR],
			                    'FORECAST'[Date] = ThisDate,
			                    'FORECAST'[Brand] = ThisBrand
			                )
			            RETURN
			                (DAY(ThisDate) >= 15 && DAY(ThisDate) <= 17 && VariationPctRRRValue > 0.70) ||
			                (DAY(ThisDate) > 17 && DAY(ThisDate) <= 20 && VariationPctRRRValue > 0.60) ||
			                (DAY(ThisDate) > 20 && DAY(ThisDate) <= 23 && VariationPctRRRValue > 0.50) ||
			                (DAY(ThisDate) > 23 && DAY(ThisDate) <= 25 && VariationPctRRRValue > 0.40) ||
			                (DAY(ThisDate) > 25 && VariationPctRRRValue > 0.30)
			        ),
			        [Date]
			    )
			
			// Check if there is any RRR before 15th for selected brands in cutoff month
			VAR HasRRRBefore15 =
			    CALCULATE(
			        COUNTROWS('FORECAST'),
			        FILTER(
			            ALL('FORECAST'),
			            'FORECAST'[AdjustedRRR] > 0 &&
			            'FORECAST'[Brand] IN SelectedBrands &&
			            YEAR('FORECAST'[Date]) = CutoffYear &&
			            MONTH('FORECAST'[Date]) = CutoffMonth &&
			            DAY('FORECAST'[Date]) <= 15
			        )
			    ) > 0
			
			VAR TotalRRR =
			    CALCULATE(
			        SUM('FORECAST'[AdjustedRRR]),
			        FILTER(
			            ALL('FORECAST'),
			            'FORECAST'[Date] = MaxVisibleDate &&
			            'FORECAST'[Brand] IN SelectedBrands
			        )
			    )
			
			VAR TotalRunRate =
			    CALCULATE(
			        SUM('FORECAST'[Required_Run_Rate]) + SUM('FORECAST'[RR_TEST]),
			        FILTER(
			            ALL('FORECAST'),
			            'FORECAST'[Date] = MaxVisibleDate &&
			            'FORECAST'[Brand] IN SelectedBrands
			        )
			    )
			
			VAR IsCutoffMonth = (RowYear = CutoffYear && RowMonth = CutoffMonth)
			
			RETURN
			IF (
			    TotalRRR > 0 &&
			    (
			        (IsCutoffMonth && NOT ISBLANK(CutoffDate) && MaxVisibleDate < CutoffDate) ||
			        (NOT IsCutoffMonth)
			    ) &&
			    (RowDay <= 15 || HasRRRBefore15),
			    TotalRunRate,
			    BLANK()
			)
			
			```
		lineageTag: cbb419ce-a2a1-4188-b12b-4b9d44eb772e

