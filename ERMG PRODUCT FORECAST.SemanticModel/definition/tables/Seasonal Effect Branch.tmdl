	column NextMonth = ```
			
			VAR CurrentDate = TODAY()
			VAR CurrentMonth = MONTH(CurrentDate)
			VAR CurrentYear = YEAR(CurrentDate)
			VAR CurrentDay = DAY(CurrentDate)
			VAR DateMonth = MONTH('Seasonal Effect Branch'[Date])
			VAR DateYear = YEAR('Seasonal Effect Branch'[Date])
			
			RETURN 
			    IF(
			        DateYear = CurrentYear && DateMonth = CurrentMonth, 
			        IF(CurrentDay < 15, 1, BLANK()),  -- Show 1 for dates in the first 15 days of the current month
			        IF(DateYear = CurrentYear && DateMonth = CurrentMonth + 1, 
			            IF(CurrentDay >= 15, 1, 0),  -- If today is after the 15th, show 1 for next month (February)
			            IF(DateYear = CurrentYear && DateMonth > CurrentMonth + 1, 0, BLANK()))  -- Show 0 for months after next (March and onwards)
			    )
			
			```
		formatString: 0
		lineageTag: 8662b684-01cc-4e19-b550-010b9629721f
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column NewColumn = ```
			
			VAR CurrentDate = TODAY()
			VAR CurrentDay = DAY(CurrentDate)
			VAR CurrentMonth = MONTH(CurrentDate)
			VAR CurrentYear = YEAR(CurrentDate)
			
			VAR DateValue = 'Seasonal Effect Branch'[Date]
			VAR DateMonth = MONTH(DateValue)
			VAR DateYear = YEAR(DateValue)
			
			VAR IsCurrentMonth = DateYear = CurrentYear && DateMonth = CurrentMonth
			VAR IsNextMonth = 
			    (DateYear = CurrentYear && DateMonth = CurrentMonth + 1)
			    || (CurrentMonth = 12 && DateYear = CurrentYear + 1 && DateMonth = 1)
			VAR IsAfterNextMonth = 
			    (DateYear > CurrentYear || (DateYear = CurrentYear && DateMonth > CurrentMonth + 1))
			    || (CurrentMonth = 12 && DateYear > CurrentYear + 1)
			    || (CurrentMonth = 12 && DateYear = CurrentYear + 1 && DateMonth > 1)
			
			RETURN 
			    IF(
			        IsCurrentMonth,
			        IF(CurrentDay < 15, 1, BLANK()),
			        IF(
			            IsNextMonth,
			            IF(CurrentDay >= 15, 1, 0),
			            IF(
			                IsAfterNextMonth,
			                0,
			                BLANK()
			            )
			        )
			    )
			```
		formatString: 0
		lineageTag: 4fdd59a7-eae0-4f36-a8de-a476a7d76d2a
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column NewSeasonalEffect = ```
			
			VAR CurrentDate  = 'Seasonal Effect Branch'[Date]
			VAR CurrentBrand = 'Seasonal Effect Branch'[Brand]
			VAR CurrentBranch = 'Seasonal Effect Branch'[Branch]
			VAR NextMonthFlag = 'Seasonal Effect Branch'[NewColumn]
			
			VAR PreviousMonths =
			    FILTER(
			        'Seasonal Effect Branch',
			        'Seasonal Effect Branch'[Date] <= CurrentDate &&
			        'Seasonal Effect Branch'[Brand] = CurrentBrand &&
			        'Seasonal Effect Branch'[Branch] = CurrentBranch &&
			        NOT ISBLANK('Seasonal Effect Branch'[NewColumn])
			    )
			
			VAR CumulativeProduct =
			    CALCULATE(
			        PRODUCTX(
			            PreviousMonths,
			            'Seasonal Effect Branch'[Seasonal Effect]
			        )
			    )
			
			RETURN
			    IF(
			        NOT ISBLANK(NextMonthFlag) && (NextMonthFlag = 0 || NextMonthFlag = 1),
			        IF(
			            NextMonthFlag = 1,
			            'Seasonal Effect Branch'[Seasonal Effect],
			            CumulativeProduct
			        ),
			        BLANK()
			    )
			
			```
		lineageTag: 24165a10-3b9c-4b97-9d1f-80a339a802e4
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

