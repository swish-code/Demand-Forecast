table 'Seasonal Effect Branch'
	lineageTag: f6dc38b3-a3d6-4763-a596-01b30486ee71

	measure Sales_LastOrCurrentMonth_Branch =
			
			VAR CurrentDate = TODAY()
			VAR IsBeforeOrOn15th = DAY(CurrentDate) <= 14
			
			VAR TargetYear =
			    IF(
			        IsBeforeOrOn15th,
			        YEAR(EDATE(CurrentDate, -1)),
			        YEAR(CurrentDate)
			    )
			
			VAR TargetMonth =
			    IF(
			        IsBeforeOrOn15th,
			        MONTH(EDATE(CurrentDate, -1)),
			        MONTH(CurrentDate)
			    )
			
			RETURN
			CALCULATE(
			    SUM('FORECAST (2)'[Actual Sales]) +
			    SUM('FORECAST (2)'[CurrentMonthRunRate]),
			    FILTER(
			        'FORECAST (2)',
			        YEAR('FORECAST (2)'[Date]) = TargetYear
			            && MONTH('FORECAST (2)'[Date]) = TargetMonth
			            && 'FORECAST (2)'[Branch] IN VALUES('Seasonal Effect Branch'[Branch])
			            && 'FORECAST (2)'[Brand] IN VALUES('Seasonal Effect Branch'[Brand])
			    )
			)
		lineageTag: a7ee8116-911c-419d-af8b-2f9cabfa0435

		annotation PBI_FormatHint = {"isGeneralNumber":true}

