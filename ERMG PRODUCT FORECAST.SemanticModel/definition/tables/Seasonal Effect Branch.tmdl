	column SeasonalEffectTest = ```
			
			VAR SelectedMonth = MONTH('Seasonal Effect Branch'[Date]) 
			VAR SelectedBrand = 'Seasonal Effect Branch'[Brand]
			VAR CurrentMonth = MONTH(TODAY())  -- This gives the current month
			VAR CurrentYear = YEAR(TODAY())   -- This gives the current year
			VAR SalesWithRunrate = 
			    CALCULATE(
			        SUM('FORECAST (2)'[Actual Sales]) + SUM('FORECAST (2)'[CurrentMonthRunrate]),
			        FILTER(
			            'FORECAST (2)', 
			            'FORECAST (2)'[Brand] = SelectedBrand && 
			            MONTH('FORECAST (2)'[Date]) = CurrentMonth &&
			            YEAR('FORECAST (2)'[Date]) = CurrentYear  -- Ensure we are filtering for the current year as well
			        )
			    )
			RETURN SalesWithRunrate
			
			```
		lineageTag: 36c5d31c-3926-442e-9baf-5789fcb3fda5
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

