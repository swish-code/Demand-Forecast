	column Month_Forecast = MONTH('FORECAST (2)'[DATE].[Date])
		formatString: 0
		lineageTag: dccb9b17-7b05-47fe-ad8c-672c0575c5f5
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column SeasonalEffectSales = ```
			
			VAR CurrentYear = 'FORECAST (2)'[Year_Forecast]  -- Get Year from FORECAST[Year_Forecast]
			VAR CurrentMonth = 'FORECAST (2)'[Month_Forecast]  -- Get Month from FORECAST[Month_Forecast]
			VAR CurrentBrand = 'FORECAST (2)'[Brand]  -- Capture the current Brand from FORECAST[Brand]
			VAR CurrentBranch = 'FORECAST (2)'[Branch]
			
			
			RETURN
			LOOKUPVALUE(
			    'Seasonal Effect Branch'[SeasonalMonth],  -- The column to return
			    'Seasonal Effect Branch'[Brand], CurrentBrand,  -- Match Brand between tables
			    'Seasonal Effect Branch'[Branch], CurrentBranch,
			    'Seasonal Effect Branch'[Year_SeasonalEffect], CurrentYear,  -- Match Year
			    'Seasonal Effect Branch'[Month_SeasonalEffect], CurrentMonth  -- Match Month
			)
			
			```
		lineageTag: e217927e-7b87-47d3-a95f-150434c27113
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column MonthRunrate = ```
			
			    CALCULATE(
			        LASTNONBLANK('FORECAST (2)'[YesterdayMonthly], 1) * LASTNONBLANK('FORECAST (2)'[D. Forecast %], 1),
			        'FORECAST (2)'[DATE] <= TODAY() - 1
			    ) 
			
			```
		lineageTag: 9bf25b6e-5f8a-4395-82bc-7cc8473463cd
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column YesterdayMonthly = ```
			
			VAR PreviousDa = 'FORECAST (2)'[DATE] - 1
			VAR CurrentBrand = 'FORECAST (2)'[BRAND]
			VAR CurrentLocationID = 'FORECAST (2)'[BRANCH]  -- Capture current row's LocationID
			VAR YesterdayRunRate = 
			    CALCULATE(
			        MAX('FORECAST (2)'[MonthlyRunRate_MTD]),
			        FILTER(
			            'FORECAST (2)',
			            'FORECAST (2)'[Date] = PreviousDa &&
			            'FORECAST (2)'[Brand] = CurrentBrand &&
			            'FORECAST (2)'[BRANCH] = CurrentLocationID  -- Match by LocationID
			        )
			    )
			RETURN
			IF(DAY('FORECAST (2)'[DATE]) = 1, YesterdayRunRate * 'FORECAST (2)'[SeasonalEffect], YesterdayRunRate)
			```
		lineageTag: a84c8e2d-5a25-4f97-8a0f-bfd4a2909a3e
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column SeasonalEffect = ```
			
			VAR CurrentYear = 'FORECAST (2)'[Year_Forecast]  -- Get Year from FORECAST[Year_Forecast]
			VAR CurrentMonth = 'FORECAST (2)'[Month_Forecast]  -- Get Month from FORECAST[Month_Forecast]
			VAR CurrentBrand = 'FORECAST (2)'[BRAND]  -- Capture the current Brand from FORECAST[Brand]
			VAR CurrentBranch = 'FORECAST (2)'[BRANCH]
			
			RETURN
			LOOKUPVALUE(
			    'Seasonal Effect Branch'[Seasonal Effect],  -- The column to return
			    'Seasonal Effect Branch'[Brand], CurrentBrand,  -- Match Brand between tables
			    'Seasonal Effect Branch'[Year_SeasonalEffect], CurrentYear,  -- Match Year
			    'Seasonal Effect Branch'[Month_SeasonalEffect], CurrentMonth,  -- Match Month
			    'Seasonal Effect Branch'[Branch], CurrentBranch
			)
			
			```
		lineageTag: 0dd172b6-a61f-403b-bc85-14d60a4256d8
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Effect =
			
			LOOKUPVALUE(
			    FORECAST[Effect],
			    FORECAST[BRAND], 'FORECAST (2)'[BRAND],
			    FORECAST[DATE], 'FORECAST (2)'[DATE]
			)
