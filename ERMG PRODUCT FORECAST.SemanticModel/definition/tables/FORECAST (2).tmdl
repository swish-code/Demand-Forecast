table 'FORECAST (2)'
	lineageTag: b86d5f66-ea02-4c86-bacb-3fe59cecbf23

	measure 'June Forecast Total' =
			
			CALCULATE(
			    SUM('FORECAST (2)'[Totalsale]),
			    'FORECAST (2)'[Month_Forecast] = 6,
			    'FORECAST (2)'[Year_Forecast] = 2026
			)
		lineageTag: 1540c08b-fd16-4f6a-8252-2c4ecef4293e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'June Seasonal Target' =
			
			CALCULATE(
			    SUM('Seasonal Effect test'[SeasonalMonth]),
			    'Seasonal Effect test'[Month_SeasonalEffect] = 6,
			    'Seasonal Effect test'[Year_SeasonalEffect] = 2026,
			    TREATAS(
			        VALUES('FORECAST (2)'[BRAND]),
			        'Seasonal Effect test'[Brand]
			    )
			)
		lineageTag: 33bb0513-427f-44d9-bef6-1cce55cd3ddc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

