	column NextMonthRunrate =
			
			'FORECAST (2)'[SeasonalEffectSales]*'FORECAST (2)'[D. Forecast %]
		lineageTag: 4e062775-5e57-4ffb-970b-34f124e556f0
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

