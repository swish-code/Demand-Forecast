	column 'Actual Sales' = ```
			
			IF(
			    'FORECAST (2)'[DATE] < TODAY(),
			    COALESCE(
			        LOOKUPVALUE(
			            'HEADER'[NetSales],
			            'HEADER'[VoucherDate],    'FORECAST (2)'[DATE],
			            'HEADER'[Brand],          'FORECAST (2)'[BRAND],
			            'HEADER'[LOCATIONID],     'FORECAST (2)'[BRANCH]  -- Fixed: added missing quote & comma
			        ), 
			        0
			    ),
			    BLANK()
			)
			```
		lineageTag: 4f68f4d9-0e4c-4713-92de-78752ce742ad
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column MonthlyRunRate_MTD = ```
			
			VAR CurrentDate = 'FORECAST (2)'[DATE]
			VAR MTDStart = DATE(YEAR(CurrentDate), MONTH(CurrentDate), 1)
			
			-- Cumulative Actual Sales, grouped by brand and location
			VAR CumulativeActualSales = 
			    CALCULATE(
			        SUM('FORECAST (2)'[Actual Sales]),
			        FILTER(
			            'FORECAST (2)',
			            'FORECAST (2)'[Date] <= CurrentDate &&
			            'FORECAST (2)'[Date] >= MTDStart &&
			            'FORECAST (2)'[Effect] <> "Yes" &&
			            NOT(ISBLANK('FORECAST (2)'[D. Forecast %])) &&
			            'FORECAST (2)'[Brand] = EARLIER('FORECAST (2)'[BRAND]) &&
			            'FORECAST (2)'[BRANCH] = EARLIER('FORECAST (2)'[BRANCH])  -- Group by LocationID
			        )
			    )
			
			-- Cumulative Forecast %, grouped by brand and location
			VAR CumulativeForecast = 
			    CALCULATE(
			        SUM('FORECAST (2)'[D. Forecast %]),
			        FILTER(
			            'FORECAST (2)',
			            'FORECAST (2)'[Date] <= CurrentDate &&
			            'FORECAST (2)'[Date] >= MTDStart &&
			            'FORECAST (2)'[Effect] <> "Yes" &&
			            'FORECAST (2)'[Brand] = EARLIER('FORECAST (2)'[BRAND]) &&
			            'FORECAST (2)'[BRANCH] = EARLIER('FORECAST (2)'[BRANCH])  -- Group by LocationID
			        )
			    )
			
			RETURN
			IF(
			    CumulativeForecast = 0 || ISBLANK(CumulativeForecast),
			    0,
			    DIVIDE(CumulativeActualSales, CumulativeForecast)
			)
			```
		lineageTag: 27ae0509-6d44-476b-8896-e445f00f18bf
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Yesterday = ```
			'FORECAST (2)'[DATE] - 1
			
			```
		formatString: General Date
		lineageTag: bb3b7f70-2612-49ee-a03f-0dc3e6af2d86
		summarizeBy: none

		variation Variation
			isDefault
			relationship: 2b72927d-58a4-4749-b8f4-e5a8f10518ba
			defaultHierarchy: LocalDateTable_0777414d-c193-47a2-aa16-8128276b5a4b.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	column 'Yesterday Monthly RunRate' = ```
			
			VAR CurrentBrand = 'FORECAST (2)'[BRAND]
			VAR CurrentLocationID = 'FORECAST (2)'[BRANCH]  -- Capture current row's LocationID
			VAR YesterdayRunRate = 
			    CALCULATE(
			        MAX('FORECAST (2)'[MonthlyRunRate_MTD]),
			        FILTER(
			            'FORECAST (2)',
			            'FORECAST (2)'[Date] = TODAY() - 1 &&
			            'FORECAST (2)'[Brand] = CurrentBrand &&
			            'FORECAST (2)'[BRANCH] = CurrentLocationID  -- Match by LocationID
			        )
			    )
			RETURN
			YesterdayRunRate
			```
		lineageTag: 255aaf55-4712-45a2-8ec4-ad365aa176a9
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Day = DAY('FORECAST (2)'[DATE].[Date])
		formatString: 0
		lineageTag: 85f49dba-22bf-43b3-920a-6874f139eed8
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column DateCategorys = ```
			
			IF (
			    'FORECAST (2)'[DATE] < TODAY(),
			    "Actual",  -- Categorizes dates before today
			    "Forecast" -- Categorizes today and future dates
			)
			
			```
		lineageTag: a94da5c3-c065-4665-bccd-d9a9ca2355c3
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column CurrentMonthRunrate =
			
			IF(
			    MONTH('FORECAST (2)'[DATE]) = MONTH(TODAY()) &&
			    YEAR('FORECAST (2)'[DATE]) = YEAR(TODAY()), -- Ensure it is the current month
			    IF(
			        DAY(TODAY()) > 1, -- Start calculation from the 2nd day of the month
			        IF(
			            'FORECAST (2)'[Actual Sales] = 0,
			            'FORECAST (2)'[D. Forecast %] * 'FORECAST (2)'[Yesterday Monthly RunRate],
			            BLANK()
			        ),
			        BLANK() -- Exclude rows on the 1st day of the month
			    ),
			    BLANK() -- Exclude rows outside the current month
			)
		lineageTag: a57d1787-fc6c-4926-a73d-a84c94c63e38
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Totalsale = ```
			
			IF(
			    NOT(ISBLANK('FORECAST (2)'[Actual Sales])), 
			    'FORECAST (2)'[Actual Sales], -- Use ActualSales if available
			    IF(
			        NOT(ISBLANK('FORECAST (2)'[CurrentMonthRunrate])), 
			        'FORECAST (2)'[CurrentMonthRunrate], -- Use CurrentMonthRunrate if ActualSales is not available
			        'FORECAST (2)'[NextMonthRunrate] -- Use NextMonthRunrate as a fallback
			    )
			) 
			```
		lineageTag: fbf53427-00a0-4bab-8da2-8a4dd8e09386
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Year_Forecast = YEAR('FORECAST (2)'[DATE].[Date])
		formatString: 0
		lineageTag: 5a230ab9-ada0-4dcf-b4e8-fb611e60c6a9
		summarizeBy: sum

