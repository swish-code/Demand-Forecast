	measure 'Tomorrow Forecast Qty' =
			
			VAR TomorrowDate = TODAY() + 1
			
			RETURN
			CALCULATE(
			    SUM(Forecast_Product_Table[Forecast_Qty_7(last 28+2)]),
			    Forecast_Product_Table[Date] = TomorrowDate
			)
		formatString: 0
		lineageTag: 9e481fc6-51fe-4b0a-962a-86484eafde30

	measure 'Products To Prepare' =
			
			VAR TomorrowDate = TODAY() + 1
			
			RETURN
			COUNTROWS(
			    FILTER(
			        SUMMARIZE(
			            Forecast_Product_Table,
			            Forecast_Product_Table[Clean_ItemID]
			        ),
			        CALCULATE(
			            SUM(Forecast_Product_Table[Forecast_Qty_7(last 28+2)]),
			            Forecast_Product_Table[Date] = TomorrowDate
			        ) > 0
			    )
			)
		formatString: 0
		lineageTag: 8a05f1bd-a734-4599-a726-b766863a3dee

	measure 'Last 2 Weekdays Avg Actual' =
			
			VAR TomorrowDate = TODAY() + 1
			VAR TargetWeekday = WEEKDAY(TomorrowDate, 2)
			
			VAR HistoricalSameWeekdays =
			    FILTER(
			        CALCULATETABLE(
			            DISTINCT(Forecast_Product_Table[Date]),
			            REMOVEFILTERS(Forecast_Product_Table[Date]),
			            REMOVEFILTERS(Forecast_Product_Table[IsTomorrow])
			        ),
			        Forecast_Product_Table[Date] < TomorrowDate
			            && Forecast_Product_Table[Date] >= TomorrowDate - 15
			            && WEEKDAY(Forecast_Product_Table[Date], 2) = TargetWeekday
			    )
			
			VAR Last2Dates =
			    TOPN(
			        2,
			        HistoricalSameWeekdays,
			        Forecast_Product_Table[Date],
			        DESC
			    )
			
			VAR TotalActual =
			    CALCULATE(
			        SUM(Forecast_Product_Table[Actual_Qty]),
			        REMOVEFILTERS(Forecast_Product_Table[Date]),
			        REMOVEFILTERS(Forecast_Product_Table[IsTomorrow]),
			        Last2Dates
			    )
			
			VAR DatesWithActual =
			    FILTER(
			        Last2Dates,
			        CALCULATE(
			            SUM(Forecast_Product_Table[Actual_Qty]),
			            REMOVEFILTERS(Forecast_Product_Table[Date]),
			            REMOVEFILTERS(Forecast_Product_Table[IsTomorrow])
			        ) > 0
			    )
			
			VAR CountWithActual = COUNTROWS(DatesWithActual)
			
			RETURN
			    ROUND(DIVIDE(TotalActual, CountWithActual), 0)
		formatString: 0
		lineageTag: 85626f07-a876-4c7c-a3e1-b750bdaab5fc

	measure 'Demand Change %' =
			
			VAR Base = [Last 2 Weekdays Avg Actual]
			VAR Result =
			    DIVIDE(
			        [Tomorrow Forecast Qty] - Base,
			        Base
			    )
			RETURN
			IF(Base < 1, BLANK(), Result)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 5c1488ad-e468-4ee4-a679-fc345fbc9a70

