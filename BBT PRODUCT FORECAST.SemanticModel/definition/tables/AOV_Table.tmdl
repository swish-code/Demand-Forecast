	measure 'Forecast Accuracy %' =
			
			VAR _forecast = [Total_Forecast_Qty]
			VAR _actual   = [Total_Actual_Qty]
			RETURN
			    1 - ABS( DIVIDE( _actual - _forecast, _forecast, 0 ) )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 2112c5c3-8258-4732-8edb-cfeddc60f357

