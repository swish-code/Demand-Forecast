		variation Variation
			isDefault
			relationship: 7794772e-b9cf-49a7-83be-edea57dfd520
			defaultHierarchy: LocalDateTable_7e11d4e0-0997-4289-8dd9-2963e9297c7b.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column Daily_Sales
		lineageTag: c45e9724-737e-4eba-8187-4fbd67c03451
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Daily_Sales]

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Daily_Orders
		formatString: 0
		lineageTag: 48e47b06-951c-4af9-ad46-3bc7e4a65db7
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Daily_Orders]

		annotation SummarizationSetBy = Automatic

	column Daily_AOV
		lineageTag: aeefa265-5fa9-4919-8267-88385cef5cc7
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Daily_AOV]

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition AOV_Table = calculated
		mode: import
		source =
				
				ADDCOLUMNS(
				    SUMMARIZE(
				        HEADER,
				        HEADER[Brand],
				        HEADER[LOCATIONID],
				        HEADER[VOUCHERDATE]
				    ),
				
				    "Daily_Sales",
				    VAR _brand = [Brand]
				    VAR _loc   = [LOCATIONID]
				    VAR _date  = [VOUCHERDATE]
				    RETURN
				        CALCULATE(
				            SUM(HEADER[NetSales]),
				            FILTER(
				                ALL(HEADER),
				                HEADER[Brand]       = _brand &&
				                HEADER[LOCATIONID]  = _loc   &&
				                HEADER[VOUCHERDATE] = _date
				            )
				        ),
				
				    "Daily_Orders",
				    VAR _brand = [Brand]
				    VAR _loc   = [LOCATIONID]
				    VAR _date  = [VOUCHERDATE]
				    RETURN
				        CALCULATE(
				            SUM(HEADER[TotalOrders]),
				            FILTER(
				                ALL(HEADER),
				                HEADER[Brand]       = _brand &&
				                HEADER[LOCATIONID]  = _loc   &&
				                HEADER[VOUCHERDATE] = _date
				            )
				        ),
				
				    "Daily_AOV",
				    VAR _brand = [Brand]
				    VAR _loc   = [LOCATIONID]
				    VAR _date  = [VOUCHERDATE]
				
				    VAR _sales =
				        CALCULATE(
				            SUM(HEADER[NetSales]),
				            FILTER(
				                ALL(HEADER),
				                HEADER[Brand]       = _brand &&
				                HEADER[LOCATIONID]  = _loc   &&
				                HEADER[VOUCHERDATE] = _date
				            )
				        )
				
				    VAR _orders =
				        CALCULATE(
				            SUM(HEADER[TotalOrders]),
				            FILTER(
				                ALL(HEADER),
				                HEADER[Brand]       = _brand &&
				                HEADER[LOCATIONID]  = _loc   &&
				                HEADER[VOUCHERDATE] = _date
				            )
				        )
				
				    RETURN
				        DIVIDE(_sales, _orders, 0)
				)

	annotation PBI_Id = 3432b27a8e86422c92785b057592abbe

