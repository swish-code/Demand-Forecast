		sourceColumn: Brand

		annotation SummarizationSetBy = Automatic

	column ProductDelivery = ```
			
			IF(
			    'HEADER'[VOUCHERDATE] < TODAY(),  -- Check if the date is before today
			    COALESCE(
			        LOOKUPVALUE(
			            'Delivery Charges'[DeliveryCharges],          -- Column from HEADER table to return
			            'Delivery Charges'[VoucherDate],       -- First column from HEADER table to match
			            'HEADER'[VOUCHERDATE],            -- First column from FORECAST table to match
			            'Delivery Charges'[CHAINID],             -- Second column from HEADER table to match
			            'HEADER'[Brand]            -- Second column from FORECAST table to match
			        ), 
			        0  -- If no value is found, return 0
			    ),
			    BLANK()  -- Return blank if the date is today or in the future
			)
			
			```
		lineageTag: 43f7afa1-0d92-4119-8e2f-d4612d9a5c45
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

